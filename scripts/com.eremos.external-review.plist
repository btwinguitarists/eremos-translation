<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eremos.external-review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/benvanscyoc/thai-bible-ai/scripts/clear_review_queue.sh</string>
    </array>

    <!-- Run every morning at 7:00. Adjust Hour/Minute as you like. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/eremos-external-review.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/eremos-external-review.err</string>
</dict>
</plist>
