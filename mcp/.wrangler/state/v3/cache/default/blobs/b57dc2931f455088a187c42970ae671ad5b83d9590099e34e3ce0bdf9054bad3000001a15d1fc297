ียงร้อยคน และเมืองที่ส่งออกไปร้อยคน จะเหลือเพียงสิบคนสำหรับพงศ์พันธุ์อิสราเอล"},{"verse":4,"text":"เพราะองค์พระผู้เป็นเจ้าตรัสกับพงศ์พันธุ์อิสราเอลดังนี้ว่า จงแสวงหาเราและจะมีชีวิตอยู่"},{"verse":5,"text":"แต่อย่าแสวงหาเบธเอล อย่าเข้าไปในกิลกาล และอย่าข้ามไปยังเบเออร์เชบา เพราะกิลกาลจะต้องตกเป็นเชลยอย่างแน่นอน และเบธเอลจะกลายเป็นความว่างเปล่า"},{"verse":6,"text":"จงแสวงหาองค์พระผู้เป็นเจ้าและจะมีชีวิตอยู่ มิฉะนั้นพระองค์จะทรงพลุ่งขึ้นเหมือนไฟเหนือพงศ์พันธุ์โยเซฟ ไฟนั้นจะเผาผลาญเบธเอล โดยไม่มีใครดับได้"},{"verse":7,"text":"พวกเจ้าผู้เปลี่ยนความยุติธรรมให้ขมเป็นบอระเพ็ด และเหวี่ยงความชอบธรรมลงกับพื้นดิน"},{"verse":8,"text":"พระองค์ผู้ทรงสร้างกลุ่มดาวลูกไก่และกลุ่มดาวนายพราน ผู้ทรงเปลี่ยนความมืดทึบให้เป็นรุ่งเช้า และทรงทำให้กลางวันมืดลงเป็นกลางคืน ผู้ทรงเรียกน้ำทะเลมาและเทลงบนพื้นแผ่นดินโลก พระนามของพระองค์คือ องค์พระผู้เป็นเจ้า"},{"verse":9,"text":"พระองค์ผู้ทรงให้ความพินาศวาบลงมาเหนือผู้แข็งแกร่ง จนความพินาศมาถึงป้อมปราการ"},{"verse":10,"text":"พวกเขาเกลียดผู้ที่ตักเตือนตรงประตูเมือง และรังเกียจผู้ที่พูดความจริง"},{"verse":11,"text":"เพราะฉะนั้น เนื่องจากพวกเจ้าเหยียบย่ำคนยากจน และเรียกเก็บภาษีข้าวจากเขา ถึงแม้พวกเจ้าจะสร้างบ้านด้วยหินสกัด พวกเจ้าก็จะไม่ได้อาศัยอยู่ในนั้น แม้พวกเจ้าจะปลูกสวนองุ่นอันงดงาม พวกเจ้าก็จะไม่ได้ดื่มเหล้าองุ่นจากสวนนั้น"},{"verse":12,"text":"เพราะเรารู้ว่าการล่วงละเมิดของพวกเจ้ามีมากมาย และบาปของพวกเจ้าก็ใหญ่หลวงนัก พวกเจ้าเป็นผู้ข่มเหงคนชอบธรรม รับสินบน และผลักไสคนขัดสนให้แพ้คดีที่ประตูเมือง"},{"verse":13,"text":"เพราะฉะนั้น ในเวลาเช่นนั้น คนมีปัญญาก็จะนิ่งเงียบ เพราะเป็นเวลาแห่งความชั่วร้าย"},{"verse":14,"text":"จงแสวงหาความดี อย่าแสวงหาความชั่ว เพื่อพวกเจ้าจะมีชีวิตอยู่ แล้วองค์พระผู้เป็นเจ้าพระเจ้าจอมโยธาจะสถิตอยู่กับพวกเจ้า ดังที่พวกเจ้ากล่าวอ้าง"},{"verse":15,"text":"จงเกลียดความชั่ว และรักความดี จงสถาปนาความยุติธรรมขึ้นที่ประตูเมือง บางทีองค์พระผู้เป็นเจ้าพระเจ้าจอมโยธาจะทรงพระกรุณาต่อชนที่เหลืออยู่ของโยเซฟ"},{"verse":16,"text":"เพราะฉะนั้น องค์พระผู้เป็นเจ้าพระเจ้าจอมโยธา องค์เจ้านาย ตรัสดังนี้ว่า ตามลานเมืองทุกแห่งจะมีการคร่ำครวญ และตามถนนทุกสายผู้คนจะร้องว่า ‘อนิจจา อนิจจา’ พวกเขาจะเรียกชาวนามาร่วมไว้ทุกข์ และเรียกผู้ที่ชำนาญการร้องไห้มาร่ำไห้คร่ำครวญ"},{"verse":17,"text":"ในสวนองุ่นทุกแห่งจะมีการคร่ำครวญ เพราะเราจะผ่านไปท่ามกลางพวกเจ้า องค์พระผู้เป็นเจ้าตรัสดังนี้"},{"verse":18,"text":"วิบัติแก่พวกเจ้าผู้ปรารถนาวันแห่งองค์พระผู้เป็นเจ้า วันนั้นจะเป็นประโยชน์อะไรแก่พวกเจ้า วันแห่งองค์พระผู้เป็นเจ้านั้นเป็นความมืด ไม่ใช่ความสว่าง"},{"verse":19,"text":"เหมือนคนหนึ่งหนีจากสิงโต แล้วไปพบหมี หรือเข้าไปในบ้าน เอามือเท้าฝาผนัง แล้วถูกงูกัด"},{"verse":20,"text":"วันแห่งองค์พระผู้เป็นเจ้าจะเป็นความมืด ไม่ใช่ความสว่าง เป็นความมืดมิด ปราศจากแสงสว่างใด ๆ มิใช่หรือ"},{"verse":21,"text":"เราเกลียด เราชิงชังเทศกาลทั้งหลายของพวกเจ้า และเราไม่พอใจในการประชุมอันศักดิ์สิทธิ์ของพวกเจ้าเลย"},{"verse":22,"text":"แม้พวกเจ้าจะถวายเครื่องเผาบูชาและเครื่องบูชาธัญพืชแก่เรา เราก็จะไม่รับ และเครื่องสันติบูชาด้วยสัตว์อ้วนพีของพวกเจ้า เราก็จะไม่มองดู"},{"verse":23,"text":"จงเอาเสียงเพลงอึกทึกของพวกเจ้าไปให้พ้นจากเรา เราจะไม่ฟังเสียงพิณของพวกเจ้า"},{"verse":24,"text":"แต่จงให้ความยุติธรรมไหลล้นลงมาเหมือนกระแสน้ำ และให้ความชอบธรรมไหลเหมือนลำธารที่ไม่ขาดสาย"},{"verse":25,"text":"พงศ์พันธุ์อิสราเอลเอ๋ย พวกเจ้าได้นำเครื่องสัตวบูชาและเครื่องบูชาธัญพืชมาถวายแก่เราในถิ่นทุรกันดารตลอดสี่สิบปีหรือ"},{"verse":26,"text":"พวกเจ้ากลับแบกสิคูทกษัตริย์ของพวกเจ้า และคิยยูนรูปเคารพของพวกเจ้า คือรูปดาวแห่งพระของพวกเจ้า ซึ่งพวกเจ้าได้สร้างขึ้นเอง"},{"verse":27,"text":"เพราะฉะนั้น เราจะกวาดพวกเจ้าให้ไปเป็นเชลยไกลออกไปเลยเมืองดามัสกัส องค์พระผู้เป็นเจ้าผู้ทรงพระนามว่าพระเจ้าจอมโยธาตรัสดังนี้"}]},{"chapter":6,"verses":[{"verse":1,"text":"วิบัติแก่พวกเจ้าผู้อยู่อย่างสุขสบายในศิโยน และผู้รู้สึกมั่นคงปลอดภัยบนภูเขาสะมาเรีย คือพวกผู้นำคนสำคัญของชาติชั้นนำ ผู้ซึ่งพงศ์พันธุ์อิสราเอลพากันมาหา"},{"verse":2,"text":"จงข้ามไปยังเมืองคาลเนห์และดูเถิด จากที่นั่นจงไปยังเมืองฮามัทอันยิ่งใหญ่ แล้วลงไปยังเมืองกัทของชาวฟีลิสเตีย พวกเจ้าดีกว่าอาณาจักรเหล่านี้หรือ ดินแดนของพวกเขาใหญ่กว่าดินแดนของพวกเจ้าหรือ"},{"verse":3,"text":"พวกเจ้าผู้ผัดวันแห่งหายนะออกไป แต่กลับนำที่นั่งแห่งความรุนแรงเข้ามาใกล้"},{"verse":4,"text":"พวกเจ้าผู้นอนบนเตียงงาช้าง และเหยียดกายอยู่บนที่เอนกายของตน กินลูกแกะจากฝูง และลูกวัวจากคอกขุน"},{"verse":5,"text":"พวกเจ้าผู้ดีดพิณเล่นไปเรื่อยเปื่อย และคิดประดิษฐ์เครื่องดนตรีขึ้นเองเหมือนอย่างดาวิด"},{"verse":6,"text":"พวกเจ้าผู้ดื่มเหล้าองุ่นจากอ่าง และชโลมกายด้วยน้ำมันชั้นเลิศ แต่ไม่เป็นทุกข์ร้อนใจเลยกับความพินาศของโยเซฟ"},{"verse":7,"text":"เพราะฉะนั้น บัดนี้พวกเขาจะเป็นพวกแรกที่ต้องตกไปเป็นเชลย และงานเลี้ยงสำราญของผู้ที่เหยียดกายเอกเขนกก็จะสิ้นสุดลง"},{"verse":8,"text":"องค์พระผู้เป็นเจ้าทรงปฏิญาณโดยอ้างพระองค์เอง องค์พระผู้เป็นเจ้าพระเจ้าจอมโยธาตรัสดังนี้ว่า เราเกลียดชังความเย่อหยิ่งของยาโคบ และชิงชังป้อมปราการของเขา เราจะมอบเมืองนั้นพร้อมกับทุกสิ่งในเมืองนั้นไว้แก่ศัตรู"},{"verse":9,"text":"และต่อมา หากมีคนเหลืออยู่สิบคนในบ้านหลังเดียว พวกเขาก็จะตายสิ้น"},{"verse":10,"text":"เมื่อญาติคนหนึ่งซึ่งเป็นผู้เผาศพมายกกระดูกออกจากบ้าน และถามคนที่อยู่ลึกเข้าไปในบ้านว่า ‘ยังมีใครอยู่กับเจ้าอีกหรือ’ คนนั้นจะตอบว่า ‘ไม่มี’ แล้วเขาจะกล่าวว่า ‘เงียบไว้ เพราะเราต้องไม่เอ่ยพระนามขององค์พระผู้เป็นเจ้า’"},{"verse":11,"text":"เพราะดูเถิด องค์พระผู้เป็นเจ้าทรงบัญชา และบ้านหลังใหญ่จะถูกทุบให้แตกเป็นเสี่ยง ๆ และบ้านหลังเล็กก็จะแตกเป็นชิ้นเล็กชิ้นน้อย"},{"verse":12,"text":"ม้าจะวิ่งบนหน้าผาหินได้หรือ คนจะใช้วัวไถนาบนนั้นได้หรือ ถึงกระนั้น พวกเจ้ากลับเปลี่ยนความยุติธรรมให้กลายเป็นยาพิษ และเปลี่ยนผลของความชอบธรรมให้กลายเป็นบอระเพ็ด"},{"verse":13,"text":"พวกเจ้าผู้เปรมปรีดิ์ในการยึดเมืองโลเดบาร์ ผู้กล่าวว่า ‘เราได้ยึดเมืองคาร์นาอิมมาเป็นของเราด้วยกำลังของเราเองมิใช่หรือ’"},{"verse":14,"text":"พงศ์พันธุ์อิสราเอลเอ๋ย ดูเถิด เราจะให้ชนชาติหนึ่งลุกขึ้นต่อสู้พวกเจ้า องค์พระผู้เป็นเจ้าพระเจ้าจอมโยธาตรัสดังนี้ และชนชาตินั้นจะกดขี่พวกเจ้าตั้งแต่ทางเข้าเมืองฮามัทจนถึงลำธารแห่งอาราบาห์"}]},{"chapter":7,"verses":[{"verse":1,"text":"องค์พระผู้เป็นเจ้าทรงสำแดงแก่ข้าพเจ้าดังนี้ ดูเถิด พระองค์ทรงสร้างฝูงตั๊กแตนขึ้นในช่วงต้นฤดูที่พืชงอกขึ้นใหม่ คือพืชที่งอกขึ้นภายหลังการเก็บเกี่ยวส่วนของกษัตริย์"},{"verse":2,"text":"เมื่อฝูงตั๊กแตนกินพืชผักของแผ่นดินจนหมดสิ้น ข้าพเจ้าจึงทูลว่า ‘ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงโปรดอภัยเถิด ยาโคบจะยืนหยัดอยู่ได้อย่างไร เพราะเขาเล็กน้อยนัก’"},{"verse":3,"text":"องค์พระผู้เป็นเจ้าทรงเปลี่ยนพระทัยในเรื่องนี้ ‘จะไม่เป็นเช่นนั้น’ องค์พระผู้เป็นเจ้าตรัส"},{"verse":4,"text":"องค์พระผู้เป็นเจ้าทรงสำแดงแก่ข้าพเจ้าดังนี้ ดูเถิด องค์พระผู้เป็นเจ้าทรงเรียกไฟมาเพื่อพิพากษา ไฟนั้นเผาผลาญห้วงน้ำลึกใหญ่ และกำลังจะเผาผลาญที่ดินผืนนั้น"},{"verse":5,"text":"ข้าพเจ้าจึงทูลว่า ‘ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงยับยั้งเถิด ยาโคบจะยืนหยัดอยู่ได้อย่างไร เพราะเขาเล็กน้อยนัก’"},{"verse":6,"text":"องค์พระผู้เป็นเจ้าทรงเปลี่ยนพระทัยในเรื่องนี้ ‘เรื่องนี้ก็จะไม่เป็นเช่นกัน’ องค์พระผู้เป็นเจ้าตรัส"},{"verse":7,"text":"พระองค์ทรงสำแดงแก่ข้าพเจ้าดังนี้ ดูเถิด องค์เจ้านายทรงยืนอยู่ข้างกำแพงที่สร้างขึ้นด้วยลูกดิ่ง และในพระหัตถ์ของพระองค์มีลูกดิ่งอันหนึ่ง"},{"verse":8,"text":"องค์พระผู้เป็นเจ้าตรัสถามข้าพเจ้าว่า ‘อาโมส เจ้าเห็นอะไร’ ข้าพเจ้าทูลตอบว่า ‘ลูกดิ่งอันหนึ่ง’ แล้วองค์เจ้านายตรัสว่า ‘ดูเถิด เรากำลังตั้งลูกดิ่งไว้ท่ามกลางอิสราเอลประชากรของเรา เราจะไม่ผ่านเลยพวกเขาไปอีกต่อไป’"},{"verse":9,"text":"ปูชนียสถานบนที่สูงทั้งหลายของอิสอัคจะถูกทิ้งร้าง และสถานนมัสการทั้งหลายของอิสราเอลจะถูกทำลายลง และเราจะลุกขึ้นต่อสู้ราชวงศ์ของเยโรโบอัมด้วยดาบ"},{"verse":10,"text":"แล้วอามาซิยาห์ปุโรหิตแห่งเบธเอลก็ส่งข่าวไปทูลเยโรโบอัมกษัตริย์แห่งอิสราเอลว่า ‘อาโมสคบคิดกบฏต่อพระองค์ในท่ามกลางพงศ์พันธุ์อิสราเอล แผ่นดินนี้ไม่อาจทนรับถ้อยคำทั้งสิ้นของเขาได้’"},{"verse":11,"text":"เพราะอาโมสกล่าวไว้ดังนี้ว่า ‘เยโรโบอัมจะตายด้วยดาบ และอิสราเอลจะต้องตกไปเป็นเชลย ถูกกวาดไปจากแผ่นดินของตนอย่างแน่นอน’"},{"verse":12,"text":"อามาซิยาห์จึงกล่าวแก่อาโมสว่า ‘เจ้าผู้ทำนายเอ๋ย ไปเถิด จงหนีไปยังแผ่นดินยูดาห์ ไปหากินที่นั่น และไปเผยพระวจนะที่นั่น"},{"verse":13,"text":"แต่อย่าเผยพระวจนะที่เบธเอลอีกต่อไป เพราะที่นี่เป็นสถานนมัสการของกษัตริย์ และเป็นพระวิหารของราชอาณาจักร’"},{"verse":14,"text":"อาโมสจึงตอบอามาซิยาห์ว่า ‘ข้าพเจ้าไม่ใช่ผู้เผยพระวจนะ และไม่ใช่ลูกของผู้เผยพระวจนะ ข้าพเจ้าเป็นเพียงคนเลี้ยงสัตว์ และเป็นคนดูแลต้นมะเดื่อ"},{"verse":15,"text":"แต่องค์พระผู้เป็นเจ้าทรงนำข้าพเจ้ามาจากการติดตามฝูงแกะ และองค์พระผู้เป็นเจ้าตรัสกับข้าพเจ้าว่า ‘จงไปเผยพระวจนะแก่อิสราเอลประชากรของเรา’"},{"verse":16,"text":"บัดนี้ จงฟังพระวจนะขององค์พระผู้เป็นเจ้า เจ้ากล่าวว่า ‘อย่าเผยพระวจนะกล่าวโทษอิสราเอล และอย่าเทศนากล่าวโทษพงศ์พันธุ์ของอิสอัค’"},{"verse":17,"text":"เพราะฉะนั้น องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘ภรรยาของเจ้าจะกลายเป็นหญิงโสเภณีในเมือง บุตรชายและบุตรสาวของเจ้าจะล้มตายด้วยดาบ ที่ดินของเจ้าจะถูกแบ่งแยกด้วยเชือกวัด ส่วนตัวเจ้าเองจะตายในแผ่นดินที่เป็นมลทิน และอิสราเอลจะต้องตกไปเป็นเชลย ถูกกวาดไปจากแผ่นดินของตนอย่างแน่นอน’"}]},{"chapter":8,"verses":[{"verse":1,"text":"องค์พระผู้เป็นเจ้าทรงสำแดงแก่ข้าพเจ้าดังนี้ ดูเถิด มีตะกร้าผลไม้สุกปลายฤดูใบหนึ่ง"},{"verse":2,"text":"พระองค์ตรัสว่า ‘อาโมส เจ้าเห็นอะไร’ ข้าพเจ้าทูลตอบว่า ‘ตะกร้าผลไม้สุกปลายฤดู’ แล้วองค์พระผู้เป็นเจ้าตรัสกับข้าพเจ้าว่า ‘วาระสุดท้ายมาถึงอิสราเอลประชากรของเราแล้ว เราจะไม่ผ่านเลยพวกเขาไปอีกต่อไป’"},{"verse":3,"text":"องค์พระผู้เป็นเจ้าตรัสดังนี้ ในวันนั้น บทเพลงทั้งหลายในพระวิหารจะกลายเป็นเสียงร่ำไห้คร่ำครวญ จะมีซากศพมากมายถูกโยนทิ้งไปทั่วทุกแห่ง เงียบไว้"},{"verse":4,"text":"พวกเจ้าผู้เหยียบย่ำคนขัดสน และล้างผลาญคนยากจนของแผ่นดิน จงฟังสิ่งนี้"},{"verse":5,"text":"พวกเจ้ากล่าวว่า ‘เมื่อไรเทศกาลขึ้นหนึ่งค่ำจะผ่านพ้นไป เพื่อเราจะได้ขายข้าว และเมื่อไรวันสะบาโตจะหมดไป เพื่อเราจะได้เปิดขายข้าวสาลี โดยทำเอฟาห์ให้เล็กลงและทำเชเขลให้ใหญ่ขึ้น และโกงด้วยตราชั่งไม่เที่ยงตรง"},{"verse":6,"text":"เพื่อเราจะซื้อคนยากจนด้วยเงิน และซื้อคนขัดสนด้วยรองเท้าสักคู่หนึ่ง และขายแม้แต่ข้าวสาลีที่ปนเปลือกออกไป’"},{"verse":7,"text":"องค์พระผู้เป็นเจ้าทรงปฏิญาณโดยอ้างความเย่อหยิ่งของยาโคบว่า ‘เราจะไม่ลืมการกระทำใด ๆ ของพวกเขาเลยเป็นนิตย์’"},{"verse":8,"text":"เพราะเหตุนี้ แผ่นดินจะไม่สั่นสะเทือนหรือ และทุกคนที่อาศัยอยู่ในนั้นจะไม่ไว้ทุกข์หรือ แผ่นดินทั้งสิ้นจะเอ่อขึ้นเหมือนแม่น้ำไนล์ แล้วก็ปั่นป่วนและยุบลงอีกเหมือนแม่น้ำแห่งอียิปต์"},{"verse":9,"text":"องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ในวันนั้น เราจะทำให้ดวงอาทิตย์ตกตอนเที่ยงวัน และจะทำให้แผ่นดินมืดลงในเวลากลางวันแสก ๆ"},{"verse":10,"text":"เราจะเปลี่ยนเทศกาลทั้งหลายของพวกเจ้าให้กลายเป็นการไว้ทุกข์ และเปลี่ยนบทเพลงทั้งสิ้นของพวกเจ้าให้กลายเป็นเพลงคร่ำครวญ เราจะให้ทุกคนคาดเอวด้วยผ้ากระสอบ และให้ทุกศีรษะโล้นล้าน เราจะทำให้เป็นเหมือนการไว้ทุกข์ให้บุตรคนเดียว และให้บั้นปลายของมันเป็นเหมือนวันอันขมขื่น"},{"verse":11,"text":"องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ดูเถิด วันเวลาจะมาถึง เมื่อเราจะส่งการกันดารมาเหนือแผ่นดิน ไม่ใช่การกันดารอาหารหรือการกระหายน้ำ แต่เป็นการกันดารในการได้ยินพระวจนะขององค์พระผู้เป็นเจ้า"},{"verse":12,"text":"ผู้คนจะระเหเร่ร่อนจากทะเลหนึ่งไปยังอีกทะเลหนึ่ง และจากทิศเหนือไปยังทิศตะวันออก เที่ยวเสาะหาพระวจนะขององค์พระผู้เป็นเจ้า แต่จะหาไม่พบ"},{"verse":13,"text":"ในวันนั้น สาวพรหมจารีที่งดงามและชายหนุ่มทั้งหลายจะสลบไสลไปเพราะความกระหาย"},{"verse":14,"text":"บรรดาผู้ที่ปฏิญาณโดยอ้างความผิดบาปของสะมาเรีย และกล่าวว่า ‘ดานเอ๋ย พระของเจ้าทรงพระชนม์อยู่แน่ฉันใด’ และ ‘ทางแห่งเบเออร์เชบาดำรงอยู่แน่ฉันใด’ คนเหล่านั้นจะล้มลงและจะไม่ลุกขึ้นอีกเลย"}]},{"chapter":9,"verses":[{"verse":1,"text":"ข้าพเจ้าเห็นองค์เจ้านายทรงยืนอยู่ข้างแท่นบูชา และพระองค์ตรัสว่า ‘จงตีหัวเสาให้ธรณีประตูสั่นสะเทือน และให้มันแตกลงเหนือศีรษะของคนทั้งปวง คนที่เหลืออยู่เราจะฆ่าเสียด้วยดาบ จะไม่มีผู้ใดหนีรอดไปได้ ไม่มีผู้ใดหลบหนีไปได้เลย"},{"verse":2,"text":"แม้พวกเขาจะขุดลงไปถึงแดนคนตาย มือของเราก็จะคว้าพวกเขาขึ้นมาจากที่นั่น และแม้พวกเขาจะปีนขึ้นไปถึงฟ้าสวรรค์ เราก็จะนำพวกเขาลงมาจากที่นั่น"},{"verse":3,"text":"แม้พวกเขาจะซ่อนตัวอยู่บนยอดเขาคารเมล เราก็จะค้นหาและจับพวกเขามาจากที่นั่น และแม้พวกเขาจะหลบซ่อนจากสายตาของเราที่ก้นทะเล เราก็จะบัญชางูที่นั่นให้กัดพวกเขา"},{"verse":4,"text":"แม้พวกเขาจะตกไปเป็นเชลยต่อหน้าศัตรูของตน เราก็จะบัญชาดาบที่นั่นให้สังหารพวกเขา เราจะจับตาดูพวกเขาเพื่อให้ร้าย ไม่ใช่เพื่อให้ดี"},{"verse":5,"text":"องค์พระผู้เป็นเจ้าจอมโยธาทรงเป็นผู้แตะต้องแผ่นดินโลก แล้วแผ่นดินก็ละลายไป และทุกคนที่อาศัยอยู่ในนั้นก็ไว้ทุกข์ แผ่นดินทั้งสิ้นจะเอ่อขึ้นเหมือนแม่น้ำไนล์ แล้วยุบลงอีกเหมือนแม่น้ำแห่งอียิปต์"},{"verse":6,"text":"พระองค์ผู้ทรงสร้างห้องชั้นบนของพระองค์ไว้ในฟ้าสวรรค์ และทรงตั้งแผ่นฟ้าของพระองค์ไว้เหนือแผ่นดินโลก ผู้ทรงเรียกน้ำทะเลมาและเทลงบนพื้นแผ่นดินโลก พระนามของพระองค์คือ องค์พระผู้เป็นเจ้า"},{"verse":7,"text":"องค์พระผู้เป็นเจ้าตรัสว่า ชนอิสราเอลเอ๋ย พวกเจ้าไม่เป็นเหมือนชาวคูชสำหรับเราหรือ เรานำอิสราเอลขึ้นมาจากแผ่นดินอียิปต์ และนำชาวฟีลิสเตียมาจากคัฟโทร์ และนำชาวอารัมมาจากเมืองคีร์มิใช่หรือ"},{"verse":8,"text":"ดูเถิด องค์พระผู้เป็นเจ้าทอดพระเนตรดูอาณาจักรที่บาปหนานั้น และเราจะทำลายมันเสียจากพื้นแผ่นดินโลก แต่เราจะไม่ทำลายพงศ์พันธุ์ของยาโคบเสียจนหมดสิ้น องค์พระผู้เป็นเจ้าตรัสดังนี้"},{"verse":9,"text":"เพราะดูเถิด เราจะบัญชา และจะเขย่าพงศ์พันธุ์อิสราเอลท่ามกลางประชาชาติทั้งปวง เหมือนเขย่าเมล็ดข้าวในตะแกรง แต่จะไม่มีเม็ดข้าวสักเม็ดเดียวตกถึงพื้นดิน"},{"verse":10,"text":"คนบาปทั้งสิ้นในหมู่ประชากรของเราจะตายด้วยดาบ คือบรรดาผู้ที่กล่าวว่า ‘ภัยพิบัติจะไม่มาถึงหรือมาประจันหน้าเรา’"},{"verse":11,"text":"ในวันนั้น เราจะยกพลับพลาของดาวิดที่ล้มลงแล้วนั้นขึ้นใหม่ เราจะซ่อมแซมรอยร้าวของมัน ยกซากปรักหักพังของมันขึ้น และสร้างมันขึ้นใหม่ให้เหมือนในสมัยโบราณ"},{"verse":12,"text":"เพื่อพวกเขาจะได้ครอบครองชนเอโดมที่เหลืออยู่ และครอบครองประชาชาติทั้งปวงที่ถูกเรียกตามนามของเรา องค์พระผู้เป็นเจ้าผู้ทรงกระทำสิ่งนี้ตรัสดังนี้"},{"verse":13,"text":"องค์พระผู้เป็นเจ้าตรัสว่า ดูเถิด วันเวลาจะมาถึง เมื่อคนที่ไถนาจะตามทันคนที่เกี่ยวข้าว และคนที่ย่ำองุ่นจะตามทันคนที่หว่านเมล็ด ภูเขาทั้งหลายจะมีเหล้าองุ่นใหม่หยดย้อย และเนินเขาทั้งสิ้นจะมีเหล้าองุ่นไหลลงมา"},{"verse":14,"text":"เราจะให้อิสราเอลประชากรของเรากลับสู่สภาพดี พวกเขาจะสร้างเมืองที่ปรักหักพังขึ้นใหม่และเข้าอาศัยอยู่ พวกเขาจะปลูกสวนองุ่นและดื่มเหล้าองุ่นจากสวนนั้น จะทำสวนผลไม้และกินผลของมัน"},{"verse":15,"text":"เราจะปลูกพวกเขาไว้บนแผ่นดินของพวกเขา และพวกเขาจะไม่ถูกถอนรากออกจากแผ่นดินที่เราได้มอบให้แก่พวกเขาอีกต่อไป องค์พระผู้เป็นเจ้าพระเจ้าของเจ้าตรัสดังนี้"}]}]},{"osis":"Obad","usfm":"OBA","name_en":"Obadiah","name_th":"โอบาดีห์","chapters":[{"chapter":1,"verses":[{"verse":1,"text":"นิมิตของโอบาดีห์ องค์พระผู้เป็นเจ้าตรัสเกี่ยวกับเอโดมดังนี้ว่า เราได้ยินข่าวจากองค์พระผู้เป็นเจ้า และมีทูตถูกส่งไปท่ามกลางประชาชาติว่า ‘จงลุกขึ้น ให้เราลุกขึ้นทำสงครามกับมันเถิด’"},{"verse":2,"text":"ดูเถิด เราจะทำให้เจ้าเป็นชาติเล็กน้อยท่ามกลางประชาชาติ เจ้าจะถูกดูหมิ่นอย่างยิ่ง"},{"verse":3,"text":"ความเย่อหยิ่งในใจของเจ้าได้หลอกลวงเจ้า เจ้าผู้อาศัยอยู่ในซอกหินผา ในที่พำนักอันสูงเด่น เจ้ารำพึงในใจว่า ‘ใครจะดึงเราลงมาถึงพื้นดินได้’"},{"verse":4,"text":"แม้เจ้าจะเหินสูงเหมือนนกอินทรี และแม้เจ้าจะสร้างรังไว้ท่ามกลางหมู่ดาว เราก็จะดึงเจ้าลงมาจากที่นั่น องค์พระผู้เป็นเจ้าตรัสดังนี้"},{"verse":5,"text":"หากพวกขโมยมาหาเจ้า หากพวกปล้นมาในยามค่ำคืน เจ้าจะถูกทำลายเสียจริง พวกเขาจะไม่ขโมยเพียงเท่าที่ต้องการหรือ หากคนเก็บองุ่นมาหาเจ้า พวกเขาจะไม่เหลือองุ่นไว้ให้เก็บตกบ้างหรือ"},{"verse":6,"text":"เอซาวถูกค้นรื้อเสียจริง ทรัพย์สมบัติที่ซ่อนไว้ของเขาก็ถูกค้นพบหมด"},{"verse":7,"text":"พันธมิตรทั้งสิ้นของเจ้าได้ขับไล่เจ้าไปถึงชายแดน มิตรสหายของเจ้าได้หลอกลวงและเอาชนะเจ้า ผู้ที่กินอาหารร่วมกับเจ้าได้วางกับดักไว้ใต้เจ้า โดยที่เจ้าไม่รู้ตัวเลย"},{"verse":8,"text":"องค์พระผู้เป็นเจ้าตรัสว่า ในวันนั้น เราจะทำลายคนมีปัญญาให้สิ้นไปจากเอโดม และทำลายความเข้าใจให้สิ้นไปจากภูเขาเอซาวมิใช่หรือ"},{"verse":9,"text":"เทมานเอ๋ย นักรบของเจ้าจะตกใจขวัญเสีย เพื่อว่าทุกคนจะถูกตัดขาดจากภูเขาเอซาวด้วยการเข่นฆ่า"},{"verse":10,"text":"เพราะความรุนแรงที่เจ้ากระทำต่อยาโคบน้องชายของเจ้า ความอับอายจะปกคลุมเจ้า และเจ้าจะถูกตัดขาดเป็นนิตย์"},{"verse":11,"text":"ในวันที่เจ้ายืนเฉยอยู่ห่าง ๆ ในวันที่คนต่างชาติกวาดเอาทรัพย์สมบัติของเขาไป และคนต่างด้าวเข้าประตูเมืองของเขา และจับสลากแบ่งเยรูซาเล็มกัน เจ้าเองก็เป็นเหมือนคนหนึ่งในพวกเขา"},{"verse":12,"text":"แต่เจ้าไม่ควรมองดูน้องชายของเจ้าอย่างสะใจในวันแห่งเคราะห์กรรมของเขา ไม่ควรเปรมปรีดิ์เหนือชาวยูดาห์ในวันที่พวกเขาพินาศ และไม่ควรโอ้อวดในวันแห่งความทุกข์ใจ"},{"verse":13,"text":"เจ้าไม่ควรเข้าประตูเมืองแห่งประชากรของเราในวันแห่งภัยพิบัติของพวกเขา เจ้าไม่ควรมองดูความทุกข์ยากของพวกเขาอย่างสะใจในวันแห่งภัยพิบัติ และไม่ควรยื่นมือเข้าริบทรัพย์สมบัติของพวกเขาในวันแห่งภัยพิบัตินั้น"},{"verse":14,"text":"เจ้าไม่ควรยืนอยู่ที่ทางแยกเพื่อสังหารผู้ที่หนีรอดของเขา และไม่ควรมอบผู้รอดชีวิตของเขาไว้แก่ศัตรูในวันแห่งความทุกข์ใจ"},{"verse":15,"text":"เพราะวันแห่งองค์พระผู้เป็นเจ้าใกล้เข้ามาแล้วเหนือประชาชาติทั้งปวง เจ้าได้กระทำสิ่งใด สิ่งนั้นก็จะถูกกระทำต่อเจ้า การกระทำของเจ้าจะตอบสนองกลับมาบนศีรษะของเจ้าเอง"},{"verse":16,"text":"เพราะพวกเจ้าได้ดื่มบนภูเขาบริสุทธิ์ของเราอย่างไร ประชาชาติทั้งปวงก็จะดื่มอยู่เรื่อยไปอย่างนั้น พวกเขาจะดื่มและกลืนลงไป และจะเป็นเหมือนไม่เคยมีตัวตนมาก่อนเลย"},{"verse":17,"text":"แต่บนภูเขาศิโยนจะมีผู้ที่หนีรอด และภูเขานั้นจะบริสุทธิ์ และพงศ์พันธุ์ของยาโคบจะได้ครอบครองมรดกของตน"},{"verse":18,"text":"พงศ์พันธุ์ของยาโคบจะเป็นไฟ พงศ์พันธุ์ของโยเซฟจะเป็นเปลวเพลิง และพงศ์พันธุ์ของเอซาวจะเป็นฟาง พวกเขาจะลุกไหม้และเผาผลาญเอซาวเสีย จะไม่มีใครเหลือรอดในพงศ์พันธุ์ของเอซาวเลย เพราะองค์พระผู้เป็นเจ้าได้ตรัสไว้แล้ว"},{"verse":19,"text":"ชาวเนเกบจะได้ครอบครองภูเขาเอซาว และชาวที่ราบเชเฟลาห์จะได้ครอบครองแผ่นดินของชาวฟีลิสเตีย พวกเขาจะได้ครอบครองแผ่นดินของเอฟราอิมและสะมาเรีย และเบนยามินจะได้ครอบครองกิเลอาด"},{"verse":20,"text":"ฝูงเชลยของชนอิสราเอลนี้จะได้ครอบครองแผ่นดินของชาวคานาอันไกลไปจนถึงเมืองศาเรฟัท และเชลยของเยรูซาเล็มที่อยู่ในเสฟาราดจะได้ครอบครองเมืองต่าง ๆ ในเนเกบ"},{"verse":21,"text":"บรรดาผู้ช่วยให้รอดจะขึ้นไปยังภูเขาศิโยน เพื่อปกครองภูเขาเอซาว และราชอาณาจักรนั้นจะเป็นขององค์พระผู้เป็นเจ้า"}]}]},{"osis":"Jonah","usfm":"JON","name_en":"Jonah","name_th":"โยนาห์","chapters":[{"chapter":1,"verses":[{"verse":1,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงโยนาห์บุตรอามิทัยว่า"},{"verse":2,"text":"“จงลุกขึ้น ไปยังนีนะเวห์นครใหญ่ และร้องประกาศกล่าวโทษเมืองนั้น เพราะความชั่วของพวกเขาได้ขึ้นมาต่อหน้าเรา”"},{"verse":3,"text":"แต่โยนาห์ลุกขึ้นเพื่อหนีไปยังเมืองทารชิช ให้พ้นจากเบื้องพระพักตร์ขององค์พระผู้เป็นเจ้า ท่านลงไปที่เมืองยัฟโฟและพบเรือลำหนึ่งกำลังจะไปยังเมืองทารชิช ท่านจึงเสียค่าโดยสารและลงเรือไปกับลูกเรือ มุ่งหน้าสู่เมืองทารชิช ให้พ้นจากเบื้องพระพักตร์ขององค์พระผู้เป็นเจ้า"},{"verse":4,"text":"แต่องค์พระผู้เป็นเจ้าทรงบันดาลให้ลมพายุใหญ่พัดมายังทะเล เกิดพายุร้ายแรงในทะเล จนเรือเกือบจะแตก"},{"verse":5,"text":"พวกลูกเรือก็กลัวและร้องเรียกแต่ละคนต่อพระของตน เขาทั้งหลายโยนสินค้าในเรือลงทะเลเพื่อให้เรือเบาขึ้น แต่โยนาห์ได้ลงไปในส่วนล่างสุดของเรือ นอนหลับสนิท"},{"verse":6,"text":"นายเรือเข้ามาหาท่านและกล่าวว่า “ท่านนอนหลับอยู่ได้อย่างไร จงลุกขึ้น ร้องเรียกพระของท่านเถิด บางทีเทพเจ้านั้นจะคำนึงถึงเราและเราจะไม่พินาศ”"},{"verse":7,"text":"พวกเขาจึงพูดต่อกันว่า “มาเถิด ให้พวกเราจับสลากเพื่อจะได้รู้ว่าเหตุร้ายนี้เกิดขึ้นกับเราเพราะใคร” พวกเขาจึงจับสลาก และสลากตกที่โยนาห์"},{"verse":8,"text":"พวกเขาจึงถามท่านว่า “จงบอกพวกเราเถิดว่า เหตุร้ายนี้เกิดขึ้นกับเราเพราะใคร อาชีพของท่านคืออะไร ท่านมาจากที่ไหน บ้านเมืองของท่านอยู่ที่ใด และท่านมาจากชนชาติใด”"},{"verse":9,"text":"ท่านตอบพวกเขาว่า “ข้าพเจ้าเป็นคนฮีบรู ข้าพเจ้านับถือองค์พระผู้เป็นเจ้า พระเจ้าแห่งฟ้าสวรรค์ ผู้ทรงสร้างทะเลและแผ่นดินแห้ง”"},{"verse":10,"text":"พวกลูกเรือกลัวอย่างยิ่ง และกล่าวกับท่านว่า “ทำไมท่านทำเช่นนี้” พวกเขารู้แล้วว่าท่านกำลังหนีจากเบื้องพระพักตร์ขององค์พระผู้เป็นเจ้า เพราะท่านได้บอกพวกเขาเอง"},{"verse":11,"text":"พวกเขาจึงถามท่านว่า “เราจะทำอย่างไรกับท่าน เพื่อทะเลจะสงบลงให้พวกเรา” เพราะทะเลกำลังคลั่งหนักขึ้นเรื่อยๆ"},{"verse":12,"text":"ท่านตอบเขาว่า “จงจับข้าพเจ้าโยนลงในทะเล แล้วทะเลจะสงบลงให้พวกท่าน เพราะข้าพเจ้ารู้ว่า พายุใหญ่นี้ที่เกิดขึ้นกับพวกท่านเป็นเพราะข้าพเจ้า”"},{"verse":13,"text":"ถึงกระนั้นพวกลูกเรือก็พายเรืออย่างสุดกำลังเพื่อจะกลับสู่ฝั่ง แต่พวกเขาทำไม่ได้ เพราะทะเลกำลังคลั่งหนักขึ้นเรื่อยๆ ต่อพวกเขา"},{"verse":14,"text":"ดังนั้น พวกเขาจึงร้องเรียกองค์พระผู้เป็นเจ้าและกล่าวว่า “ข้าแต่องค์พระผู้เป็นเจ้า ขออย่าให้พวกข้าพระองค์ต้องพินาศเพราะชีวิตของชายผู้นี้เลย และขออย่าทรงให้โทษโลหิตอันไร้ผิดตกอยู่กับพวกข้าพระองค์ เพราะพระองค์ทรงเป็นองค์พระผู้เป็นเจ้า ทรงกระทำตามที่ทรงพอพระทัย”"},{"verse":15,"text":"แล้วพวกเขาก็จับโยนาห์ขึ้นและโยนท่านลงในทะเล และทะเลก็หยุดคลั่ง"},{"verse":16,"text":"แล้วลูกเรือเหล่านั้นก็เกรงกลัวองค์พระผู้เป็นเจ้าอย่างยิ่ง พวกเขาจึงถวายเครื่องบูชาแด่องค์พระผู้เป็นเจ้า และทำการบนต่อพระองค์"},{"verse":17,"text":"องค์พระผู้เป็นเจ้าทรงจัดเตรียมปลาใหญ่ตัวหนึ่งให้กลืนโยนาห์ และโยนาห์อยู่ในท้องปลานั้นสามวันสามคืน"}]},{"chapter":2,"verses":[{"verse":1,"text":"โยนาห์อธิษฐานต่อองค์พระผู้เป็นเจ้า พระเจ้าของท่าน จากท้องของปลานั้น"},{"verse":2,"text":"ท่านกล่าวว่า “ในยามทุกข์ของข้าพระองค์ ข้าพระองค์ร้องเรียกองค์พระผู้เป็นเจ้า และพระองค์ทรงตอบข้าพระองค์ จากท้องของแดนคนตาย ข้าพระองค์ร้องขอความช่วยเหลือ พระองค์ทรงสดับฟังเสียงของข้าพระองค์"},{"verse":3,"text":"พระองค์ทรงเหวี่ยงข้าพระองค์ลงสู่ที่ลึก ท่ามกลางใจกลางทะเล กระแสน้ำล้อมรอบข้าพระองค์ คลื่นและระลอกทั้งหมดของพระองค์ซัดผ่านเหนือข้าพระองค์"},{"verse":4,"text":"ข้าพระองค์กล่าวแล้วว่า ‘ข้าพระองค์ถูกขับออกไปจากเบื้องหน้าพระเนตรของพระองค์ แต่ข้าพระองค์ก็ยังจะมองดูพระวิหารบริสุทธิ์ของพระองค์อีก’"},{"verse":5,"text":"น้ำท่วมล้อมข้าพระองค์ถึงคอ ที่ลึกล้อมรอบข้าพระองค์ สาหร่ายพันรอบศีรษะของข้าพระองค์"},{"verse":6,"text":"ข้าพระองค์ลงไปยังรากของภูเขาทั้งหลาย แผ่นดินกั้นข้าพระองค์ไว้ด้วยดาลของมันเป็นนิตย์ แต่พระองค์ทรงนำชีวิตของข้าพระองค์ขึ้นมาจากหลุม ข้าแต่องค์พระผู้เป็นเจ้า พระเจ้าของข้าพระองค์"},{"verse":7,"text":"เมื่อจิตวิญญาณของข้าพระองค์อ่อนระโหยภายในข้าพระองค์ ข้าพระองค์ระลึกถึงองค์พระผู้เป็นเจ้า และคำอธิษฐานของข้าพระองค์ได้ขึ้นไปถึงพระองค์ ถึงพระวิหารบริสุทธิ์ของพระองค์"},{"verse":8,"text":"บรรดาผู้ที่ยึดถือรูปเคารพอันไร้ค่า ก็ทอดทิ้งความรักมั่นคงที่พวกเขาควรได้รับ"},{"verse":9,"text":"แต่ข้าพระองค์ ด้วยเสียงโมทนาขอบพระคุณ ข้าพระองค์จะถวายเครื่องบูชาแด่พระองค์ สิ่งที่ข้าพระองค์ได้บนบานไว้ ข้าพระองค์จะกระทำให้ครบถ้วน การช่วยกู้เป็นขององค์พระผู้เป็นเจ้า”"},{"verse":10,"text":"แล้วองค์พระผู้เป็นเจ้าตรัสกับปลานั้น และมันก็คายโยนาห์ออกที่แผ่นดินแห้ง"}]},{"chapter":3,"verses":[{"verse":1,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงโยนาห์เป็นครั้งที่สองว่า"},{"verse":2,"text":"“จงลุกขึ้น ไปยังนีนะเวห์นครใหญ่ และประกาศคำประกาศที่เราจะบอกเจ้าแก่เมืองนั้น”"},{"verse":3,"text":"ครั้งนี้โยนาห์ลุกขึ้นและไปยังนีนะเวห์ ตามพระวจนะขององค์พระผู้เป็นเจ้า ฝ่ายนีนะเวห์เป็นนครใหญ่ยิ่ง ใหญ่จนต้องเดินสามวันจึงจะข้ามได้"},{"verse":4,"text":"โยนาห์เริ่มเข้าไปในนคร เดินไปได้ระยะทางหนึ่งวัน แล้วท่านก็ประกาศว่า “อีกสี่สิบวัน นีนะเวห์จะถูกพลิกล้ม”"},{"verse":5,"text":"ฝ่ายชาวนีนะเวห์ก็เชื่อพระเจ้า พวกเขาประกาศการอดอาหารและสวมผ้ากระสอบ ตั้งแต่ผู้ใหญ่จนถึงผู้น้อย"},{"verse":6,"text":"เมื่อข่าวมาถึงกษัตริย์แห่งนีนะเวห์ พระองค์ก็ทรงลุกขึ้นจากพระบัลลังก์ ทรงถอดเสื้อคลุมพระราชาออก แล้วทรงคลุมพระวรกายด้วยผ้ากระสอบ และทรงประทับนั่งบนกองขี้เถ้า"},{"verse":7,"text":"พระองค์ทรงให้ประกาศไปทั่วนีนะเวห์ว่า “โดยพระราชโองการของกษัตริย์และเหล่าขุนนางของพระองค์ ห้ามมนุษย์หรือสัตว์ ฝูงโคหรือฝูงแพะแกะ ลิ้มรสสิ่งใด อย่ากินอาหารหรือดื่มน้ำ"},{"verse":8,"text":"ให้มนุษย์และสัตว์คลุมตนด้วยผ้ากระสอบ และให้ผู้คนร้องเรียกต่อพระเจ้าด้วยความเร่งร้อน ให้ทุกคนหันกลับจากทางอันชั่วร้ายของตน และจากความทารุณที่อยู่ในมือของเขา"},{"verse":9,"text":"ใครเล่าจะรู้ได้ พระเจ้าอาจจะทรงหันและเปลี่ยนพระทัย ทรงหันจากพระพิโรธอันรุนแรงของพระองค์ และพวกเราจะไม่พินาศ”"},{"verse":10,"text":"เมื่อพระเจ้าทรงทอดพระเนตรเห็นการกระทำของพวกเขา ว่าพวกเขาหันกลับจากทางอันชั่วร้ายของตน พระเจ้าจึงทรงเปลี่ยนพระทัยเรื่องเหตุร้ายซึ่งพระองค์ได้ตรัสว่าจะทรงทำต่อพวกเขา และพระองค์มิได้ทรงทำเช่นนั้น"}]},{"chapter":4,"verses":[{"verse":1,"text":"แต่เรื่องนี้เป็นเหตุร้ายอย่างยิ่งสำหรับโยนาห์ ท่านจึงโกรธจัด"},{"verse":2,"text":"ท่านจึงอธิษฐานต่อองค์พระผู้เป็นเจ้าว่า “ข้าแต่องค์พระผู้เป็นเจ้า เรื่องนี้มิใช่หรือคือสิ่งที่ข้าพระองค์กล่าวเมื่อยังอยู่ในแผ่นดินบ้านเกิดของข้าพระองค์ เพราะเหตุนี้ข้าพระองค์จึงรีบหนีไปยังเมืองทารชิช เพราะข้าพระองค์ทราบว่าพระองค์ทรงเป็นพระเจ้าผู้ทรงพระคุณและทรงพระเมตตา ทรงกริ้วช้า ทรงบริบูรณ์ด้วยความรักมั่นคง และทรงเปลี่ยนพระทัยจากการลงโทษ"},{"verse":3,"text":"“บัดนี้ ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงโปรดเอาชีวิตของข้าพระองค์ไปจากข้าพระองค์เถิด เพราะการตายดีกว่าการอยู่”"},{"verse":4,"text":"องค์พระผู้เป็นเจ้าตรัสว่า “เจ้าโกรธจัดเช่นนี้ถูกต้องหรือ”"},{"verse":5,"text":"โยนาห์ออกจากนคร ไปนั่งทางทิศตะวันออกของเมือง ท่านสร้างเพิงให้ตนที่นั่น และนั่งใต้ร่มของเพิง รอดูว่าอะไรจะเกิดขึ้นแก่นครนั้น"},{"verse":6,"text":"องค์พระผู้เป็นเจ้าพระเจ้าทรงจัดเตรียมต้นน้ำเต้า ต้นนั้นงอกขึ้นเหนือโยนาห์เพื่อเป็นร่มเหนือศีรษะของท่าน เพื่อช่วยท่านให้พ้นจากความเดือดร้อน โยนาห์ดีใจอย่างยิ่งเพราะต้นน้ำเต้านั้น"},{"verse":7,"text":"พระเจ้าทรงจัดเตรียมหนอนตัวหนึ่ง เมื่ออรุณรุ่งของวันถัดไป มันก็กัดต้นน้ำเต้าจนต้นนั้นเหี่ยวแห้ง"},{"verse":8,"text":"เมื่อดวงอาทิตย์ขึ้น พระเจ้าทรงจัดเตรียมลมตะวันออกอันร้อนแรง ดวงอาทิตย์ก็แผดเผาศีรษะของโยนาห์ ท่านอ่อนเปลี้ยลง ขอให้ตนตาย กล่าวว่า “การตายดีกว่าการอยู่”"},{"verse":9,"text":"พระเจ้าตรัสกับโยนาห์ว่า “เจ้าโกรธจัดเรื่องต้นน้ำเต้านั้นถูกต้องหรือ” โยนาห์ทูลตอบว่า “ข้าพระองค์โกรธจัดถูกต้องอย่างยิ่ง — โกรธพอที่จะตาย”"},{"verse":10,"text":"องค์พระผู้เป็นเจ้าตรัสว่า “เจ้าห่วงใยต้นน้ำเต้า ซึ่งเจ้ามิได้ลงแรงเลย เจ้ามิได้ปลูกให้เติบโต ในชั่วคืนเดียวมันงอกขึ้น และในชั่วคืนเดียวมันก็เหี่ยวแห้งไป"},{"verse":11,"text":"และเราจะไม่ห่วงใยนีนะเวห์ นครใหญ่ ซึ่งมีคนมากกว่าหนึ่งแสนสองหมื่นคน ผู้ไม่รู้จักแยกแยะมือขวาจากมือซ้ายของตน และมีฝูงสัตว์เป็นจำนวนมากด้วยหรือ”"}]}]},{"osis":"Mic","usfm":"MIC","name_en":"Micah","name_th":"มีคาห์","chapters":[{"chapter":1,"verses":[{"verse":1,"text":"พระวจนะขององค์พระผู้เป็นเจ้าที่มาถึงมีคาห์ชาวเมืองโมเรเชท ในรัชสมัยของโยธาม อาหัส และเฮเซคียาห์ กษัตริย์แห่งยูดาห์ คือนิมิตที่ท่านได้รับเกี่ยวกับสะมาเรียและเยรูซาเล็ม"},{"verse":2,"text":"ชนชาติทั้งหลายเอ๋ย จงฟังเถิด แผ่นดินโลกและสรรพสิ่งในนั้นเอ๋ย จงเงี่ยหูฟัง ขอองค์พระผู้เป็นเจ้าทรงเป็นพยานปรักปรำพวกท่าน คือองค์เจ้านายจากพระวิหารบริสุทธิ์ของพระองค์"},{"verse":3,"text":"เพราะดูเถิด องค์พระผู้เป็นเจ้ากำลังเสด็จออกมาจากที่ประทับของพระองค์ พระองค์จะเสด็จลงมาและทรงเหยียบย่างไปบนที่สูงทั้งหลายของแผ่นดินโลก"},{"verse":4,"text":"ภูเขาทั้งหลายจะละลายไปใต้พระองค์ และหุบเขาทั้งหลายจะแยกออก เหมือนขี้ผึ้งหน้าไฟ เหมือนน้ำที่ไหลพรูลงมาตามที่ลาดชัน"},{"verse":5,"text":"ทั้งหมดนี้เป็นเพราะการล่วงละเมิดของยาโคบ และเพราะบาปทั้งหลายของพงศ์พันธุ์อิสราเอล อะไรคือการล่วงละเมิดของยาโคบ ไม่ใช่สะมาเรียหรือ และอะไรคือสถานบูชาบนที่สูงของยูดาห์ ไม่ใช่เยรูซาเล็มหรือ"},{"verse":6,"text":"เราจะทำให้สะมาเรียกลายเป็นกองปรักหักพังกลางทุ่ง เป็นที่สำหรับปลูกสวนองุ่น เราจะเทหินของเมืองนั้นลงในหุบเขา และจะเปิดรากฐานของเมืองนั้นให้เปลือยเปล่า"},{"verse":7,"text":"รูปสลักทั้งสิ้นของเมืองนั้นจะถูกทุบให้แตกเป็นชิ้น ๆ และค่าจ้างทั้งหมดของนางจะถูกเผาด้วยไฟ เราจะทำให้รูปเคารพทั้งสิ้นของนางพินาศ เพราะนางได้รวบรวมสิ่งเหล่านั้นมาจากค่าจ้างของหญิงโสเภณี และมันจะกลับไปเป็นค่าจ้างของหญิงโสเภณีอีก"},{"verse":8,"text":"เพราะเหตุนี้ ข้าพเจ้าจะร่ำไห้คร่ำครวญ ข้าพเจ้าจะเดินไปอย่างถูกปล้นและเปลือยเปล่า ข้าพเจ้าจะร้องโหยหวนเหมือนหมาใน และคร่ำครวญเหมือนนกกระจอกเทศ"},{"verse":9,"text":"เพราะบาดแผลของสะมาเรียนั้นรักษาไม่หาย และมันได้ลามมาถึงยูดาห์ มาจ่อถึงประตูเมืองแห่งประชากรของเรา คือถึงเยรูซาเล็ม"},{"verse":10,"text":"อย่าบอกเรื่องนี้ในเมืองกัท อย่าร้องไห้เลย ที่เมืองเบธเลอัฟราห์ จงกลิ้งเกลือกตัวอยู่ในฝุ่นธุลี"},{"verse":11,"text":"ชาวเมืองชาฟีร์เอ๋ย จงผ่านไปอย่างเปลือยเปล่าและอับอาย ชาวเมืองศาอานันไม่กล้าออกมา เมืองเบธเอเซลร่ำไห้คร่ำครวญ และจะถอนที่กำบังไปจากเจ้า"},{"verse":12,"text":"เพราะชาวเมืองมาโรทเฝ้ารอคอยสิ่งดี แต่ภัยพิบัติได้ลงมาจากองค์พระผู้เป็นเจ้าถึงประตูเมืองเยรูซาเล็ม"},{"verse":13,"text":"ชาวเมืองลาคีชเอ๋ย จงเทียมม้าศึกเข้ากับรถรบ เมืองนี้เป็นจุดเริ่มต้นของบาปสำหรับธิดาแห่งศิโยน เพราะพบการล่วงละเมิดของอิสราเอลในเจ้า"},{"verse":14,"text":"เพราะฉะนั้น เจ้าจะต้องมอบของขวัญอำลาแก่เมืองโมเรเชทกัท บ้านเรือนของเมืองอัคซิบจะเป็นสิ่งหลอกลวงแก่บรรดากษัตริย์แห่งอิสราเอล"},{"verse":15,"text":"ชาวเมืองมาเรชาห์เอ๋ย เราจะนำผู้พิชิตมาเหนือเจ้าอีก ผู้มีศักดิ์ศรีแห่งอิสราเอลจะต้องหนีไปถึงเมืองอดุลลัม"},{"verse":16,"text":"จงโกนผมและตัดผมของเจ้าให้สั้น เพื่อไว้ทุกข์ให้ลูก ๆ ที่เจ้ารักยิ่ง จงทำให้หัวของเจ้าล้านเหมือนนกอินทรี เพราะลูก ๆ ของเจ้าจะถูกกวาดต้อนจากเจ้าไปเป็นเชลย"}]},{"chapter":2,"verses":[{"verse":1,"text":"วิบัติแก่ผู้ที่คิดวางแผนชั่วร้าย และก่อการชั่วบนที่นอนของตน พอรุ่งสางพวกเขาก็ลงมือทำทันที เพราะมันอยู่ในอำนาจมือของพวกเขา"},{"verse":2,"text":"พวกเขาโลภอยากได้ที่นาแล้วยึดเอาไป อยากได้บ้านเรือนก็ริบเอาไป พวกเขากดขี่เจ้าของบ้านและบ้านของเขา กดขี่คนหนึ่งและมรดกของเขา"},{"verse":3,"text":"เพราะฉะนั้น องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ดูเถิด เรากำลังคิดวางแผนนำภัยพิบัติมาเหนือตระกูลนี้ ซึ่งพวกเจ้าจะปลดคอออกไม่ได้ และพวกเจ้าจะเดินอย่างผยองไม่ได้ เพราะเป็นยุคแห่งความชั่วร้าย"},{"verse":4,"text":"ในวันนั้น จะมีผู้ยกถ้อยคำเยาะเย้ยขึ้นกล่าวโทษพวกเจ้า และร้องคร่ำครวญอย่างขมขื่นว่า ‘เราถูกทำลายย่อยยับเสียแล้ว พระองค์ทรงเปลี่ยนส่วนแบ่งของประชากรของข้า พระองค์ทรงริบมันไปจากข้าได้อย่างไร และทรงแบ่งที่นาของเราให้แก่ผู้ทรยศ’"},{"verse":5,"text":"เพราะฉะนั้น พวกเจ้าจะไม่มีใครเหลือที่จะจับสลากปันที่ดินด้วยเชือกวัดในที่ประชุมขององค์พระผู้เป็นเจ้าเลย"},{"verse":6,"text":"พวกเขากล่าวว่า ‘อย่าเทศนาเลย’ คนเหล่านี้เทศนาว่า ‘อย่าเทศนาเรื่องเหล่านี้ ความอัปยศจะไม่ตกถึงเราหรอก’"},{"verse":7,"text":"พงศ์พันธุ์ยาโคบเอ๋ย ควรกล่าวเช่นนี้หรือ พระวิญญาณขององค์พระผู้เป็นเจ้าทรงสิ้นความอดทนแล้วหรือ สิ่งเหล่านี้เป็นการกระทำของพระองค์หรือ ถ้อยคำของเราไม่เป็นผลดีต่อผู้ที่ดำเนินชีวิตอย่างเที่ยงตรงหรือ"},{"verse":8,"text":"แต่เมื่อไม่นานมานี้ ประชากรของเราได้ลุกขึ้นเป็นศัตรู พวกเจ้ากระชากเสื้อคลุมราคาแพงจากคนที่เดินผ่านไปอย่างไว้วางใจ คือจากคนที่ไม่คิดจะทำสงคราม"},{"verse":9,"text":"พวกเจ้าขับไล่หญิงทั้งหลายในหมู่ประชากรของเราออกจากบ้านอันแสนสุขของนาง และเจ้าได้ริบศักดิ์ศรีของเราไปจากลูก ๆ ของนางเป็นนิตย์"},{"verse":10,"text":"จงลุกขึ้นและไปเสีย เพราะนี่ไม่ใช่ที่พักสงบของพวกเจ้า เพราะความเป็นมลทินที่นำมาซึ่งความพินาศ คือความพินาศอันร้ายแรง"},{"verse":11,"text":"หากมีใครคนหนึ่งที่ดำเนินตามลมและความเท็จมากล่าวคำมุสาว่า ‘ข้าจะเทศนาแก่เจ้าเรื่องเหล้าองุ่นและสุรา’ เขาผู้นั้นแหละจะได้เป็นนักเทศน์สำหรับชนชาตินี้"},{"verse":12,"text":"ยาโคบเอ๋ย เราจะรวบรวมพวกเจ้าทั้งสิ้นอย่างแน่นอน เราจะรวบรวมอิสราเอลที่เหลืออยู่มาไว้ด้วยกันอย่างแน่นอน เราจะให้พวกเขาอยู่รวมกันเหมือนฝูงแกะในคอก เหมือนฝูงสัตว์ที่อยู่กลางทุ่งหญ้า จะมีเสียงอึกทึกด้วยผู้คนมากมาย"},{"verse":13,"text":"ผู้เปิดทางจะขึ้นไปข้างหน้าพวกเขา พวกเขาจะทลายออกไป ผ่านประตูเมืองและออกไปทางนั้น กษัตริย์ของพวกเขาจะนำหน้าพวกเขาไป และองค์พระผู้เป็นเจ้าจะทรงเป็นผู้นำอยู่ข้างหน้าพวกเขา"}]},{"chapter":3,"verses":[{"verse":1,"text":"ข้าพเจ้ากล่าวว่า บรรดาผู้นำของยาโคบ และบรรดาเจ้านายแห่งพงศ์พันธุ์อิสราเอลเอ๋ย จงฟังเถิด ไม่ใช่หน้าที่ของพวกท่านหรือที่จะรู้จักความยุติธรรม"},{"verse":2,"text":"พวกท่านผู้เกลียดความดีและรักความชั่ว ผู้ถลกหนังของประชากรของเราออกจากตัวพวกเขา และฉีกเนื้อออกจากกระดูกของพวกเขา"},{"verse":3,"text":"พวกเขากินเนื้อประชากรของเรา ถลกหนังของพวกเขาออก หักกระดูกของพวกเขา และสับให้เป็นชิ้น ๆ เหมือนเนื้อในหม้อ เหมือนเนื้อในกระทะ"},{"verse":4,"text":"แล้วพวกเขาจะร้องทูลต่อองค์พระผู้เป็นเจ้า แต่พระองค์จะไม่ทรงตอบพวกเขา ในเวลานั้นพระองค์จะทรงซ่อนหน้าของพระองค์จากพวกเขา เพราะการกระทำอันชั่วร้ายของพวกเขา"},{"verse":5,"text":"องค์พระผู้เป็นเจ้าตรัสดังนี้เกี่ยวกับบรรดาผู้เผยพระวจนะที่นำประชากรของเราให้หลงผิด ผู้ซึ่งร้องประกาศว่า ‘สันติสุข’ เมื่อมีอะไรให้พวกเขาเคี้ยวกิน แต่ประกาศทำสงครามกับผู้ที่ไม่ใส่อะไรในปากของพวกเขา"},{"verse":6,"text":"เพราะฉะนั้น มันจะกลายเป็นกลางคืนแก่พวกเจ้า ปราศจากนิมิต และเป็นความมืดแก่พวกเจ้า ปราศจากการทำนาย ดวงอาทิตย์จะตกเหนือบรรดาผู้เผยพระวจนะ และกลางวันจะมืดมิดเหนือพวกเขา"},{"verse":7,"text":"ผู้ทำนายเหตุการณ์จะอับอาย และพวกหมอดูจะขายหน้า พวกเขาทุกคนจะปิดริมฝีปากของตน เพราะไม่มีคำตอบจากพระเจ้า"},{"verse":8,"text":"แต่ส่วนข้าพเจ้านั้น ข้าพเจ้าเปี่ยมด้วยฤทธิ์อำนาจ ด้วยพระวิญญาณขององค์พระผู้เป็นเจ้า ด้วยความยุติธรรมและกำลัง เพื่อจะประกาศแก่ยาโคบถึงการล่วงละเมิดของเขา และประกาศแก่อิสราเอลถึงบาปของเขา"},{"verse":9,"text":"บรรดาผู้นำของพงศ์พันธุ์ยาโคบ และบรรดาเจ้านายแห่งพงศ์พันธุ์อิสราเอลเอ๋ย จงฟังสิ่งนี้เถิด คือพวกท่านผู้รังเกียจความยุติธรรม และบิดเบือนความเที่ยงตรงทั้งสิ้น"},{"verse":10,"text":"พวกท่านสร้างศิโยนด้วยการนองเลือด และสร้างเยรูซาเล็มด้วยความอยุติธรรม"},{"verse":11,"text":"บรรดาผู้นำของเมืองนี้ตัดสินคดีเพื่อเห็นแก่สินบน บรรดาปุโรหิตของเมืองสั่งสอนเพื่อเห็นแก่ค่าจ้าง และบรรดาผู้เผยพระวจนะของเมืองทำนายเพื่อเห็นแก่เงิน ถึงกระนั้นพวกเขายังพึ่งพิงองค์พระผู้เป็นเจ้า และกล่าวว่า ‘องค์พระผู้เป็นเจ้าทรงสถิตอยู่ท่ามกลางเรามิใช่หรือ ภัยพิบัติจะไม่มาถึงเราหรอก’"},{"verse":12,"text":"เพราะฉะนั้น เพราะพวกท่าน ศิโยนจะถูกไถเหมือนทุ่งนา เยรูซาเล็มจะกลายเป็นกองซากปรักหักพัง และภูเขาที่ตั้งของพระนิเวศจะกลายเป็นป่าทึบบนเนินสูง"}]},{"chapter":4,"verses":[{"verse":1,"text":"ในยุคสุดท้าย ภูเขาแห่งพระนิเวศขององค์พระผู้เป็นเจ้าจะได้รับการสถาปนาให้เป็นภูเขาที่สูงเด่นที่สุด จะถูกยกขึ้นเหนือบรรดาเนินเขา และชนชาติทั้งหลายจะหลั่งไหลไปยังภูเขานั้น"},{"verse":2,"text":"ประชาชาติเป็นอันมากจะมาและกล่าวว่า ‘มาเถิด ให้เราขึ้นไปยังภูเขาขององค์พระผู้เป็นเจ้า ไปยังพระนิเวศของพระเจ้าแห่งยาโคบ พระองค์จะทรงสอนวิถีทางของพระองค์แก่เรา และเราจะดำเนินในมรรคาของพระองค์’ เพราะพระบัญญัติจะออกมาจากศิโยน และพระวจนะขององค์พระผู้เป็นเจ้าจะออกมาจากเยรูซาเล็ม"},{"verse":3,"text":"พระองค์จะทรงพิพากษาระหว่างชนชาติเป็นอันมาก และจะทรงตัดสินความให้แก่ประชาชาติที่เข้มแข็งซึ่งอยู่ห่างไกล พวกเขาจะตีดาบของตนเป็นผาลไถนา และตีหอกของตนเป็นมีดลิดแขนง ประชาชาติจะไม่ยกดาบต่อสู้ประชาชาติ และพวกเขาจะไม่เรียนรู้การสงครามอีกต่อไป"},{"verse":4,"text":"ทุกคนจะนั่งอยู่ใต้เถาองุ่นและใต้ต้นมะเดื่อของตน และจะไม่มีใครทำให้พวกเขาหวาดกลัว เพราะพระโอษฐ์ขององค์พระผู้เป็นเจ้าจอมโยธาได้ตรัสไว้เช่นนั้น"},{"verse":5,"text":"เพราะบรรดาชนชาติต่างก็ดำเนินในนามแห่งพระของตน แต่เราจะดำเนินในพระนามขององค์พระผู้เป็นเจ้าพระเจ้าของเราตลอดไปเป็นนิตย์"},{"verse":6,"text":"องค์พระผู้เป็นเจ้าตรัสว่า ในวันนั้น เราจะรวบรวมคนที่ขาพิการ และรวบรวมคนที่ถูกขับไล่ไป คือคนที่เราได้ทำให้ทุกข์ใจ"},{"verse":7,"text":"เราจะทำให้คนขาพิการนั้นเป็นชนที่เหลืออยู่ และทำให้คนที่ถูกขับไล่ไปไกลเป็นชาติที่เข้มแข็ง และองค์พระผู้เป็นเจ้าจะทรงครอบครองเหนือพวกเขาที่ภูเขาศิโยน ตั้งแต่บัดนี้ไปจนนิรันดร์"},{"verse":8,"text":"ส่วนเจ้า หอสังเกตการณ์แห่งฝูงแกะ เนินแห่งธิดาของศิโยนเอ๋ย อำนาจการปกครองในกาลก่อนจะกลับคืนมาสู่เจ้า คือราชอาณาจักรของธิดาแห่งเยรูซาเล็ม"},{"verse":9,"text":"บัดนี้ เหตุใดเจ้าจึงร้องเสียงดัง เจ้าไม่มีกษัตริย์หรือ ที่ปรึกษาของเจ้าพินาศไปแล้วหรือ เจ้าจึงเจ็บปวดเหมือนหญิงคลอดบุตร"},{"verse":10,"text":"ธิดาแห่งศิโยนเอ๋ย จงบิดตัวด้วยความเจ็บปวดและคลอดออกมาเถิด เหมือนหญิงที่คลอดบุตร เพราะบัดนี้เจ้าจะต้องออกจากเมืองไปอาศัยอยู่ในทุ่งนา และเจ้าจะไปถึงบาบิโลน ที่นั่นเจ้าจะได้รับการช่วยกู้ ที่นั่นองค์พระผู้เป็นเจ้าจะทรงไถ่เจ้าจากมือศัตรูของเจ้า"},{"verse":11,"text":"บัดนี้ มีหลายประชาชาติชุมนุมกันต่อสู้เจ้า กล่าวว่า ‘ให้ศิโยนถูกทำให้เป็นมลทินเถิด ให้ตาของเราเพ่งดูศิโยนอย่างสะใจ’"},{"verse":12,"text":"แต่พวกเขาไม่รู้พระดำริขององค์พระผู้เป็นเจ้า และไม่เข้าใจแผนการของพระองค์ เพราะพระองค์ทรงรวบรวมพวกเขาไว้เหมือนฟ่อนข้าวที่นำมาสู่ลานนวด"},{"verse":13,"text":"ธิดาแห่งศิโยนเอ๋ย จงลุกขึ้นนวดข้าวเถิด เพราะเราจะทำให้เขาของเจ้าเป็นเหล็ก และทำให้กีบเท้าของเจ้าเป็นทองสัมฤทธิ์ เจ้าจะบดขยี้ชนชาติเป็นอันมากให้แหลกไป และเราจะถวายสิ่งที่ริบได้ของพวกเขาแด่องค์พระผู้เป็นเจ้า ถวายทรัพย์สมบัติของพวกเขาแด่องค์พระผู้เป็นเจ้าแห่งแผ่นดินโลกทั้งสิ้น"}]},{"chapter":5,"verses":[{"verse":1,"text":"บัดนี้ ธิดาแห่งกองทัพเอ๋ย จงรวมกำลังพลของเจ้าเข้าด้วยกัน เพราะมีการล้อมเมืองมาประชิดเรา เขาจะเอาไม้เรียวฟาดที่แก้มของผู้พิพากษาแห่งอิสราเอล"},{"verse":2,"text":"ส่วนเจ้า เบธเลเฮมเอฟราธาห์เอ๋ย ถึงแม้เจ้าจะเล็กน้อยเกินกว่าจะนับเข้าในบรรดาตระกูลของยูดาห์ แต่จากเจ้าจะมีผู้หนึ่งออกมาเพื่อเรา คือผู้ที่จะเป็นผู้ปกครองในอิสราเอล ผู้ซึ่งต้นกำเนิดของท่านมีมาแต่โบราณกาล ตั้งแต่ดึกดำบรรพ์"},{"verse":3,"text":"เพราะฉะนั้น พระองค์จะทรงมอบพวกเขาไว้ จนกว่าจะถึงเวลาที่หญิงผู้กำลังคลอดได้คลอดบุตรแล้ว เมื่อนั้นพี่น้องที่เหลืออยู่ของท่านจะกลับมาสมทบกับชนอิสราเอล"},{"verse":4,"text":"ท่านจะยืนหยัดและเลี้ยงดูฝูงแกะของท่านด้วยพระกำลังขององค์พระผู้เป็นเจ้า ด้วยพระบารมีแห่งพระนามขององค์พระผู้เป็นเจ้าพระเจ้าของท่าน และพวกเขาจะอาศัยอยู่อย่างมั่นคง เพราะบัดนี้ท่านจะยิ่งใหญ่จนถึงที่สุดปลายแผ่นดินโลก"},{"verse":5,"text":"และท่านผู้นี้จะเป็นสันติสุขของพวกเขา เมื่อชาวอัสซีเรียบุกเข้ามาในแผ่นดินของเรา และเหยียบย่ำเข้ามาในป้อมปราการของเรา เราจะตั้งผู้เลี้ยงแกะเจ็ดคน และเจ้านายแปดคนขึ้นต่อสู้เขา"},{"verse":6,"text":"พวกเขาจะปกครองแผ่นดินอัสซีเรียด้วยดาบ และปกครองแผ่นดินของนิมโรดด้วยดาบที่ชักออกจากฝัก ท่านจะช่วยเราให้พ้นจากชาวอัสซีเรีย เมื่อเขาบุกเข้ามาในแผ่นดินของเรา และเหยียบย่ำเข้ามาในเขตแดนของเรา"},{"verse":7,"text":"แล้วชนที่เหลืออยู่ของยาโคบจะอยู่ท่ามกลางชนชาติมากมาย เหมือนน้ำค้างจากองค์พระผู้เป็นเจ้า เหมือนสายฝนที่ตกบนหญ้า ซึ่งไม่รอคอยมนุษย์ และไม่ขึ้นกับบุตรของมนุษย์"},{"verse":8,"text":"ชนที่เหลืออยู่ของยาโคบจะอยู่ท่ามกลางประชาชาติ ท่ามกลางชนชาติมากมาย เหมือนสิงโตท่ามกลางสัตว์ป่า เหมือนสิงห์หนุ่มท่ามกลางฝูงแกะ ซึ่งเมื่อมันผ่านไป ก็เหยียบย่ำและฉีกเป็นชิ้น ๆ โดยไม่มีใครช่วยให้พ้นได้"},{"verse":9,"text":"มือของเจ้าจะถูกยกขึ้นเหนือบรรดาคู่อริของเจ้า และศัตรูทั้งสิ้นของเจ้าจะถูกตัดขาด"},{"verse":10,"text":"องค์พระผู้เป็นเจ้าตรัสว่า ในวันนั้น เราจะตัดม้าของเจ้าออกจากท่ามกลางเจ้า และจะทำลายรถม้าศึกของเจ้า"},{"verse":11,"text":"เราจะตัดเมืองต่าง ๆ ในแผ่นดินของเจ้าออกเสีย และจะทลายป้อมปราการทั้งสิ้นของเจ้าลง"},{"verse":12,"text":"เราจะตัดวิทยาคมออกจากมือของเจ้า และเจ้าจะไม่มีหมอดูฤกษ์ยามอีกต่อไป"},{"verse":13,"text":"เราจะตัดรูปสลักและเสาศักดิ์สิทธิ์ของเจ้าออกจากท่ามกลางเจ้า และเจ้าจะไม่กราบไหว้สิ่งที่มือของเจ้าสร้างขึ้นอีกต่อไป"},{"verse":14,"text":"เราจะถอนเสาอาเชราห์ของเจ้าออกจากท่ามกลางเจ้า และจะทำลายเมืองต่าง ๆ ของเจ้าเสีย"},{"verse":15,"text":"และเราจะแก้แค้นประชาชาติที่ไม่เชื่อฟังด้วยความโกรธและความเดือดดาล"}]},{"chapter":6,"verses":[{"verse":1,"text":"จงฟังสิ่งที่องค์พระผู้เป็นเจ้าตรัสเถิด จงลุกขึ้นสู้คดีต่อหน้าภูเขาทั้งหลาย และให้เนินเขาทั้งหลายได้ยินเสียงของเจ้า"},{"verse":2,"text":"ภูเขาทั้งหลายเอ๋ย จงฟังคดีขององค์พระผู้เป็นเจ้า และรากฐานอันมั่นคงของแผ่นดินโลกเอ๋ย จงฟังเถิด เพราะองค์พระผู้เป็นเจ้าทรงมีคดีกับประชากรของพระองค์ และจะทรงสู้ความกับอิสราเอล"},{"verse":3,"text":"ประชากรของเราเอ๋ย เราได้ทำอะไรแก่เจ้า เราได้ทำให้เจ้าเหน็ดเหนื่อยด้วยเรื่องอะไร จงตอบเราเถิด"},{"verse":4,"text":"เพราะเราได้นำเจ้าออกมาจากแผ่นดินอียิปต์ และไถ่เจ้าจากเรือนทาส เราได้ใช้โมเสส อาโรน และมิเรียมไปนำหน้าเจ้า"},{"verse":5,"text":"ประชากรของเราเอ๋ย จงระลึกถึงสิ่งที่บาลาคกษัตริย์แห่งโมอับได้คิดวางแผนไว้ และสิ่งที่บาลาอัมบุตรเบโอร์ได้ตอบเขา จงระลึกถึงเหตุการณ์ตั้งแต่ชิทธีมจนถึงกิลกาล เพื่อเจ้าจะได้รู้ถึงพระราชกิจอันชอบธรรมขององค์พระผู้เป็นเจ้า"},{"verse":6,"text":"ข้าพเจ้าจะนำอะไรมาเข้าเฝ้าองค์พระผู้เป็นเจ้า และกราบไหว้พระเจ้าผู้สูงสุด ข้าพเจ้าควรเข้าเฝ้าพระองค์ด้วยเครื่องเผาบูชา ด้วยลูกวัวอายุหนึ่งปีหรือ"},{"verse":7,"text":"องค์พระผู้เป็นเจ้าจะทรงพอพระทัยในแกะผู้นับพัน ๆ ตัว หรือในธารน้ำมันนับหมื่น ๆ สายหรือ ข้าพเจ้าควรถวายบุตรหัวปีของข้าพเจ้าเพื่อไถ่การล่วงละเมิดของข้าพเจ้า ถวายผลแห่งกายของข้าพเจ้าเพื่อไถ่บาปแห่งจิตวิญญาณของข้าพเจ้าหรือ"},{"verse":8,"text":"มนุษย์เอ๋ย พระองค์ได้ทรงสำแ