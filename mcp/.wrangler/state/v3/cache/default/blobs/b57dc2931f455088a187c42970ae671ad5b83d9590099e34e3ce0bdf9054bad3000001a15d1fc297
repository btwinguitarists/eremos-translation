และมือของราษฎรในแผ่นดินจะสั่นเทาด้วยความหวาดกลัว เราจะกระทำต่อพวกเขาตามวิถีทางของพวกเขา และจะพิพากษาพวกเขาตามมาตรฐานของพวกเขาเอง แล้วพวกเขาจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า”"}]},{"chapter":8,"verses":[{"verse":1,"text":"ในปีที่หก เดือนที่หก วันที่ห้าของเดือนนั้น ขณะที่ข้าพเจ้านั่งอยู่ในบ้านของข้าพเจ้า และบรรดาผู้อาวุโสแห่งยูดาห์นั่งอยู่ต่อหน้าข้าพเจ้า พระหัตถ์ขององค์พระผู้เป็นเจ้าก็มาสถิตเหนือข้าพเจ้าที่นั่น"},{"verse":2,"text":"ข้าพเจ้ามองดู และดูเถิด มีร่างหนึ่งดูเหมือนไฟ ตั้งแต่ส่วนที่ดูเหมือนบั้นเอวของพระองค์ลงมาเป็นไฟ และตั้งแต่บั้นเอวขึ้นไปดูเหมือนแสงเรืองรอง ดุจโลหะสุกปลั่ง"},{"verse":3,"text":"พระองค์ทรงยื่นสิ่งที่ดูเหมือนมือออกมาจับข้าพเจ้าที่ปอยผมบนศีรษะ แล้วพระวิญญาณก็ทรงยกข้าพเจ้าขึ้นระหว่างแผ่นดินโลกกับฟ้าสวรรค์ และทรงนำข้าพเจ้ามายังกรุงเยรูซาเล็มในนิมิตจากพระเจ้า มาถึงทางเข้าประตูด้านในที่หันไปทางทิศเหนือ ที่ซึ่งรูปเคารพแห่งความหึงหวงตั้งอยู่ คือรูปที่ยั่วยุให้ทรงหึงหวง"},{"verse":4,"text":"และดูเถิด พระสิริของพระเจ้าแห่งอิสราเอลก็อยู่ที่นั่น ดุจนิมิตที่ข้าพเจ้าได้เห็นที่ราบนั้น"},{"verse":5,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “บุตรแห่งมนุษย์เอ๋ย จงเงยหน้าขึ้นมองไปทางทิศเหนือ” ข้าพเจ้าจึงเงยหน้ามองไปทางทิศเหนือ และดูเถิด ทางเหนือของประตูแท่นบูชา ตรงทางเข้านั้น มีรูปเคารพแห่งความหึงหวงนี้ตั้งอยู่"},{"verse":6,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “บุตรแห่งมนุษย์เอ๋ย เจ้าเห็นสิ่งที่พวกเขากำลังทำหรือไม่ คือสิ่งน่ารังเกียจใหญ่หลวงที่วงศ์วานอิสราเอลกำลังกระทำที่นี่ เพื่อขับไล่เราให้ห่างไกลจากสถานนมัสการของเรา แต่เจ้าจะได้เห็นสิ่งน่ารังเกียจที่ใหญ่หลวงยิ่งกว่านี้อีก”"},{"verse":7,"text":"แล้วพระองค์ทรงนำข้าพเจ้ามาที่ทางเข้าลานพระวิหาร ข้าพเจ้ามองดู และดูเถิด มีรูอยู่รูหนึ่งในกำแพง"},{"verse":8,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “บุตรแห่งมนุษย์เอ๋ย จงเจาะกำแพงนี้” เมื่อข้าพเจ้าเจาะกำแพงแล้ว ดูเถิด มีทางเข้าอยู่ทางหนึ่ง"},{"verse":9,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “จงเข้าไปดูสิ่งน่ารังเกียจอันชั่วร้ายที่พวกเขากำลังกระทำอยู่ที่นี่”"},{"verse":10,"text":"ข้าพเจ้าจึงเข้าไปดู และดูเถิด มีรูปสัตว์เลื้อยคลานและสัตว์อันน่ารังเกียจทุกชนิด กับรูปเคารพทั้งสิ้นของวงศ์วานอิสราเอล แกะสลักอยู่ทั่วผนังโดยรอบ"},{"verse":11,"text":"และมีผู้อาวุโสแห่งวงศ์วานอิสราเอลเจ็ดสิบคนยืนอยู่ต่อหน้ารูปเหล่านั้น โดยมียาอาซันยาห์บุตรของชาฟานยืนอยู่ท่ามกลางพวกเขา แต่ละคนถือกระถางเครื่องหอมอยู่ในมือ และกลุ่มควันเครื่องหอมก็ลอยขึ้น"},{"verse":12,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “บุตรแห่งมนุษย์เอ๋ย เจ้าเห็นสิ่งที่บรรดาผู้อาวุโสแห่งวงศ์วานอิสราเอลกระทำในความมืดหรือไม่ ต่างคนต่างอยู่ในห้องรูปสลักของตน เพราะพวกเขาพูดว่า ‘องค์พระผู้เป็นเจ้าไม่ทรงเห็นเรา องค์พระผู้เป็นเจ้าทรงทอดทิ้งแผ่นดินแล้ว’”"},{"verse":13,"text":"แล้วพระองค์ตรัสกับข้าพเจ้าว่า “เจ้าจะได้เห็นสิ่งน่ารังเกียจที่ใหญ่หลวงยิ่งกว่านี้ที่พวกเขากระทำอีก”"},{"verse":14,"text":"แล้วพระองค์ทรงนำข้าพเจ้ามาที่ทางเข้าประตูเหนือของพระนิเวศขององค์พระผู้เป็นเจ้า และดูเถิด มีพวกผู้หญิงนั่งร้องไห้คร่ำครวญเพื่อเทพทัมมุสอยู่ที่นั่น"},{"verse":15,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “บุตรแห่งมนุษย์เอ๋ย เจ้าเห็นแล้วหรือ เจ้าจะได้เห็นสิ่งน่ารังเกียจที่ใหญ่หลวงยิ่งกว่านี้อีก”"},{"verse":16,"text":"แล้วพระองค์ทรงนำข้าพเจ้าเข้ามาที่ลานชั้นในของพระนิเวศขององค์พระผู้เป็นเจ้า และดูเถิด ตรงทางเข้าพระวิหารขององค์พระผู้เป็นเจ้า ระหว่างมุขกับแท่นบูชา มีชายประมาณยี่สิบห้าคน หันหลังให้พระวิหารขององค์พระผู้เป็นเจ้า หันหน้าไปทางทิศตะวันออก และพวกเขากำลังกราบไหว้ดวงอาทิตย์ทางทิศตะวันออก"},{"verse":17,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “บุตรแห่งมนุษย์เอ๋ย เจ้าเห็นแล้วหรือ การที่วงศ์วานยูดาห์กระทำสิ่งน่ารังเกียจที่พวกเขาทำที่นี่ยังเป็นเรื่องเล็กน้อยอยู่หรือ จนพวกเขาต้องทำให้แผ่นดินเต็มไปด้วยความทารุณ และยั่วยุเราให้โกรธซ้ำแล้วซ้ำเล่า ดูเถิด พวกเขาถึงกับเอากิ่งไม้แตะจมูกของตน"},{"verse":18,"text":"เพราะฉะนั้นเราจะกระทำด้วยพระพิโรธ ตาของเราจะไม่เมตตา และเราจะไม่ปรานี แม้พวกเขาจะร้องดังในหูของเรา เราก็จะไม่ฟังพวกเขา”"}]},{"chapter":9,"verses":[{"verse":1,"text":"แล้วข้าพเจ้าได้ยินพระองค์ทรงร้องเรียกด้วยเสียงดังว่า “ให้บรรดาผู้ลงทัณฑ์เมืองเข้ามาใกล้ ต่างถืออาวุธสังหารไว้ในมือ”"},{"verse":2,"text":"และดูเถิด มีชายหกคนเดินมาจากทางประตูบนที่หันไปทางทิศเหนือ แต่ละคนถืออาวุธทุบทำลายไว้ในมือ และมีชายอีกคนหนึ่งอยู่ท่ามกลางพวกเขา สวมเสื้อผ้าป่าน มีหีบเครื่องเขียนของอาลักษณ์อยู่ที่เอว พวกเขาเข้ามายืนอยู่ข้างแท่นบูชาทองสัมฤทธิ์"},{"verse":3,"text":"แล้วพระสิริของพระเจ้าแห่งอิสราเอลก็เลื่อนขึ้นจากเครูบที่พระสิริเคยสถิตอยู่ ไปยังธรณีประตูพระนิเวศ และพระองค์ทรงร้องเรียกชายที่สวมเสื้อผ้าป่านซึ่งมีหีบเครื่องเขียนของอาลักษณ์อยู่ที่เอว"},{"verse":4,"text":"องค์พระผู้เป็นเจ้าตรัสกับเขาว่า “จงไปทั่วเมือง คือทั่วกรุงเยรูซาเล็ม และทำเครื่องหมายไว้ที่หน้าผากของบรรดาคนที่ถอนหายใจและคร่ำครวญเพราะสิ่งน่ารังเกียจทั้งสิ้นที่กระทำกันในเมืองนั้น”"},{"verse":5,"text":"และข้าพเจ้าได้ยินพระองค์ตรัสกับคนอื่น ๆ ว่า “จงตามเขาไปทั่วเมืองและฆ่าฟัน อย่าให้ตาของเจ้าเมตตา และอย่าสงสารเลย"},{"verse":6,"text":"จงฆ่าทั้งคนแก่ คนหนุ่ม หญิงสาว เด็กเล็ก และผู้หญิงให้สิ้น แต่อย่าเข้าใกล้ผู้ใดที่มีเครื่องหมายนั้น และจงเริ่มต้นที่สถานนมัสการของเรา” พวกเขาจึงเริ่มต้นที่บรรดาผู้อาวุโสซึ่งอยู่หน้าพระนิเวศ"},{"verse":7,"text":"พระองค์ตรัสกับพวกเขาว่า “จงทำให้พระนิเวศเป็นมลทิน และทำให้ลานทั้งหลายเต็มไปด้วยคนที่ถูกฆ่า จงออกไปเถิด” พวกเขาจึงออกไปและฆ่าฟันไปทั่วเมือง"},{"verse":8,"text":"ขณะที่พวกเขากำลังฆ่าฟันอยู่นั้น ข้าพเจ้าถูกทิ้งไว้แต่ผู้เดียว ข้าพเจ้าก็ซบหน้าลงถึงดินและร้องทูลว่า “ข้าแต่องค์พระผู้เป็นเจ้า เมื่อพระองค์ทรงเทพระพิโรธลงเหนือกรุงเยรูซาเล็ม พระองค์จะทรงทำลายคนอิสราเอลที่เหลืออยู่ทั้งหมดหรือ”"},{"verse":9,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “ความผิดบาปของวงศ์วานอิสราเอลและยูดาห์นั้นใหญ่หลวงยิ่งนัก แผ่นดินเต็มไปด้วยการนองเลือด และเมืองก็เต็มไปด้วยความอยุติธรรม เพราะพวกเขาพูดว่า ‘องค์พระผู้เป็นเจ้าทรงทอดทิ้งแผ่นดินแล้ว และองค์พระผู้เป็นเจ้าไม่ทรงเห็น’"},{"verse":10,"text":"ส่วนเราเอง ตาของเราจะไม่เมตตา และเราจะไม่ปรานี เราจะตอบสนองการกระทำของพวกเขาให้ตกบนศีรษะของพวกเขาเอง”"},{"verse":11,"text":"และดูเถิด ชายที่สวมเสื้อผ้าป่านซึ่งมีหีบเครื่องเขียนอยู่ที่เอวนั้น กลับมารายงานว่า “ข้าพระองค์ได้ทำตามที่พระองค์ทรงบัญชาแล้ว”"}]},{"chapter":10,"verses":[{"verse":1,"text":"ข้าพเจ้ามองดู และดูเถิด เหนือแผ่นฟ้าที่อยู่เหนือศีรษะของเหล่าเครูบ มีสิ่งที่ดูเหมือนพระที่นั่งทำด้วยไพลินปรากฏอยู่เหนือพวกมัน"},{"verse":2,"text":"พระองค์ตรัสกับชายที่สวมเสื้อผ้าป่านว่า “จงเข้าไปท่ามกลางวงล้อที่อยู่ใต้เครูบ เอามือกอบถ่านไฟจากท่ามกลางเหล่าเครูบ แล้วโปรยลงเหนือเมือง” และชายนั้นก็เข้าไปต่อหน้าต่อตาข้าพเจ้า"},{"verse":3,"text":"ขณะที่ชายนั้นเข้าไป เหล่าเครูบยืนอยู่ทางทิศใต้ของพระนิเวศ และเมฆก็เต็มลานชั้นใน"},{"verse":4,"text":"แล้วพระสิริขององค์พระผู้เป็นเจ้าก็เลื่อนขึ้นจากเครูบไปยังธรณีประตูพระนิเวศ พระนิเวศก็เต็มไปด้วยเมฆ และลานนั้นก็เต็มไปด้วยแสงเจิดจ้าแห่งพระสิริขององค์พระผู้เป็นเจ้า"},{"verse":5,"text":"เสียงปีกของเหล่าเครูบดังไปถึงลานชั้นนอก ดุจพระสุรเสียงของพระเจ้าผู้ทรงมหิทธิฤทธิ์เมื่อพระองค์ตรัส"},{"verse":6,"text":"เมื่อพระองค์ทรงบัญชาชายที่สวมเสื้อผ้าป่านว่า ‘จงเอาไฟจากท่ามกลางวงล้อ จากท่ามกลางเหล่าเครูบ’ ชายนั้นก็เข้าไปยืนอยู่ข้างวงล้อหนึ่ง"},{"verse":7,"text":"แล้วเครูบตนหนึ่งก็ยื่นมือออกไปยังไฟที่อยู่ท่ามกลางเหล่าเครูบ หยิบไฟนั้นใส่ในมือของชายที่สวมเสื้อผ้าป่าน ชายนั้นก็รับไปแล้วออกไป"},{"verse":8,"text":"เหล่าเครูบนั้นปรากฏว่ามีสิ่งที่ดูเหมือนมือมนุษย์อยู่ใต้ปีกของพวกมัน"},{"verse":9,"text":"ข้าพเจ้ามองดู และดูเถิด มีวงล้อสี่วงอยู่ข้างเหล่าเครูบ วงล้อหนึ่งอยู่ข้างเครูบแต่ละตน และวงล้อเหล่านั้นเป็นประกายดุจพลอยทาร์ชิช"},{"verse":10,"text":"ส่วนลักษณะของวงล้อทั้งสี่นั้นเหมือนกัน คือดูเหมือนวงล้อซ้อนอยู่ในวงล้อ"},{"verse":11,"text":"เมื่อเคลื่อนไป วงล้อไปได้ทั้งสี่ทิศโดยไม่ต้องหันเลี้ยว เพราะหัวหันไปทางไหน วงล้อก็ตามไปทางนั้นโดยไม่ต้องหันเลี้ยว"},{"verse":12,"text":"ทั่วทั้งกาย ทั้งหลัง มือ และปีกของพวกมัน รวมทั้งวงล้อทั้งสี่ ล้วนเต็มไปด้วยดวงตาโดยรอบ"},{"verse":13,"text":"ข้าพเจ้าได้ยินว่าวงล้อเหล่านั้นถูกเรียกว่า ‘วงล้อหมุนวน’"},{"verse":14,"text":"เครูบแต่ละตนมีสี่หน้า หน้าแรกเป็นหน้าเครูบ หน้าที่สองเป็นหน้ามนุษย์ หน้าที่สามเป็นหน้าสิงโต และหน้าที่สี่เป็นหน้านกอินทรี"},{"verse":15,"text":"แล้วเหล่าเครูบก็ลอยขึ้น สิ่งมีชีวิตเหล่านี้คือสิ่งมีชีวิตที่ข้าพเจ้าได้เห็นที่ริมแม่น้ำเคบาร์"},{"verse":16,"text":"เมื่อเหล่าเครูบเคลื่อนไป วงล้อก็เคลื่อนไปข้าง ๆ และเมื่อเหล่าเครูบกางปีกเพื่อลอยขึ้นจากพื้น วงล้อก็ไม่แยกจากข้างพวกมัน"},{"verse":17,"text":"เมื่อเหล่าเครูบหยุดนิ่ง วงล้อก็หยุดนิ่ง และเมื่อเหล่าเครูบลอยขึ้น วงล้อก็ลอยขึ้นไปด้วย เพราะวิญญาณแห่งสิ่งมีชีวิตนั้นอยู่ในวงล้อ"},{"verse":18,"text":"แล้วพระสิริขององค์พระผู้เป็นเจ้าก็เคลื่อนออกจากธรณีประตูพระนิเวศ และมาสถิตเหนือเหล่าเครูบ"},{"verse":19,"text":"เหล่าเครูบกางปีกและลอยขึ้นจากพื้นต่อหน้าต่อตาข้าพเจ้าขณะที่พวกมันออกไป โดยมีวงล้ออยู่เคียงข้าง พวกมันหยุดอยู่ที่ทางเข้าประตูตะวันออกของพระนิเวศขององค์พระผู้เป็นเจ้า และพระสิริของพระเจ้าแห่งอิสราเอลอยู่เหนือพวกมัน"},{"verse":20,"text":"สิ่งมีชีวิตเหล่านี้คือสิ่งที่ข้าพเจ้าได้เห็นอยู่ใต้พระเจ้าแห่งอิสราเอลที่ริมแม่น้ำเคบาร์ และข้าพเจ้าจึงรู้ว่าพวกมันเป็นเครูบ"},{"verse":21,"text":"แต่ละตนมีสี่หน้าและสี่ปีก กับสิ่งที่ดูเหมือนมือมนุษย์อยู่ใต้ปีกของพวกมัน"},{"verse":22,"text":"ส่วนลักษณะหน้าของพวกมันนั้นเหมือนกับหน้าที่ข้าพเจ้าได้เห็นที่ริมแม่น้ำเคบาร์ ทั้งรูปลักษณ์และตัวพวกมันเอง แต่ละตนมุ่งตรงไปข้างหน้า"}]},{"chapter":11,"verses":[{"verse":1,"text":"แล้วพระวิญญาณก็ทรงยกข้าพเจ้าขึ้น และทรงนำข้าพเจ้ามายังประตูตะวันออกของพระนิเวศขององค์พระผู้เป็นเจ้า ซึ่งหันหน้าไปทางทิศตะวันออก และดูเถิด ที่ทางเข้าประตูนั้นมีชายยี่สิบห้าคน ข้าพเจ้าเห็นยาอาซันยาห์บุตรของอัสซูร์ และเปลาทียาห์บุตรของเบไนยาห์ ผู้เป็นเจ้านายของประชาชนอยู่ท่ามกลางพวกเขา"},{"verse":2,"text":"พระองค์ตรัสกับข้าพเจ้าว่า “บุตรแห่งมนุษย์เอ๋ย คนเหล่านี้คือคนที่คิดการชั่วและให้คำปรึกษาชั่วร้ายในเมืองนี้"},{"verse":3,"text":"พวกเขาพูดว่า ‘เวลาที่จะสร้างบ้านยังไม่ใกล้ดอกหรือ เมืองนี้เป็นหม้อ และเราเป็นเนื้อ’"},{"verse":4,"text":"เพราะฉะนั้น จงเผยพระวจนะกล่าวโทษพวกเขา จงเผยพระวจนะเถิด บุตรแห่งมนุษย์เอ๋ย”"},{"verse":5,"text":"แล้วพระวิญญาณขององค์พระผู้เป็นเจ้าก็มาสถิตเหนือข้าพเจ้า และตรัสกับข้าพเจ้าให้ประกาศว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า “วงศ์วานอิสราเอลเอ๋ย เจ้าพูดเช่นนั้น และเรารู้ถึงสิ่งที่ผุดขึ้นในใจของเจ้า"},{"verse":6,"text":"เจ้าได้ฆ่าคนมากมายในเมืองนี้ และทำให้ถนนเต็มไปด้วยคนที่ถูกฆ่า"},{"verse":7,"text":"เพราะฉะนั้น องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า คนที่ถูกฆ่าซึ่งเจ้าทิ้งไว้กลางเมืองนั้นแหละคือเนื้อ และเมืองนี้คือหม้อ แต่เราจะนำเจ้าออกไปจากกลางเมืองนั้น"},{"verse":8,"text":"เจ้ากลัวดาบ และเราจะนำดาบมาเหนือเจ้า องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้"},{"verse":9,"text":"เราจะนำเจ้าออกไปจากกลางเมือง และมอบเจ้าไว้ในมือของคนต่างชาติ และเราจะลงโทษเจ้า"},{"verse":10,"text":"เจ้าจะล้มตายด้วยดาบ เราจะพิพากษาเจ้าที่ชายแดนอิสราเอล แล้วเจ้าจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า"},{"verse":11,"text":"เมืองนี้จะไม่เป็นหม้อสำหรับเจ้า และเจ้าจะไม่เป็นเนื้ออยู่ในนั้น เราจะพิพากษาเจ้าที่ชายแดนอิสราเอล"},{"verse":12,"text":"แล้วเจ้าจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า เพราะเจ้าไม่ได้ดำเนินตามกฎเกณฑ์ของเรา ไม่ได้รักษากฎหมายของเรา แต่กลับทำตามกฎหมายของบรรดาประชาชาติที่อยู่ล้อมรอบเจ้า”"},{"verse":13,"text":"ขณะที่ข้าพเจ้ากำลังเผยพระวจนะอยู่นั้น เปลาทียาห์บุตรของเบไนยาห์ก็สิ้นชีวิต ข้าพเจ้าจึงซบหน้าลงถึงดินและร้องเสียงดังว่า “ข้าแต่องค์พระผู้เป็นเจ้า พระองค์จะทรงทำลายคนอิสราเอลที่เหลืออยู่จนสิ้นหรือ”"},{"verse":14,"text":"แล้วพระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าว่า"},{"verse":15,"text":"บุตรแห่งมนุษย์เอ๋ย พี่น้องของเจ้า คือญาติของเจ้า เพื่อนเชลยของเจ้า และวงศ์วานอิสราเอลทั้งหมด เป็นผู้ที่ชาวเยรูซาเล็มกล่าวถึงว่า ‘พวกเขาห่างไกลจากองค์พระผู้เป็นเจ้าแล้ว แผ่นดินนี้ตกเป็นกรรมสิทธิ์ของเรา’"},{"verse":16,"text":"เพราะฉะนั้น จงกล่าวว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘แม้เราได้ส่งพวกเขาไปไกลท่ามกลางบรรดาประชาชาติ และทำให้พวกเขากระจัดกระจายไปตามดินแดนต่าง ๆ แต่เราเองก็เป็นสถานนมัสการให้พวกเขาชั่วระยะหนึ่งในดินแดนที่พวกเขาไปอยู่นั้น’"},{"verse":17,"text":"เพราะฉะนั้น จงกล่าวว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘เราจะรวบรวมเจ้าจากชนชาติทั้งหลาย และรวมเจ้าจากดินแดนที่เจ้าถูกทำให้กระจัดกระจายไป และเราจะคืนแผ่นดินอิสราเอลให้แก่เจ้า’"},{"verse":18,"text":"เมื่อพวกเขากลับมา พวกเขาจะกำจัดสิ่งน่าสะอิดสะเอียนและสิ่งน่ารังเกียจทั้งสิ้นออกจากแผ่นดินนั้น"},{"verse":19,"text":"เราจะให้เขาทั้งหลายมีใจเดียว และจะใส่จิตใจใหม่ไว้ภายในพวกเจ้า เราจะนำใจที่เป็นหินออกจากเนื้อของพวกเขา และจะให้ใจที่เป็นเนื้อแก่พวกเขา"},{"verse":20,"text":"เพื่อพวกเขาจะดำเนินตามกฎเกณฑ์ของเรา รักษากฎหมายของเรา และประพฤติตาม แล้วพวกเขาจะเป็นประชากรของเรา และเราจะเป็นพระเจ้าของพวกเขา"},{"verse":21,"text":"แต่สำหรับคนที่มีใจมุ่งติดตามสิ่งน่าสะอิดสะเอียนและสิ่งน่ารังเกียจของพวกเขา เราจะตอบสนองการกระทำของพวกเขาให้ตกบนศีรษะของพวกเขาเอง องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้"},{"verse":22,"text":"แล้วเหล่าเครูบก็กางปีกของพวกมัน โดยมีวงล้ออยู่เคียงข้าง และพระสิริของพระเจ้าแห่งอิสราเอลอยู่เหนือพวกมัน"},{"verse":23,"text":"และพระสิริขององค์พระผู้เป็นเจ้าก็ขึ้นไปจากกลางเมือง และหยุดอยู่บนภูเขาทางทิศตะวันออกของเมือง"},{"verse":24,"text":"แล้วพระวิญญาณก็ทรงยกข้าพเจ้าขึ้น และทรงนำข้าพเจ้ากลับมายังแผ่นดินเคลเดีย มาหาพวกเชลย ในนิมิตโดยพระวิญญาณของพระเจ้า แล้วนิมิตที่ข้าพเจ้าได้เห็นนั้นก็ขึ้นไปจากข้าพเจ้า"},{"verse":25,"text":"ข้าพเจ้าจึงเล่าให้พวกเชลยฟังถึงทุกสิ่งที่องค์พระผู้เป็นเจ้าทรงสำแดงแก่ข้าพเจ้า"}]},{"chapter":12,"verses":[{"verse":1,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าว่า"},{"verse":2,"text":"“บุตรแห่งมนุษย์เอ๋ย เจ้าอาศัยอยู่ท่ามกลางวงศ์วานที่ชอบกบฏ ผู้มีตาเพื่อจะดูแต่ไม่ดู มีหูเพื่อจะฟังแต่ไม่ฟัง เพราะพวกเขาเป็นวงศ์วานที่ชอบกบฏ"},{"verse":3,"text":"เพราะฉะนั้น บุตรแห่งมนุษย์เอ๋ย จงเตรียมสัมภาระสำหรับการเป็นเชลย และออกเดินทางไปเป็นเชลยในเวลากลางวันต่อหน้าต่อตาพวกเขา จงออกจากที่ของเจ้าไปยังอีกที่หนึ่งต่อหน้าพวกเขา บางทีพวกเขาจะเข้าใจ แม้พวกเขาเป็นวงศ์วานที่ชอบกบฏ"},{"verse":4,"text":"จงนำสัมภาระของเจ้าออกมาในเวลากลางวันต่อหน้าต่อตาพวกเขา ให้เป็นเหมือนสัมภาระสำหรับการเป็นเชลย แล้วในเวลาเย็น เจ้าจงออกไปต่อหน้าพวกเขาเหมือนคนที่ถูกกวาดไปเป็นเชลย"},{"verse":5,"text":"จงเจาะกำแพงต่อหน้าต่อตาพวกเขา และขนสัมภาระของเจ้าออกไปทางนั้น"},{"verse":6,"text":"จงแบกสัมภาระขึ้นบ่าต่อหน้าต่อตาพวกเขา และขนออกไปในความมืด จงคลุมหน้าของเจ้าไว้ไม่ให้เห็นแผ่นดิน เพราะเราได้ตั้งเจ้าให้เป็นเครื่องหมายแก่วงศ์วานอิสราเอล”"},{"verse":7,"text":"ข้าพเจ้าก็ทำตามที่ได้รับบัญชา ข้าพเจ้านำสัมภาระออกมาในเวลากลางวันเหมือนสัมภาระสำหรับการเป็นเชลย และในเวลาเย็นข้าพเจ้าก็เจาะกำแพงด้วยมือ แล้วขนสัมภาระออกไปในความมืด แบกขึ้นบ่าต่อหน้าต่อตาพวกเขา"},{"verse":8,"text":"ครั้นรุ่งเช้า พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าว่า"},{"verse":9,"text":"“บุตรแห่งมนุษย์เอ๋ย วงศ์วานอิสราเอล คือวงศ์วานที่ชอบกบฏนั้น ได้ถามเจ้ามิใช่หรือว่า ‘เจ้ากำลังทำอะไร’"},{"verse":10,"text":"จงกล่าวแก่พวกเขาว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘ภาระแห่งคำพยากรณ์นี้เกี่ยวกับเจ้านายในกรุงเยรูซาเล็มและวงศ์วานอิสราเอลทั้งหมดที่อยู่ในเมืองนั้น’"},{"verse":11,"text":"จงกล่าวว่า ‘เราเป็นเครื่องหมายแก่เจ้า’ สิ่งที่เราได้ทำนั้น พวกเขาก็จะประสบเช่นนั้น พวกเขาจะถูกกวาดไปเป็นเชลย ไปสู่การเป็นเชลย"},{"verse":12,"text":"เจ้านายที่อยู่ท่ามกลางพวกเขาจะแบกสัมภาระขึ้นบ่าในความมืดและออกไป พวกเขาจะเจาะกำแพงเพื่อนำเขาออกไปทางนั้น เขาจะคลุมหน้าของตนเพราะจะไม่ได้เห็นแผ่นดินด้วยตา"},{"verse":13,"text":"เราจะกางตาข่ายของเราคลุมเขา และเขาจะติดอยู่ในกับดักของเรา เราจะนำเขาไปยังบาบิโลน แผ่นดินของชาวเคลเดีย ถึงกระนั้นเขาก็จะไม่ได้เห็นแผ่นดินนั้น และเขาจะตายที่นั่น"},{"verse":14,"text":"เราจะกระจายบรรดาผู้ที่อยู่รอบตัวเขา คือผู้ช่วยและกองทหารทั้งสิ้นของเขา ให้กระจัดกระจายไปตามลมทุกทิศ และจะชักดาบออกไล่ตามพวกเขา"},{"verse":15,"text":"แล้วพวกเขาจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า เมื่อเราทำให้พวกเขากระจัดกระจายไปท่ามกลางบรรดาประชาชาติ และทำให้พวกเขากระจายไปตามดินแดนต่าง ๆ"},{"verse":16,"text":"แต่เราจะเหลือคนไว้บ้างให้รอดพ้นจากดาบ การกันดารอาหาร และโรคระบาด เพื่อพวกเขาจะเล่าถึงสิ่งน่ารังเกียจทั้งสิ้นของตนท่ามกลางบรรดาประชาชาติที่พวกเขาไปอยู่ แล้วพวกเขาจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า”"},{"verse":17,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าอีกว่า"},{"verse":18,"text":"“บุตรแห่งมนุษย์เอ๋ย จงกินอาหารของเจ้าด้วยความสั่นสะท้าน และดื่มน้ำของเจ้าด้วยความหวาดหวั่นและกระวนกระวาย"},{"verse":19,"text":"และจงกล่าวแก่ชาวแผ่นดินนั้นว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่าเกี่ยวกับชาวกรุงเยรูซาเล็มในแผ่นดินอิสราเอล ‘พวกเขาจะกินอาหารด้วยความกระวนกระวาย และดื่มน้ำด้วยความหวาดกลัว เพราะแผ่นดินของเขาจะถูกริบเอาทุกสิ่งไปเพราะความทารุณของทุกคนที่อาศัยอยู่ในนั้น"},{"verse":20,"text":"เมืองที่มีคนอาศัยอยู่จะถูกทิ้งร้าง และแผ่นดินจะกลายเป็นที่รกร้าง แล้วพวกเจ้าจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า’”"},{"verse":21,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าอีกว่า"},{"verse":22,"text":"“บุตรแห่งมนุษย์เอ๋ย คำภาษิตที่พวกเจ้ามีในแผ่นดินอิสราเอลที่ว่า ‘วันเวลาก็ยืดยาวออกไป และนิมิตทุกอย่างก็เลือนหายไป’ นั้นหมายความว่าอย่างไร"},{"verse":23,"text":"เพราะฉะนั้น จงกล่าวแก่พวกเขาว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘เราจะทำให้คำภาษิตนี้สิ้นสุดลง และจะไม่มีใครกล่าวคำภาษิตนี้ในอิสราเอลอีกต่อไป’ แต่จงกล่าวแก่พวกเขาว่า ‘วันเวลาใกล้เข้ามาแล้ว และทุกนิมิตจะสำเร็จ"},{"verse":24,"text":"เพราะจะไม่มีนิมิตเท็จหรือการทำนายที่ประจบสอพลออีกต่อไปท่ามกลางวงศ์วานอิสราเอล"},{"verse":25,"text":"เพราะเราคือองค์พระผู้เป็นเจ้า เราจะพูดถ้อยคำที่เราจะพูด และถ้อยคำนั้นจะสำเร็จ จะไม่ล่าช้าอีกต่อไป วงศ์วานที่ชอบกบฏเอ๋ย ในสมัยของเจ้านี่แหละ เราจะพูดถ้อยคำและจะกระทำให้สำเร็จ องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้’”"},{"verse":26,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าอีกว่า"},{"verse":27,"text":"“บุตรแห่งมนุษย์เอ๋ย ดูเถิด วงศ์วานอิสราเอลกำลังพูดว่า ‘นิมิตที่เขาเห็นนั้นเป็นเรื่องของอีกหลายปีข้างหน้า เขาพยากรณ์ถึงกาลไกลโพ้น’"},{"verse":28,"text":"เพราะฉะนั้น จงกล่าวแก่พวกเขาว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘ถ้อยคำของเราจะไม่ล่าช้าอีกต่อไป ถ้อยคำที่เราพูดจะสำเร็จ องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้’”"}]},{"chapter":13,"verses":[{"verse":1,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าว่า"},{"verse":2,"text":"“บุตรแห่งมนุษย์เอ๋ย จงเผยพระวจนะกล่าวโทษบรรดาผู้เผยพระวจนะแห่งอิสราเอลที่กำลังเผยพระวจนะอยู่ และจงกล่าวแก่ผู้ที่เผยพระวจนะตามใจของตนเองว่า จงฟังพระวจนะขององค์พระผู้เป็นเจ้า"},{"verse":3,"text":"องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า วิบัติแก่ผู้เผยพระวจนะโง่เขลาที่ติดตามวิญญาณของตนเอง และไม่ได้เห็นสิ่งใดเลย"},{"verse":4,"text":"อิสราเอลเอ๋ย ผู้เผยพระวจนะของเจ้าเป็นดุจสุนัขจิ้งจอกท่ามกลางซากปรักหักพัง"},{"verse":5,"text":"เจ้าไม่ได้ขึ้นไปยังช่องโหว่ หรือซ่อมกำแพงให้วงศ์วานอิสราเอล เพื่อให้ยืนหยัดได้ในศึกสงครามในวันแห่งองค์พระผู้เป็นเจ้า"},{"verse":6,"text":"พวกเขาเห็นนิมิตเท็จและคำทำนายมุสา พวกเขาพูดว่า ‘องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้’ ทั้งที่องค์พระผู้เป็นเจ้าไม่ได้ทรงใช้พวกเขา แต่พวกเขายังหวังให้ถ้อยคำนั้นเป็นจริง"},{"verse":7,"text":"เจ้าได้เห็นนิมิตเท็จและกล่าวคำทำนายมุสามิใช่หรือ เมื่อเจ้าพูดว่า ‘องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้’ ทั้งที่เราไม่ได้พูดเลย”"},{"verse":8,"text":"เพราะฉะนั้น องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า เพราะเจ้าพูดสิ่งไร้สาระและเห็นนิมิตเท็จ ดูเถิด เราจึงเป็นปฏิปักษ์ต่อเจ้า องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้"},{"verse":9,"text":"มือของเราจะต่อสู้บรรดาผู้เผยพระวจนะที่เห็นนิมิตเท็จและทำนายมุสา พวกเขาจะไม่ได้อยู่ในที่ประชุมแห่งประชากรของเรา จะไม่ถูกบันทึกไว้ในทะเบียนของวงศ์วานอิสราเอล และจะไม่ได้เข้าสู่แผ่นดินอิสราเอล แล้วเจ้าจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า"},{"verse":10,"text":"เพราะพวกเขาได้ชักนำประชากรของเราให้หลงผิด โดยกล่าวว่า ‘สันติสุข’ ทั้งที่ไม่มีสันติสุข และเมื่อมีคนสร้างกำแพงอันบอบบาง พวกเขาก็ฉาบมันด้วยปูนขาว"},{"verse":11,"text":"จงบอกบรรดาผู้ที่ฉาบกำแพงด้วยปูนขาวว่ามันจะพังลง จะมีฝนตกกระหน่ำ ลูกเห็บจะตกลงมา และลมพายุจะพัดทลายมัน"},{"verse":12,"text":"ดูเถิด เมื่อกำแพงพังลง เขาจะไม่ถามเจ้าหรือว่า ‘ปูนที่เจ้าฉาบไว้นั้นอยู่ที่ไหน’"},{"verse":13,"text":"เพราะฉะนั้น องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า เราจะปล่อยลมพายุออกมาด้วยพระพิโรธของเรา จะมีฝนกระหน่ำด้วยความโกรธของเรา และลูกเห็บด้วยความเกรี้ยวกราดเพื่อทำลายล้าง"},{"verse":14,"text":"เราจะรื้อกำแพงที่เจ้าฉาบด้วยปูนขาวลง ทำให้ราบลงถึงดิน จนฐานรากของมันปรากฏออกมา กำแพงนั้นจะพังลง และเจ้าจะถูกทำลายอยู่ในนั้น แล้วเจ้าจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า"},{"verse":15,"text":"เมื่อเราได้ระบายพระพิโรธของเราใส่กำแพงและใส่บรรดาผู้ที่ฉาบมันด้วยปูนขาวแล้ว เราจะกล่าวแก่เจ้าว่า ‘กำแพงนั้นไม่มีอีกแล้ว และผู้ที่ฉาบมันก็ไม่มีอีกแล้ว’"},{"verse":16,"text":"คือบรรดาผู้เผยพระวจนะแห่งอิสราเอลที่เผยพระวจนะแก่กรุงเยรูซาเล็ม และเห็นนิมิตแห่งสันติสุขสำหรับเมืองนั้น ทั้งที่ไม่มีสันติสุขเลย องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้”"},{"verse":17,"text":"ส่วนเจ้า บุตรแห่งมนุษย์เอ๋ย จงตั้งหน้าของเจ้าต่อสู้บรรดาบุตรหญิงแห่งชนชาติของเจ้า ผู้เผยพระวจนะตามใจของตนเอง และจงเผยพระวจนะกล่าวโทษพวกนาง"},{"verse":18,"text":"และจงกล่าวว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า วิบัติแก่พวกผู้หญิงที่เย็บปลอกเครื่องรางไว้ที่ข้อมือทุกข้อ และทำผ้าคลุมศีรษะสำหรับคนทุกขนาด เพื่อล่าจับชีวิตผู้คน เจ้าจะล่าจับชีวิตประชากรของเรา แล้วรักษาชีวิตของพวกเจ้าเองไว้หรือ"},{"verse":19,"text":"เจ้าได้ทำให้เราเป็นที่ดูหมิ่นท่ามกลางประชากรของเรา เพียงเพื่อข้าวบาร์เลย์ไม่กี่หยิบมือและเศษขนมปัง โดยฆ่าคนที่ไม่ควรตาย และไว้ชีวิตคนที่ไม่ควรอยู่ ด้วยคำมุสาของเจ้าต่อประชากรของเราซึ่งชอบฟังคำมุสา"},{"verse":20,"text":"เพราะฉะนั้น องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ดูเถิด เราเป็นปฏิปักษ์ต่อปลอกเครื่องรางของเจ้า ซึ่งเจ้าใช้ล่าจับชีวิตคนดุจนก เราจะฉีกมันออกจากแขนของเจ้า และจะปล่อยชีวิตที่เจ้าล่าจับดุจนกนั้นให้เป็นอิสระ"},{"verse":21,"text":"เราจะฉีกผ้าคลุมของเจ้าออก และจะช่วยกู้ประชากรของเราให้พ้นจากมือของเจ้า พวกเขาจะไม่ตกเป็นเหยื่ออยู่ในมือของเจ้าอีกต่อไป แล้วเจ้าจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า"},{"verse":22,"text":"เพราะเจ้าได้ทำให้ใจของคนชอบธรรมท้อแท้ด้วยคำมุสา ทั้งที่เราไม่ได้ทำให้เขาเป็นทุกข์ และเจ้าได้หนุนมือคนชั่วไม่ให้หันจากทางชั่วของเขาเพื่อรักษาชีวิตไว้"},{"verse":23,"text":"เพราะฉะนั้น เจ้าจะไม่เห็นนิมิตเท็จหรือทำการทำนายอีกต่อไป เราจะช่วยกู้ประชากรของเราให้พ้นจากมือของเจ้า แล้วเจ้าจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า”"}]},{"chapter":14,"verses":[{"verse":1,"text":"แล้วมีผู้อาวุโสบางคนของอิสราเอลมาหาข้าพเจ้าและนั่งลงต่อหน้าข้าพเจ้า"},{"verse":2,"text":"และพระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าว่า"},{"verse":3,"text":"“บุตรแห่งมนุษย์เอ๋ย คนเหล่านี้ได้ตั้งรูปเคารพไว้ในใจของตน และวางสิ่งที่ทำให้สะดุดในความผิดบาปไว้ตรงหน้าตน เราควรจะให้พวกเขาทูลถามเราหรือ"},{"verse":4,"text":"เพราะฉะนั้น จงกล่าวแก่พวกเขาว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘เมื่อชนอิสราเอลคนใดตั้งรูปเคารพไว้ในใจ และวางสิ่งที่ทำให้สะดุดในความผิดบาปไว้ตรงหน้าตน แล้วมาหาผู้เผยพระวจนะ เราคือองค์พระผู้เป็นเจ้าจะตอบเขาเองตามรูปเคารพมากมายของเขา"},{"verse":5,"text":"เพื่อเราจะยึดจิตใจของวงศ์วานอิสราเอลคืนมา ผู้ซึ่งล้วนได้เหินห่างไปจากเราเพราะรูปเคารพของพวกเขา’"},{"verse":6,"text":"เพราะฉะนั้น จงกล่าวแก่วงศ์วานอิสราเอลว่า องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘จงกลับใจเสีย จงหันจากรูปเคารพของเจ้า และหันหน้าของเจ้าเสียจากสิ่งน่ารังเกียจทั้งสิ้นของเจ้า"},{"verse":7,"text":"เพราะเมื่อชนอิสราเอลคนใด หรือคนต่างชาติที่อาศัยอยู่ในอิสราเอล แยกตัวออกจากเรา ตั้งรูปเคารพไว้ในใจ และวางสิ่งที่ทำให้สะดุดในความผิดบาปไว้ตรงหน้าตน แล้วมาหาผู้เผยพระวจนะเพื่อทูลถามเรา เราคือองค์พระผู้เป็นเจ้าจะตอบเขาด้วยตนเอง"},{"verse":8,"text":"เราจะหันหน้าของเราเข้าต่อสู้คนนั้น และทำให้เขาเป็นเครื่องหมายและคำเปรียบเปรย เราจะตัดเขาออกจากท่ามกลางประชากรของเรา แล้วเจ้าจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า"},{"verse":9,"text":"ส่วนผู้เผยพระวจนะ ถ้าเขาถูกหลอกล่อให้พูดถ้อยคำใด เราคือองค์พระผู้เป็นเจ้าเองที่ได้ปล่อยให้ผู้เผยพระวจนะนั้นถูกหลอกล่อ เราจะเหยียดมือของเราออกต่อสู้เขา และจะทำลายเขาเสียจากท่ามกลางอิสราเอลประชากรของเรา"},{"verse":10,"text":"ทั้งสองจะแบกรับความผิดบาปของตน โทษของผู้ที่มาทูลถามจะเท่ากับโทษของผู้เผยพระวจนะ"},{"verse":11,"text":"เพื่อวงศ์วานอิสราเอลจะไม่หลงเจิ่นไปจากเราอีก และจะไม่ทำตัวเป็นมลทินด้วยการละเมิดทั้งสิ้นของพวกเขาอีกต่อไป แล้วพวกเขาจะเป็นประชากรของเรา และเราจะเป็นพระเจ้าของพวกเขา องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้’”"},{"verse":12,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าอีกว่า"},{"verse":13,"text":"“บุตรแห่งมนุษย์เอ๋ย เมื่อแผ่นดินใดทำบาปต่อเราโดยการทรยศ เราจะเหยียดมือของเราออกต่อสู้แผ่นดินนั้น ตัดการจัดหาอาหารของแผ่นดิน ส่งการกันดารอาหารมา และตัดทั้งคนและสัตว์ออกจากแผ่นดินนั้น"},{"verse":14,"text":"แม้ว่าชายสามคนนี้ คือโนอาห์ ดาเนียล และโยบ จะอยู่ในแผ่นดินนั้น พวกเขาก็จะช่วยได้แต่ชีวิตของตนเองด้วยความชอบธรรมของตน องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้"},{"verse":15,"text":"หากเราส่งสัตว์ร้ายให้ผ่านไปทั่วแผ่นดิน ทำให้แผ่นดินนั้นไร้ผู้คนและเป็นที่ร้างเปล่า จนไม่มีใครผ่านไปได้เพราะกลัวสัตว์ร้าย"},{"verse":16,"text":"แม้ชายสามคนนี้จะอยู่ในแผ่นดินนั้น เรามีชีวิตอยู่แน่ฉันใด องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้ พวกเขาจะช่วยแม้แต่บุตรชายหรือบุตรหญิงของตนไม่ได้ พวกเขาจะรอดได้แต่ตัวเองเท่านั้น และแผ่นดินก็จะเป็นที่ร้างเปล่า"},{"verse":17,"text":"หรือหากเรานำดาบมาเหนือแผ่นดินนั้น และสั่งว่า ‘ให้ดาบผ่านไปทั่วแผ่นดิน’ และตัดทั้งคนและสัตว์ออกจากแผ่นดินนั้น"},{"verse":18,"text":"แม้ชายสามคนนี้จะอยู่ในแผ่นดินนั้น เรามีชีวิตอยู่แน่ฉันใด องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้ พวกเขาจะช่วยบุตรชายหรือบุตรหญิงไม่ได้ พวกเขาจะรอดได้แต่ตัวเองเท่านั้น"},{"verse":19,"text":"หรือหากเราส่งโรคระบาดเข้ามาในแผ่นดินนั้น และระบายพระพิโรธของเราลงเหนือแผ่นดินนั้นด้วยการนองเลือด เพื่อตัดทั้งคนและสัตว์ออกไป"},{"verse":20,"text":"แม้โนอาห์ ดาเนียล และโยบ จะอยู่ในแผ่นดินนั้น เรามีชีวิตอยู่แน่ฉันใด องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้ พวกเขาจะช่วยบุตรชายหรือบุตรหญิงไม่ได้ พวกเขาจะช่วยได้แต่ชีวิตของตนเองด้วยความชอบธรรมของตน"},{"verse":21,"text":"เพราะองค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘ยิ่งกว่านั้นสักเท่าใด เมื่อเราส่งการพิพากษาอันรุนแรงทั้งสี่ของเรา คือดาบ การกันดารอาหาร สัตว์ร้าย และโรคระบาด ไปยังกรุงเยรูซาเล็ม เพื่อตัดทั้งคนและสัตว์ออกจากเมืองนั้น"},{"verse":22,"text":"แต่ดูเถิด จะมีผู้รอดชีวิตเหลืออยู่ในเมืองนั้น คือบุตรชายและบุตรหญิงที่จะถูกนำออกมา พวกเขาจะออกมาหาเจ้า และเมื่อเจ้าเห็นความประพฤติและการกระทำของพวกเขา เจ้าจะได้รับการปลอบใจเรื่องภัยพิบัติที่เราได้นำมาเหนือกรุงเยรูซาเล็ม คือทุกสิ่งที่เราได้นำมาเหนือเมืองนั้น"},{"verse":23,"text":"พวกเขาจะปลอบใจเจ้า เมื่อเจ้าเห็นความประพฤติและการกระทำของพวกเขา แล้วเจ้าจะรู้ว่าเราไม่ได้กระทำสิ่งทั้งปวงนี้ในเมืองนั้นโดยไร้เหตุ องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้”"}]},{"chapter":15,"verses":[{"verse":1,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าว่า"},{"verse":2,"text":"“บุตรแห่งมนุษย์เอ๋ย ไม้เถาองุ่นดีเด่นกว่าไม้อื่นใด คือกิ่งไม้ที่อยู่ท่ามกลางต้นไม้ในป่าอย่างไรหรือ"},{"verse":3,"text":"จะเอาไม้จากมันไปทำสิ่งที่ใช้การได้หรือ หรือจะเอาไปทำเป็นหมุดสำหรับแขวนภาชนะได้หรือ"},{"verse":4,"text":"ดูเถิด มันถูกโยนเข้าไฟเป็นเชื้อเพลิง ไฟก็เผาผลาญทั้งสองปลาย และตรงกลางก็ไหม้เกรียม มันจะใช้การได้หรือ"},{"verse":5,"text":"ดูเถิด แม้เมื่อยังอยู่ครบบริบูรณ์ มันก็ทำให้ใช้การไม่ได้อยู่แล้ว ยิ่งเมื่อไฟเผาผลาญจนไหม้เกรียมแล้ว จะใช้การได้น้อยยิ่งกว่านั้นสักเท่าใด"},{"verse":6,"text":"เพราะฉะนั้น องค์พระผู้เป็นเจ้าตรัสดังนี้ว่า ‘เหมือนไม้เถาองุ่นท่ามกลางต้นไม้ในป่า ซึ่งเราได้มอบให้เป็นเชื้อเพลิงแก่ไฟ เราก็จะมอบชาวกรุงเยรูซาเล็มเช่นนั้น"},{"verse":7,"text":"เราจะหันหน้าของเราเข้าต่อสู้พวกเขา แม้พวกเขาจะหนีรอดจากไฟไปได้ ไฟก็ยังจะเผาผลาญพวกเขา และเมื่อเราหันหน้าของเราเข้าต่อสู้พวกเขา เจ้าทั้งหลายจะรู้ว่าเราคือองค์พระผู้เป็นเจ้า"},{"verse":8,"text":"เราจะทำให้แผ่นดินนั้นเป็นที่ร้างเปล่า เพราะพวกเขาได้ทรยศ องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้’”"}]},{"chapter":16,"verses":[{"verse":1,"text":"พระวจนะขององค์พระผู้เป็นเจ้ามาถึงข้าพเจ้าอีกว่า"},{"verse":2,"text":"“บุตรแห่งมนุษย์เอ๋ย จงให้กรุงเยรูซาเล็มรู้ถึงสิ่งน่ารังเกียจของนาง"},{"verse":3,"text":"และจงกล่าวว่า องค์พระผู้เป็นเจ้าตรัสแก่กรุงเยรูซาเล็มดังนี้ว่า กำเนิดและการเกิดของเจ้าอยู่ในแผ่นดินคานาอัน บิดาของเจ้าเป็นคนอาโมไรต์ และมารดาของเจ้าเป็นคนฮิตไทต์"},{"verse":4,"text":"ในวันที่เจ้าเกิดมานั้น สายสะดือของเจ้าก็ไม่ได้ถูกตัด เจ้าไม่ได้ถูกล้างด้วยน้ำให้สะอาด ไม่ได้ถูกถูด้วยเกลือ และไม่ได้ถูกห่อด้วยผ้าเลย"},{"verse":5,"text":"ไม่มีตาใดสงสารเจ้าพอที่จะทำสิ่งเหล่านี้แก่เจ้าด้วยความเมตตาแม้แต่อย่างเดียว แต่เจ้ากลับถูกทิ้งไว้กลางทุ่งโล่ง เพราะในวันที่เจ้าเกิดมานั้น เจ้าเป็นที่รังเกียจ"},{"verse":6,"text":"เมื่อเราผ่านมาและเห็นเจ้าดิ้นรนอยู่ในกองเลือดของเจ้า เราก็พูดกับเจ้าขณะที่เจ้านอนอยู่ในเลือดของเจ้าว่า ‘จงมีชีวิตอยู่’ เราพูดกับเจ้าว่า ‘จงมีชีวิตอยู่’"},{"verse":7,"text":"เราทำให้เจ้าเจริญขึ้นดุจต้นไม้ในทุ่ง เจ้าก็เติบโตขึ้นจนเป็นสาวงาม ทรวงอกของเจ้าเต่งตึงและผมของเจ้างอกยาว แต่เจ้ายังเปลือยกายและล่อนจ้อนอยู่"},{"verse":8,"text":"เมื่อเราผ่านมาและเห็นเจ้าอีก ดูเถิด เจ้าถึงวัยที่จะมีความรักแล้ว เราจึงกางชายเสื้อของเราคลุมเจ้า ปกปิดความเปลือยเปล่าของเจ้า เราได้ปฏิญาณกับเจ้าและทำพันธสัญญากับเจ้า เจ้าจึงเป็นของเรา องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้"},{"verse":9,"text":"แล้วเราอาบน้ำให้เจ้า ล้างเลือดออกจากตัวเจ้า และชโลมเจ้าด้วยน้ำมัน"},{"verse":10,"text":"เราสวมเสื้อผ้าปักลายให้เจ้า สวมรองเท้าหนังอย่างดีให้เจ้า เราคาดเอวเจ้าด้วยผ้าลินินเนื้อดี และคลุมเจ้าด้วยผ้าไหม"},{"verse":11,"text":"เราประดับเจ้าด้วยเครื่องเพชรพลอย สวมกำไลที่ข้อมือของเจ้า และสวมสร้อยที่คอของเจ้า"},{"verse":12,"text":"เราใส่ห่วงที่จมูกของเจ้า ใส่ตุ้มหูที่หูของเจ้า และสวมมงกุฎงดงามบนศีรษะของเจ้า"},{"verse":13,"text":"เจ้าจึงได้ประดับด้วยทองคำและเงิน เสื้อผ้าของเจ้าทำด้วยผ้าลินินเนื้อดี ผ้าไหม และผ้าปักลาย เจ้ารับประทานแป้งละเอียด น้ำผึ้ง และน้ำมัน เจ้างามยิ่งนัก และเจริญขึ้นจนได้เป็นราชินี"},{"verse":14,"text":"ชื่อเสียงของเจ้าก็เลื่องลือไปท่ามกลางบรรดาประชาชาติเพราะความงามของเจ้า ด้วยความงามนั้นสมบูรณ์แบบโดยสง่าราศีที่เราได้ประทานแก่เจ้า องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้"},{"verse":15,"text":"แต่เจ้ากลับวางใจในความงามของเจ้า และอาศัยชื่อเสียงของเจ้าเล่นชู้ เจ้าปรนเปรอความใคร่ของเจ้าแก่ทุกคนที่ผ่านไปมา และความงามของเจ้าก็ตกเป็นของเขา"},{"verse":16,"text":"เจ้าเอาเสื้อผ้าของเจ้าบางส่วนไปทำสถานสูงหลากสีสำหรับตัวเจ้า แล้วเล่นชู้อยู่บนนั้น สิ่งเช่นนี้ไม่ควรเกิดขึ้นเลย และไม่ควรมีเลย"},{"verse":17,"text":"เจ้าเอาเครื่องเพชรพลอยอันงดงามที่ทำด้วยทองคำและเงินซึ่งเราให้แก่เจ้า ไปทำเป็นรูปเคารพรูปผู้ชาย แล้วเล่นชู้กับมัน"},{"verse":18,"text":"เจ้าเอาเสื้อผ้าปักลายของเจ้าไปคลุมรูปเคารพเหล่านั้น และตั้งน้ำมันกับเครื่องหอมของเราไว้ต่อหน้ามัน"},{"verse":19,"text":"ทั้งอาหารที่เราให้แก่เจ้า คือแป้งละเอียด น้ำมัน และน้ำผึ้งที่เราเลี้ยงเจ้า เจ้าก็เอาไปตั้งไว้ต่อหน้ามันเป็นกลิ่นหอมอันน่าพอใจ เรื่องนี้เป็นไปแล้ว องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้"},{"verse":20,"text":"ยิ่งกว่านั้น เจ้ายังเอาบุตรชายและบุตรหญิงที่เจ้าคลอดให้เราไปฆ่าบูชายัญแก่รูปเคารพเป็นอาหาร การเล่นชู้ของเจ้ายังน้อยไปอีกหรือ"},{"verse":21,"text":"เจ้าได้ฆ่าลูก ๆ ของเรา และมอบพวกเขาให้ลุยไฟถวายแก่รูปเคารพ"},{"verse":22,"text":"ในการกระทำอันน่ารังเกียจและการเล่นชู้ทั้งสิ้นของเจ้านั้น เจ้าไม่ได้ระลึกถึงวันเยาว์วัยของเจ้า เมื่อเจ้าเปลือยกายและล่อนจ้อน ดิ้นรนอยู่ในกองเลือดของเจ้าเลย"},{"verse":23,"text":"หลังจากความชั่วร้ายทั้งสิ้นของเจ้านี้ — วิบัติ วิบัติแก่เจ้า องค์พระผู้เป็นเจ้าตรัสไว้ดังนี้ —"},{"verse":24,"text":"เจ้าได้สร้างเนินบูชาสำหรับตัวเจ้า และทำแท่นสูงไว้ในทุกลานเมือง"},{"verse":25,"text":"เจ้าสร้างแท่นสูงของเจ้าไว้ที่หัวถนนทุกสาย ทำให้ความงามของเจ้าเป็นที่น่ารังเกียจ และแยกขาของเจ้าให้แก่ทุกคนที่ผ่านไปมา ทวีการเล่นชู้ของเจ้าให้มากขึ้น"},{"verse":26,"text":"เจ้าเล่นชู้กับชาวอียิปต์เพื่อนบ้านของเจ้าที่มากด้วยราคะ และทวีการเล่นชู้ของเจ้ามากขึ้นเพื่อยั่วยุเราให้โกรธ"},{"verse":27,"text":"เพราะฉะนั้น เราจึงเหยียดมือของเราออกต่อสู้เจ้า ลดส่วนแบ่งของเจ้าลง และมอบเจ้าไว้กับความปรารถนาของผู้ที่เกลียดชังเจ้า คือบรรดาบุตรหญิงของฟีลิสเตีย ผู้ละอายต่อความประพฤติลามกของเจ้า"},{"verse":28,"text":"เจ้ายังเล่นชู้กับชาวอัสซีเรียอีก เพราะเจ้าไม่เคยรู้จักพอ เจ้าเล่นชู้