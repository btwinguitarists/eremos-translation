ับโยยาริบและเอลนาธันผู้เป็นครู"},{"verse":17,"text":"แล้วส่งพวกเขาไปหาอิดโดหัวหน้าที่เมืองคาสิเฟีย ข้าพเจ้าฝากถ้อยคำให้ไปพูดกับอิดโดและพี่น้องผู้รับใช้ประจำพระวิหารที่คาสิเฟีย ให้นำผู้ปรนนิบัติมายังเราสำหรับพระนิเวศของพระเจ้าของเรา"},{"verse":18,"text":"เพราะพระหัตถ์อันเปี่ยมด้วยพระกรุณาของพระเจ้าของเราอยู่เหนือเรา พวกเขาจึงนำเชเรบิยาห์ผู้มีความเข้าใจ จากลูกหลานของมาห์ลีบุตรเลวีบุตรอิสราเอล มาให้เรา พร้อมกับบุตรและพี่น้องของเขารวม 18 คน"},{"verse":19,"text":"และฮาชาบิยาห์ พร้อมกับเยชายาห์จากลูกหลานของเมรารี กับพี่น้องและบุตรของพวกเขารวม 20 คน"},{"verse":20,"text":"และจากผู้รับใช้ประจำพระวิหารที่ดาวิดและบรรดาขุนนางตั้งไว้ให้ช่วยงานคนเลวี มีผู้รับใช้ประจำพระวิหาร 220 คน ทุกคนระบุชื่อไว้"},{"verse":21,"text":"ที่ลำคลองอาหะวานั้น ข้าพเจ้าประกาศให้ถืออดอาหาร เพื่อเราจะถ่อมตัวลงต่อพระพักตร์พระเจ้าของเรา และทูลขอการเดินทางที่ปลอดภัยสำหรับเรา บุตรหลานของเรา และทรัพย์สินทั้งสิ้นของเรา"},{"verse":22,"text":"เพราะข้าพเจ้าละอายที่จะขอกองทหารและพลม้าจากกษัตริย์เพื่อคุ้มกันเราจากศัตรูระหว่างทาง ในเมื่อเราได้ทูลกษัตริย์ไว้ว่า “พระหัตถ์ของพระเจ้าของเราเป็นคุณแก่ทุกคนที่แสวงหาพระองค์ แต่ฤทธานุภาพและพระพิโรธของพระองค์ต่อสู้ทุกคนที่ละทิ้งพระองค์”"},{"verse":23,"text":"เราจึงอดอาหารและทูลขอต่อพระเจ้าในเรื่องนี้ และพระเจ้าก็ทรงสดับคำวิงวอนของเรา"},{"verse":24,"text":"แล้วข้าพเจ้าได้แยกหัวหน้าปุโรหิตสิบสองคนไว้ คือเชเรบิยาห์ ฮาชาบิยาห์ และพี่น้องของพวกเขาอีกสิบคน"},{"verse":25,"text":"และข้าพเจ้าชั่งเงิน ทอง และภาชนะ คือของถวายสำหรับพระนิเวศของพระเจ้าของเรา ที่กษัตริย์ ที่ปรึกษา ขุนนาง และอิสราเอลทั้งปวงที่อยู่ที่นั่นได้ถวาย มอบให้แก่พวกเขา"},{"verse":26,"text":"ข้าพเจ้าชั่งมอบใส่มือของพวกเขา เป็นเงินหกร้อยห้าสิบตะลันต์ ภาชนะเงินหนักหนึ่งร้อยตะลันต์ ทองหนึ่งร้อยตะลันต์"},{"verse":27,"text":"ชามทองยี่สิบใบ มูลค่าหนึ่งพันดาริค และภาชนะทองสัมฤทธิ์เนื้อดีขัดเงาสองใบ ล้ำค่าดุจทองคำ"},{"verse":28,"text":"แล้วข้าพเจ้ากล่าวแก่พวกเขาว่า “ท่านทั้งหลายเป็นผู้บริสุทธิ์แด่องค์พระผู้เป็นเจ้า และภาชนะเหล่านี้ก็บริสุทธิ์ ส่วนเงินและทองเป็นของถวายด้วยใจสมัครแด่องค์พระผู้เป็นเจ้าพระเจ้าของบรรพบุรุษของท่าน"},{"verse":29,"text":"จงเฝ้าระวังรักษาไว้ให้ดี จนกว่าท่านจะชั่งมอบต่อหน้าหัวหน้าปุโรหิต คนเลวี และหัวหน้าตระกูลของอิสราเอลในเยรูซาเล็ม ในห้องคลังแห่งพระนิเวศขององค์พระผู้เป็นเจ้า”"},{"verse":30,"text":"บรรดาปุโรหิตและคนเลวีจึงรับเงิน ทอง และภาชนะที่ชั่งไว้นั้น เพื่อนำไปยังเยรูซาเล็มสู่พระนิเวศของพระเจ้าของเรา"},{"verse":31,"text":"เราออกเดินทางจากลำคลองอาหะวาในวันที่สิบสองของเดือนที่หนึ่ง เพื่อไปยังเยรูซาเล็ม และพระหัตถ์ของพระเจ้าของเราอยู่เหนือเรา คอยปกป้องเราให้พ้นจากเงื้อมมือของศัตรูและผู้ซุ่มดักระหว่างทาง"},{"verse":32,"text":"เรามาถึงเยรูซาเล็มและพักอยู่ที่นั่นสามวัน"},{"verse":33,"text":"ในวันที่สี่ เราได้ชั่งเงิน ทอง และภาชนะในพระนิเวศของพระเจ้าของเรา มอบใส่มือของเมเรโมทบุตรอุรียาห์ปุโรหิต พร้อมกับเอเลอาซาร์บุตรฟีเนหัส และคนเลวีคือโยซาบาดบุตรเยชูอา กับโนอัดยาห์บุตรบินนุย"},{"verse":34,"text":"ทุกสิ่งครบถ้วนตามจำนวนและน้ำหนัก และได้บันทึกน้ำหนักทั้งหมดไว้ในเวลานั้น"},{"verse":35,"text":"เหล่าเชลยที่กลับมาจากการเป็นเชลยก็ถวายเครื่องเผาบูชาแด่พระเจ้าแห่งอิสราเอล คือวัวผู้สิบสองตัวสำหรับอิสราเอลทั้งหมด แกะผู้เก้าสิบหกตัว ลูกแกะเจ็ดสิบเจ็ดตัว และแพะผู้สิบสองตัวเป็นเครื่องบูชาไถ่บาป ทั้งหมดนี้เป็นเครื่องเผาบูชาแด่องค์พระผู้เป็นเจ้า"},{"verse":36,"text":"พวกเขายังมอบพระราชโองการของกษัตริย์แก่บรรดาสมุหเทศาภิบาลและข้าหลวงในแคว้นฟากตะวันตกของแม่น้ำ คนเหล่านั้นก็ให้การสนับสนุนแก่ประชาชนและพระนิเวศของพระเจ้า"}]},{"chapter":9,"verses":[{"verse":1,"text":"หลังจากสิ่งเหล่านี้สำเร็จแล้ว บรรดาผู้นำก็มาหาข้าพเจ้า กล่าวว่า “ประชาชนอิสราเอล รวมทั้งปุโรหิตและคนเลวี ไม่ได้แยกตัวออกจากชนชาติต่างๆ ในแผ่นดิน ซึ่งมีการกระทำอันน่าสะอิดสะเอียนเหมือนอย่างคนคานาอัน คนฮิตไทต์ คนเปริสซี คนเยบุส คนอัมโมน คนโมอับ คนอียิปต์ และคนอาโมไรต์"},{"verse":2,"text":"เพราะพวกเขาได้รับบุตรสาวของชนเหล่านั้นมาเป็นภรรยาของตนและของบุตรชายตน เชื้อสายบริสุทธิ์จึงปะปนกับชนชาติต่างๆ ในแผ่นดิน และบรรดาผู้นำกับขุนนางก็เป็นตัวตั้งตัวตีในการทรยศนี้”"},{"verse":3,"text":"เมื่อข้าพเจ้าได้ยินเรื่องนี้ ข้าพเจ้าก็ฉีกเสื้อและเสื้อคลุมของตน ทึ้งผมจากศีรษะและเครา แล้วนั่งลงด้วยความตกตะลึง"},{"verse":4,"text":"ทุกคนที่เกรงกลัวยำเกรงต่อพระวจนะของพระเจ้าแห่งอิสราเอลก็มาชุมนุมรอบข้าพเจ้า เพราะการทรยศของพวกเชลย ส่วนข้าพเจ้านั่งตะลึงอยู่จนถึงเวลาถวายเครื่องบูชาตอนเย็น"},{"verse":5,"text":"เมื่อถึงเวลาถวายเครื่องบูชาตอนเย็น ข้าพเจ้าก็ลุกขึ้นจากการถ่อมตัว ทั้งที่เสื้อและเสื้อคลุมยังฉีกอยู่ แล้วคุกเข่าลงชูมือขึ้นต่อองค์พระผู้เป็นเจ้าพระเจ้าของข้าพเจ้า"},{"verse":6,"text":"ทูลว่า “ข้าแต่พระเจ้าของข้าพระองค์ ข้าพระองค์อับอายและละอายใจที่จะเงยหน้าขึ้นต่อพระองค์ พระเจ้าของข้าพระองค์ เพราะความชั่วช้าของเราท่วมท้นเหนือศีรษะ และความผิดของเราใหญ่หลวงขึ้นไปถึงฟ้าสวรรค์"},{"verse":7,"text":"ตั้งแต่สมัยบรรพบุรุษของเราจนถึงทุกวันนี้ เรามีความผิดใหญ่หลวง และเพราะความชั่วของเรา เราพร้อมทั้งกษัตริย์และปุโรหิตของเราจึงถูกมอบไว้ในมือของบรรดากษัตริย์แห่งแผ่นดินทั้งหลาย ต้องเผชิญดาบ การเป็นเชลย การถูกปล้น และความอัปยศ ดังเช่นทุกวันนี้"},{"verse":8,"text":"แต่บัดนี้ ชั่วครู่หนึ่ง พระกรุณาได้มาจากองค์พระผู้เป็นเจ้าพระเจ้าของเรา เพื่อให้เรามีคนที่เหลือรอด และประทานที่ยึดเหนี่ยวมั่นคงแก่เราในสถานบริสุทธิ์ของพระองค์ ทำให้ตาของเราสว่างขึ้น ข้าแต่พระเจ้าของเรา และทรงให้เราได้รับการฟื้นชีวิตเล็กน้อยในยามเป็นทาส"},{"verse":9,"text":"เพราะเราเป็นทาส แต่ในยามเป็นทาสนั้น พระเจ้าของเราก็ไม่ทรงทอดทิ้งเรา พระองค์ทรงสำแดงความรักมั่นคงต่อเราต่อหน้าบรรดากษัตริย์แห่งเปอร์เซีย ประทานการฟื้นชีวิตแก่เราเพื่อสร้างพระนิเวศของพระเจ้าของเราขึ้น ซ่อมแซมส่วนที่ปรักหักพัง และประทานกำแพงคุ้มภัยแก่เราในยูดาห์และเยรูซาเล็ม"},{"verse":10,"text":"บัดนี้ ข้าแต่พระเจ้าของเรา เราจะทูลอะไรได้อีกหลังจากเหตุการณ์นี้? เพราะเราได้ละทิ้งพระบัญญัติของพระองค์"},{"verse":11,"text":"ซึ่งพระองค์ทรงบัญชาผ่านบรรดาผู้เผยพระวจนะผู้รับใช้ของพระองค์ว่า ‘แผ่นดินที่เจ้าทั้งหลายกำลังจะเข้าไปยึดครองนั้น เป็นแผ่นดินที่เป็นมลทินด้วยความโสโครกของชนชาติต่างๆ ในแผ่นดิน ด้วยการกระทำอันน่าสะอิดสะเอียนที่ทำให้แผ่นดินเต็มไปด้วยมลทินจากปลายด้านหนึ่งจรดอีกด้านหนึ่ง"},{"verse":12,"text":"เพราะฉะนั้น อย่ายกบุตรสาวของเจ้าให้แก่บุตรชายของเขา และอย่ารับบุตรสาวของเขามาให้บุตรชายของเจ้า อย่าแสวงหาสันติสุขหรือความเจริญของพวกเขาเลยตลอดไป เพื่อเจ้าจะเข้มแข็ง ได้กินผลดีของแผ่นดิน และมอบเป็นมรดกแก่บุตรหลานของเจ้าสืบไปเป็นนิตย์’"},{"verse":13,"text":"หลังจากสิ่งทั้งปวงที่เกิดแก่เราเพราะการกระทำชั่วและความผิดใหญ่หลวงของเรา ทั้งที่พระองค์พระเจ้าของเราทรงลงโทษเราน้อยกว่าที่ความชั่วของเราสมควรได้รับ และทรงให้เรามีคนที่เหลือรอดเช่นนี้"},{"verse":14,"text":"เราควรจะกลับไปละเมิดพระบัญญัติของพระองค์ และแต่งงานกับชนชาติที่ทำสิ่งน่าสะอิดสะเอียนเหล่านี้อีกหรือ? พระองค์จะไม่ทรงพระพิโรธต่อเราจนทำลายเราเสียสิ้น ไม่เหลือผู้รอดชีวิตสักคนหรือ?"},{"verse":15,"text":"ข้าแต่องค์พระผู้เป็นเจ้าพระเจ้าแห่งอิสราเอล พระองค์ทรงชอบธรรม เพราะวันนี้เราเหลืออยู่เป็นคนที่รอด ดูเถิด เราอยู่ต่อพระพักตร์พระองค์ในความผิดของเรา แม้ว่าเพราะเหตุนี้ไม่มีผู้ใดยืนอยู่ต่อพระพักตร์พระองค์ได้”"}]},{"chapter":10,"verses":[{"verse":1,"text":"ขณะที่เอสรากำลังอธิษฐานและสารภาพบาป ร้องไห้และหมอบกราบลงต่อหน้าพระนิเวศของพระเจ้า ชนอิสราเอลกลุ่มใหญ่มาก ทั้งชาย หญิง และเด็ก ก็มาชุมนุมรอบท่าน เพราะประชาชนต่างร้องไห้อย่างขมขื่น"},{"verse":2,"text":"แล้วเชคานิยาห์บุตรเยฮีเอล จากลูกหลานของเอลาม ก็กล่าวแก่เอสราว่า “เราได้ทรยศต่อพระเจ้าของเรา โดยรับหญิงต่างชาติจากชนชาติในแผ่นดินนี้มาเป็นภรรยา แต่ถึงกระนั้น ก็ยังมีความหวังสำหรับอิสราเอลในเรื่องนี้"},{"verse":3,"text":"บัดนี้ ให้เราทำพันธสัญญาต่อพระเจ้าของเราที่จะส่งบรรดาภรรยาและลูกที่เกิดจากนางเหล่านั้นกลับไป ตามคำปรึกษาของนายข้าพเจ้าและของบรรดาผู้ที่เกรงกลัวต่อพระบัญญัติของพระเจ้าของเรา และให้กระทำตามธรรมบัญญัติ"},{"verse":4,"text":"จงลุกขึ้นเถิด เพราะเรื่องนี้เป็นหน้าที่ของท่าน และเราจะอยู่เคียงข้างท่าน จงเข้มแข็งและลงมือทำเถิด”"},{"verse":5,"text":"เอสราจึงลุกขึ้น ให้บรรดาหัวหน้าปุโรหิต คนเลวี และอิสราเอลทั้งปวงปฏิญาณว่าจะทำตามที่กล่าวนี้ และพวกเขาก็ปฏิญาณ"},{"verse":6,"text":"แล้วเอสราก็ลุกขึ้นจากหน้าพระนิเวศของพระเจ้า ไปยังห้องของเยโฮฮานันบุตรเอลียาชีบ ขณะที่อยู่ที่นั่น ท่านไม่ได้กินอาหารหรือดื่มน้ำเลย เพราะท่านโศกเศร้าเรื่องการทรยศของพวกเชลย"},{"verse":7,"text":"และมีการประกาศไปทั่วยูดาห์และเยรูซาเล็ม ให้เชลยทั้งปวงที่กลับมามาชุมนุมที่เยรูซาเล็ม"},{"verse":8,"text":"ผู้ใดไม่มาภายในสามวัน ตามคำสั่งของบรรดาผู้นำและผู้อาวุโส ทรัพย์สินทั้งหมดของเขาจะถูกริบ และ