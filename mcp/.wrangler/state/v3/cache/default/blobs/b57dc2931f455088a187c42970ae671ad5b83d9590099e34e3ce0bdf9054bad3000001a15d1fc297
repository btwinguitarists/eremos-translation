กณฑ์ของพระองค์แก่ข้าพระองค์"},{"verse":172,"text":"ลิ้นของข้าพระองค์จะร้องเพลงถึงพระวจนะของพระองค์ เพราะพระบัญญัติทั้งสิ้นของพระองค์ชอบธรรม"},{"verse":173,"text":"ขอให้พระหัตถ์ของพระองค์พร้อมที่จะช่วยข้าพระองค์ เพราะข้าพระองค์ได้เลือกข้อบังคับของพระองค์"},{"verse":174,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ข้าพระองค์ปรารถนาความรอดของพระองค์ และธรรมบัญญัติของพระองค์เป็นความปีติยินดีของข้าพระองค์"},{"verse":175,"text":"ขอให้ข้าพระองค์มีชีวิตอยู่เพื่อจะสรรเสริญพระองค์ และขอให้ข้อตัดสินของพระองค์ค้ำจุนข้าพระองค์"},{"verse":176,"text":"ข้าพระองค์หลงเจิ่นไปเหมือนแกะที่หลงทาง ขอทรงตามหาผู้รับใช้ของพระองค์ เพราะข้าพระองค์ไม่ลืมพระบัญญัติของพระองค์"}]},{"chapter":120,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น ในยามทุกข์ใจ ข้าพระองค์ร้องทูลต่อองค์พระผู้เป็นเจ้า และพระองค์ทรงตอบข้าพระองค์"},{"verse":2,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงช่วยชีวิตของข้าพระองค์ให้พ้นจากริมฝีปากที่โกหกและลิ้นที่หลอกลวง"},{"verse":3,"text":"ลิ้นที่หลอกลวงเอ๋ย พระองค์จะทรงทำสิ่งใดแก่เจ้า และจะทรงเพิ่มสิ่งใดแก่เจ้า"},{"verse":4,"text":"ก็คือลูกธนูอันแหลมคมของนักรบ พร้อมกับถ่านไม้ซากที่ลุกโชน"},{"verse":5,"text":"วิบัติแก่ข้าพระองค์ที่ต้องอาศัยอยู่ในเมเชค ที่ต้องอยู่ท่ามกลางเต็นท์ของเคดาร์"},{"verse":6,"text":"ข้าพระองค์อยู่ท่ามกลางผู้ที่เกลียดชังสันติภาพมานานเกินไปแล้ว"},{"verse":7,"text":"ข้าพระองค์อยู่ฝ่ายสันติภาพ แต่เมื่อข้าพระองค์พูด พวกเขากลับต้องการสงคราม"}]},{"chapter":121,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น ข้าพเจ้าเงยหน้าขึ้นมองไปยังภูเขาทั้งหลาย ความช่วยเหลือของข้าพเจ้าจะมาจากที่ใด"},{"verse":2,"text":"ความช่วยเหลือของข้าพเจ้ามาจากองค์พระผู้เป็นเจ้า ผู้ทรงสร้างฟ้าสวรรค์และแผ่นดินโลก"},{"verse":3,"text":"พระองค์จะไม่ทรงให้เท้าของท่านพลาด ผู้พิทักษ์ของท่านจะไม่ทรงงีบหลับ"},{"verse":4,"text":"ดูเถิด ผู้พิทักษ์แห่งอิสราเอลจะไม่ทรงงีบหลับหรือบรรทมเลย"},{"verse":5,"text":"องค์พระผู้เป็นเจ้าทรงเป็นผู้พิทักษ์ของท่าน องค์พระผู้เป็นเจ้าทรงเป็นร่มเงาที่อยู่เบื้องขวาของท่าน"},{"verse":6,"text":"ดวงอาทิตย์จะไม่แผดเผาท่านในเวลากลางวัน หรือดวงจันทร์ในเวลากลางคืน"},{"verse":7,"text":"องค์พระผู้เป็นเจ้าจะทรงปกป้องท่านจากความชั่วร้ายทั้งสิ้น พระองค์จะทรงพิทักษ์ชีวิตของท่าน"},{"verse":8,"text":"องค์พระผู้เป็นเจ้าจะทรงพิทักษ์การออกไปและการเข้ามาของท่าน ตั้งแต่บัดนี้จนชั่วนิรันดร์"}]},{"chapter":122,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้นของดาวิด ข้าพเจ้าดีใจเมื่อมีผู้กล่าวแก่ข้าพเจ้าว่า ‘ให้เราขึ้นไปยังพระนิเวศขององค์พระผู้เป็นเจ้า’"},{"verse":2,"text":"เท้าของเราทั้งหลายกำลังยืนอยู่ภายในประตูเมืองของเจ้า กรุงเยรูซาเล็มเอ๋ย"},{"verse":3,"text":"กรุงเยรูซาเล็มถูกสร้างขึ้นเป็นนครที่เป็นปึกแผ่นเดียวกัน"},{"verse":4,"text":"เป็นที่ซึ่งบรรดาเผ่าขึ้นไป คือเผ่าทั้งหลายขององค์พระผู้เป็นเจ้า ตามที่ทรงกำหนดให้อิสราเอลทำ เพื่อขอบพระคุณพระนามขององค์พระผู้เป็นเจ้า"},{"verse":5,"text":"เพราะที่นั่นมีบัลลังก์แห่งการพิพากษาตั้งอยู่ คือบัลลังก์แห่งราชวงศ์ดาวิด"},{"verse":6,"text":"จงอธิษฐานขอสันติสุขให้แก่กรุงเยรูซาเล็มว่า ‘ขอให้บรรดาผู้ที่รักเจ้าเจริญรุ่งเรือง"},{"verse":7,"text":"ขอให้มีสันติสุขภายในกำแพงของเจ้า และมีความเจริญรุ่งเรืองภายในป้อมปราการของเจ้า’"},{"verse":8,"text":"เพื่อเห็นแก่พี่น้องและมิตรสหายของข้าพเจ้า ข้าพเจ้าจะกล่าวว่า ‘ขอสันติสุขจงมีอยู่ภายในเจ้า’"},{"verse":9,"text":"เพื่อเห็นแก่พระนิเวศขององค์พระผู้เป็นเจ้าพระเจ้าของเรา ข้าพเจ้าจะแสวงหาความเจริญรุ่งเรืองให้แก่เจ้า"}]},{"chapter":123,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น ข้าพระองค์เงยตาขึ้นมองดูพระองค์ ผู้ประทับบนบัลลังก์ในฟ้าสวรรค์"},{"verse":2,"text":"ดวงตาของคนรับใช้จับจ้องที่มือของนายฉันใด และดวงตาของหญิงรับใช้จับจ้องที่มือของนายหญิงฉันใด ดวงตาของข้าพระองค์ทั้งหลายก็จับจ้องที่องค์พระผู้เป็นเจ้าพระเจ้าของข้าพระองค์ทั้งหลายฉันนั้น จนกว่าพระองค์จะทรงเมตตาข้าพระองค์ทั้งหลาย"},{"verse":3,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงเมตตาข้าพระองค์ทั้งหลาย ขอทรงเมตตาเถิด เพราะข้าพระองค์ทั้งหลายได้ทนรับการดูหมิ่นมามากแล้ว"},{"verse":4,"text":"ข้าพระองค์ทั้งหลายได้ทนรับการเยาะเย้ยจากคนที่หยิ่งผยอง และการดูหมิ่นจากคนที่จองหองมามากแล้ว"}]},{"chapter":124,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้นของดาวิด หากองค์พระผู้เป็นเจ้าไม่ได้ทรงอยู่ฝ่ายเรา ขอให้อิสราเอลกล่าวเถิด"},{"verse":2,"text":"หากองค์พระผู้เป็นเจ้าไม่ได้ทรงอยู่ฝ่ายเรา เมื่อคนทั้งหลายลุกขึ้นโจมตีเรา"},{"verse":3,"text":"เมื่อความโกรธของพวกเขาพลุ่งขึ้นต่อเรา พวกเขาก็คงได้กลืนเราทั้งเป็นไปแล้ว"},{"verse":4,"text":"แล้วน้ำก็คงได้ท่วมเรา กระแสน้ำก็คงได้ท่วมมิดเราไปแล้ว"},{"verse":5,"text":"แล้วน้ำที่เชี่ยวกรากก็คงได้พัดพาเราไปแล้ว"},{"verse":6,"text":"สาธุการแด่องค์พระผู้เป็นเจ้า ผู้ไม่ทรงปล่อยให้เราเป็นเหยื่อของฟันพวกเขา"},{"verse":7,"text":"เราได้หนีรอดมาเหมือนนกที่หลุดจากกับดักของนายพราน กับดักนั้นขาด และเราก็หนีรอดมาได้"},{"verse":8,"text":"ความช่วยเหลือของเราอยู่ในพระนามขององค์พระผู้เป็นเจ้า ผู้ทรงสร้างฟ้าสวรรค์และแผ่นดินโลก"}]},{"chapter":125,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น บรรดาผู้ที่วางใจในองค์พระผู้เป็นเจ้าก็เป็นเหมือนภูเขาศิโยน ซึ่งไม่หวั่นไหว แต่ดำรงอยู่เป็นนิตย์"},{"verse":2,"text":"ภูเขาทั้งหลายล้อมรอบเยรูซาเล็มฉันใด องค์พระผู้เป็นเจ้าก็ทรงล้อมรอบประชากรของพระองค์ฉันนั้น ตั้งแต่บัดนี้สืบไปเป็นนิตย์"},{"verse":3,"text":"เพราะคทาของคนชั่วจะไม่คงอยู่เหนือดินแดนที่ตกเป็นมรดกของคนชอบธรรม เพื่อว่าคนชอบธรรมจะไม่ยื่นมือของตนออกไปทำการอยุติธรรม"},{"verse":4,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงกระทำดีต่อคนที่ดี และต่อผู้ที่มีใจเที่ยงธรรม"},{"verse":5,"text":"แต่บรรดาผู้ที่หันไปสู่ทางคดเคี้ยว องค์พระผู้เป็นเจ้าจะทรงขับไล่พวกเขาไปพร้อมกับคนที่ทำชั่ว ขอสันติสุขจงมีแก่อิสราเอล"}]},{"chapter":126,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น เมื่อองค์พระผู้เป็นเจ้าทรงนำเชลยศิโยนกลับคืนมา เราก็เป็นเหมือนคนที่ฝันไป"},{"verse":2,"text":"แล้วปากของเราก็เต็มไปด้วยเสียงหัวเราะ และลิ้นของเราก็เต็มไปด้วยเสียงโห่ร้องยินดี แล้วมีคำกล่าวท่ามกลางบรรดาประชาชาติว่า ‘องค์พระผู้เป็นเจ้าได้ทรงกระทำการยิ่งใหญ่เพื่อพวกเขา’"},{"verse":3,"text":"องค์พระผู้เป็นเจ้าได้ทรงกระทำการยิ่งใหญ่เพื่อเรา เราจึงเปี่ยมด้วยความยินดี"},{"verse":4,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงนำเชลยของข้าพระองค์ทั้งหลายกลับคืนมา ดุจธารน้ำในเนเกบ"},{"verse":5,"text":"บรรดาผู้ที่หว่านด้วยน้ำตา จะเก็บเกี่ยวด้วยเสียงโห่ร้องยินดี"},{"verse":6,"text":"ผู้ที่ออกไปพลางร้องไห้พลาง หอบเมล็ดพืชไปหว่าน จะกลับมาด้วยเสียงโห่ร้องยินดีอย่างแน่นอน นำฟ่อนข้าวของเขากลับมาด้วย"}]},{"chapter":127,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้นของซาโลมอน หากองค์พระผู้เป็นเจ้าไม่ได้ทรงสร้างบ้าน บรรดาผู้ที่สร้างก็เหนื่อยเปล่า หากองค์พระผู้เป็นเจ้าไม่ได้ทรงเฝ้ารักษาเมือง ยามที่เฝ้าอยู่ก็ตื่นเฝ้าเปล่า"},{"verse":2,"text":"เป็นการเปล่าประโยชน์ที่ท่านลุกขึ้นแต่เช้าตรู่และนอนดึก ตรากตรำเพื่อหาอาหารกิน เพราะพระองค์ประทานการหลับสนิทแก่ผู้ที่พระองค์ทรงรัก"},{"verse":3,"text":"ดูเถิด บุตรทั้งหลายเป็นมรดกจากองค์พระผู้เป็นเจ้า และผลแห่งครรภ์ก็เป็นบำเหน็จจากพระองค์"},{"verse":4,"text":"บุตรที่เกิดในวัยหนุ่มก็เป็นเหมือนลูกธนูในมือของนักรบ"},{"verse":5,"text":"ความสุขเป็นของชายผู้มีลูกธนูเต็มแล่งของตน เขาจะไม่ต้องอับอาย เมื่อเขาโต้ตอบกับศัตรูที่ประตูเมือง"}]},{"chapter":128,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น ความสุขเป็นของทุกคนที่ยำเกรงองค์พระผู้เป็นเจ้า ผู้ดำเนินในทางของพระองค์"},{"verse":2,"text":"เมื่อท่านได้กินผลจากน้ำพักน้ำแรงของท่าน ท่านก็จะเป็นสุขและจะอยู่เย็นเป็นสุข"},{"verse":3,"text":"ภรรยาของท่านจะเป็นเหมือนเถาองุ่นที่ออกผลดกอยู่ภายในบ้านของท่าน บุตรชายทั้งหลายของท่านจะเป็นเหมือนหน่อมะกอกล้อมรอบโต๊ะของท่าน"},{"verse":4,"text":"ดูเถิด ชายผู้ยำเกรงองค์พระผู้เป็นเจ้าก็จะได้รับพระพรเช่นนี้แหละ"},{"verse":5,"text":"ขอองค์พระผู้เป็นเจ้าทรงอวยพรท่านจากศิโยน ขอให้ท่านได้เห็นความเจริญรุ่งเรืองของเยรูซาเล็มตลอดวันคืนแห่งชีวิตของท่าน"},{"verse":6,"text":"และขอให้ท่านได้เห็นลูกหลานของท่าน ขอสันติสุขจงมีแก่อิสราเอล"}]},{"chapter":129,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น ‘เขาทั้งหลายได้ข่มเหงข้าพเจ้าหลายครั้งหลายหนตั้งแต่เยาว์วัย’ ขอให้อิสราเอลกล่าวเถิด"},{"verse":2,"text":"‘เขาทั้งหลายได้ข่มเหงข้าพเจ้าหลายครั้งหลายหนตั้งแต่เยาว์วัย แต่เขาก็เอาชนะข้าพเจ้าไม่ได้’"},{"verse":3,"text":"คนที่ไถนาได้ไถบนหลังของข้าพเจ้า เขาทำรอยไถให้ยาว"},{"verse":4,"text":"องค์พระผู้เป็นเจ้าทรงชอบธรรม พระองค์ทรงตัดเชือกของคนชั่วให้ขาด ปลดปล่อยข้าพเจ้าให้เป็นอิสระ"},{"verse":5,"text":"ขอให้บรรดาผู้ที่เกลียดชังศิโยนต้องอับอายและล่าถอยไป"},{"verse":6,"text":"ขอให้เขาเป็นเหมือนหญ้าบนหลังคา ซึ่งเหี่ยวแห้งไปก่อนที่มันจะงอกงาม"},{"verse":7,"text":"ซึ่งไม่อาจทำให้มือของผู้เกี่ยวเต็มได้ หรือทำให้อ้อมแขนของผู้มัดฟ่อนข้าวเต็มได้"},{"verse":8,"text":"และขออย่าให้ผู้ที่ผ่านไปมากล่าวว่า ‘ขอพระพรขององค์พระผู้เป็นเจ้าจงมีแก่ท่าน เราอวยพรท่านในพระนามขององค์พระผู้เป็นเจ้า’"}]},{"chapter":130,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น ข้าแต่องค์พระผู้เป็นเจ้า ข้าพระองค์ร้องทูลต่อพระองค์จากห้วงลึก"},{"verse":2,"text":"ข้าแต่องค์เจ้านาย ขอทรงสดับฟังเสียงของข้าพระองค์ ขอทรงเงี่ยพระกรรณสดับฟังเสียงคำวิงวอนขอความเมตตาของข้าพระองค์"},{"verse":3,"text":"ข้าแต่องค์พระผู้เป็นเจ้า หากพระองค์จะทรงจดจำความชั่วช้าทั้งหลายไว้ ข้าแต่องค์เจ้านาย ผู้ใดเล่าจะยืนอยู่ได้"},{"verse":4,"text":"แต่ที่พระองค์ทรงมีการอภัยโทษนั้น ก็เพื่อให้พระองค์ทรงเป็นที่ยำเกรง"},{"verse":5,"text":"ข้าพเจ้ารอคอยองค์พระผู้เป็นเจ้า จิตวิญญาณของข้าพเจ้ารอคอย และข้าพเจ้าหวังใจในพระวจนะของพระองค์"},{"verse":6,"text":"จิตวิญญาณของข้าพเจ้ารอคอยองค์เจ้านาย ยิ่งกว่ายามที่คอยเฝ้ารุ่งอรุณ ยิ่งกว่ายามที่คอยเฝ้ารุ่งอรุณ"},{"verse":7,"text":"อิสราเอลเอ๋ย จงหวังใจในองค์พระผู้เป็นเจ้า เพราะความรักมั่นคงอยู่ที่องค์พระผู้เป็นเจ้า และการไถ่อันบริบูรณ์ก็อยู่กับพระองค์"},{"verse":8,"text":"และพระองค์เองจะทรงไถ่อิสราเอลจากความชั่วช้าทั้งสิ้นของเขา"}]},{"chapter":131,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้นของดาวิด ข้าแต่องค์พระผู้เป็นเจ้า ใจของข้าพระองค์ไม่ได้หยิ่งผยอง และนัยน์ตาของข้าพระองค์ก็ไม่ได้ทะนงตน ข้าพระองค์ไม่ได้ฝักใฝ่ในเรื่องที่ใหญ่โต หรือเรื่องที่สูงเกินตัวข้าพระองค์"},{"verse":2,"text":"แท้จริง ข้าพระองค์ได้สงบและระงับจิตใจของข้าพระองค์แล้ว เหมือนเด็กที่หย่านมแล้วซึ่งสงบอยู่กับมารดาของตน จิตใจของข้าพระองค์ในตัวข้าพระองค์ก็เป็นเหมือนเด็กที่หย่านมแล้ว"},{"verse":3,"text":"อิสราเอลเอ๋ย จงหวังใจในองค์พระผู้เป็นเจ้า ตั้งแต่บัดนี้สืบไปเป็นนิตย์"}]},{"chapter":132,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงระลึกถึงดาวิด และความทุกข์ยากทั้งสิ้นที่เขาได้ทนรับ"},{"verse":2,"text":"ว่าเขาได้ปฏิญาณต่อองค์พระผู้เป็นเจ้าอย่างไร และได้สาบานต่อองค์ผู้ทรงอานุภาพแห่งยาโคบว่า"},{"verse":3,"text":"‘ข้าพเจ้าจะไม่เข้าไปในบ้านของข้าพเจ้า หรือขึ้นไปนอนบนเตียงของข้าพเจ้า"},{"verse":4,"text":"ข้าพเจ้าจะไม่ให้ดวงตาของข้าพเจ้าได้หลับ หรือให้หนังตาของข้าพเจ้าได้งีบ"},{"verse":5,"text":"จนกว่าข้าพเจ้าจะพบสถานที่สำหรับองค์พระผู้เป็นเจ้า เป็นที่ประทับสำหรับองค์ผู้ทรงอานุภาพแห่งยาโคบ’"},{"verse":6,"text":"ดูเถิด เราได้ยินว่าหีบนั้นอยู่ที่เอฟราธาห์ เราได้พบหีบนั้นในทุ่งแห่งยาอาร์"},{"verse":7,"text":"ให้เราเข้าไปยังที่ประทับของพระองค์ ให้เรากราบนมัสการที่แท่นรองพระบาทของพระองค์"},{"verse":8,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอเสด็จลุกขึ้นสู่ที่พำนักของพระองค์ ทั้งพระองค์และหีบแห่งอานุภาพของพระองค์"},{"verse":9,"text":"ขอให้บรรดาปุโรหิตของพระองค์สวมความชอบธรรม และให้ผู้ภักดีของพระองค์โห่ร้องด้วยความยินดี"},{"verse":10,"text":"เพราะเห็นแก่ดาวิดผู้รับใช้ของพระองค์ ขออย่าทรงปฏิเสธผู้ที่พระองค์ทรงเจิมไว้"},{"verse":11,"text":"องค์พระผู้เป็นเจ้าได้ทรงปฏิญาณต่อดาวิด เป็นคำสัตย์ที่พระองค์จะไม่ทรงคืนคำว่า ‘เราจะตั้งผู้หนึ่งจากเชื้อสายของเจ้าไว้บนบัลลังก์ของเจ้า"},{"verse":12,"text":"หากบรรดาบุตรของเจ้าจะรักษาพันธสัญญาของเรา และรักษาพระโอวาทของเราที่เราจะสอนเขา บุตรของเขาทั้งหลายก็จะนั่งบนบัลลังก์ของเจ้าสืบไปเป็นนิตย์เช่นกัน’"},{"verse":13,"text":"เพราะองค์พระผู้เป็นเจ้าได้ทรงเลือกศิโยน พระองค์ทรงปรารถนาให้เป็นที่ประทับของพระองค์ว่า"},{"verse":14,"text":"‘นี่คือที่พำนักของเราสืบไปเป็นนิตย์ เราจะอาศัยอยู่ที่นี่ เพราะเราปรารถนาที่นี่"},{"verse":15,"text":"เราจะอวยพรเสบียงอาหารของเมืองนี้ให้บริบูรณ์ เราจะให้คนยากจนของเมืองนี้อิ่มด้วยอาหาร"},{"verse":16,"text":"เราจะให้บรรดาปุโรหิตของเมืองนี้สวมความรอด และผู้ภักดีของเมืองนี้จะโห่ร้องด้วยความยินดีอย่างยิ่ง"},{"verse":17,"text":"ที่นั่นเราจะให้เขาสัตว์งอกขึ้นสำหรับดาวิด เราได้เตรียมดวงประทีปไว้สำหรับผู้ที่เราเจิมไว้"},{"verse":18,"text":"เราจะให้ศัตรูของเขาสวมความอับอาย แต่มงกุฎบนศีรษะของเขาจะเปล่งประกาย’"}]},{"chapter":133,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้นของดาวิด ดูเถิด เป็นการดีและน่าชื่นใจสักเพียงไร เมื่อพี่น้องอาศัยอยู่ด้วยกันเป็นน้ำหนึ่งใจเดียวกัน"},{"verse":2,"text":"เป็นเหมือนน้ำมันประเสริฐที่เทบนศีรษะ ไหลลงมาบนเครา ไหลลงมาบนเคราของอาโรน ลงมาบนคอเสื้อของท่าน"},{"verse":3,"text":"เป็นเหมือนน้ำค้างแห่งภูเขาเฮอร์โมนที่ตกลงบนภูเขาทั้งหลายของศิโยน เพราะที่นั่นแหละองค์พระผู้เป็นเจ้าได้ประทานพระพร คือชีวิตที่ยั่งยืนเป็นนิตย์"}]},{"chapter":134,"verses":[{"verse":1,"text":"บทเพลงใช้แห่ขึ้น มาเถิด จงถวายสาธุการแด่องค์พระผู้เป็นเจ้า บรรดาผู้รับใช้ขององค์พระผู้เป็นเจ้าทั้งปวง ผู้ปรนนิบัติอยู่ในพระนิเวศขององค์พระผู้เป็นเจ้าในยามค่ำคืน"},{"verse":2,"text":"จงยกมือของท่านขึ้นสู่สถานนมัสการ และถวายสาธุการแด่องค์พระผู้เป็นเจ้า"},{"verse":3,"text":"ขอองค์พระผู้เป็นเจ้าผู้ทรงสร้างฟ้าสวรรค์และแผ่นดินโลก ทรงอวยพรท่านจากศิโยน"}]},{"chapter":135,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ จงสรรเสริญพระนามขององค์พระผู้เป็นเจ้า บรรดาผู้รับใช้ขององค์พระผู้เป็นเจ้าเอ๋ย จงสรรเสริญเถิด"},{"verse":2,"text":"ท่านผู้ยืนอยู่ในพระนิเวศขององค์พระผู้เป็นเจ้า ในลานพระนิเวศของพระเจ้าของเรา"},{"verse":3,"text":"จงสรรเสริญองค์พระผู้เป็นเจ้า เพราะองค์พระผู้เป็นเจ้าทรงประเสริฐ จงร้องเพลงสรรเสริญพระนามของพระองค์ เพราะพระนามนั้นน่าชื่นใจ"},{"verse":4,"text":"เพราะองค์พระผู้เป็นเจ้าได้ทรงเลือกยาโคบไว้เป็นของพระองค์ ทรงเลือกอิสราเอลเป็นกรรมสิทธิ์อันล้ำค่าของพระองค์"},{"verse":5,"text":"เพราะข้าพเจ้ารู้ว่าองค์พระผู้เป็นเจ้านั้นยิ่งใหญ่ องค์เจ้านายของเราทรงเป็นใหญ่เหนือพระทั้งปวง"},{"verse":6,"text":"องค์พระผู้เป็นเจ้าทรงกระทำทุกสิ่งที่พระองค์ทรงประสงค์ ทั้งในฟ้าสวรรค์และบนแผ่นดินโลก ในท้องทะเลและในที่ลึกทั้งสิ้น"},{"verse":7,"text":"พระองค์ทรงให้เมฆลอยขึ้นจากสุดปลายแผ่นดินโลก ทรงทำให้เกิดฟ้าแลบพร้อมกับฝน และทรงนำลมออกมาจากคลังของพระองค์"},{"verse":8,"text":"พระองค์ทรงประหารบุตรหัวปีของอียิปต์ ทั้งของมนุษย์และของสัตว์"},{"verse":9,"text":"ทรงส่งหมายสำคัญและการอัศจรรย์มาท่ามกลางเจ้า อียิปต์เอ๋ย มาสู้กับฟาโรห์และข้าราชบริพารทั้งสิ้นของเขา"},{"verse":10,"text":"พระองค์ทรงประหารหลายประชาชาติ และทรงสังหารบรรดากษัตริย์ผู้เกรียงไกร"},{"verse":11,"text":"คือสิโหนกษัตริย์ของคนอาโมไรต์ โอกกษัตริย์แห่งบาชาน และบรรดากษัตริย์แห่งคานาอัน"},{"verse":12,"text":"และทรงยกแผ่นดินของพวกเขาให้เป็นมรดก เป็นมรดกแก่อิสราเอลประชากรของพระองค์"},{"verse":13,"text":"ข้าแต่องค์พระผู้เป็นเจ้า พระนามของพระองค์ดำรงเป็นนิตย์ ข้าแต่องค์พระผู้เป็นเจ้า พระเกียรติของพระองค์เลื่องลือตลอดทุกชั่วอายุ"},{"verse":14,"text":"เพราะองค์พระผู้เป็นเจ้าจะทรงให้ความเป็นธรรมแก่ประชากรของพระองค์ และจะทรงเมตตาผู้รับใช้ของพระองค์"},{"verse":15,"text":"รูปเคารพของบรรดาประชาชาติเป็นเงินและทอง เป็นผลงานที่ทำด้วยมือของมนุษย์"},{"verse":16,"text":"มันมีปากแต่พูดไม่ได้ มีตาแต่มองไม่เห็น"},{"verse":17,"text":"มีหูแต่ฟังไม่ได้ ทั้งไม่มีลมหายใจในปากของมัน"},{"verse":18,"text":"บรรดาผู้ที่สร้างมันก็จะเป็นเหมือนมัน และทุกคนที่วางใจในมันก็เช่นกัน"},{"verse":19,"text":"วงศ์วานอิสราเอลเอ๋ย จงถวายสาธุการแด่องค์พระผู้เป็นเจ้า วงศ์วานของอาโรนเอ๋ย จงถวายสาธุการแด่องค์พระผู้เป็นเจ้า"},{"verse":20,"text":"วงศ์วานของเลวีเอ๋ย จงถวายสาธุการแด่องค์พระผู้เป็นเจ้า ท่านผู้ยำเกรงองค์พระผู้เป็นเจ้า จงถวายสาธุการแด่องค์พระผู้เป็นเจ้า"},{"verse":21,"text":"สาธุการแด่องค์พระผู้เป็นเจ้าจากศิโยน แด่พระองค์ผู้ประทับในเยรูซาเล็ม ฮาเลลูยาห์"}]},{"chapter":136,"verses":[{"verse":1,"text":"จงขอบพระคุณองค์พระผู้เป็นเจ้า เพราะพระองค์ทรงประเสริฐ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":2,"text":"จงขอบพระคุณพระเจ้าผู้ทรงเป็นเจ้าเหนือพระทั้งปวง เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":3,"text":"จงขอบพระคุณองค์เจ้านายผู้ทรงเป็นเจ้าเหนือเจ้านายทั้งปวง เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":4,"text":"แด่พระองค์ผู้ทรงกระทำการอัศจรรย์อันยิ่งใหญ่แต่เพียงผู้เดียว เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":5,"text":"แด่พระองค์ผู้ทรงสร้างฟ้าสวรรค์ด้วยพระปัญญา เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":6,"text":"แด่พระองค์ผู้ทรงแผ่แผ่นดินโลกออกเหนือห้วงน้ำ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":7,"text":"แด่พระองค์ผู้ทรงสร้างดวงสว่างที่ยิ่งใหญ่ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":8,"text":"คือดวงอาทิตย์ให้ครองกลางวัน เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":9,"text":"ดวงจันทร์และดวงดาวให้ครองกลางคืน เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":10,"text":"แด่พระองค์ผู้ทรงประหารบุตรหัวปีของอียิปต์ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":11,"text":"และทรงนำอิสราเอลออกมาจากท่ามกลางพวกเขา เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":12,"text":"ด้วยพระหัตถ์อันเกรียงไกรและพระกรที่เหยียดออก เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":13,"text":"แด่พระองค์ผู้ทรงแยกทะเลแดงออกเป็นสองส่วน เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":14,"text":"และทรงนำอิสราเอลให้เดินผ่านกลางทะเลนั้น เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":15,"text":"แต่ทรงสลัดฟาโรห์และกองทัพของเขาลงในทะเลแดง เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":16,"text":"แด่พระองค์ผู้ทรงนำประชากรของพระองค์ผ่านถิ่นทุรกันดาร เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":17,"text":"แด่พระองค์ผู้ทรงประหารบรรดากษัตริย์ผู้ยิ่งใหญ่ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":18,"text":"และทรงสังหารบรรดากษัตริย์ผู้เกรียงไกร เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":19,"text":"คือสิโหนกษัตริย์ของคนอาโมไรต์ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":20,"text":"และโอกกษัตริย์แห่งบาชาน เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":21,"text":"และทรงยกแผ่นดินของพวกเขาให้เป็นมรดก เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":22,"text":"เป็นมรดกแก่อิสราเอลผู้รับใช้ของพระองค์ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":23,"text":"แด่พระองค์ผู้ทรงระลึกถึงเราในยามที่เราตกต่ำ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":24,"text":"และทรงช่วยเราให้พ้นจากศัตรูของเรา เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":25,"text":"แด่พระองค์ผู้ประทานอาหารแก่สรรพสัตว์ทั้งปวง เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":26,"text":"จงขอบพระคุณพระเจ้าแห่งฟ้าสวรรค์ เพราะความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"}]},{"chapter":137,"verses":[{"verse":1,"text":"ที่ริมฝั่งแม่น้ำแห่งบาบิโลน เรานั่งลงและร้องไห้ เมื่อเราระลึกถึงศิโยน"},{"verse":2,"text":"เราแขวนพิณของเราไว้บนต้นหลิวที่นั่น"},{"verse":3,"text":"เพราะที่นั่น บรรดาผู้ที่จับเราเป็นเชลยได้ขอให้เราร้องเพลง ผู้ที่ทรมานเราเรียกร้องเพลงรื่นเริงว่า ‘จงร้องเพลงแห่งศิโยนให้เราฟังสักบทเถิด’"},{"verse":4,"text":"เราจะร้องเพลงขององค์พระผู้เป็นเจ้าในแผ่นดินต่างด้าวได้อย่างไร"},{"verse":5,"text":"เยรูซาเล็มเอ๋ย หากข้าพเจ้าลืมเจ้า ก็ขอให้มือขวาของข้าพเจ้าลืมความชำนาญของมันเสีย"},{"verse":6,"text":"หากข้าพเจ้าไม่ระลึกถึงเจ้า ก็ขอให้ลิ้นของข้าพเจ้าติดอยู่กับเพดานปาก หากข้าพเจ้าไม่เชิดชูเยรูซาเล็มไว้เหนือความชื่นชมยินดีสูงสุดของข้าพเจ้า"},{"verse":7,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงระลึกถึงสิ่งที่ชาวเอโดมได้ทำในวันที่เยรูซาเล็มล่มสลาย พวกเขาร้องว่า ‘จงทำลายมันเสีย จงรื้อมันลงให้ถึงรากฐาน’"},{"verse":8,"text":"ธิดาแห่งบาบิโลนเอ๋ย เจ้าผู้จะต้องถูกทำลาย ความสุขจะมีแก่ผู้ที่ตอบสนองเจ้าตามที่เจ้าได้กระทำต่อเรา"},{"verse":9,"text":"ความสุขจะมีแก่ผู้ที่จับลูกเล็กๆ ของเจ้า แล้วฟาดลงกับก้อนหิน"}]},{"chapter":138,"verses":[{"verse":1,"text":"ของดาวิด ข้าพระองค์ขอบพระคุณพระองค์ด้วยสุดใจ ข้าพระองค์ร้องเพลงสรรเสริญพระองค์ต่อหน้าพระทั้งหลาย"},{"verse":2,"text":"ข้าพระองค์กราบลงตรงต่อพระวิหารอันบริสุทธิ์ของพระองค์ และขอบพระคุณพระนามของพระองค์ เพราะความรักมั่นคงและความซื่อสัตย์ของพระองค์ เพราะพระองค์ทรงเชิดชูพระนามและพระดำรัสของพระองค์เหนือสิ่งสารพัด"},{"verse":3,"text":"ในวันที่ข้าพระองค์ร้องทูล พระองค์ทรงตอบข้าพระองค์ พระองค์ทรงทำให้ข้าพระองค์มีใจกล้าหาญและทรงเสริมกำลังจิตวิญญาณของข้าพระองค์"},{"verse":4,"text":"ข้าแต่องค์พระผู้เป็นเจ้า บรรดากษัตริย์แห่งแผ่นดินโลกจะขอบพระคุณพระองค์ เมื่อพวกเขาได้ยินถ้อยคำจากพระโอษฐ์ของพระองค์"},{"verse":5,"text":"พวกเขาจะร้องเพลงถึงพระมรรคาขององค์พระผู้เป็นเจ้า เพราะพระสิริขององค์พระผู้เป็นเจ้านั้นยิ่งใหญ่"},{"verse":6,"text":"แม้องค์พระผู้เป็นเจ้าทรงสูงส่ง พระองค์ก็ทรงเหลียวแลผู้ต่ำต้อย แต่ทรงรู้จักคนหยิ่งผยองแต่ไกล"},{"verse":7,"text":"แม้ข้าพระองค์เดินอยู่ท่ามกลางความทุกข์ลำบาก พระองค์ก็ทรงรักษาชีวิตข้าพระองค์ไว้ พระองค์ทรงเหยียดพระหัตถ์ของพระองค์ออกต่อสู้ความโกรธของศัตรู และพระหัตถ์ขวาของพระองค์ช่วยข้าพระองค์ให้รอด"},{"verse":8,"text":"องค์พระผู้เป็นเจ้าจะทรงกระทำให้แผนการของพระองค์เพื่อข้าพระองค์สำเร็จ ข้าแต่องค์พระผู้เป็นเจ้า ความรักมั่นคงของพระองค์ดำรงเป็นนิตย์ ขออย่าทรงทอดทิ้งพระหัตถกิจของพระองค์"}]},{"chapter":139,"verses":[{"verse":1,"text":"สำหรับหัวหน้านักดนตรี บทเพลงสดุดีของดาวิด ข้าแต่องค์พระผู้เป็นเจ้า พระองค์ได้ทรงตรวจค้นข้าพระองค์ และทรงรู้จักข้าพระองค์"},{"verse":2,"text":"พระองค์ทรงทราบเมื่อข้าพระองค์นั่งลงและเมื่อข้าพระองค์ลุกขึ้น พระองค์ทรงหยั่งรู้ความคิดของข้าพระองค์แต่ไกล"},{"verse":3,"text":"พระองค์ทรงพิเคราะห์ทางเดินและการนอนลงของข้าพระองค์ พระองค์ทรงคุ้นเคยกับทางทั้งสิ้นของข้าพระองค์"},{"verse":4,"text":"ข้าแต่องค์พระผู้เป็นเจ้า แม้ก่อนที่คำจะมาถึงลิ้นของข้าพระองค์ ดูเถิด พระองค์ก็ทรงทราบสิ้นแล้ว"},{"verse":5,"text":"พระองค์ทรงโอบล้อมข้าพระองค์ไว้ทั้งข้างหลังและข้างหน้า และทรงวางพระหัตถ์ของพระองค์เหนือข้าพระองค์"},{"verse":6,"text":"ความรู้เช่นนี้อัศจรรย์เกินกว่าข้าพระองค์จะเข้าใจได้ สูงส่งเกินกว่าที่ข้าพระองค์จะหยั่งถึง"},{"verse":7,"text":"ข้าพระองค์จะไปไหนให้พ้นพระวิญญาณของพระองค์ได้ หรือข้าพระองค์จะหนีไปไหนให้พ้นพระพักตร์ของพระองค์ได้"},{"verse":8,"text":"หากข้าพระองค์ขึ้นไปยังฟ้าสวรรค์ พระองค์ก็ทรงอยู่ที่นั่น หากข้าพระองค์นอนลงในแดนคนตาย พระองค์ก็ทรงอยู่ที่นั่น"},{"verse":9,"text":"หากข้าพระองค์ติดปีกแห่งรุ่งอรุณบินไป หรือไปอาศัยอยู่ที่สุดปลายทะเล"},{"verse":10,"text":"แม้ที่นั่น พระหัตถ์ของพระองค์ก็จะนำข้าพระองค์ และพระหัตถ์ขวาของพระองค์จะยึดข้าพระองค์ไว้"},{"verse":11,"text":"หากข้าพระองค์กล่าวว่า ‘แน่ทีเดียว ความมืดจะปกคลุมข้าพระองค์ และแสงสว่างรอบตัวข้าพระองค์จะกลายเป็นกลางคืน’"},{"verse":12,"text":"แม้ความมืดก็ไม่มืดสำหรับพระองค์ กลางคืนก็สว่างดุจกลางวัน เพราะความมืดก็เป็นเหมือนความสว่างสำหรับพระองค์"},{"verse":13,"text":"เพราะพระองค์ทรงสร้างส่วนลึกภายในของข้าพระองค์ พระองค์ทรงถักทอข้าพระองค์ขึ้นในครรภ์มารดาของข้าพระองค์"},{"verse":14,"text":"ข้าพระองค์ขอบพระคุณพระองค์ เพราะข้าพระองค์ถูกสร้างขึ้นอย่างน่าครั่นคร้ามและน่าอัศจรรย์ พระราชกิจของพระองค์มหัศจรรย์ยิ่งนัก จิตวิญญาณของข้าพระองค์ทราบดี"},{"verse":15,"text":"โครงร่างของข้าพระองค์ไม่ได้ถูกซ่อนไว้จากพระองค์ เมื่อข้าพระองค์ถูกสร้างขึ้นในที่ลับ เมื่อข้าพระองค์ถูกถักทอขึ้นในที่ลึกแห่งแผ่นดินโลก"},{"verse":16,"text":"พระเนตรของพระองค์เห็นข้าพระองค์ตั้งแต่ยังเป็นเพียงตัวอ่อนที่ยังไม่เป็นรูปร่าง วันคืนทั้งสิ้นที่กำหนดไว้สำหรับข้าพระองค์ถูกจารึกไว้ในหนังสือของพระองค์ ก่อนที่วันเหล่านั้นจะมาถึงแม้สักวันเดียว"},{"verse":17,"text":"ข้าแต่พระเจ้า พระดำริของพระองค์ประเสริฐต่อข้าพระองค์เพียงไร และมีมากมายเหลือคณานับ"},{"verse":18,"text":"หากข้าพระองค์จะนับ ก็มีมากกว่าเม็ดทราย เมื่อข้าพระองค์ตื่นขึ้น ข้าพระองค์ก็ยังอยู่กับพระองค์"},{"verse":19,"text":"ข้าแต่พระเจ้า ขอพระองค์ทรงประหารคนชั่วเสียเถิด เจ้าคนกระหายเลือดทั้งหลาย จงไปให้พ้นจากข้าพระองค์"},{"verse":20,"text":"พวกเขากล่าวถึงพระองค์ด้วยเจตนาร้าย ศัตรูของพระองค์อ้างพระนามของพระองค์อย่างไร้ค่า"},{"verse":21,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ข้าพระองค์ไม่ได้เกลียดชังบรรดาผู้ที่เกลียดชังพระองค์หรือ และไม่ได้ชิงชังบรรดาผู้ที่ลุกขึ้นต่อสู้พระองค์หรือ"},{"verse":22,"text":"ข้าพระองค์เกลียดชังพวกเขาด้วยความเกลียดชังอย่างที่สุด ข้าพระองค์ถือว่าพวกเขาเป็นศัตรูของข้าพระองค์"},{"verse":23,"text":"ข้าแต่พระเจ้า ขอทรงตรวจค้นข้าพระองค์ และทรงทราบจิตใจของข้าพระองค์ ขอทรงทดสอบข้าพระองค์ และทรงทราบความคิดกังวลของข้าพระองค์"},{"verse":24,"text":"ขอทรงดูว่ามีทางใดในข้าพระองค์ที่ผิดต่อพระองค์หรือไม่ และขอทรงนำข้าพระองค์ไปในทางนิรันดร์"}]},{"chapter":140,"title":"สำหรับหัวหน้านักดนตรี บทเพลงสดุดีของดาวิด","verses":[{"verse":1,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงช่วยกู้ข้าพระองค์ให้พ้นจากคนชั่ว ขอทรงปกป้องข้าพระองค์จากคนที่ชอบความรุนแรง"},{"verse":2,"text":"ผู้ซึ่งคิดการชั่วร้ายในใจ และก่อสงครามอยู่วันยังค่ำ"},{"verse":3,"text":"พวกเขาทำให้ลิ้นของตนคมกริบเหมือนงู พิษของงูร้ายอยู่ที่ริมฝีปากของพวกเขา เซลาห์"},{"verse":4,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงพิทักษ์ข้าพระองค์ให้พ้นจากมือของคนชั่ว ขอทรงปกป้องข้าพระองค์จากคนที่ชอบความรุนแรง ผู้ซึ่งวางแผนจะทำให้ข้าพระองค์ล้มลง"},{"verse":5,"text":"คนหยิ่งผยองได้ซ่อนกับดักไว้ดักข้าพระองค์ พวกเขาขึงตาข่ายไว้ริมทางเดิน และวางบ่วงดักข้าพระองค์ เซลาห์"},{"verse":6,"text":"ข้าพระองค์ทูลต่อองค์พระผู้เป็นเจ้าว่า ‘พระองค์ทรงเป็นพระเจ้าของข้าพระองค์’ ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงสดับเสียงคำวิงวอนของข้าพระองค์"},{"verse":7,"text":"ข้าแต่องค์พระผู้เป็นเจ้า องค์เจ้านายของข้าพระองค์ พระผู้ทรงเป็นกำลังแห่งความรอดของข้าพระองค์ พระองค์ทรงปกคลุมศีรษะของข้าพระองค์ในยามสงคราม"},{"verse":8,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขออย่าทรงให้สมความปรารถนาของคนชั่ว ขออย่าทรงให้แผนชั่วของพวกเขาสำเร็จ เกรงว่าพวกเขาจะลำพองตน เซลาห์"},{"verse":9,"text":"ขอให้ความเดือดร้อนที่ริมฝีปากของพวกเขาก่อขึ้นนั้น ตกลงบนศีรษะของบรรดาผู้ที่ล้อมข้าพระองค์ไว้"},{"verse":10,"text":"ขอให้ถ่านที่ลุกโชนตกลงบนพวกเขา ขอให้พวกเขาถูกโยนลงในไฟ ลงในหลุมลึก ไม่ได้ลุกขึ้นอีกเลย"},{"verse":11,"text":"ขออย่าให้คนที่ใส่ร้ายป้ายสีตั้งมั่นอยู่ในแผ่นดิน ขอให้ความหายนะตามล่าคนที่ชอบความรุนแรงให้พินาศไปโดยเร็ว"},{"verse":12,"text":"ข้าพระองค์รู้ว่าองค์พระผู้เป็นเจ้าจะทรงให้ความยุติธรรมแก่คนยากจน และทรงปกป้องสิทธิ์ของผู้ขัดสน"},{"verse":13,"text":"แน่ทีเดียว คนชอบธรรมจะสรรเสริญพระนามของพระองค์ คนเที่ยงธรรมจะได้อยู่ต่อพระพักตร์ของพระองค์"}]},{"chapter":141,"verses":[{"verse":1,"text":"บทเพลงสดุดีของดาวิด ข้าแต่องค์พระผู้เป็นเจ้า ข้าพระองค์ร้องทูลต่อพระองค์ ขอทรงรีบเสด็จมาหาข้าพระองค์ ขอทรงสดับเสียงของข้าพระองค์เมื่อข้าพระองค์ร้องทูลต่อพระองค์"},{"verse":2,"text":"ขอให้คำอธิษฐานของข้าพระองค์ตั้งอยู่ต่อหน้าพระองค์ดุจเครื่องหอม ขอให้การยกมือของข้าพระองค์ขึ้นเป็นดุจเครื่องบูชาในยามเย็น"},{"verse":3,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงตั้งยามเฝ้าปากของข้าพระองค์ ขอทรงเฝ้าระวังประตูริมฝีปากของข้าพระองค์"},{"verse":4,"text":"ขออย่าให้ใจของข้าพระองค์เอนเอียงไปสู่สิ่งชั่วร้ายใดๆ หรือมีส่วนในการกระทำชั่วร่วมกับคนที่ทำความชั่วช้า ขออย่าให้ข้าพระองค์ได้ลิ้มรสอาหารเลิศรสของพวกเขา"},{"verse":5,"text":"ขอให้คนชอบธรรมตีสอนข้าพระองค์ด้วยความเมตตา และขอให้การว่ากล่าวของเขาเป็นดุจน้ำมันชโลมศีรษะ ขอศีรษะของข้าพระองค์อย่าได้ปฏิเสธมันเลย เพราะคำอธิษฐานของข้าพระองค์ยังคงต่อต้านการกระทำชั่วของคนชั่วเสมอ"},{"verse":6,"text":"เมื่อบรรดาผู้ปกครองของพวกเขาถูกเหวี่ยงลงจากหน้าผา ผู้คนก็จะฟังถ้อยคำของข้าพระองค์ เพราะถ้อยคำเหล่านั้นไพเราะ"},{"verse":7,"text":"ดุจคนที่ไถและพรวนดินให้แตกฉันใด กระดูกของเราก็ถูกกระจัดกระจายอยู่ที่ปากแดนคนตายฉันนั้น"},{"verse":8,"text":"ข้าแต่องค์พระผู้เป็นเจ้า องค์เจ้านายของข้าพระองค์ ดวงตาของข้าพระองค์จับจ้องอยู่ที่พระองค์ ข้าพระองค์เข้ามาลี้ภัยในพระองค์ ขออย่าทรงทอดทิ้งจิตวิญญาณของข้าพระองค์ให้ไร้ที่พึ่ง"},{"verse":9,"text":"ขอทรงปกป้องข้าพระองค์จากกับดักที่พวกเขาวางดักข้าพระองค์ไว้ และจากบ่วงแร้วของคนที่ทำชั่ว"},{"verse":10,"text":"ขอให้คนชั่วตกลงในตาข่ายของพวกเขาเอง ขณะที่ข้าพระองค์ผ่านพ้นไปอย่างปลอดภัย"}]},{"chapter":142,"title":"บทมัสคิลของดาวิด เมื่อท่านอยู่ในถ้ำ เป็นคำอธิษฐาน","verses":[{"verse":1,"text":"ข้าพระองค์ร้องเสียงดังต่อองค์พระผู้เป็นเจ้า ข้าพระองค์เปล่งเสียงทูลขอความเมตตาต่อองค์พระผู้เป็นเจ้า"},{"verse":2,"text":"ข้าพระองค์ระบายความทุกข์ใจออกต่อพระพักตร์พระองค์ ข้าพระองค์ทูลความเดือดร้อนของข้าพระองค์ต่อพระองค์"},{"verse":3,"text":"แม้จิตวิญญาณของข้าพระองค์อ่อนระโหยอยู่ภายใน พระองค์ก็ทรงทราบหนทางของข้าพระองค์ บนทางที่ข้าพระองค์เดินไป พวกเขาได้ซ่อนกับดักดักข้าพระองค์ไว้"},{"verse":4,"text":"ขอทรงมองดูทางขวาของข้าพระองค์เถิด ไม่มีใครเหลียวแลข้าพระองค์ ข้าพระองค์ไม่มีที่ลี้ภัย ไม่มีใครห่วงใยจิตวิญญาณของข้าพระองค์"},{"verse":5,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ข้าพระองค์ร้องทูลต่อพระองค์ว่า ‘พระองค์ทรงเป็นที่ลี้ภัยของข้าพระองค์ เป็นส่วนมรดกของข้าพระองค์ในแผ่นดินของคนเป็น’"},{"verse":6,"text":"ขอทรงสดับเสียงร้องของข้าพระองค์ เพราะข้าพระองค์ตกต่ำเหลือเกิน ขอทรงช่วยกู้ข้าพระองค์ให้พ้นจากผู้ที่ไล่ตามข้าพระองค์ เพราะพวกเขาแข็งแกร่งเกินกำลังข้าพระองค์"},{"verse":7,"text":"ขอทรงปลดปล่อยจิตวิญญาณของข้าพระองค์ออกจากที่คุมขัง เพื่อข้าพระองค์จะได้สรรเสริญพระนามของพระองค์ คนชอบธรรมจะมาห้อมล้อมข้าพระองค์ เพราะพระองค์ทรงดีต่อข้าพระองค์"}]},{"chapter":143,"verses":[{"verse":1,"text":"บทเพลงสดุดีของดาวิด ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงสดับคำอธิษฐานของข้าพระองค์ และขอทรงสดับฟังคำวิงวอนของข้าพระองค์ตามความซื่อสัตย์ของพระองค์ ขอทรงตอบข้าพระองค์ตามความชอบธรรมของพระองค์"},{"verse":2,"text":"ขออย่าทรงนำผู้รับใช้ของพระองค์เข้าสู่การพิพากษา เพราะไม่มีผู้ใดที่มีชีวิตอยู่จะเป็นผู้ชอบธรรมต่อพระพักตร์ของพระองค์ได้"},{"verse":3,"text":"เพราะศัตรูได้ไล่ตามจิตวิญญาณของข้าพระองค์ มันได้บดขยี้ชีวิตของข้าพระองค์ลงกับพื้นดิน มันทำให้ข้าพระองค์ต้องอาศัยอยู่ในความมืดดุจคนที่ตายไปนานแล้ว"},{"verse":4,"text":"จิตวิญญาณของข้าพระองค์อ่อนระโหยอยู่ภายใน จิตใจของข้าพระองค์ก็ท้อแท้อยู่ในตัวข้าพระองค์"},{"verse":5,"text":"ข้าพระองค์ระลึกถึงวันคืนแต่ก่อน ข้าพระองค์ใคร่ครวญถึงพระราชกิจทั้งสิ้นของพระองค์ และพิเคราะห์ถึงพระหัตถกิจของพระองค์"},{"verse":6,"text":"ข้าพระองค์ชูมือของข้าพระองค์ขึ้นต่อพระองค์ จิตวิญญาณของข้าพระองค์กระหายหาพระองค์ดุจแผ่นดินที่แห้งผาก เซลาห์"},{"verse":7,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงรีบตอบข้าพระองค์ จิตวิญญาณของข้าพระองค์อ่อนล้าเต็มที ขออย่าทรงซ่อนพระพักตร์ของพระองค์จากข้าพระองค์ มิฉะนั้นข้าพระองค์จะเป็นเหมือนคนที่ลงไปสู่หลุมลึก"},{"verse":8,"text":"ขอให้ข้าพระองค์ได้ยินถึงความรักมั่นคงของพระองค์ในยามเช้า เพราะข้าพระองค์วางใจในพระองค์ ขอทรงสอนทางที่ข้าพระองค์ควรเดินไป เพราะข้าพระองค์ตั้งจิตวิญญาณของข้าพระองค์ไว้ที่พระองค์"},{"verse":9,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงช่วยกู้ข้าพระองค์ให้พ้นจากศัตรูของข้าพระองค์ ข้าพระองค์หนีมาลี้ภัยในพระองค์"},{"verse":10,"text":"ขอทรงสอนข้าพระองค์ให้กระทำตามพระประสงค์ของพระองค์ เพราะพระองค์ทรงเป็นพระเจ้าของข้าพระองค์ ขอพระวิญญาณอันประเสริฐของพระองค์ทรงนำข้าพระองค์ไปบนทางราบ"},{"verse":11,"text":"ข้าแต่องค์พระผู้เป็นเจ้า เพราะเห็นแก่พระนามของพระองค์ ขอทรงให้ข้าพระองค์มีชีวิตอยู่ ขอทรงนำจิตวิญญาณของข้าพระองค์ออกจากความทุกข์ลำบากตามความชอบธรรมของพระองค์"},{"verse":12,"text":"และตามความรักมั่นคงของพระองค์ ขอทรงกำจัดศัตรูของข้าพระองค์เสีย ขอทรงทำลายบรรดาผู้ที่ทำให้ข้าพระองค์ทุกข์ร้อนให้หมดสิ้น เพราะข้าพระองค์เป็นผู้รับใช้ของพระองค์"}]},{"chapter":144,"verses":[{"verse":1,"text":"ของดาวิด สาธุการแด่องค์พระผู้เป็นเจ้า ศิลาของข้าพระองค์ ผู้ทรงฝึกมือของข้าพระองค์ให้ทำสงคราม และฝึกนิ้วมือของข้าพระองค์ให้สู้รบ"},{"verse":2,"text":"พระองค์ทรงเป็นความรักมั่นคงและป้อมปราการของข้าพระองค์ เป็นที่กำบังเข้มแข็งและผู้ช่วยกู้ของข้าพระองค์ เป็นโล่ของข้าพระองค์ผู้ที่ข้าพระองค์เข้าลี้ภัย ผู้ทรงปราบชนชาติทั้งหลายให้อยู่ใต้อำนาจข้าพระองค์"},{"verse":3,"text":"ข้าแต่องค์พระผู้เป็นเจ้า มนุษย์เป็นใครเล่า ที่พระองค์ทรงเหลียวแลเขา และบุตรของมนุษย์เป็นใคร ที่พระองค์ทรงคำนึงถึงเขา"},{"verse":4,"text":"มนุษย์เป็นเหมือนลมหายใจ วันคืนของเขาเป็นดุจเงาที่ผ่านไป"},{"verse":5,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงโน้มฟ้าสวรรค์ของพระองค์ลงมา และเสด็จลงมา ขอทรงแตะต้องภูเขาทั้งหลายเพื่อให้มันมีควันพลุ่งขึ้น"},{"verse":6,"text":"ขอทรงปล่อยฟ้าแลบของพระองค์ออกไปและทำให้พวกเขากระจัดกระจาย ขอทรงยิงลูกธนูของพระองค์และทำให้พวกเขาแตกพ่าย"},{"verse":7,"text":"ขอทรงเหยียดพระหัตถ์ของพระองค์ลงมาจากเบื้องบน โปรดช่วยกู้และปลดปล่อยข้าพระองค์ให้พ้นจากกระแสน้ำอันมากหลาย ให้พ้นจากเงื้อมมือของคนต่างด้าว"},{"verse":8,"text":"ผู้ซึ่งปากของเขาพูดเท็จ และมือขวาของเขาเต็มไปด้วยความหลอกลวง"},{"verse":9,"text":"ข้าแต่พระเจ้า ข้าพระองค์จะร้องเพลงบทใหม่ถวายแด่พระองค์ ข้าพระองค์จะบรรเลงพิณสิบสายถวายแด่พระองค์"},{"verse":10,"text":"แด่พระองค์ผู้ประทานชัยชนะแก่บรรดากษัตริย์ ผู้ทรงช่วยกู้ดาวิดผู้รับใช้ของพระองค์ให้พ้นจากดาบอันร้ายกาจ"},{"verse":11,"text":"ขอทรงช่วยกู้และปลดปล่อยข้าพระองค์ให้พ้นจากเงื้อมมือของคนต่างด้าว ผู้ซึ่งปากของเขาพูดเท็จ และมือขวาของเขาเต็มไปด้วยความหลอกลวง"},{"verse":12,"text":"แล้วบรรดาบุตรชายของเราในวัยหนุ่มจะเป็นเหมือนต้นไม้ที่เติบโตเต็มที่ และบรรดาบุตรสาวของเราจะเป็นเหมือนเสามุมที่สลักไว้อย่างงดงามเพื่อประดับพระราชวัง"},{"verse":13,"text":"ยุ้งฉางของเราจะเต็มบริบูรณ์ มีพืชผลทุกชนิด ฝูงแกะของเราจะเพิ่มจำนวนเป็นพันเป็นหมื่นในทุ่งหญ้าของเรา"},{"verse":14,"text":"วัวของเราจะลากของหนักได้ จะไม่มีการพังทลายของกำแพง ไม่มีการตกเป็นเชลย และไม่มีเสียงร้องคร่ำครวญตามถนนของเรา"},{"verse":15,"text":"ความสุขเป็นของชนชาติที่เป็นเช่นนี้ ความสุขเป็นของชนชาติที่มีองค์พระผู้เป็นเจ้าเป็นพระเจ้าของตน"}]},{"chapter":145,"verses":[{"verse":1,"text":"บทเพลงสรรเสริญของดาวิด ข้าพระองค์จะเทิดทูนพระองค์ พระเจ้าและกษัตริย์ของข้าพระองค์ ข้าพระองค์จะถวายสาธุการแด่พระนามของพระองค์เป็นนิตย์นิรันดร์"},{"verse":2,"text":"ทุกๆ วันข้าพระองค์จะถวายสาธุการแด่พระองค์ และจะสรรเสริญพระนามของพระองค์เป็นนิตย์นิรันดร์"},{"verse":3,"text":"องค์พระผู้เป็นเจ้าทรงยิ่งใหญ่และสมควรแก่การสรรเสริญอย่างยิ่ง ความยิ่งใหญ่ของพระองค์นั้นเหลือที่จะหยั่งรู้ได้"},{"verse":4,"text":"คนชั่วอายุหนึ่งจะยกย่องพระราชกิจของพระองค์แก่คนอีกชั่วอายุหนึ่ง และจะประกาศพระราชกิจอันทรงฤทธิ์ของพระองค์"},{"verse":5,"text":"ข้าพระองค์จะใคร่ครวญถึงความโอ่อ่าตระการแห่งพระบารมีอันรุ่งโรจน์ของพระองค์ และถึงพระราชกิจอันมหัศจรรย์ของพระองค์"},{"verse":6,"text":"ผู้คนจะกล่าวถึงอานุภาพแห่งพระราชกิจอันน่าครั่นคร้ามของพระองค์ และข้าพระองค์จะประกาศความยิ่งใหญ่ของพระองค์"},{"verse":7,"text":"พวกเขาจะป่าวร้องถึงความเลื่องลือแห่งความดีอันอุดมของพระองค์ และจะร้องเพลงด้วยความชื่นบานถึงความชอบธรรมของพระองค์"},{"verse":8,"text":"องค์พระผู้เป็นเจ้าทรงพระคุณและทรงพระเมตตา ทรงกริ้วช้า และทรงยิ่งใหญ่ในความรักมั่นคง"},{"verse":9,"text":"องค์พระผู้เป็นเจ้าทรงดีต่อทุกคน และความเมตตาของพระองค์อยู่เหนือสรรพสิ่งทั้งปวงที่พระองค์ทรงสร้าง"},{"verse":10,"text":"ข้าแต่องค์พระผู้เป็นเจ้า สรรพสิ่งทั้งปวงที่พระองค์ทรงสร้างจะขอบพระคุณพระองค์ และบรรดาผู้ภักดีของพระองค์จะถวายสาธุการแด่พระองค์"},{"verse":11,"text":"พวกเขาจะกล่าวถึงพระสิริแห่งราชอาณาจักรของพระองค์ และจะเล่าถึงอานุภาพของพระองค์"},{"verse":12,"text":"เพื่อให้บุตรของมนุษย์ได้รู้ถึงพระราชกิจอันทรงฤทธิ์ของพระองค์ และความโอ่อ่าตระการอันรุ่งโรจน์แห่งราชอาณาจักรของพระองค์"},{"verse":13,"text":"ราชอาณาจักรของพระองค์เป็นราชอาณาจักรนิรันดร์ และการครอบครองของพระองค์ดำรงอยู่ตลอดทุกชั่วอายุ"},{"verse":14,"text":"องค์พระผู้เป็นเจ้าทรงค้ำชูทุกคนที่ล้มลง และทรงพยุงทุกคนที่ค้อมตัวลงให้ลุกขึ้น"},{"verse":15,"text":"ดวงตาของสรรพสิ่งทั้งปวงล้วนเฝ้ามองที่พระองค์ และพระองค์ประทานอาหารแก่พวกมันตามฤดูกาล"},{"verse":16,"text":"พระองค์ทรงเปิดพระหัตถ์ของพระองค์ และทำให้สิ่งมีชีวิตทั้งปวงอิ่มเอมตามความปรารถนา"},{"verse":17,"text":"องค์พระผู้เป็นเจ้าทรงชอบธรรมในทางทั้งสิ้นของพระองค์ และทรงเมตตาในพระราชกิจทั้งปวงของพระองค์"},{"verse":18,"text":"องค์พระผู้เป็นเจ้าทรงอยู่ใกล้ทุกคนที่ร้องทูลต่อพระองค์ ทุกคนที่ร้องทูลต่อพระองค์ด้วยความจริงใจ"},{"verse":19,"text":"พระองค์ทรงโปรดประทานตามความปรารถนาของบรรดาผู้ที่ยำเกรงพระองค์ พระองค์ทรงสดับเสียงร้องของพวกเขาและทรงช่วยพวกเขาให้รอด"},{"verse":20,"text":"องค์พระผู้เป็นเจ้าทรงพิทักษ์รักษาทุกคนที่รักพระองค์ แต่จะทรงทำลายคนชั่วทั้งปวง"},{"verse":21,"text":"ปากของข้าพระองค์จะกล่าวสรรเสริญองค์พระผู้เป็นเจ้า ขอให้สรรพสิ่งทั้งมวลถวายสาธุการแด่พระนามอันบริสุทธิ์ของพระองค์เป็นนิตย์นิรันดร์"}]},{"chapter":146,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ จิตวิญญาณของข้าพเจ้าเอ๋ย จงสรรเสริญองค์พระผู้เป็นเจ้า"},{"verse":2,"text":"ข้าพเจ้าจะสรรเสริญองค์พระผู้เป็นเจ้าตลอดชีวิตของข้าพเจ้า ข้าพเจ้าจะร้องเพลงสรรเสริญพระเจ้าของข้าพเจ้าตราบเท่าที่ข้าพเจ้ายังมีชีวิตอยู่"},{"verse":3,"text":"อย่าวางใจในเจ้านายทั้งหลาย ในบุตรของมนุษย์ซึ่งช่วยให้รอดไม่ได้"},{"verse":4,"text":"เมื่อลมหายใจของเขาออกไป เขาก็กลับคืนสู่ดิน ในวันนั้นเองแผนการทั้งหลายของเขาก็พินาศไป"},{"verse":5,"text":"ความสุขเป็นของผู้ที่มีพระเจ้าของยาโคบเป็นผู้อุปถัมภ์ ผู้ซึ่งความหวังของเขาอยู่ในองค์พระผู้เป็นเจ้าพระเจ้าของเขา"},{"verse":6,"text":"พระผู้ทรงสร้างฟ้าสวรรค์และแผ่นดินโลก ทะเล และสรรพสิ่งในที่เหล่านั้น พระองค์ทรงรักษาความซื่อสัตย์ไว้เป็นนิตย์"},{"verse":7,"text":"พระองค์ทรงให้ความยุติธรรมแก่ผู้ที่ถูกข่มเหง และประทานอาหารแก่ผู้ที่หิวโหย องค์พระผู้เป็นเจ้าทรงปลดปล่อยผู้ที่ถูกจองจำ"},{"verse":8,"text":"องค์พระผู้เป็นเจ้าทรงเปิดตาของคนตาบอด องค์พระผู้เป็นเจ้าทรงพยุงผู้ที่ค้อมตัวลง องค์พระผู้เป็นเจ้าทรงรักผู้ชอบธรรม"},{"verse":9,"text":"องค์พระผู้เป็นเจ้าทรงปกป้องคนต่างด้าว ทรงค้ำจุนลูกกำพร้าพ่อและหญิงม่าย แต่ทรงทำให้ทางของคนชั่วต้องล้มเหลว"},{"verse":10,"text":"องค์พระผู้เป็นเจ้าจะทรงครอบครองเป็นนิตย์ ศิโยนเอ๋ย พระเจ้าของเจ้าจะทรงครอบครองตลอดทุกชั่วอายุ ฮาเลลูยาห์"}]},{"chapter":147,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ เป็นการดีที่จะร้องเพลงสรรเสริญพระเจ้าของเรา การสรรเสริญพระองค์นั้นเป็นที่น่าชื่นใจและงดงาม"},{"verse":2,"text":"องค์พระผู้เป็นเจ้าทรงสร้างเยรูซาเล็มขึ้นใหม่ พระองค์ทรงรวบรวมเชลยอิสราเอลที่กระจัดกระจายให้กลับมา"},{"verse":3,"text":"พระองค์ทรงรักษาผู้ที่ชอกช้ำใจ และทรงพันบาดแผลของพวกเขา"},{"verse":4,"text":"พระองค์ทรงกำหนดจำนวนของดวงดาว และทรงเรียกชื่อของมันทุกดวง"},{"verse":5,"text":"องค์เจ้านายของเราทรงยิ่งใหญ่และทรงฤทธานุภาพมาก พระปัญญาของพระองค์ไม่มีขอบเขตจำกัด"},{"verse":6,"text":"องค์พระผู้เป็นเจ้าทรงค้ำชูผู้ที่ถ่อมใจ แต่ทรงเหวี่ยงคนชั่วลงกับพื้นดิน"},{"verse":7,"text":"จงร้องเพลงขอบพระคุณแด่องค์พระผู้เป็นเจ้า จงบรรเลงพิณถวายแด่พระเจ้าของเรา"},{"verse":8,"text":"พระองค์ผู้ทรงคลุมท้องฟ้าด้วยเมฆ ทรงจัดเตรียมฝนให้แก่แผ่นดินโลก ทรงทำให้หญ้างอกขึ้นบนภูเขา"},{"verse":9,"text":"พระองค์ประทานอาหารแก่สัตว์ทั้งหลาย และแก่ลูกกาที่ส่งเสียงร้อง"},{"verse":10,"text":"พระองค์ไม่ทรงชื่นชมในกำลังของม้า และไม่ทรงยินดีในเรียวขาของชายใด"},{"verse":11,"text":"องค์พระผู้เป็นเจ้าทรงโปรดปรานบรรดาผู้ที่ยำเกรงพระองค์ ผู้ซึ่งหวังใจในความรักมั่นคงของพระองค์"},{"verse":12,"text":"เยรูซาเล็มเอ๋ย จงยกย่ององค์พระผู้เป็นเจ้า ศิโยนเอ๋ย จงสรรเสริญพระเจ้าของเจ้า"},{"verse":13,"text":"เพราะพระองค์ทรงเสริมกำลังดาลประตูเมืองของเจ้า และทรงอวยพรลูกหลานที่อยู่ภายในเจ้า"},{"verse":14,"text":"พระองค์ทรงประทานสันติสุขที่ชายแดนของเจ้า ทรงให้เจ้าอิ่มด้วยข้าวสาลีอย่างดีที่สุด"},{"verse":15,"text":"พระองค์ทรงส่งพระบัญชาของพระองค์ไปยังแผ่นดินโลก พระวจนะของพระองค์แล่นไปอย่างรวดเร็ว"},{"verse":16,"text":"พระองค์ทรงโปรยหิมะดุจขนแกะ ทรงโปรยน้ำค้างแข็งดุจขี้เถ้า"},{"verse":17,"text":"พระองค์ทรงเหวี่ยงลูกเห็บของพระองค์ลงมาดุจก้อนกรวด ใครจะทนต่อความหนาวเย็นของพระองค์ได้"},{"verse":18,"text":"พระองค์ทรงส่งพระวจนะของพระองค์ออกไปและทำให้สิ่งเหล่านั้นละลาย ทรงให้ลมของพระองค์พัดและน้ำก็ไหลไป"},{"verse":19,"text":"พระองค์ทรงสำแดงพระวจนะของพระองค์แก่ยาโคบ ทรงสำแดงกฎเกณฑ์และข้อตัดสินของพระองค์แก่อิสราเอล"},{"verse":20,"text":"พระองค์ไม่ได้ทรงกระทำเช่นนี้แก่ชนชาติอื่นใด พวกเขาไม่รู้จักข้อตัดสินของพระองค์ ฮาเลลูยาห์"}]},{"chapter":148,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ จงสรรเสริญองค์พระผู้เป็นเจ้าจากฟ้าสวรรค์ จงสรรเสริญพระองค์ในที่สูงสุด"},{"verse":2,"text":"ทูตสวรรค์ทั้งสิ้นของพระองค์เอ๋ย จงสรรเสริญพระองค์ บรรดาพลโยธาในสวรรค์ของพระองค์เอ๋ย จงสรรเสริญพระองค์"},{"verse":3,"text":"ดวงอาทิตย์และดวงจันทร์เอ๋ย จงสรรเสริญพระองค์ ดวงดาวที่ส่องแสงทั้งสิ้นเอ๋ย จงสรรเสริญพระองค์"},{"verse":4,"text":"ฟ้าสวรรค์ที่สูงที่สุดเอ๋ย และน้ำที่อยู่เหนือท้องฟ้าเอ๋ย จงสรรเสริญพระองค์"},{"verse":5,"text":"ให้สิ่งเหล่านั้นสรรเสริญพระนามขององค์พระผู้เป็นเจ้า เพราะพระองค์ทรงบัญชา สิ่งเหล่านั้นก็ถูกสร้างขึ้น"},{"verse":6,"text":"พระองค์ทรงสถาปนาสิ่งเหล่านั้นไว้เป็นนิตย์นิรันดร์ ทรงออกกฎเกณฑ์ที่จะไม่มีวันสูญสิ้นไป"},{"verse":7,"text":"จงสรรเสริญองค์พระผู้เป็นเจ้าจากแผ่นดินโลก เจ้าสัตว์ทะเลขนาดใหญ่และห้วงน้ำลึกทั้งสิ้น"},{"verse":8,"text":"ฟ้าแลบและลูกเห็บ หิมะและเมฆหมอก ลมพายุที่กระทำตามพระวจนะของพระองค์"},{"verse":9,"text":"ภูเขาและเนินเขาทั้งสิ้น ต้นไม้ผลและต้นสนซีดาร์ทั้งปวง"},{"verse":10,"text":"สัตว์ป่าและสัตว์เลี้ยงทั้งสิ้น สัตว์เลื้อยคลานและนกที่บินได้"},{"verse":11,"text":"บรรดากษัตริย์แห่งแผ่นดินโลกและชนชาติทั้งปวง บรรดาเจ้านายและผู้ปกครองทั้งสิ้นแห่งแผ่นดินโลก"},{"verse":12,"text":"ชายหนุ่มและหญิงสาว คนชราและเด็กๆ ด้วยกัน"},{"verse":13,"text":"ให้พวกเขาสรรเสริญพระนามขององค์พระผู้เป็นเจ้า เพราะพระนามของพระองค์เท่านั้นที่สูงส่ง พระบารมีของพระองค์อยู่เหนือแผ่นดินโลกและฟ้าสวรรค์"},{"verse":14,"text":"พระองค์ทรงชูเขาสัตว์ขึ้นสำหรับประชากรของพระองค์ เป็นที่สรรเสริญของบรรดาผู้ภักดีของพระองค์ทั้งสิ้น คืออิสราเอลชนชาติที่อยู่ใกล้ชิดพระองค์ ฮาเลลูยาห์"}]},{"chapter":149,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ จงร้องเพลงบทใหม่ถวายแด่องค์พระผู้เป็นเจ้า จงร้องเพลงสรรเสริญพระองค์ในที่ชุมนุมของบรรดาผู้ภักดี"},{"verse":2,"text":"ให้อิสราเอลเปรมปรีดิ์ในพระผู้ทรงสร้างพวกเขา ให้บรรดาบุตรแห่งศิโยนชื่นชมยินดีในกษัตริย์ของพวกเขา"},{"verse":3,"text":"ให้พวกเขาสรรเสริญพระนามของพระองค์ด้วยการเต้นรำ ให้บรรเลงดนตรีถวายแด่พระองค์ด้วยรำมะนาและพิณ"},{"verse":4,"text":"เพราะองค์พระผู้เป็นเจ้าทรงปีติยินดีในประชากรของพระองค์ พระองค์ทรงประดับผู้ที่ถ่อมใจด้วยความรอด"},{"verse":5,"text":"ให้บรรดาผู้ภักดีลิงโลดในพระสิริ ให้พวกเขาร้องเพลงด้วยความชื่นบานบนที่นอนของตน"},{"verse":6,"text":"ขอให้คำสรรเสริญพระเจ้าอันสูงส่งอยู่ในปากของพวกเขา และดาบสองคมอยู่ในมือของพวกเขา"},{"verse":7,"text":"เพื่อกระทำการแก้แค้นต่อบรรดาประชาชาติ และลงโทษชนชาติทั้งหลาย"},{"verse":8,"text":"เพื่อล่ามบรรดากษัตริย์ของพวกเขาด้วยโซ่ตรวน และล่ามบรรดาขุนนางของพวกเขาด้วยเครื่องพันธนาการเหล็ก"},{"verse":9,"text":"เพื่อกระทำการพิพากษาที่บันทึกไว้ต่อสู้พวกเขา เกียรตินี้เป็นของบรรดาผู้ภักดีของพระองค์ทั้งสิ้น ฮาเลลูยาห์"}]},{"chapter":150,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ จงสรรเสริญพระเจ้าในสถานนมัสการของพระองค์ จงสรรเสริญพระองค์ในท้องฟ้าอันทรงฤทธิ์ของพระองค์"},{"verse":2,"text":"จงสรรเสริญพระองค์เพราะพระราชกิจอันทรงฤทธิ์ของพระองค์ จงสรรเสริญพระองค์ตามความยิ่งใหญ่อันเลิศล้ำของพระองค์"},{"verse":3,"text":"จงสรรเสริญพระองค์ด้วยเสียงเป่าเขาสัตว์ จงสรรเสริญพระองค์ด้วยพิณใหญ่และพิณเขาคู่"},{"verse":4,"text":"จงสรรเสริญพระองค์ด้วยรำมะนาและการเต้นรำ จงสรรเสริญพระองค์ด้วยเครื่องสายและขลุ่ย"},{"verse":5,"text":"จงสรรเสริญพระองค์ด้วยเสียงฉาบที่กังวาน จงสรรเสริญพระองค์ด้วยเสียงฉาบที่ดังก้อง"},{"verse":6,"text":"ให้ทุกสิ่งที่มีลมหายใจสรรเสริญองค์พระผู้เป็นเจ้า ฮาเลลูยาห์"}]}]},{"osis":"Prov","usfm":"PRO","name_en":"Proverbs","name_th":"สุภาษิต","chapters":[{"chapter":1,"verses":[{"verse":1,"text":"สุภาษิตของซาโลมอน โอรสของดาวิด กษัตริย์แห่งอิสราเอล"},{"verse":2,"text":"เพื่อให้รู้ถึงปัญญาและคำสั่งสอน เพื่อให้เข้าใจถ้อยคำแห่งความหยั่งรู้"},{"verse":3,"text":"เพื่อรับคำสั่งสอนในการดำเนินชีวิตอย่างมีปัญญา ในความชอบธรรม ความยุติธรรม และความเที่ยงตรง"},{"verse":4,"text":"เพื่อให้คนรู้น้อยมีความสุขุม และให้คนหนุ่มมีความรู้และความรอบคอบ"},{"verse":5,"text":"ให้คนมีปัญญาฟังและเพิ่มพูนการเรียนรู้ และให้คนที่มีความเข้าใจได้รับคำแนะนำที่ชาญฉลาด"},{"verse":6,"text":"เพื่อเข้าใจสุภาษิตและคำอุปมา ถ้อยคำและปริศนาของคนมีปัญญา"},{"verse":7,"text":"ความยำเกรงองค์พระผู้เป็นเจ้าเป็นจุดเริ่มต้นของความรู้ แต่คนโง่ดูหมิ่นปัญญาและคำสั่งสอน"},{"verse":8,"text":"ลูกเอ๋ย จงฟังคำสั่งสอนของบิดาเจ้า และอย่าละทิ้งคำสอนของมารดาเจ้า"},{"verse":9,"text":"เพราะสิ่งเหล่านั้นเป็นเหมือนมาลัยประดับศีรษะของเจ้า และเป็นสร้อยคล้องคอของเจ้า"},{"verse":10,"text":"ลูกเอ๋ย หากคนบาปชักชวนเจ้า อย่ายอมตามพวกเขา"},{"verse":11,"text":"หากพวกเขากล่าวว่า ‘มากับเราเถิด ให้เราซุ่มดักเอาเลือด ให้เราดักทำร้ายคนบริสุทธิ์โดยไม่มีเหตุ"},{"verse":12,"text":"ให้เรากลืนพวกเขาทั้งเป็นเหมือนแดนคนตาย กลืนทั้งตัวเหมือนคนที่ลงไปในหลุมลึก"},{"verse":13,"text":"เราจะได้ข้าวของล้ำค่าทุกชนิด เราจะเติมบ้านของเราให้เต็มด้วยของที่ปล้นมา"},{"verse":14,"text":"จงเข้าหุ้นกับเรา ให้เราทุกคนใช้กระเป๋าเงินใบเดียวกัน’"},{"verse":15,"text":"ลูกเอ๋ย อย่าเดินไปตามทางเดียวกับพวกเขา จงยับยั้งเท้าของเจ้าจากวิถีของพวกเขา"},{"verse":16,"text":"เพราะเท้าของพวกเขาวิ่งไปหาความชั่ว และพวกเขารีบเร่งที่จะทำให้เลือดตก"},{"verse":17,"text":"การกางตาข่ายให้นกทุกตัวเห็นนั้นช่างเปล่าประโยชน์"},{"verse":18,"text":"แต่คนเหล่านี้ซุ่มดักเอาเลือดของตนเอง พวกเขาดักทำร้ายชีวิตของตนเอง"},{"verse":19,"text":"นี่คือจุดจบของทุกคนที่โลภมักได้ ความโลภนั้นเอาชีวิตของเจ้าของมันไปเสีย"},{"verse":20,"text":"ปัญญาร้องป่าวประกาศอยู่ตามถนน นางเปล่งเสียงของนางในลานเมือง"},{"verse":21,"text":"นางร้องเรียกที่หัวมุมถนนอันจอแจ นางกล่าวถ้อยคำของนางที่ประตูเมือง"},{"verse":22,"text":"‘เจ้าคนรู้น้อยทั้งหลาย เจ้าจะรักความโง่เขลาของเจ้าไปอีกนานเท่าใด คนชอบเยาะเย้ยจะหลงใหลในการเยาะเย้ยไปนานเท่าใด และคนโง่จะเกลียดความรู้ไปนานเท่าใด"},{"verse":23,"text":"หากเจ้าหันกลับเมื่อเราตักเตือน เราก็จะเทวิญญาณของเราลงเหนือเจ้า เราจะให้ถ้อยคำของเราเป็นที่รู้แก่เจ้า"},{"verse":24,"text":"เพราะเราร้องเรียกแล้วเจ้าปฏิเสธ เรายื่นมือออกแล้วไม่มีใครใส่ใจ"},{"verse":25,"text":"เพราะเจ้าเพิกเฉยต่อคำแนะนำทั้งสิ้นของเรา และไม่ยอมรับการตักเตือนของเรา"},{"verse":26,"text":"เราก็จะหัวเราะเยาะเมื่อความหายนะมาถึงเจ้า เราจะเย้ยหยันเมื่อความหวาดกลัวจู่โจมเจ้า"},{"verse":27,"text":"เมื่อความหวาดกลัวมาถึงเจ้าดุจพายุ และความพินาศของเจ้ามาดุจลมหมุน เมื่อความทุกข์และความเดือดร้อนท่วมท้นเจ้า"},{"verse":28,"text":"แล้วพวกเขาจะร้องเรียกเรา แต่เราจะไม่ตอบ พวกเขาจะแสวงหาเราอย่างจริงจัง แต่จะไม่พบเรา"},{"verse":29,"text":"เพราะพวกเขาเกลียดความรู้ และเลือกที่จะไม่ยำเกรงองค์พระผู้เป็นเจ้า"},{"verse":30,"text":"พวกเขาไม่ยอมรับคำแนะนำของเรา และดูหมิ่นการตักเตือนทั้งสิ้นของเรา"},{"verse":31,"text":"ดังนั้นพวกเขาจะกินผลแห่งวิถีทางของตนเอง และอิ่มด้วยผลจากแผนการของตนเอง"},{"verse":32,"text":"เพราะการหันเหของคนรู้น้อยจะฆ่าพวกเขา และความประมาทของคนโง่จะทำลายพวกเขา"},{"verse":33,"text":"แต่ผู้ใดที่ฟังเรา จะอาศัยอยู่อย่างปลอดภัย และสงบสุขปราศจากความกลัวภัย"}]},{"chapter":2,"verses":[{"verse":1,"text":"ลูกเอ๋ย หากเจ้ารับถ้อยคำของเรา และสะสมคำสั่งสอนของเราไว้กับตัว"},{"verse":2,"text":"โดยเงี่ยหูฟังปัญญา และน้อมใจของเจ้าสู่ความเข้าใจ"},{"verse":3,"text":"หากเจ้าร้องเรียกหาความหยั่งรู้ และเปล่งเสียงหาความเข้าใจ"},{"verse":4,"text":"หากเจ้าแสวงหาสิ่งนี้ดุจหาเงิน และเสาะหาดุจหาขุมทรัพย์ที่ซ่อนอยู่"},{"verse":5,"text":"แล้วเจ้าจะเข้าใจความยำเกรงองค์พระผู้เป็นเจ้า และจะพบความรู้ของพระเจ้า"},{"verse":6,"text":"เพราะองค์พระผู้เป็นเจ้าประทานปัญญา จากพระโอษฐ์ของพระองค์มีความรู้และความเข้าใจ"},{"verse":7,"text":"พระองค์ทรงสะสมปัญญาอันสมบูรณ์ไว้ให้คนเที่ยงธรรม ทรงเป็นโล่ให้แก่ผู้ที่ดำเนินอย่างไร้ที่ติ"},{"verse":8,"text":"พระองค์ทรงพิทักษ์วิถีแห่งความยุติธรรม และทรงปกป้องทางของผู้ภักดีของพระองค์"},{"verse":9,"text":"แล้วเจ้าจะเข้าใจความชอบธรรม ความยุติธรรม และความเที่ยงตรง คือวิถีอันดีทุกทาง"},{"verse":10,"text":"เพราะปัญญาจะเข้าสู่ใจของเจ้า และความรู้จะเป็นที่ชื่นใจแก่จิตวิญญาณของเจ้า"},{"verse":11,"text":"ความรอบคอบจะคุ้มครองเจ้า และความเข้าใจจะปกป้องเจ้า"},{"verse":12,"text":"เพื่อช่วยเจ้าให้พ้นจากทางของคนชั่ว จากคนที่พูดจาตลบตะแลง"},{"verse":13,"text":"ผู้ละทิ้งวิถีอันเที่ยงตรงเพื่อเดินในทางมืด"},{"verse":14,"text":"ผู้ยินดีในการทำชั่ว และเปรมปรีดิ์ในความวิปริตของคนชั่ว"},{"verse":15,"text":"ผู้มีวิถีคดเคี้ยว และทางเดินอันบิดเบี้ยว"},{"verse":16,"text":"ปัญญาจะช่วยเจ้าให้พ้นจากหญิงชั่ว จากหญิงแปลกหน้าที่พูดจาประจบ"},{"verse":17,"text":"ผู้ละทิ้งคู่ครองในวัยสาวของนาง และลืมพันธสัญญาต่อพระเจ้าของนาง"},{"verse":18,"text":"เพราะบ้านของนางจมดิ่งสู่ความตาย และวิถีของนางนำไปสู่เหล่าคนตาย"},{"verse":19,"text":"ทุกคนที่ไปหานางจะไม่กลับมา และจะไม่พบวิถีแห่งชีวิตอีก"},{"verse":20,"text":"ดังนั้นเจ้าจงเดินในทางของคนดี และรักษาวิถีของคนชอบธรรม"},{"verse":21,"text":"เพราะคนเที่ยงธรรมจะได้อาศัยอยู่ในแผ่นดิน และคนไร้ที่ติจะคงอยู่ที่นั่น"},{"verse":22,"text":"แต่คนชั่วจะถูกตัดขาดจากแผ่นดิน และคนทรยศจะถูกถอนรากออกไป"}]},{"chapter":3,"verses":[{"verse":1,"text":"ลูกเอ๋ย อย่าลืมคำสอนของเรา แต่ให้ใจของเจ้ารักษาคำสั่งสอนของเราไว้"},{"verse":2,"text":"เพราะสิ่งเหล่านั้นจะเพิ่มความยืนยาวแก่วันคืนของเจ้า และเพิ่มปีเดือนและสันติสุขแก่ชีวิตของเจ้า"},{"verse":3,"text":"อย่าให้ความรักมั่นคงและความซื่อสัตย์ละจากเจ้า 