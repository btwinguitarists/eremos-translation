ะองค์ และการอัศจรรย์ที่พระองค์ทรงกระทำเพื่อบุตรของมนุษย์"},{"verse":32,"text":"ขอให้พวกเขายกย่องพระองค์ในที่ชุมนุมของประชาชน และสรรเสริญพระองค์ในที่ประชุมของบรรดาผู้อาวุโส"},{"verse":33,"text":"พระองค์ทรงเปลี่ยนแม่น้ำให้เป็นถิ่นทุรกันดาร และเปลี่ยนน้ำพุให้เป็นพื้นดินแห้งแล้ง"},{"verse":34,"text":"และเปลี่ยนแผ่นดินอุดมให้เป็นทุ่งเกลือ เพราะความชั่วร้ายของผู้อาศัยในนั้น"},{"verse":35,"text":"พระองค์ทรงเปลี่ยนถิ่นทุรกันดารให้เป็นแอ่งน้ำ และเปลี่ยนแผ่นดินแห้งแล้งให้เป็นน้ำพุที่ไหลริน"},{"verse":36,"text":"พระองค์ทรงให้คนหิวโหยมาตั้งถิ่นฐานที่นั่น เพื่อพวกเขาจะได้สร้างเมืองที่จะอาศัยอยู่"},{"verse":37,"text":"พวกเขาหว่านพืชในนาและปลูกสวนองุ่น ซึ่งให้ผลเก็บเกี่ยวอุดมสมบูรณ์"},{"verse":38,"text":"พระองค์ทรงอวยพรพวกเขา และพวกเขาก็ทวีจำนวนขึ้นมากมาย พระองค์ไม่ทรงให้ฝูงสัตว์ของพวกเขาลดน้อยลง"},{"verse":39,"text":"เมื่อพวกเขาลดจำนวนลงและตกต่ำเพราะการกดขี่ ความทุกข์ และความโศกเศร้า"},{"verse":40,"text":"พระองค์ทรงเทความดูหมิ่นลงเหนือบรรดาขุนนาง และทรงทำให้พวกเขาระเหเร่ร่อนในที่เปลี่ยวที่ไร้ทาง"},{"verse":41,"text":"แต่พระองค์ทรงยกชูคนขัดสนให้พ้นจากความทุกข์ และทรงทำให้ครอบครัวของพวกเขาเพิ่มพูนขึ้นเหมือนฝูงแกะ"},{"verse":42,"text":"คนเที่ยงธรรมเห็นแล้วก็ยินดี และความชั่วทั้งปวงก็ปิดปากเงียบ"},{"verse":43,"text":"ผู้ใดมีปัญญา ก็ให้เขาใส่ใจในสิ่งเหล่านี้ และพิจารณาความรักมั่นคงขององค์พระผู้เป็นเจ้า"}]},{"chapter":108,"title":"บทเพลง บทเพลงสดุดีของดาวิด","verses":[{"verse":1,"text":"ข้าแต่พระเจ้า จิตใจของข้าพระองค์มั่นคง ข้าพระองค์จะร้องเพลงและบรรเลงสรรเสริญด้วยสุดจิตสุดใจ"},{"verse":2,"text":"พิณใหญ่และพิณเล็กเอ๋ย จงตื่นเถิด ข้าพระองค์จะปลุกอรุณรุ่ง"},{"verse":3,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ข้าพระองค์จะขอบพระคุณพระองค์ท่ามกลางชนชาติทั้งหลาย ข้าพระองค์จะร้องเพลงสรรเสริญพระองค์ท่ามกลางประชาชาติ"},{"verse":4,"text":"เพราะความรักมั่นคงของพระองค์ใหญ่หลวงเหนือฟ้าสวรรค์ และความซื่อสัตย์ของพระองค์สูงถึงเมฆ"},{"verse":5,"text":"ข้าแต่พระเจ้า ขอทรงเป็นที่เทิดทูนเหนือฟ้าสวรรค์ ขอพระสิริของพระองค์อยู่เหนือทั่วทั้งแผ่นดินโลก"},{"verse":6,"text":"เพื่อผู้ที่พระองค์ทรงรักจะได้รับการช่วยกู้ ขอทรงตอบข้าพระองค์ทั้งหลายและทรงช่วยให้รอดด้วยพระหัตถ์ขวาของพระองค์"},{"verse":7,"text":"พระเจ้าตรัสในความบริสุทธิ์ของพระองค์ว่า ‘เราจะปีติยินดี เราจะแบ่งเมืองเชเคม และจะแบ่งหุบเขาสุคคทออก’"},{"verse":8,"text":"‘กิเลอาดเป็นของเรา มนัสเสห์ก็เป็นของเรา เอฟราอิมเป็นหมวกเกราะแห่งศีรษะของเรา ยูดาห์เป็นคทาของเรา’"},{"verse":9,"text":"‘โมอับเป็นอ่างชำระล้างของเรา เราจะเหวี่ยงรองเท้าของเราลงเหนือเอโดม เราจะโห่ร้องชัยชนะเหนือแผ่นดินฟีลิสเตีย’"},{"verse":10,"text":"ใครจะนำข้าพระองค์เข้าสู่เมืองป้อมปราการ ใครจะพาข้าพระองค์ไปยังเอโดม"},{"verse":11,"text":"ข้าแต่พระเจ้า มิใช่พระองค์หรือที่ทรงทอดทิ้งเรา และไม่เสด็จออกไปกับกองทัพของเราอีกแล้ว"},{"verse":12,"text":"ขอทรงช่วยเราให้พ้นจากศัตรู เพราะความช่วยเหลือจากมนุษย์นั้นไร้ค่า"},{"verse":13,"text":"โดยพระเจ้า เราจะมีชัยชนะ พระองค์จะทรงเหยียบย่ำศัตรูของเรา"}]},{"chapter":109,"verses":[{"verse":1,"text":"ถึงหัวหน้านักดนตรี บทเพลงสดุดีของดาวิด ข้าแต่พระเจ้าผู้ที่ข้าพระองค์สรรเสริญ ขออย่าทรงเงียบอยู่เลย"},{"verse":2,"text":"เพราะปากของคนชั่วและคนเจ้าเล่ห์เปิดออกต่อสู้ข้าพระองค์ พวกเขาพูดใส่ร้ายข้าพระองค์ด้วยลิ้นที่โกหก"},{"verse":3,"text":"พวกเขารุมล้อมข้าพระองค์ด้วยถ้อยคำแห่งความเกลียดชัง และโจมตีข้าพระองค์โดยไม่มีเหตุ"},{"verse":4,"text":"เขาตอบแทนความรักของข้าพระองค์ด้วยการกล่าวหา แต่ข้าพระองค์เป็นคนแห่งการอธิษฐาน"},{"verse":5,"text":"พวกเขาตอบแทนข้าพระองค์ด้วยความชั่วแทนความดี และด้วยความเกลียดชังแทนความรักของข้าพระองค์"},{"verse":6,"text":"ขอทรงตั้งคนชั่วให้อยู่เหนือเขา ขอให้มีผู้กล่าวหายืนอยู่ข้างขวาของเขา"},{"verse":7,"text":"เมื่อเขาถูกพิพากษา ขอให้เขาถูกตัดสินว่าผิด และขอให้คำอธิษฐานของเขากลายเป็นบาป"},{"verse":8,"text":"ขอให้วันเวลาของเขาเหลือน้อย และให้คนอื่นมายึดตำแหน่งของเขา"},{"verse":9,"text":"ขอให้ลูกๆ ของเขากำพร้าพ่อ และให้ภรรยาของเขาเป็นม่าย"},{"verse":10,"text":"ขอให้ลูกๆ ของเขาระเหเร่ร่อนไปขอทาน เสาะหาอาหารห่างไกลจากบ้านที่ปรักหักพังของพวกเขา"},{"verse":11,"text":"ขอให้เจ้าหนี้ยึดทุกสิ่งที่เขามี และให้คนแปลกหน้าปล้นผลแห่งการตรากตรำของเขา"},{"verse":12,"text":"ขออย่าให้มีใครสำแดงความกรุณาต่อเขา และอย่าให้ใครเมตตาลูกกำพร้าของเขา"},{"verse":13,"text":"ขอให้เชื้อสายของเขาถูกตัดขาด และให้ชื่อของพวกเขาถูกลบไปในชั่วอายุถัดไป"},{"verse":14,"text":"ขอให้ความผิดบาปของบรรพบุรุษของเขาเป็นที่ระลึกต่อพระพักตร์องค์พระผู้เป็นเจ้า และอย่าให้บาปของมารดาเขาถูกลบเลย"},{"verse":15,"text":"ขอให้บาปของพวกเขาอยู่ต่อหน้าองค์พระผู้เป็นเจ้าเสมอ เพื่อพระองค์จะทรงตัดความทรงจำถึงพวกเขาออกจากแผ่นดินโลก"},{"verse":16,"text":"เพราะเขาไม่เคยคิดที่จะสำแดงความกรุณา แต่กลับข่มเหงคนยากจน คนขัดสน และคนชอกช้ำใจ จนถึงความตาย"},{"verse":17,"text":"เขารักการสาปแช่ง ขอให้การสาปแช่งนั้นตกแก่เขา เขาไม่ยินดีในการอวยพร ขอให้พรนั้นห่างไกลจากเขา"},{"verse":18,"text":"เขาสวมการสาปแช่งเหมือนเสื้อคลุม ขอให้มันซึมเข้าในตัวเขาเหมือนน้ำ และเข้าในกระดูกของเขาเหมือนน้ำมัน"},{"verse":19,"text":"ขอให้มันเป็นเหมือนเสื้อที่ห่อหุ้มเขาไว้ เหมือนเข็มขัดที่คาดรอบตัวเขาไว้เป็นนิตย์"},{"verse":20,"text":"ขอให้นี่เป็นบำเหน็จจากองค์พระผู้เป็นเจ้าแก่ผู้ที่กล่าวหาข้าพระองค์ แก่ผู้ที่พูดร้ายต่อข้าพระองค์"},{"verse":21,"text":"แต่ข้าแต่องค์พระผู้เป็นเจ้า องค์เจ้านายของข้าพระองค์ ขอทรงกระทำต่อข้าพระองค์ด้วยความกรุณาเพื่อเห็นแก่พระนามของพระองค์ ขอทรงช่วยกู้ข้าพระองค์ด้วยความรักมั่นคงอันประเสริฐของพระองค์"},{"verse":22,"text":"เพราะข้าพระองค์ยากจนและขัดสน และใจของข้าพระองค์ก็ชอกช้ำอยู่ภายใน"},{"verse":23,"text":"ข้าพระองค์กำลังจางหายไปเหมือนเงาที่ทอดยาว ข้าพระองค์ถูกสลัดทิ้งเหมือนตั๊กแตน"},{"verse":24,"text":"เข่าของข้าพระองค์อ่อนเปลี้ยเพราะการอดอาหาร และร่างกายของข้าพระองค์ก็ซูบผอม"},{"verse":25,"text":"ข้าพระองค์กลายเป็นที่เยาะเย้ยของผู้ที่กล่าวหาข้าพระองค์ เมื่อพวกเขาเห็นข้าพระองค์ ก็สั่นศีรษะ"},{"verse":26,"text":"ข้าแต่องค์พระผู้เป็นเจ้าพระเจ้าของข้าพระองค์ ขอทรงช่วยข้าพระองค์ ขอทรงช่วยข้าพระองค์ให้รอดตามความรักมั่นคงของพระองค์"},{"verse":27,"text":"ขอให้พวกเขารู้ว่านี่เป็นพระหัตถ์ของพระองค์ ข้าแต่องค์พระผู้เป็นเจ้า พระองค์เองเป็นผู้กระทำการนี้"},{"verse":28,"text":"ถึงแม้พวกเขาจะสาปแช่ง แต่พระองค์จะทรงอวยพร เมื่อพวกเขาลุกขึ้นต่อสู้ พวกเขาจะต้องอับอาย แต่ผู้รับใช้ของพระองค์จะเปรมปรีดิ์"},{"verse":29,"text":"ขอให้ผู้ที่กล่าวหาข้าพระองค์สวมความอัปยศ ขอให้พวกเขาห่มความอับอายของตนเหมือนเสื้อคลุม"},{"verse":30,"text":"ข้าพระองค์จะขอบพระคุณองค์พระผู้เป็นเจ้าอย่างยิ่งด้วยปากของข้าพระองค์ ข้าพระองค์จะสรรเสริญพระองค์ท่ามกลางคนเป็นอันมาก"},{"verse":31,"text":"เพราะพระองค์ทรงยืนอยู่ที่เบื้องขวาของผู้ขัดสน เพื่อช่วยเขาให้รอดจากบรรดาผู้ที่ตัดสินลงโทษชีวิตของเขา"}]},{"chapter":110,"verses":[{"verse":1,"text":"บทเพลงสดุดีของดาวิด องค์พระผู้เป็นเจ้าตรัสกับองค์เจ้านายของข้าพเจ้าว่า ‘จงนั่งที่เบื้องขวาของเรา จนกว่าเราจะทำให้ศัตรูของพระองค์เป็นที่รองพระบาทของพระองค์’"},{"verse":2,"text":"องค์พระผู้เป็นเจ้าจะทรงยื่นคทาแห่งฤทธานุภาพของพระองค์ออกไปจากศิโยน ว่า ‘ขอจงครอบครองท่ามกลางศัตรูของพระองค์’"},{"verse":3,"text":"ในวันที่พระองค์ทรงยกทัพ ประชากรของพระองค์จะมาถวายตัวด้วยความเต็มใจ ในเครื่องประดับอันบริสุทธิ์ น้ำค้างแห่งวัยหนุ่มของพระองค์จะมาถึงพระองค์จากครรภ์แห่งรุ่งอรุณ"},{"verse":4,"text":"องค์พระผู้เป็นเจ้าทรงปฏิญาณแล้ว และจะไม่ทรงคืนคำ ว่า ‘พระองค์ทรงเป็นปุโรหิตเป็นนิตย์ ตามแบบของเมลคีเซเดค’"},{"verse":5,"text":"องค์เจ้านายผู้สถิตที่เบื้องขวาของพระองค์ จะทรงทุบบรรดากษัตริย์ให้แหลกในวันแห่งพระพิโรธของพระองค์"},{"verse":6,"text":"พระองค์จะทรงพิพากษาบรรดาประชาชาติ ทำให้ศพกองพะเนิน พระองค์จะทรงทุบบรรดาผู้นำให้แหลกไปทั่วแผ่นดินอันกว้างใหญ่"},{"verse":7,"text":"พระองค์จะทรงดื่มน้ำจากลำธารริมทาง เพราะฉะนั้นพระองค์จะทรงเงยพระเศียรขึ้น"}]},{"chapter":111,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ ข้าพเจ้าจะขอบพระคุณองค์พระผู้เป็นเจ้าด้วยสุดใจ ในที่ประชุมของคนเที่ยงธรรมและในที่ชุมนุม"},{"verse":2,"text":"พระราชกิจขององค์พระผู้เป็นเจ้ายิ่งใหญ่ ทุกคนที่ปีติยินดีในพระราชกิจนั้นก็พินิจพิเคราะห์"},{"verse":3,"text":"พระราชกิจของพระองค์เปี่ยมด้วยความโอ่อ่าและความสง่างาม และความชอบธรรมของพระองค์ดำรงเป็นนิตย์"},{"verse":4,"text":"พระองค์ทรงทำให้การอัศจรรย์ของพระองค์เป็นที่จดจำ องค์พระผู้เป็นเจ้าทรงพระคุณและทรงพระเมตตา"},{"verse":5,"text":"พระองค์ประทานอาหารแก่บรรดาผู้ที่ยำเกรงพระองค์ พระองค์ทรงระลึกถึงพันธสัญญาของพระองค์เป็นนิตย์"},{"verse":6,"text":"พระองค์ทรงสำแดงฤทธิ์แห่งพระราชกิจของพระองค์แก่ประชากรของพระองค์ โดยประทานมรดกของบรรดาประชาชาติให้แก่พวกเขา"},{"verse":7,"text":"พระราชกิจแห่งพระหัตถ์ของพระองค์เป็นความจริงและความยุติธรรม ข้อบังคับทั้งสิ้นของพระองค์ก็เชื่อถือได้"},{"verse":8,"text":"ข้อบังคับเหล่านั้นได้รับการสถาปนาไว้เป็นนิตย์นิรันดร์ และถูกบัญญัติขึ้นด้วยความจริงและความเที่ยงตรง"},{"verse":9,"text":"พระองค์ทรงส่งการไถ่มาให้ประชากรของพระองค์ พระองค์ทรงบัญชาพันธสัญญาของพระองค์ไว้เป็นนิตย์ พระนามของพระองค์บริสุทธิ์และน่าเกรงขาม"},{"verse":10,"text":"ความยำเกรงองค์พระผู้เป็นเจ้าเป็นบ่อเกิดแห่งสติปัญญา ทุกคนที่ปฏิบัติตามข้อบังคับของพระองค์ก็ได้รับความเข้าใจอันดี การสรรเสริญพระองค์ดำรงอยู่เป็นนิตย์"}]},{"chapter":112,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ ความสุขเป็นของคนที่ยำเกรงองค์พระผู้เป็นเจ้า ผู้ปีติยินดียิ่งในพระบัญญัติของพระองค์"},{"verse":2,"text":"เชื้อสายของเขาจะมีอำนาจในแผ่นดิน คนรุ่นของคนเที่ยงธรรมจะได้รับพร"},{"verse":3,"text":"ทรัพย์สมบัติและความมั่งคั่งอยู่ในบ้านของเขา และความชอบธรรมของเขาดำรงเป็นนิตย์"},{"verse":4,"text":"แสงสว่างส่องขึ้นในความมืดสำหรับคนเที่ยงธรรม สำหรับคนที่มีพระคุณ มีความเมตตา และชอบธรรม"},{"verse":5,"text":"เป็นการดีสำหรับคนที่ใจกว้างและให้ยืมด้วยใจกว้าง ผู้จัดการกิจการของตนด้วยความยุติธรรม"},{"verse":6,"text":"แน่ทีเดียว เขาจะไม่มีวันคลอนแคลน คนชอบธรรมจะเป็นที่ระลึกตลอดไป"},{"verse":7,"text":"เขาไม่กลัวข่าวร้าย จิตใจของเขามั่นคง วางใจในองค์พระผู้เป็นเจ้า"},{"verse":8,"text":"จิตใจของเขามั่นคง เขาไม่หวาดกลัว จนกระทั่งเขาได้เห็นชัยชนะเหนือศัตรูของตน"},{"verse":9,"text":"เขาได้แจกจ่ายของของเขาให้แก่คนยากจน ความชอบธรรมของเขาดำรงเป็นนิตย์ เขาของเขาจะถูกเชิดชูขึ้นด้วยเกียรติ"},{"verse":10,"text":"คนชั่วจะเห็นแล้วก็ขัดเคืองใจ เขาจะขบเขี้ยวเคี้ยวฟันและทรุดโทรมไป ความปรารถนาของคนชั่วจะพินาศ"}]},{"chapter":113,"verses":[{"verse":1,"text":"ฮาเลลูยาห์ บรรดาผู้รับใช้ขององค์พระผู้เป็นเจ้าเอ๋ย จงสรรเสริญเถิด จงสรรเสริญพระนามขององค์พระผู้เป็นเจ้า"},{"verse":2,"text":"ขอให้พระนามขององค์พระผู้เป็นเจ้าได้รับการสรรเสริญ ตั้งแต่บัดนี้จนชั่วนิรันดร์"},{"verse":3,"text":"ตั้งแต่ที่ดวงอาทิตย์ขึ้นจนถึงที่ดวงอาทิตย์ตก พระนามขององค์พระผู้เป็นเจ้าก็เป็นที่สรรเสริญ"},{"verse":4,"text":"องค์พระผู้เป็นเจ้าทรงเป็นที่ยกย่องเหนือบรรดาประชาชาติ พระสิริของพระองค์อยู่เหนือฟ้าสวรรค์"},{"verse":5,"text":"ผู้ใดเล่าจะเหมือนองค์พระผู้เป็นเจ้าพระเจ้าของเรา ผู้ประทับบนบัลลังก์เบื้องสูง"},{"verse":6,"text":"พระองค์ทรงน้อมพระองค์ลงมาทอดพระเนตรดูฟ้าสวรรค์และแผ่นดินโลก"},{"verse":7,"text":"พระองค์ทรงยกชูคนยากจนขึ้นจากผงคลีดิน และทรงยกคนขัดสนขึ้นจากกองขี้เถ้า"},{"verse":8,"text":"เพื่อให้เขานั่งอยู่กับบรรดาเจ้านาย กับบรรดาเจ้านายแห่งประชากรของพระองค์"},{"verse":9,"text":"พระองค์ทรงให้หญิงที่เป็นหมันได้อยู่ในบ้านอย่างมารดาผู้ชื่นบานที่มีบุตร ฮาเลลูยาห์"}]},{"chapter":114,"verses":[{"verse":1,"text":"เมื่ออิสราเอลออกจากอียิปต์ เมื่อพงศ์พันธุ์ยาโคบจากชนชาติที่พูดภาษาต่างด้าว"},{"verse":2,"text":"ยูดาห์ก็กลายเป็นสถานนมัสการของพระเจ้า อิสราเอลกลายเป็นอาณาจักรของพระองค์"},{"verse":3,"text":"ทะเลมองดูแล้วก็หนีไป แม่น้ำจอร์แดนก็ไหลกลับ"},{"verse":4,"text":"ภูเขาทั้งหลายกระโดดโลดเต้นเหมือนแกะผู้ และเนินเขาก็เหมือนลูกแกะ"},{"verse":5,"text":"ทะเลเอ๋ย เป็นอะไรไปเล่า เจ้าจึงหนีไป จอร์แดนเอ๋ย เจ้าจึงไหลกลับ"},{"verse":6,"text":"ภูเขาทั้งหลายเอ๋ย เจ้าจึงกระโดดโลดเต้นเหมือนแกะผู้ เนินเขาเอ๋ย เจ้าจึงเป็นเหมือนลูกแกะ"},{"verse":7,"text":"แผ่นดินโลกเอ๋ย จงสั่นสะท้านต่อพระพักตร์ขององค์เจ้านาย ต่อพระพักตร์ของพระเจ้าแห่งยาโคบ"},{"verse":8,"text":"พระองค์ผู้ทรงเปลี่ยนศิลาให้เป็นสระน้ำ และเปลี่ยนหินเหล็กไฟให้เป็นน้ำพุที่ไหลริน"}]},{"chapter":115,"verses":[{"verse":1,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขออย่าให้เกียรติแก่ข้าพระองค์ทั้งหลายเลย อย่าให้แก่ข้าพระองค์ทั้งหลาย แต่ขอให้พระเกียรติเป็นของพระนามของพระองค์ เพราะความรักมั่นคงและความซื่อสัตย์ของพระองค์"},{"verse":2,"text":"ทำไมจะให้บรรดาประชาชาติกล่าวว่า ‘พระเจ้าของพวกเขาอยู่ที่ไหน’"},{"verse":3,"text":"พระเจ้าของเราสถิตในฟ้าสวรรค์ พระองค์ทรงกระทำทุกสิ่งตามที่พอพระทัย"},{"verse":4,"text":"รูปเคารพของพวกเขาทำด้วยเงินและทอง เป็นผลงานจากมือของมนุษย์"},{"verse":5,"text":"พวกมันมีปากแต่พูดไม่ได้ มีตาแต่มองไม่เห็น"},{"verse":6,"text":"มีหูแต่ฟังไม่ได้ยิน มีจมูกแต่ดมไม่ได้"},{"verse":7,"text":"มีมือแต่คลำไม่ได้ มีเท้าแต่เดินไม่ได้ และทำเสียงในลำคอก็ไม่ได้"},{"verse":8,"text":"ผู้ที่สร้างมันก็จะเป็นเหมือนมัน และทุกคนที่วางใจในมันก็เช่นกัน"},{"verse":9,"text":"อิสราเอลเอ๋ย จงวางใจในองค์พระผู้เป็นเจ้า พระองค์ทรงเป็นความช่วยเหลือและโล่ของพวกเขา"},{"verse":10,"text":"พงศ์พันธุ์อาโรนเอ๋ย จงวางใจในองค์พระผู้เป็นเจ้า พระองค์ทรงเป็นความช่วยเหลือและโล่ของพวกเขา"},{"verse":11,"text":"ท่านผู้ยำเกรงองค์พระผู้เป็นเจ้าเอ๋ย จงวางใจในองค์พระผู้เป็นเจ้า พระองค์ทรงเป็นความช่วยเหลือและโล่ของพวกเขา"},{"verse":12,"text":"องค์พระผู้เป็นเจ้าทรงระลึกถึงเรา พระองค์จะทรงอวยพรเรา พระองค์จะทรงอวยพรพงศ์พันธุ์อิสราเอล และจะทรงอวยพรพงศ์พันธุ์อาโรน"},{"verse":13,"text":"พระองค์จะทรงอวยพรบรรดาผู้ที่ยำเกรงองค์พระผู้เป็นเจ้า ทั้งผู้น้อยและผู้ใหญ่"},{"verse":14,"text":"ขอองค์พระผู้เป็นเจ้าทรงให้ท่านทั้งหลายเพิ่มพูนขึ้น ทั้งตัวท่านและลูกหลานของท่าน"},{"verse":15,"text":"ขอท่านทั้งหลายได้รับพรจากองค์พระผู้เป็นเจ้า ผู้ทรงสร้างฟ้าสวรรค์และแผ่นดินโลก"},{"verse":16,"text":"ฟ้าสวรรค์ที่สูงสุดเป็นขององค์พระผู้เป็นเจ้า แต่แผ่นดินโลกนั้นพระองค์ประทานแก่มนุษย์"},{"verse":17,"text":"คนตายไม่อาจสรรเสริญองค์พระผู้เป็นเจ้าได้ ทั้งบรรดาผู้ที่ลงไปสู่ความเงียบงันก็เช่นกัน"},{"verse":18,"text":"แต่พวกเราจะถวายสาธุการแด่องค์พระผู้เป็นเจ้า ตั้งแต่บัดนี้จนชั่วนิรันดร์ ฮาเลลูยาห์"}]},{"chapter":116,"verses":[{"verse":1,"text":"ข้าพระองค์รักองค์พระผู้เป็นเจ้า เพราะพระองค์ทรงสดับเสียงของข้าพระองค์ คือคำวิงวอนขอความเมตตาของข้าพระองค์"},{"verse":2,"text":"เพราะพระองค์ทรงเงี่ยพระกรรณลงฟังข้าพระองค์ ข้าพระองค์จะร้องทูลต่อพระองค์ตลอดชีวิตของข้าพระองค์"},{"verse":3,"text":"บ่วงแห่งความตายรัดข้าพระองค์ไว้ ความทุกข์ทรมานแห่งแดนคนตายเข้าครอบงำข้าพระองค์ ข้าพระองค์เผชิญความทุกข์ใจและความโศกเศร้า"},{"verse":4,"text":"แล้วข้าพระองค์ก็ร้องออกพระนามขององค์พระผู้เป็นเจ้าว่า ‘ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงช่วยชีวิตของข้าพระองค์’"},{"verse":5,"text":"องค์พระผู้เป็นเจ้าทรงเปี่ยมด้วยพระคุณและความชอบธรรม พระเจ้าของเราทรงเปี่ยมด้วยพระเมตตา"},{"verse":6,"text":"องค์พระผู้เป็นเจ้าทรงพิทักษ์รักษาคนใจซื่อ เมื่อข้าพระองค์ตกต่ำ พระองค์ก็ทรงช่วยข้าพระองค์ให้รอด"},{"verse":7,"text":"จิตวิญญาณของข้าพเจ้าเอ๋ย จงกลับสู่ความสงบของเจ้าเถิด เพราะองค์พระผู้เป็นเจ้าทรงดีต่อเจ้า"},{"verse":8,"text":"เพราะพระองค์ทรงช่วยชีวิตของข้าพระองค์ให้พ้นจากความตาย ทรงเช็ดน้ำตาจากนัยน์ตาของข้าพระองค์ และทรงปกป้องเท้าของข้าพระองค์ไม่ให้สะดุดล้ม"},{"verse":9,"text":"ข้าพระองค์จะดำเนินอยู่ต่อหน้าองค์พระผู้เป็นเจ้าในแผ่นดินของคนเป็น"},{"verse":10,"text":"ข้าพระองค์เชื่อ ฉะนั้นข้าพระองค์จึงกล่าวว่า ‘ข้าพระองค์ทุกข์ยากยิ่งนัก’"},{"verse":11,"text":"ในความตื่นตระหนก ข้าพระองค์กล่าวว่า ‘มนุษย์ทุกคนเป็นคนโกหก’"},{"verse":12,"text":"ข้าพระองค์จะตอบแทนองค์พระผู้เป็นเจ้าอย่างไรดี สำหรับความดีทั้งสิ้นที่ทรงมีต่อข้าพระองค์"},{"verse":13,"text":"ข้าพระองค์จะยกถ้วยแห่งความรอดขึ้น และร้องออกพระนามขององค์พระผู้เป็นเจ้า"},{"verse":14,"text":"ข้าพระองค์จะทำตามคำปฏิญาณที่ให้ไว้แด่องค์พระผู้เป็นเจ้าต่อหน้าประชากรทั้งสิ้นของพระองค์"},{"verse":15,"text":"ความตายของบรรดาผู้บริสุทธิ์ของพระองค์นั้นล้ำค่าในสายพระเนตรขององค์พระผู้เป็นเจ้า"},{"verse":16,"text":"ข้าแต่องค์พระผู้เป็นเจ้า แท้จริงข้าพระองค์เป็นผู้รับใช้ของพระองค์ ข้าพระองค์เป็นผู้รับใช้ของพระองค์ เป็นบุตรของหญิงผู้รับใช้ของพระองค์ พระองค์ทรงแก้พันธนาการของข้าพระองค์แล้ว"},{"verse":17,"text":"ข้าพระองค์จะถวายเครื่องบูชาแห่งการขอบพระคุณแด่พระองค์ และจะร้องออกพระนามขององค์พระผู้เป็นเจ้า"},{"verse":18,"text":"ข้าพระองค์จะทำตามคำปฏิญาณที่ให้ไว้แด่องค์พระผู้เป็นเจ้าต่อหน้าประชากรทั้งสิ้นของพระองค์"},{"verse":19,"text":"ในลานพระนิเวศขององค์พระผู้เป็นเจ้า ในท่ามกลางเจ้า กรุงเยรูซาเล็มเอ๋ย ฮาเลลูยาห์"}]},{"chapter":117,"verses":[{"verse":1,"text":"บรรดาประชาชาติทั้งสิ้นเอ๋ย จงสรรเสริญองค์พระผู้เป็นเจ้า ชนชาติทั้งปวงเอ๋ย จงยกย่องพระองค์"},{"verse":2,"text":"เพราะความรักมั่นคงของพระองค์ที่มีต่อเรานั้นยิ่งใหญ่ และความซื่อสัตย์ขององค์พระผู้เป็นเจ้าดำรงเป็นนิตย์ ฮาเลลูยาห์"}]},{"chapter":118,"verses":[{"verse":1,"text":"จงขอบพระคุณองค์พระผู้เป็นเจ้า เพราะพระองค์ทรงแสนดี ความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"},{"verse":2,"text":"ขอให้อิสราเอลกล่าวว่า ‘ความรักมั่นคงของพระองค์ดำรงเป็นนิตย์’"},{"verse":3,"text":"ขอให้พงศ์พันธุ์อาโรนกล่าวว่า ‘ความรักมั่นคงของพระองค์ดำรงเป็นนิตย์’"},{"verse":4,"text":"ขอให้บรรดาผู้ที่ยำเกรงองค์พระผู้เป็นเจ้ากล่าวว่า ‘ความรักมั่นคงของพระองค์ดำรงเป็นนิตย์’"},{"verse":5,"text":"ในยามทุกข์ใจ ข้าพระองค์ร้องทูลต่อองค์พระผู้เป็นเจ้า และพระองค์ทรงตอบและทรงปลดปล่อยข้าพระองค์ให้เป็นอิสระ"},{"verse":6,"text":"องค์พระผู้เป็นเจ้าทรงอยู่ฝ่ายข้าพระองค์ ข้าพระองค์จะไม่กลัว มนุษย์จะทำอะไรข้าพระองค์ได้เล่า"},{"verse":7,"text":"องค์พระผู้เป็นเจ้าทรงอยู่ฝ่ายข้าพระองค์ พระองค์ทรงเป็นผู้ช่วยของข้าพระองค์ ฉะนั้นข้าพระองค์จะมองดูผู้ที่เกลียดชังข้าพระองค์ด้วยความมีชัย"},{"verse":8,"text":"การลี้ภัยในองค์พระผู้เป็นเจ้านั้นดีกว่าการวางใจในมนุษย์"},{"verse":9,"text":"การลี้ภัยในองค์พระผู้เป็นเจ้านั้นดีกว่าการวางใจในเจ้านาย"},{"verse":10,"text":"บรรดาประชาชาติรุมล้อมข้าพระองค์ แต่ในพระนามขององค์พระผู้เป็นเจ้า ข้าพระองค์ได้กำจัดพวกเขา"},{"verse":11,"text":"พวกเขาล้อมข้าพระองค์ไว้ทุกด้าน แต่ในพระนามขององค์พระผู้เป็นเจ้า ข้าพระองค์ได้กำจัดพวกเขา"},{"verse":12,"text":"พวกเขารุมล้อมข้าพระองค์เหมือนฝูงผึ้ง แต่ก็ถูกดับไปเหมือนไฟที่เผาหนาม ในพระนามขององค์พระผู้เป็นเจ้า ข้าพระองค์ได้กำจัดพวกเขา"},{"verse":13,"text":"ข้าพระองค์ถูกผลักอย่างแรงจนเกือบล้ม แต่องค์พระผู้เป็นเจ้าทรงช่วยข้าพระองค์ไว้"},{"verse":14,"text":"องค์พระผู้เป็นเจ้าทรงเป็นกำลังและบทเพลงของข้าพระองค์ และพระองค์ทรงเป็นความรอดของข้าพระองค์"},{"verse":15,"text":"เสียงโห่ร้องด้วยความยินดีและความรอดดังก้องในเต็นท์ของคนชอบธรรมว่า ‘พระหัตถ์ขวาขององค์พระผู้เป็นเจ้าได้กระทำการอย่างกล้าหาญ"},{"verse":16,"text":"พระหัตถ์ขวาขององค์พระผู้เป็นเจ้าได้รับการเชิดชู พระหัตถ์ขวาขององค์พระผู้เป็นเจ้าได้กระทำการอย่างกล้าหาญ’"},{"verse":17,"text":"ข้าพระองค์จะไม่ตาย แต่จะมีชีวิตอยู่ และจะประกาศพระราชกิจขององค์พระผู้เป็นเจ้า"},{"verse":18,"text":"องค์พระผู้เป็นเจ้าทรงตีสอนข้าพระองค์อย่างหนัก แต่พระองค์ไม่ได้ทรงมอบข้าพระองค์ไว้แก่ความตาย"},{"verse":19,"text":"ขอเปิดประตูแห่งความชอบธรรมให้ข้าพระองค์ เพื่อข้าพระองค์จะได้เข้าไปขอบพระคุณองค์พระผู้เป็นเจ้า"},{"verse":20,"text":"นี่คือประตูขององค์พระผู้เป็นเจ้า คนชอบธรรมจะเข้าไปทางประตูนี้"},{"verse":21,"text":"ข้าพระองค์จะขอบพระคุณพระองค์ เพราะพระองค์ทรงตอบข้าพระองค์ และทรงเป็นความรอดของข้าพระองค์"},{"verse":22,"text":"ศิลาที่ช่างก่อสร้างทิ้งเสีย กลับกลายเป็นศิลามุมเอก"},{"verse":23,"text":"การนี้มาจากองค์พระผู้เป็นเจ้า และเป็นสิ่งมหัศจรรย์ในสายตาของเรา"},{"verse":24,"text":"นี่เป็นวันที่องค์พระผู้เป็นเจ้าทรงสร้างขึ้น ให้เราเปรมปรีดิ์และยินดีในวันนั้น"},{"verse":25,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงช่วยข้าพระองค์ทั้งหลายให้รอดเถิด ข้าแต่องค์พระผู้เป็นเจ้า ข้าพระองค์ทั้งหลายวิงวอน ขอทรงให้ข้าพระองค์ทั้งหลายเจริญรุ่งเรืองเถิด"},{"verse":26,"text":"ขอให้ผู้ที่เสด็จมาในพระนามขององค์พระผู้เป็นเจ้าได้รับพระพร เราอวยพรท่านทั้งหลายจากพระนิเวศขององค์พระผู้เป็นเจ้า"},{"verse":27,"text":"องค์พระผู้เป็นเจ้าทรงเป็นพระเจ้า พระองค์ทรงให้แสงสว่างของพระองค์ส่องเหนือเรา จงผูกเครื่องบูชาในเทศกาลด้วยเชือกไว้ที่เชิงงอนของแท่นบูชา"},{"verse":28,"text":"พระองค์ทรงเป็นพระเจ้าของข้าพระองค์ และข้าพระองค์จะขอบพระคุณพระองค์ พระองค์ทรงเป็นพระเจ้าของข้าพระองค์ ข้าพระองค์จะเทิดทูนพระองค์"},{"verse":29,"text":"จงขอบพระคุณองค์พระผู้เป็นเจ้า เพราะพระองค์ทรงแสนดี ความรักมั่นคงของพระองค์ดำรงเป็นนิตย์"}]},{"chapter":119,"verses":[{"verse":1,"text":"ความสุขเป็นของบรรดาผู้ที่ดำเนินในทางที่ไร้ตำหนิ ผู้ดำเนินตามธรรมบัญญัติขององค์พระผู้เป็นเจ้า"},{"verse":2,"text":"ความสุขเป็นของบรรดาผู้ที่รักษาพระโอวาทของพระองค์ และแสวงหาพระองค์ด้วยสุดใจ"},{"verse":3,"text":"พวกเขาไม่ทำสิ่งชั่วช้า แต่ดำเนินในทางของพระองค์"},{"verse":4,"text":"พระองค์ทรงตั้งข้อบังคับของพระองค์ไว้ เพื่อให้ข้าพระองค์ทั้งหลายรักษาอย่างเคร่งครัด"},{"verse":5,"text":"โอ ขอให้ทางของข้าพระองค์มั่นคงในการรักษากฎเกณฑ์ของพระองค์"},{"verse":6,"text":"แล้วข้าพระองค์จะไม่ต้องอับอาย เมื่อพิจารณาพระบัญญัติทั้งสิ้นของพระองค์"},{"verse":7,"text":"ข้าพระองค์จะสรรเสริญพระองค์ด้วยใจเที่ยงตรง เมื่อข้าพระองค์เรียนรู้ข้อตัดสินอันชอบธรรมของพระองค์"},{"verse":8,"text":"ข้าพระองค์จะรักษากฎเกณฑ์ของพระองค์ ขออย่าทรงทอดทิ้งข้าพระองค์โดยสิ้นเชิง"},{"verse":9,"text":"คนหนุ่มจะรักษาทางของตนให้บริสุทธิ์ได้อย่างไร ก็โดยการระแวดระวังตามพระวจนะของพระองค์"},{"verse":10,"text":"ข้าพระองค์ได้แสวงหาพระองค์ด้วยสุดใจ ขออย่าให้ข้าพระองค์หลงไปจากพระบัญญัติของพระองค์"},{"verse":11,"text":"ข้าพระองค์ได้สะสมพระวจนะของพระองค์ไว้ในใจ เพื่อข้าพระองค์จะไม่ทำบาปต่อพระองค์"},{"verse":12,"text":"ข้าแต่องค์พระผู้เป็นเจ้า สาธุการแด่พระองค์ ขอทรงสอนกฎเกณฑ์ของพระองค์แก่ข้าพระองค์"},{"verse":13,"text":"ด้วยริมฝีปากของข้าพระองค์ ข้าพระองค์ประกาศข้อตัดสินทั้งสิ้นจากพระโอษฐ์ของพระองค์"},{"verse":14,"text":"ข้าพระองค์ปีติยินดีในทางแห่งพระโอวาทของพระองค์ มากเท่ากับในทรัพย์สมบัติทั้งสิ้น"},{"verse":15,"text":"ข้าพระองค์จะใคร่ครวญถึงข้อบังคับของพระองค์ และพิจารณาทางทั้งหลายของพระองค์"},{"verse":16,"text":"ข้าพระองค์จะปีติยินดีในกฎเกณฑ์ของพระองค์ ข้าพระองค์จะไม่ลืมพระวจนะของพระองค์"},{"verse":17,"text":"ขอทรงโปรดปรานผู้รับใช้ของพระองค์อย่างบริบูรณ์ เพื่อข้าพระองค์จะมีชีวิตอยู่และรักษาพระวจนะของพระองค์"},{"verse":18,"text":"ขอทรงเปิดตาของข้าพระองค์ เพื่อข้าพระองค์จะเห็นสิ่งมหัศจรรย์จากธรรมบัญญัติของพระองค์"},{"verse":19,"text":"ข้าพระองค์เป็นคนแปลกหน้าบนแผ่นดินโลก ขออย่าทรงซ่อนพระบัญญัติของพระองค์จากข้าพระองค์"},{"verse":20,"text":"จิตวิญญาณของข้าพระองค์เร่าร้อนด้วยความปรารถนาในข้อตัดสินของพระองค์อยู่เสมอ"},{"verse":21,"text":"พระองค์ทรงตำหนิคนหยิ่งยโส คือคนที่ถูกสาปแช่งซึ่งหลงไปจากพระบัญญัติของพระองค์"},{"verse":22,"text":"ขอทรงเอาความเยาะเย้ยและความดูหมิ่นไปจากข้าพระองค์ เพราะข้าพระองค์รักษาพระโอวาทของพระองค์"},{"verse":23,"text":"แม้บรรดาผู้ครอบครองจะนั่งลงนินทาข้าพระองค์ ผู้รับใช้ของพระองค์ก็ใคร่ครวญถึงกฎเกณฑ์ของพระองค์"},{"verse":24,"text":"พระโอวาทของพระองค์เป็นความปีติยินดีของข้าพระองค์ เป็นที่ปรึกษาของข้าพระองค์"},{"verse":25,"text":"จิตวิญญาณของข้าพระองค์ติดผงคลีดิน ขอทรงให้ข้าพระองค์มีชีวิตชีวาตามพระวจนะของพระองค์"},{"verse":26,"text":"ข้าพระองค์ทูลถึงทางของข้าพระองค์ และพระองค์ทรงตอบข้าพระองค์ ขอทรงสอนกฎเกณฑ์ของพระองค์แก่ข้าพระองค์"},{"verse":27,"text":"ขอทรงให้ข้าพระองค์เข้าใจทางแห่งข้อบังคับของพระองค์ แล้วข้าพระองค์จะใคร่ครวญถึงการอัศจรรย์ของพระองค์"},{"verse":28,"text":"จิตวิญญาณของข้าพระองค์ละลายไปด้วยความโศกเศร้า ขอทรงเสริมกำลังข้าพระองค์ตามพระวจนะของพระองค์"},{"verse":29,"text":"ขอทร