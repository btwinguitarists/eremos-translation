าจากองค์พระผู้เป็นเจ้า พระองค์ทรงเป็นป้อมปราการของพวกเขาในยามทุกข์ร้อน"},{"verse":40,"text":"องค์พระผู้เป็นเจ้าทรงช่วยและทรงปลดปล่อยพวกเขา ทรงช่วยกู้และช่วยพวกเขาให้รอดจากคนชั่ว เพราะพวกเขาเข้ามาลี้ภัยในพระองค์"}]},{"chapter":38,"title":"บทเพลงสดุดีของดาวิด เพื่อเป็นที่ระลึก","verses":[{"verse":1,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขออย่าทรงตำหนิข้าพระองค์ด้วยพระพิโรธ และขออย่าทรงตีสอนข้าพระองค์ด้วยความกริ้ว"},{"verse":2,"text":"เพราะลูกธนูของพระองค์ปักลึกในตัวข้าพระองค์ และพระหัตถ์ของพระองค์กดทับข้าพระองค์ลง"},{"verse":3,"text":"ไม่มีส่วนใดในร่างกายของข้าพระองค์ที่ปกติเลย เพราะพระพิโรธของพระองค์ กระดูกของข้าพระองค์ไม่มีความสงบสุข เพราะบาปของข้าพระองค์"},{"verse":4,"text":"เพราะความบาปผิดของข้าพระองค์ท่วมท้นเหนือศีรษะ มันเป็นภาระหนักเกินกว่าที่ข้าพระองค์จะแบกไหว"},{"verse":5,"text":"บาดแผลของข้าพระองค์เน่าเหม็นและเปื่อยพุ เพราะความโง่เขลาในบาปของข้าพระองค์"},{"verse":6,"text":"ข้าพระองค์ค้อมตัวลงและตกต่ำอย่างยิ่ง ข้าพระองค์เดินโศกเศร้าตลอดทั้งวัน"},{"verse":7,"text":"เพราะบั้นเอวของข้าพระองค์เต็มไปด้วยความเจ็บปวดแสบร้อน และไม่มีส่วนใดในร่างกายของข้าพระองค์ที่ปกติเลย"},{"verse":8,"text":"ข้าพระองค์อ่อนระโหยและบอบช้ำอย่างยิ่ง ข้าพระองค์คร่ำครวญด้วยความทุกข์ระทมในใจ"},{"verse":9,"text":"ข้าแต่องค์เจ้านาย ความปรารถนาทั้งสิ้นของข้าพระองค์อยู่ต่อพระพักตร์ของพระองค์ และเสียงถอนใจของข้าพระองค์ก็ไม่ได้ถูกซ่อนไว้จากพระองค์"},{"verse":10,"text":"ใจของข้าพระองค์เต้นระทึก กำลังของข้าพระองค์ถดถอย แม้แต่แสงสว่างในดวงตาของข้าพระองค์ก็หมดไป"},{"verse":11,"text":"บรรดาคนรักและมิตรสหายของข้าพระองค์ก็หลีกห่างจากโรคของข้าพระองค์ และญาติพี่น้องของข้าพระองค์ก็ยืนอยู่แต่ไกล"},{"verse":12,"text":"ผู้ที่หมายเอาชีวิตของข้าพระองค์ก็วางกับดัก ผู้ที่ปองร้ายข้าพระองค์ก็พูดถึงความพินาศ และคิดวางแผนหลอกลวงตลอดทั้งวัน"},{"verse":13,"text":"แต่ข้าพระองค์เป็นเหมือนคนหูหนวกที่ไม่ได้ยิน และเหมือนคนใบ้ที่ไม่ปริปาก"},{"verse":14,"text":"ข้าพระองค์เป็นเหมือนคนที่ไม่ได้ยิน และในปากของเขาไม่มีคำโต้ตอบ"},{"verse":15,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ข้าพระองค์รอคอยพระองค์ พระองค์จะทรงตอบ ข้าแต่องค์เจ้านาย พระเจ้าของข้าพระองค์"},{"verse":16,"text":"เพราะข้าพระองค์ทูลว่า ‘ขออย่าให้พวกเขาได้สะใจในตัวข้าพระองค์’ เมื่อเท้าของข้าพระองค์พลาด พวกเขาก็ยกตัวข่มข้าพระองค์"},{"verse":17,"text":"เพราะข้าพระองค์จวนจะล้มลงแล้ว และความเจ็บปวดของข้าพระองค์ก็อยู่กับข้าพระองค์เสมอ"},{"verse":18,"text":"ข้าพระองค์ขอสารภาพความบาปผิดของข้าพระองค์ และเป็นทุกข์เพราะบาปของข้าพระองค์"},{"verse":19,"text":"ศัตรูของข้าพระองค์มีกำลังเข้มแข็ง และผู้ที่เกลียดชังข้าพระองค์อย่างไม่เป็นธรรมก็มีมากมาย"},{"verse":20,"text":"ผู้ที่ตอบแทนความดีของข้าพระองค์ด้วยความชั่ว ก็เป็นปฏิปักษ์ต่อข้าพระองค์ เพราะข้าพระองค์มุ่งทำสิ่งที่ดี"},{"verse":21,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขออย่าทรงทอดทิ้งข้าพระองค์ ข้าแต่พระเจ้าของข้าพระองค์ ขออย่าทรงห่างไกลจากข้าพระองค์"},{"verse":22,"text":"ขอทรงรีบมาช่วยข้าพระองค์ ข้าแต่องค์เจ้านาย ผู้ทรงเป็นความรอดของข้าพระองค์"}]},{"chapter":39,"title":"ถึงหัวหน้านักดนตรี สำหรับเยดูธูน บทเพลงสดุดีของดาวิด","verses":[{"verse":1,"text":"ข้าพเจ้าได้กล่าวว่า ‘ข้าพเจ้าจะระวังทางของข้าพเจ้า เพื่อจะไม่ทำบาปด้วยลิ้นของข้าพเจ้า ข้าพเจ้าจะควบคุมปากของข้าพเจ้าไว้ ตราบที่คนชั่วยังอยู่ต่อหน้าข้าพเจ้า’"},{"verse":2,"text":"ข้าพเจ้านิ่งเงียบไม่พูดอะไร ข้าพเจ้าสงบปากแม้แต่จะพูดสิ่งดี และความเจ็บปวดของข้าพเจ้าก็กำเริบขึ้น"},{"verse":3,"text":"ใจของข้าพเจ้าร้อนรุ่มอยู่ภายใน เมื่อข้าพเจ้าครุ่นคิด ไฟก็ลุกโชนขึ้น แล้วข้าพเจ้าจึงพูดออกมาด้วยลิ้นของข้าพเจ้าว่า"},{"verse":4,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงสำแดงแก่ข้าพระองค์ถึงบั้นปลายของข้าพระองค์ และจำนวนวันของข้าพระองค์ว่ามีเท่าใด ขอให้ข้าพระองค์รู้ว่าชีวิตของข้าพระองค์นั้นสั้นเพียงไหน"},{"verse":5,"text":"ดูเถิด พระองค์ทรงกำหนดวันคืนของข้าพระองค์ให้สั้นเพียงฝ่ามือ และช่วงชีวิตของข้าพระองค์ก็เป็นดุจไม่มีอะไรต่อพระพักตร์ของพระองค์ แท้จริง ทุกคนแม้ในยามที่มั่นคงที่สุดก็เป็นเพียงลมหายใจ เซลาห์"},{"verse":6,"text":"แท้จริง มนุษย์เที่ยวไปมาดุจเงา เขาวุ่นวายไปเปล่าๆ เขาสะสมทรัพย์สมบัติ แต่ไม่รู้ว่าใครจะเป็นผู้เก็บเกี่ยวมันไป"},{"verse":7,"text":"บัดนี้ ข้าแต่องค์เจ้านาย ข้าพระองค์จะรอคอยสิ่งใด ความหวังของข้าพระองค์อยู่ในพระองค์"},{"verse":8,"text":"ขอทรงช่วยกู้ข้าพระองค์ให้พ้นจากการล่วงละเมิดทั้งสิ้นของข้าพระองค์ ขออย่าทรงทำให้ข้าพระองค์เป็นที่เยาะเย้ยของคนโง่"},{"verse":9,"text":"ข้าพระองค์นิ่งเงียบ ไม่ปริปาก เพราะพระองค์ทรงเป็นผู้กระทำ"},{"verse":10,"text":"ขอทรงเอาการลงโทษของพระองค์ไปจากข้าพระองค์ ข้าพระองค์กำลังย่อยยับไปด้วยการตีของพระหัตถ์ของพระองค์"},{"verse":11,"text":"พระองค์ทรงตีสอนและทรงตักเตือนมนุษย์เพราะความบาปผิดของเขา ทรงทำให้สิ่งที่เขารักหวงสลายไปดุจถูกแมลงกัดกิน แท้จริง มนุษย์ทุกคนเป็นเพียงไอระเหย เซลาห์"},{"verse":12,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงสดับคำอธิษฐานของข้าพระองค์ และขอทรงฟังเสียงร้องขอความช่วยเหลือของข้าพระองค์ ขออย่าทรงนิ่งเฉยต่อน้ำตาของข้าพระองค์ เพราะข้าพระองค์เป็นคนต่างด้าวที่อาศัยอยู่กับพระองค์ เป็นคนแปลกหน้าเหมือนบรรพบุรุษทั้งสิ้นของข้าพระองค์"},{"verse":13,"text":"ขอทรงหันสายพระเนตรไปจากข้าพระองค์ เพื่อข้าพระองค์จะได้ชื่นบานอีกครั้ง ก่อนที่ข้าพระองค์จะจากไปและไม่มีอยู่อีก"}]},{"chapter":40,"title":"ถึงหัวหน้านักดนตรี บทเพลงสดุดีของดาวิด","verses":[{"verse":1,"text":"ข้าพเจ้าได้รอคอยองค์พระผู้เป็นเจ้าด้วยความอดทน และพระองค์ทรงเอนพระองค์ลงมาหาข้าพเจ้า และทรงสดับเสียงร้องของข้าพเจ้า"},{"verse":2,"text":"พระองค์ทรงยกข้าพเจ้าขึ้นจากหลุมแห่งความพินาศ จากเลนตม ทรงตั้งเท้าของข้าพเจ้าไว้บนศิลา และทรงทำให้ย่างก้าวของข้าพเจ้ามั่นคง"},{"verse":3,"text":"พระองค์ทรงบรรจุเพลงบทใหม่ไว้ในปากของข้าพเจ้า เป็นบทเพลงสรรเสริญพระเจ้าของเรา คนเป็นอันมากจะเห็นและยำเกรง และจะวางใจในองค์พระผู้เป็นเจ้า"},{"verse":4,"text":"ความสุขมีแก่คนที่ไว้วางใจในองค์พระผู้เป็นเจ้า ผู้ไม่หันไปหาคนเย่อหยิ่ง หรือไปหาผู้ที่หลงไปในความเท็จ"},{"verse":5,"text":"ข้าแต่องค์พระผู้เป็นเจ้า พระเจ้าของข้าพระองค์ การอัศจรรย์ที่พระองค์ทรงกระทำนั้นมากมาย และพระดำริที่ทรงมีต่อเรานั้นก็เกินกว่าจะนับ ไม่มีสิ่งใดเปรียบกับพระองค์ได้ หากข้าพระองค์จะประกาศและกล่าวถึงสิ่งเหล่านั้น ก็มากมายเกินกว่าจะพรรณนาให้หมดได้"},{"verse":6,"text":"พระองค์ไม่ทรงประสงค์เครื่องสัตวบูชาและเครื่องธัญบูชา แต่พระองค์ทรงเปิดหูของข้าพระองค์ พระองค์ไม่ได้ทรงเรียกร้องเครื่องเผาบูชาและเครื่องบูชาไถ่บาป"},{"verse":7,"text":"แล้วข้าพระองค์ทูลว่า ‘ข้าพระองค์มาแล้ว ในหนังสือม้วนมีเขียนเรื่องข้าพระองค์ไว้"},{"verse":8,"text":"ข้าแต่พระเจ้าของข้าพระองค์ ข้าพระองค์ปีติยินดีที่จะทำตามพระประสงค์ของพระองค์ ธรรมบัญญัติของพระองค์อยู่ภายในจิตใจของข้าพระองค์’"},{"verse":9,"text":"ข้าพระองค์ได้ประกาศความชอบธรรมในที่ประชุมใหญ่ ดูเถิด ข้าพระองค์ไม่ได้ปิดริมฝีปากของข้าพระองค์ ข้าแต่องค์พระผู้เป็นเจ้า พระองค์ก็ทรงทราบ"},{"verse":10,"text":"ข้าพระองค์ไม่ได้ซ่อนความชอบธรรมของพระองค์ไว้ในใจ ข้าพระองค์ได้กล่าวถึงความซื่อสัตย์และความรอดของพระองค์ ข้าพระองค์ไม่ได้ปิดบังความรักมั่นคงและความจริงของพระองค์จากที่ประชุมใหญ่"},{"verse":11,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขออย่าทรงยับยั้งพระเมตตาของพระองค์จากข้าพระองค์ ขอความรักมั่นคงและความจริงของพระองค์คุ้มครองข้าพระองค์ไว้เสมอ"},{"verse":12,"text":"เพราะความเลวร้ายมากมายนับไม่ถ้วนได้ล้อมรอบข้าพระองค์ ความบาปผิดของข้าพระองค์ไล่ทันข้าพระองค์ จนข้าพระองค์มองอะไรไม่เห็น มันมากยิ่งกว่าเส้นผมบนศีรษะของข้าพระองค์ และใจของข้าพระองค์ก็ฝ่อไป"},{"verse":13,"text":"ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงโปรดช่วยกู้ข้าพระองค์ ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงรีบมาช่วยข้าพระองค์"},{"verse":14,"text":"ขอให้ผู้ที่หมายเอาชีวิตของข้าพระองค์ต้องอับอายขายหน้าด้วยกัน ขอให้ผู้ที่ปรารถนาจะทำร้ายข้าพระองค์ต้องถอยกลับไปด้วยความอัปยศ"},{"verse":15,"text":"ขอให้ผู้ที่กล่าวกับข้าพระองค์ว่า ‘นั่นไง นั่นไง’ ต้องตกตะลึงด้วยความอับอายของตน"},{"verse":16,"text":"ขอให้ทุกคนที่แสวงหาพระองค์ได้เปรมปรีดิ์และยินดีในพระองค์ ขอให้ผู้ที่รักความรอดของพระองค์กล่าวเสมอว่า ‘ขอองค์พระผู้เป็นเจ้าทรงเป็นที่ยกย่อง’"},{"verse":17,"text":"ส่วนข้าพระองค์ยากจนและขัดสน ขอองค์เจ้านายทรงระลึกถึงข้าพระองค์ พระองค์ทรงเป็นผู้ช่วยและผู้ปลดปล่อยของข้าพระองค์ ข้าแต่พระเจ้าของข้าพระองค์ ขออย่าทรงรอช้า"}]},{"chapter":41,"title":"ถึงหัวหน้านักดนตรี บทเพลงสดุดีของดาวิด","verses":[{"verse":1,"text":"ความสุขมีแก่ผู้ที่ห่วงใยคนยากไร้ องค์พระผู้เป็นเจ้าจะทรงช่วยกู้เขาในยามทุกข์ร้อน"},{"verse":2,"text":"องค์พระผู้เป็นเจ้าจะทรงปกป้องและรักษาชีวิตเขาไว้ เขาจะได้รับพรในแผ่นดิน และพระองค์จะไม่ทรงมอบเขาไว้ตามใจปรารถนาของศัตรู"},{"verse":3,"text":"องค์พระผู้เป็นเจ้าจะทรงค้ำชูเขาบนเตียงที่เขาป่วย พระองค์จะทรงพลิกฟื้นที่นอนแห่งความเจ็บไข้ของเขา"},{"verse":4,"text":"ข้าพระองค์ทูลว่า ‘ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงเมตตาข้าพระองค์ ขอทรงรักษาจิตวิญญาณของข้าพระองค์ให้หาย เพราะข้าพระองค์ได้ทำบาปต่อพระองค์’"},{"verse":5,"text":"ศัตรูของข้าพระองค์กล่าวร้ายต่อข้าพระองค์ว่า ‘เมื่อไรเขาจะตายและชื่อของเขาจะสูญสิ้นไป’"},{"verse":6,"text":"เมื่อมีคนมาเยี่ยมข้าพระองค์ เขาก็พูดเท็จ ในใจเขาสะสมเรื่องร้าย แล้วออกไปข้างนอกก็เที่ยวพูดกระจายไป"},{"verse":7,"text":"บรรดาผู้ที่เกลียดชังข้าพระองค์ก็ซุบซิบกันต่อสู้ข้าพระองค์ พวกเขาคิดร้ายต่อข้าพระองค์ว่า"},{"verse":8,"text":"‘โรคร้ายได้เกาะกุมเขาแล้ว เขาล้มป่วยลงและจะไม่ลุกขึ้นมาอีก’"},{"verse":9,"text":"แม้แต่เพื่อนสนิทที่ข้าพระองค์ไว้วางใจ ผู้ที่ร่วมรับประทานอาหารกับข้าพระองค์ ก็ยังยกส้นเท้าขึ้นต่อสู้ข้าพระองค์"},{"verse":10,"text":"แต่ข้าแต่องค์พระผู้เป็นเจ้า ขอทรงเมตตาข้าพระองค์ และทรงพยุงข้าพระองค์ขึ้น เพื่อข้าพระองค์จะได้ตอบแทนพวกเขา"},{"verse":11,"text":"ด้วยเหตุนี้ข้าพระองค์จึงรู้ว่าพระองค์ทรงพอพระทัยในข้าพระองค์ เพราะศัตรูของข้าพระองค์ไม่อาจมีชัยเหนือข้าพระองค์"},{"verse":12,"text":"ส่วนข้าพระองค์ พระองค์ทรงค้ำจุนข้าพระองค์ไว้ในความซื่อตรงของข้าพระองค์ และทรงตั้งข้าพระองค์ไว้ต่อพระพักตร์ของพระองค์ตลอดไป"},{"verse":13,"text":"สาธุการแด่องค์พระผู้เป็นเจ้า พระเจ้าแห่งอิสราเอล ตั้งแต่นิรันดร์กาลจนถึงนิรันดร์กาล อาเมนและอาเมน"}]},{"chapter":42,"title":"ถึงหัวหน้านักดนตรี บทมัสคีลของบุตรหลานโคราห์","verses":[{"verse":1,"text":"กวางกระหายหาธารน้ำฉันใด ข้าแต่พระเจ้า จิตวิญญาณของข้าพระองค์ก็กระหายหาพระองค์ฉันนั้น"},{"verse":2,"text":"จิตวิญญาณของข้าพระองค์กระหายหาพระเจ้า พระเจ้าผู้ทรงพระชนม์อยู่ เมื่อไรข้าพระองค์จะได้ไปเข้าเฝ้าต่อพระพักตร์ของพระเจ้า"},{"verse":3,"text":"น้ำตาของข้าพระองค์เป็นอาหารของข้าพระองค์ทั้งวันทั้งคืน ขณะที่ผู้คนพูดกับข้าพระองค์ตลอดวันว่า ‘พระเจ้าของเจ้าอยู่ที่ไหน’"},{"verse":4,"text":"ข้าพระองค์ระลึกถึงสิ่งเหล่านี้และเทจิตวิญญาณของข้าพระองค์ออกมา คือการที่ข้าพระองค์เคยเดินไปกับฝูงชน นำขบวนไปยังพระนิเวศของพระเจ้า ด้วยเสียงโห่ร้องยินดีและขอบพระคุณ ท่ามกลางหมู่ชนที่ฉลองเทศกาล"},{"verse":5,"text":"จิตวิญญาณของข้าพเจ้าเอ๋ย ทำไมเจ้าจึงท้อแท้ ทำไมจึงกระสับกระส่ายอยู่ภายในข้าพเจ้า จงหวังใจในพระเจ้า เพราะข้าพเจ้าจะยังคงสรรเสริญพระองค์ ผู้ทรงเป็นความรอดแห่งพระพักตร์ของพระองค์"},{"verse":6,"text":"ข้าแต่พระเจ้าของข้าพระองค์ จิตวิญญาณของข้าพระองค์ท้อแท้อยู่ภายใน เพราะฉะนั้นข้าพระองค์จึงระลึกถึงพระองค์จากแผ่นดินจอร์แดน จากยอดเขาเฮอร์โมน และจากภูเขามิซาร์"},{"verse":7,"text":"ที่ลึกร้องเรียกที่ลึกด้วยเสียงน้ำตกของพระองค์ คลื่นและระลอกคลื่นทั้งสิ้นของพระองค์ท่วมท้นเหนือข้าพระองค์"},{"verse":8,"text":"ในเวลากลางวัน องค์พระผู้เป็นเจ้าทรงบัญชาความรักมั่นคงของพระองค์ และในเวลากลางคืน บทเพลงของพระองค์อยู่กับข้าพระองค์ เป็นคำอธิษฐานต่อพระเจ้าแห่งชีวิตของข้าพระองค์"},{"verse":9,"text":"ข้าพระองค์ทูลต่อพระเจ้า ศิลาของข้าพระองค์ว่า ‘ไฉนพระองค์ทรงลืมข้าพระองค์ ทำไมข้าพระองค์ต้องเดินโศกเศร้าเพราะการกดขี่ของศัตรู’"},{"verse":10,"text":"ศัตรูเยาะเย้ยข้าพระองค์ ดุจกระดูกของข้าพระองค์ถูกบดขยี้ ขณะที่พวกเขาพูดกับข้าพระองค์ตลอดวันว่า ‘พระเจ้าของเจ้าอยู่ที่ไหน’"},{"verse":11,"text":"จิตวิญญาณของข้าพเจ้าเอ๋ย ทำไมเจ้าจึงท้อแท้ ทำไมจึงกระสับกระส่ายอยู่ภายในข้าพเจ้า จงหวังใจในพระเจ้า เพราะข้าพเจ้าจะยังคงสรรเสริญพระองค์ ผู้ทรงเป็นความรอดและเป็นพระเจ้าของข้าพเจ้า"}]},{"chapter":43,"verses":[{"verse":1,"text":"ข้าแต่พระเจ้า ขอทรงตัดสินความให้ข้าพระองค์ และทรงสู้คดีแทนข้าพระองค์ต่อชนชาติที่ไร้ความภักดี ขอทรงช่วยกู้ข้าพระองค์ให้พ้นจากคนหลอกลวงและคนอธรรม"},{"verse":2,"text":"เพราะพระองค์ทรงเป็นพระเจ้าผู้เป็นที่กำบังเข้มแข็งของข้าพระองค์ ไฉนพระองค์ทรงทอดทิ้งข้าพระองค์ ทำไมข้าพระองค์ต้องเดินโศกเศร้าเพราะการกดขี่ของศัตรู"},{"verse":3,"text":"ขอทรงส่งความสว่างและความจริงของพระองค์ออกมา ให้สิ่งเหล่านั้นนำข้าพระองค์ไป ให้นำข้าพระองค์ไปยังภูเขาบริสุทธิ์ของพระองค์ และไปยังที่ประทับของพระองค์"},{"verse":4,"text":"แล้วข้าพระองค์จะไปยังแท่นบูชาของพระเจ้า ไปหาพระเจ้าผู้ทรงเป็นความชื่นบานยินดียิ่งของข้าพระองค์ ข้าแต่พระเจ้า พระเจ้าของข้าพระองค์ ข้าพระองค์จะสรรเสริญพระองค์ด้วยพิณ"},{"verse":5,"text":"จิตวิญญาณของข้าพเจ้าเอ๋ย ทำไมเจ้าจึงท้อแท้ ทำไมจึงกระสับกระส่ายอยู่ภายในข้าพเจ้า จงหวังใจในพระเจ้า เพราะข้าพเจ้าจะยังคงสรรเสริญพระองค์ ผู้ทรงเป็นความรอดและเป็นพระเจ้าของข้าพเจ้า"}]},{"chapter":44,"title":"ถึงหัวหน้านักดนตรี บทมัสคีลของบุตรหลานโคราห์","verses":[{"verse":1,"text":"ข้าแต่พระเจ้า เราได้ยินกับหูของเราเอง บรรพบุรุษของเราได้เล่าให้เราฟังถึงพระราชกิจที่พระองค์ทรงกระทำในสมัยของพวกเขา ในสมัยโบราณ"},{"verse":2,"text":"พระองค์ทรงขับไล่บรรดาประชาชาติออกไปและทรงปลูกบรรพบุรุษของเราไว้แทนที่ พระองค์ทรงเหยียบย่ำชนชาติทั้งหลายและทรงทำให้บรรพบุรุษของเราแผ่ขยายออกไป ทั้งสิ้นนี้สำเร็จโดยพระหัตถ์ของพระองค์"},{"verse":3,"text":"เพราะมิใช่ด้วยดาบของพวกเขาที่ได้แผ่นดินมาเป็นกรรมสิทธิ์ และมิใช่แขนของพวกเขาที่ช่วยให้พวกเขามีชัย แต่เป็นพระหัตถ์ขวาของพระองค์ พระกรของพระองค์ และแสงสว่างแห่งพระพักตร์ของพระองค์ เพราะพระองค์โปรดปรานพวกเขา"},{"verse":4,"text":"ข้าแต่พระเจ้า พระองค์ทรงเป็นกษัตริย์ของข้าพระองค์ ผู้ทรงบัญชาชัยชนะให้แก่ยาโคบ"},{"verse":5,"text":"โดยพระองค์ เราจะขวิดศัตรูของเราให้ล้มลง โดยพระนามของพระองค์ เราจะเหยียบย่ำผู้ที่ลุกขึ้นต่อสู้เรา"},{"verse":6,"text":"เพราะข้าพเจ้าไม่ได้วางใจในธนูของข้าพเจ้า และดาบของข้าพเจ้าก็ช่วยข้าพเจ้าให้รอดไม่ได้"},{"verse":7,"text":"แต่พระองค์ทรงช่วยเราให้รอดจากศัตรูของเรา และทรงทำให้ผู้ที่เกลียดชังเราต้องอับอาย"},{"verse":8,"text":"เราอวดในพระเจ้าตลอดวัน และเราจะสรรเสริญพระนามของพระองค์เป็นนิตย์ เซลาห์"},{"verse":9,"text":"แต่บัดนี้พระองค์ทรงทอดทิ้งและทำให้เราอับอาย พระองค์ไม่เสด็จออกไปกับกองทัพของเราอีกแล้ว"},{"verse":10,"text":"พระองค์ทรงทำให้เราถอยหนีจากศัตรู และผู้ที่เกลียดชังเราก็ปล้นชิงเราตามใจชอบ"},{"verse":11,"text":"พระองค์ทรงมอบเราไว้เหมือนแกะที่จะถูกกิน และทรงทำให้เรากระจัดกระจายไปท่ามกลางประชาชาติ"},{"verse":12,"text":"พระองค์ทรงขายประชากรของพระองค์ไปในราคาถูก และไม่ได้ทรงกำไรอะไรจากการขายนั้นเลย"},{"verse":13,"text":"พระองค์ทรงทำให้เราเป็นที่เหยียดหยามของเพื่อนบ้าน เป็นที่เยาะเย้ยและดูหมิ่นของคนที่อยู่รอบข้างเรา"},{"verse":14,"text":"พระองค์ทรงทำให้เราเป็นคำเปรียบเปรยท่ามกลางประชาชาติ เป็นที่ส่ายหน้าเย้ยหยันในหมู่ชนชาติทั้งหลาย"},{"verse":15,"text":"ความอับอายของข้าพเจ้าอยู่ตรงหน้าข้าพเจ้าตลอดวัน และความอัปยศก็ปกคลุมใบหน้าของข้าพเจ้า"},{"verse":16,"text":"เพราะเสียงของผู้ที่เยาะเย้ยและกล่าวหมิ่นประมาท เพราะศัตรูและผู้ที่คิดแก้แค้น"},{"verse":17,"text":"ทั้งหมดนี้เกิดขึ้นกับเรา แม้เราไม่ได้ลืมพระองค์ และไม่ได้ทรยศต่อพันธสัญญาของพระองค์"},{"verse":18,"text":"ใจของเราไม่ได้หันกลับ และย่างก้าวของเราก็ไม่ได้เตลิดออกจากวิถีของพระองค์"},{"verse":19,"text":"แต่พระองค์ทรงบดขยี้เราในที่อยู่ของหมาใน และทรงปกคลุมเราไว้ด้วยความมืดมิดแห่งความตาย"},{"verse":20,"text":"หากเราลืมพระนามของพระเจ้าของเรา หรือชูมือของเราขึ้นต่อพระต่างด้าว"},{"verse":21,"text":"พระเจ้าจะไม่ทรงทราบหรือ ในเมื่อพระองค์ทรงทราบความลับในใจ"},{"verse":22,"text":"แต่เพราะเห็นแก่พระองค์ เราจึงถูกประหารตลอดวัน เราถูกนับว่าเป็นเหมือนแกะที่จะถูกฆ่า"},{"verse":23,"text":"ข้าแต่องค์เจ้านาย ขอทรงตื่นเถิด ไฉนพระองค์บรรทมอยู่ ขอทรงลุกขึ้น ขออย่าทรงทอดทิ้งเราตลอดไป"},{"verse":24,"text":"ไฉนพระองค์ทรงลืมความทุกข์และการถูกข่มเหงของเรา และทรงซ่อนพระพักตร์ของพระองค์ไปเสีย"},{"verse":25,"text":"เพราะจิตวิญญาณของเราจมลงสู่ผงคลีดิน ร่างกายของเราแนบติดอยู่กับพื้นดิน"},{"verse":26,"text":"ขอทรงลุกขึ้นช่วยเหลือเรา ขอทรงไถ่เราเพราะเห็นแก่ความรักมั่นคงของพระองค์"}]},{"chapter":45,"title":"ถึงหัวหน้านักดนตรี ตามทำนอง ‘ดอกลิลลี่’ บทมัสคีลของบุตรหลานโคราห์ บทเพลงแห่งความรัก","verses":[{"verse":1,"text":"ใจของข้าพเจ้าเอ่อล้นด้วยเรื่องราวอันดีงาม ข้าพเจ้าจะกล่าวบทประพันธ์ของข้าพเจ้าถวายแด่กษัตริย์ ลิ้นของข้าพเจ้าเป็นดุจปากกาของอาลักษณ์ผู้ชำนาญ"},{"verse":2,"text":"พระองค์ทรงงามเลิศกว่าบุตรทั้งหลายของมนุษย์ พระคุณหลั่งรินบนริมฝีปากของพระองค์ เพราะฉะนั้นพระเจ้าจึงทรงอวยพรพระองค์เป็นนิตย์"},{"verse":3,"text":"ข้าแต่องค์ผู้ทรงเดชานุภาพ ขอทรงคาดพระแสงดาบไว้ที่บั้นเอวของพระองค์ ด้วยพระสง่าราศีและพระบารมีของพระองค์"},{"verse":4,"text":"ขอทรงเสด็จไปอย่างมีชัยด้วยพระบารมีของพระองค์ เพื่อความจริง ความถ่อมตน และความยุติธรรม ขอให้มือขวาของพระองค์สำแดงกิจอันน่าเกรงขาม"},{"verse":5,"text":"ลูกธนูของพระองค์คมกริบ ปักเข้าที่ใจของศัตรูของกษัตริย์ ชนชาติทั้งหลายล้มลงอยู่ใต้พระองค์"},{"verse":6,"text":"ข้าแต่พระเจ้า บัลลังก์ของพระองค์ดำรงอยู่เป็นนิตย์นิรันดร์ และคทาแห่งราชอาณาจักรของพระองค์เป็นคทาแห่งความเที่ยงธรรม"},{"verse":7,"text":"พระองค์ทรงรักความชอบธรรมและทรงเกลียดความชั่วร้าย เพราะฉะนั้น พระเจ้า คือพระเจ้าของพระองค์ จึงทรงเจิมพระองค์ด้วยน้ำมันแห่งความยินดี เหนือกว่าพระสหายทั้งหลายของพระองค์"},{"verse":8,"text":"ฉลองพระองค์ทั้งสิ้นของพระองค์หอมกรุ่นด้วยมดยอบ กฤษณา และการบูร จากปราสาทงาช้าง เสียงพิณทำให้พระองค์ทรงเปรมปรีดิ์"},{"verse":9,"text":"บรรดาธิดาของกษัตริย์อยู่ในหมู่สตรีผู้มีเกียรติของพระองค์ พระราชินีประทับอยู่ที่เบื้องขวาของพระองค์ ประดับด้วยทองคำแห่งโอฟีร์"},{"verse":10,"text":"ธิดาเอ๋ย จงฟังเถิด จงพิจารณาและเงี่ยหูฟัง จงลืมชนชาติของเธอและบ้านบิดาของเธอเสีย"},{"verse":11,"text":"แล้วกษัตริย์จะทรงปรารถนาความงามของเธอ เพราะพระองค์ทรงเป็นเจ้านายของเธอ จงกราบลงต่อพระองค์"},{"verse":12,"text":"ธิดาแห่งเมืองไทระจะนำของกำนัลมา บรรดาคนมั่งมีจะมาขอความโปรดปรานจากเธอ"},{"verse":13,"text":"พระธิดาของกษัตริย์ทรงสง่างามยิ่งนักในห้องของพระนาง ฉลองพระองค์ของพระนางถักทอด้วยทองคำ"},{"verse":14,"text":"พระนางถูกนำเข้าเฝ้ากษัตริย์ในชุดปักลวดลายงดงาม เหล่าหญิงพรหมจารีสหายของพระนางก็ตามมา ถูกนำมาเฝ้าพระองค์"},{"verse":15,"text":"พวกนางถูกนำมาด้วยความยินดีและเปรมปรีดิ์ พวกนางเข้าสู่พระราชวังของกษัตริย์"},{"verse":16,"text":"บรรดาโอรสของพระองค์จะสืบต่อจากบรรพบุรุษของพระองค์ พระองค์จะทรงตั้งพวกเขาให้เป็นเจ้านายทั่วทั้งแผ่นดิน"},{"verse":17,"text":"ข้าพเจ้าจะทำให้พระนามของพระองค์เป็นที่ระลึกตลอดทุกชั่วอายุ เพราะฉะนั้นชนชาติทั้งหลายจะสรรเสริญพระองค์เป็นนิตย์นิรันดร์"}]},{"chapter":46,"title":"ถึงหัวหน้านักดนตรี ของบุตรหลานโคราห์ ตามทำนองอาลาโมท บทเพลง","verses":[{"verse":1,"text":"พระเจ้าทรงเป็นที่ลี้ภัยและกำลังของเรา เป็นความช่วยเหลือที่พร้อมเสมอในยามทุกข์ร้อน"},{"verse":2,"text":"เพราะฉะนั้นเราจะไม่กลัว แม้แผ่นดินโลกจะเปลี่ยนแปลงไป และภูเขาจะทลายลงสู่ใจกลางทะเล"},{"verse":3,"text":"แม้น้ำในทะเลจะคำรามและซัดสาด และภูเขาจะสั่นสะเทือนด้วยความปั่นป่วนของมัน เซลาห์"},{"verse":4,"text":"มีแม่น้ำสายหนึ่ง ลำธารของมันทำให้นครของพระเจ้าชื่นบาน คือสถานบริสุทธิ์ที่ประทับขององค์ผู้สูงสุด"},{"verse":5,"text":"พระเจ้าสถิตอยู่ท่ามกลางนครนั้น มันจะไม่คลอนแคลน พระเจ้าจะทรงช่วยนครนั้นเมื่อรุ่งอรุณมาถึง"},{"verse":6,"text":"บรรดาประชาชาติโกลาหล อาณาจักรทั้งหลายล่มสลาย เมื่อพระองค์ทรงเปล่งพระสุรเสียง แผ่นดินโลกก็ละลายไป"},{"verse":7,"text":"องค์พระผู้เป็นเจ้าจอมโยธาสถิตกับเรา พระเจ้าแห่งยาโคบทรงเป็นป้อมปราการของเรา เซลาห์"},{"verse":8,"text":"มาเถิด มาดูพระราชกิจขององค์พระผู้เป็นเจ้า ผู้ทรงนำความรกร้างมาสู่แผ่นดินโลก"},{"verse":9,"text":"พระองค์ทรงทำให้สงครามยุติทั่วทั้งแผ่นดินโลก ทรงหักธนูและฟันหอกให้แตกหัก ทรงเผารถรบในไฟ"},{"verse":10,"text":"‘จงนิ่งสงบและรู้เถิดว่าเราคือพระเจ้า เราจะได้รับการยกย่องท่ามกลางประชาชาติ เราจะได้รับการยกย่องทั่วแผ่นดินโลก’"},{"verse":11,"text":"องค์พระผู้เป็นเจ้าจอมโยธาสถิตกับเรา พระเจ้าแห่งยาโคบทรงเป็นป้อมปราการของเรา เซลาห์"}]},{"chapter":47,"title":"ถึงหัวหน้านักดนตรี บทเพลงสดุดีของบุตรหลานโคราห์","verses":[{"verse":1,"text":"ชนชาติทั้งปวงเอ๋ย จงปรบมือ จงโห่ร้องถวายแด่พระเจ้าด้วยเสียงแห่งชัยชนะ"},{"verse":2,"text":"เพราะองค์พระผู้เป็นเจ้าผู้สูงสุดทรงเป็นที่น่าเกรงขาม ทรงเป็นกษัตริย์ผู้ยิ่งใหญ่เหนือทั่วทั้งแผ่นดินโลก"},{"verse":3,"text":"พระองค์ทรงปราบประชาชาติให้อยู่ใต้เรา และทรงให้ชนชาติทั้งหลายอยู่ใต้เท้าของเรา"},{"verse":4,"text":"พระองค์ทรงเลือกมรดกให้แก่เรา คือความภาคภูมิของยาโคบที่พระองค์ทรงรัก เซลาห์"},{"verse":5,"text":"พระเจ้าเสด็จขึ้นไปท่ามกลางเสียงโห่ร้องยินดี องค์พระผู้เป็นเจ้าเสด็จขึ้นไปพร้อมเสียงแตรเขาสัตว์"},{"verse":6,"text":"จงร้องเพลงสรรเสริญพระเจ้า จงร้องเพลงสรรเสริญ จงร้องเพลงสรรเสริญกษัตริย์ของเรา จงร้องเพลงสรรเสริญ"},{"verse":7,"text":"เพราะพระเจ้าทรงเป็นกษัตริย์เหนือทั่วทั้งแผ่นดินโลก จงร้องเพลงสรรเสริญด้วยบทเพลงอันไพเราะ"},{"verse":8,"text":"พระเจ้าทรงครอบครองเหนือบรรดาประชาชาติ พระเจ้าประทับบนบัลลังก์บริสุทธิ์ของพระองค์"},{"verse":9,"text":"บรรดาเจ้านายของชนชาติทั้งหลายมาประชุมกันเป็นประชากรของพระเจ้าแห่งอับราฮัม เพราะโล่ทั้งหลายของแผ่นดินโลกเป็นของพระเจ้า พระองค์ทรงได้รับการยกย่องเหนือสิ่งใดทั้งสิ้น"}]},{"chapter":48,"title":"บทเพลง บทสดุดีของบุตรหลานโคราห์","verses":[{"verse":1,"text":"องค์พระผู้เป็นเจ้าทรงยิ่งใหญ่และสมควรแก่การสรรเสริญอย่างยิ่ง ในนครของพระเจ้าของเรา บนภูเขาบริสุทธิ์ของพระองค์"},{"verse":2,"text":"ภูเขาศิโยนนั้นงดงามตระหง่าน เป็นความชื่นชมยินดีของคนทั้งโลก ดุจยอดเขาแห่งทิศเหนือ เป็นนครของมหากษัตริย์"},{"verse":3,"text":"พระเจ้าทรงสถิตอยู่ในป้อมปราการของนครนั้น พระองค์ทรงสำแดงพระองค์ว่าทรงเป็นที่กำบังเข้มแข็ง"},{"verse":4,"text":"เพราะดูเถิด บรรดากษัตริย์ได้ชุมนุมกัน พวกเขารุดหน้าเข้ามาด้วยกัน"},{"verse":5,"text":"พวกเขาเห็นแล้วก็ตะลึงงัน พวกเขาตกใจกลัวและรีบหนีไป"},{"verse":6,"text":"ความสั่นสะท้านยึดกุมพวกเขาที่นั่น เป็นความเจ็บปวดดุจหญิงคลอดบุตร"},{"verse":7,"text":"พระองค์ทรงทำลายเรือแห่งเมืองทารชิชด้วยลมตะวันออก"},{"verse":8,"text":"ดังที่เราได้ยินมา เราก็ได้เห็นเช่นนั้นในนครขององค์พระผู้เป็นเจ้าจอมโยธา ในนครของพระเจ้าของเรา พระเจ้าจะทรงสถาปนานครนั้นไว้เป็นนิตย์ เซลาห์"},{"verse":9,"text":"ข้าแต่พระเจ้า เราใคร่ครวญถึงความรักมั่นคงของพระองค์ ภายในพระวิหารของพระองค์"},{"verse":10,"text":"ข้าแต่พระเจ้า พระนามของพระองค์เป็นที่สรรเสริญไปทั่วสุดปลายแผ่นดินโลก พระหัตถ์ขวาของพระองค์เต็มไปด้วยความชอบธรรม"},{"verse":11,"text":"ภูเขาศิโยนยินดี และบรรดาธิดาแห่งยูดาห์ก็เปรมปรีดิ์ เพราะการพิพากษาของพระองค์"},{"verse":12,"text":"จงเดินรอบศิโยน จงเดินวนรอบนคร จงนับหอคอยของมัน"},{"verse":13,"text":"จงพินิจกำแพงป้อมของมัน จงสำรวจป้อมปราการของมัน เพื่อเจ้าจะเล่าให้คนรุ่นต่อไปฟัง"},{"verse":14,"text":"เพราะพระเจ้าองค์นี้ทรงเป็นพระเจ้าของเราตลอดไปเป็นนิตย์ พระองค์จะทรงเป็นผู้นำของเราไปตราบจนวันสิ้นชีวิต"}]},{"chapter":49,"title":"ถึงหัวหน้านักดนตรี บทเพลงสดุดีของบุตรหลานโคราห์","verses":[{"verse":1,"text":"ชนชาติทั้งปวงเอ๋ย จงฟังเรื่องนี้ ชาวโลกทั้งสิ้นเอ๋ย จงเงี่ยหูฟัง"},{"verse":2,"text":"ทั้งคนต่ำต้อยและคนสูงศักดิ์ ทั้งคนมั่งมีและคนยากจน"},{"verse":3,"text":"ปากของข้าพเจ้าจะกล่าวถ้อยคำแห่งปัญญา และการรำพึงในใจของข้าพเจ้าจะนำมาซึ่งความเข้าใจ"},{"verse":4,"text":"ข้าพเจ้าจะเงี่ยหูฟังคำสุภาษิต และจะไขปริศนาของข้าพเจ้าด้วยเสียงพิณ"},{"verse":5,"text":"เหตุใดข้าพเจ้าจะต้องกลัวในยามทุกข์ร้อน เมื่อความชั่วร้ายของผู้ที่คอยปองร้ายล้อมรอบข้าพเจ้า"},{"verse":6,"text":"คือบรรดาผู้ที่วางใจในทรัพย์สมบัติของตน และโอ้อวดในความมั่งคั่งอันมากมายของตน"},{"verse":7,"text":"ไม่มีผู้ใดสามารถไถ่พี่น้องของตน หรือถวายค่าไถ่สำหรับเขาแด่พระเจ้าได้เลย"},{"verse":8,"text":"เพราะค่าไถ่ชีวิตนั้นแพงเกินไป ไม่มีวันที่จะจ่ายให้พอได้"},{"verse":9,"text":"เพื่อเขาจะมีชีวิตอยู่ต่อไปเป็นนิตย์ และไม่ต้องเห็นความเน่าเปื่อย"},{"verse":10,"text":"เพราะเห็นได้ชัดว่าคนมีปัญญาก็ตาย คนโง่และคนเขลาก็พินาศเช่นกัน แล้วทิ้งทรัพย์สมบัติของตนไว้ให้คนอื่น"},{"verse":11,"text":"พวกเขาคิดในใจว่าบ้านเรือนของตนจะคงอยู่เป็นนิตย์ ที่อาศัยของตนจะดำรงอยู่ทุกชั่วอายุ พวกเขาจึงตั้งชื่อที่ดินตามชื่อของตน"},{"verse":12,"text":"แต่มนุษย์แม้จะมั่งมีก็คงอยู่ไม่ได้ เขาเป็นเหมือนสัตว์ที่ต้องพินาศไป"},{"verse":13,"text":"นี่คือชะตากรรมของคนที่โง่เขลา และของผู้ที่ตามอย่างพวกเขาที่ชอบคำพูดของพวกเขา เซลาห์"},{"verse":14,"text":"พวกเขาถูกกำหนดให้ลงไปสู่แดนคนตายเหมือนฝูงแกะ ความตายจะเป็นผู้เลี้ยงพวกเขา คนเที่ยงธรรมจะปกครองพวกเขาในยามเช้า รูปร่างของพวกเขาจะเปื่อยเน่าในแดนคนตาย ไกลจากที่อาศัยอันโอ่อ่าของพวกเขา"},{"verse":15,"text":"แต่พระเจ้าจะทรงไถ่จิตวิญญาณของข้าพเจ้าจากอำนาจของแดนคนตาย เพราะพระองค์จะทรงรับข้าพเจ้าไป เซลาห์"},{"verse":16,"text":"อย่ากลัวเลยเมื่อเห็นคนมั่งมีขึ้น เมื่อความโอ่อ่าแห่งบ้านของเขาทวีขึ้น"},{"verse":17,"text":"เพราะเมื่อเขาตาย เขาจะเอาอะไรไปไม่ได้เลย ความมั่งคั่งของเขาจะไม่ตามเขาลงไป"},{"verse":18,"text":"แม้ขณะมีชีวิตอยู่เขาถือว่าตนเป็นสุข และผู้คนสรรเสริญเจ้าเมื่อเจ้าอยู่ดีมีสุข"},{"verse":19,"text":"เขาก็จะไปอยู่กับชนรุ่นบรรพบุรุษของเขา ผู้ซึ่งจะไม่มีวันเห็นแสงสว่างอีกเลย"},{"verse":20,"text":"มนุษย์ที่มั่งมีแต่ปราศจากความเข้าใจ ก็เป็นเหมือนสัตว์ที่ต้องพินาศไป"}]},{"chapter":50,"verses":[{"verse":1,"text":"บทเพลงสดุดีของอาสาฟ องค์ผู้ทรงฤทธิ์ พระเจ้า องค์พระผู้เป็นเจ้า ตรัสและทรงเรียกแผ่นดินโลก ตั้งแต่ที่ดวงอาทิตย์ขึ้นจนถึงที่ดวงอาทิตย์ตก"},{"verse":2,"text":"พระเจ้าทรงทอแสงออกมาจากศิโยน ที่งดงามบริบูรณ์"},{"verse":3,"text":"พระเจ้าของเราเสด็จมา และจะไม่ทรงนิ่งเงียบ ไฟเผาผลาญนำหน้าพระองค์ไป และมีพายุกระหน่ำอยู่รอบพระองค์"},{"verse":4,"text":"พระองค์ทรงเรียกฟ้าสวรรค์เบื้องบนและแผ่นดินโลก เพื่อจะทรงพิพากษาประชากรของพระองค์"},{"verse":5,"text":"‘จงรวบรวมผู้ที่ภักดีของเรามาหาเรา คือผู้ที่ได้ทำพันธสัญญากับเราด้วยเครื่องบูชา’"},{"verse":6,"text":"และฟ้าสวรรค์ก็ประกาศความชอบธรรมของพระองค์ เพราะพระเจ้าเองทรงเป็นผู้พิพากษา เซลาห์"},{"verse":7,"text":"‘ประชากรของเราเอ๋ย จงฟัง เราจะพูด อิสราเอลเอ๋ย เราจะเป็นพยานปรักปรำเจ้า เราคือพระเจ้า พระเจ้าของเจ้า"},{"verse":8,"text":"เราไม่ได้ตำหนิเจ้าเรื่องเครื่องสัตวบูชาของเจ้า หรือเครื่องเผาบูชาของเจ้าที่อยู่ต่อหน้าเราเสมอ"},{"verse":9,"text":"เราไม่ต้องการวัวผู้จากคอกของเจ้า หรือแพะจากเล้าของเจ้า"},{"verse":10,"text":"เพราะสัตว์ป่าทุกตัวเป็นของเรา ทั้งฝูงปศุสัตว์บนภูเขาตั้งพันลูก"},{"verse":11,"text":"เรารู้จักนกทุกตัวบนภูเขา และสรรพสัตว์ในทุ่งนาก็เป็นของเรา"},{"verse":12,"text":"หากเราหิว เราก็จะไม่บอกเจ้า เพราะพิภพและสรรพสิ่งในนั้นเป็นของเรา"},{"verse":13,"text":"เรากินเนื้อวัวผู้หรือ หรือเราดื่มเลือดแพะหรือ"},{"verse":14,"text":"จงถวายเครื่องบูชาแห่งการขอบพระคุณแด่พระเจ้า และจงทำตามคำปฏิญาณของเจ้าต่อองค์ผู้สูงสุด"},{"verse":15,"text":"จงร้องเรียกเราในยามทุกข์ร้อน เราจะช่วยกู้เจ้า และเจ้าจะถวายเกียรติแก่เรา’"},{"verse":16,"text":"แต่พระเจ้าตรัสกับคนชั่วว่า ‘เจ้ามีสิทธิ์อะไรที่จะท่องบทบัญญัติของเรา และเอาพันธสัญญาของเรามาอยู่บนปากของเจ้า"},{"verse":17,"text":"ในเมื่อเจ้าเกลียดชังคำสั่งสอน และเหวี่ยงถ้อยคำของเราทิ้งไว้ข้างหลัง"},{"verse":18,"text":"เมื่อเจ้าเห็นขโมย เจ้าก็คบหากับเขา และเจ้าสมคบกับพวกที่ล่วงประเวณี"},{"verse":19,"text":"เจ้าปล่อยปากของเจ้าให้พูดความชั่ว และผูกลิ้นของเจ้าไว้กับการหลอกลวง"},{"verse":20,"text":"เจ้านั่งลงแล้วใส่ร้ายพี่น้องของเจ้า เจ้านินทาบุตรชายของมารดาของเจ้าเอง"},{"verse":21,"text":"เจ้าทำสิ่งเหล่านี้ และเราก็นิ่งเงียบไว้ เจ้าจึงคิดว่าเราเป็นเหมือนเจ้า แต่บัดนี้เราจะตำหนิเจ้า และกล่าวโทษเจ้าต่อหน้าต่อตาของเจ้า"},{"verse":22,"text":"บัดนี้ จงพิจารณาเรื่องนี้เถิด เจ้าทั้งหลายที่ลืมพระเจ้า มิฉะนั้นเราจะฉีกเจ้าเป็นชิ้นๆ และจะไม่มีใครช่วยกู้ได้เลย"},{"verse":23,"text":"ผู้ที่ถวายเครื่องบูชาแห่งการขอบพระคุณก็ถวายเกียรติแก่เรา และผู้ที่จัดวิถีทางของตนอย่างถูกต้อง เราจะสำแดงความรอดของพระเจ้าแก่เขา’"}]},{"chapter":51,"title":"ถึงหัวหน้านักดนตรี บทเพลงสดุดีของดาวิด เมื่อนาธันผู้เผยพระวจนะมาหาท่าน หลังจากที่ท่านได้ล่วงประเวณีกับนางบัทเชบา","verses":[{"verse":1,"text":"ขอทรงเมตตาข้าพระองค์ ข้าแต่พระเจ้า ตามความรักมั่นคงของพระองค์ ตามพระเมตตาอันยิ่งใหญ่ของพระองค์ ขอทรงลบล้างการล่วงละเมิดของข้าพระองค์"},{"verse":2,"text":"ขอทรงล้างข้าพระองค์ให้สิ้นจากความบาปผิด และทรงชำระข้าพระองค์ให้พ้นจากบาปของข้าพระองค์"},{"verse":3,"text":"เพราะข้าพระองค์ทราบถึงการล่วงละเมิดของข้าพระองค์ และบาปของข้าพระองค์ก็อยู่ต่อหน้าข้าพระองค์เสมอ"},{"verse":4,"text":"ข้าพระองค์ได้ทำบาปต่อพระองค์ ต่อพระองค์เท่านั้น และได้ทำสิ่งที่ชั่วร้ายในสายพระเนตรของพระองค์ ดังนั้นพระดำรัสของพระองค์จึงชอบธรรม และการพิพากษาของพระองค์ก็ไร้ที่ติ"},{"verse":5,"text":"ดูเถิด ข้าพระองค์ถือกำเนิดมาในความบาปผิด และตั้งแต่มารดาตั้งครรภ์ ข้าพระองค์ก็เป็นคนบาปแล้ว"},{"verse":6,"text":"ดูเถิด พระองค์ทรงประสงค์ความจริงในส่วนลึกของจิตใจ และทรงสอนข้าพระองค์ให้มีปัญญาในส่วนที่ซ่อนเร้น"},{"verse":7,"text":"ขอทรงชำระข้าพระองค์ด้วยต้นหุสบ แล้วข้าพระองค์จะสะอาด ขอทรงล้างข้าพระองค์ แล้วข้าพระองค์จะขาวยิ่งกว่าหิมะ"},{"verse":8,"text":"ขอทรงให้ข้าพระองค์ได้ยินเสียงแห่งความชื่นบานและความยินดี เพื่อกระดูกที่พระองค์ทรงบดขยี้นั้นจะได้เปรมปรีดิ์"},{"verse":9,"text":"ขอทรงลบล้างความผิดทั้งสิ้นของข้าพระองค์ และทรงซ่อนพระพักตร์ของพระองค์จากบาปของข้าพระองค์"},{"verse":10,"text":"ข้าแต่พระเจ้า ขอทรงสร้างใจที่สะอาดบริสุทธิ์ขึ้นภายในข้าพระองค์ และทรงฟื้นจิตวิญญาณที่มั่นคงขึ้นใหม่ภายในข้าพระองค์"},{"verse":11,"text":"ขออย่าทรงเหวี่ยงข้าพระองค์ไปจากพระพักตร์ของพระองค์ และขออย่านำพระวิญญาณบริสุทธิ์ของพระองค์ไปจากข้าพระองค์เลย"},{"verse":12,"text":"ขอทรงคืนความชื่นบานแห่งความรอดของพระองค์แก่ข้าพระองค์ และทรงค้ำจุนข้าพระองค์ด้วยจิตวิญญาณที่เต็มใจ"},{"verse":13,"text":"แล้วข้าพระองค์จะสอนทางของพระองค์แก่ผู้ที่ล่วงละเมิด และคนบาปจะหันกลับมาหาพระองค์"},{"verse":14,"text":"ข้าแต่พระเจ้า พระเจ้าแห่งความรอดของข้าพระองค์ ขอทรงช่วยกู้ข้าพระองค์ให้พ้นจากความผิดเรื่องการทำให้โลหิตตก แล้วลิ้นของข้าพระองค์จะร้องเพลงถึงความชอบธรรมของพระองค์"},{"verse":15,"text":"ข้าแต่องค์เจ้านาย ขอทรงเปิดริมฝีปากของข้าพระองค์ แล้วปากของข้าพระองค์จะประกาศคำสรรเสริญพระองค์"},{"verse":16,"text":"เพราะพระองค์ไม่ทรงประสงค์เครื่องสัตวบูชา มิฉะนั้นข้าพระองค์ก็จะถวายให้ และพระองค์ไม่ทรงพอพระทัยในเครื่องเผาบูชา"},{"verse":17,"text":"เครื่องบูชาที่พระเจ้าทรงประสงค์คือจิตวิญญาณที่แตกสลาย ข้าแต่พระเจ้า พระองค์จะไม่ทรงดูหมิ่นใจที่แตกสลายและสำนึกผิด"},{"verse":18,"text":"ขอทรงทำดีต่อศิโยนด้วยความโปรดปรานของพระองค์ ขอทรงสร้างกำแพงเยรูซาเล็มขึ้น"},{"verse":19,"text":"แล้วพระองค์จะทรงพอพระทัยในเครื่องบูชาแห่งความชอบธรรม ในเครื่องเผาบูชาและของถวายที่เผาทั้งตัว แล้วเขาจะถวายวัวผู้บนแท่นบูชาของพระองค์"}]},{"chapter":52,"title":"ถึงหัวหน้านักดนตรี บทมัสคีลของดาวิด เมื่อโดเอกชาวเอโดมไปทูลซาอูลว่า ‘ดาวิดได้มาที่บ้านของอาหิเมเลค’","verses":[{"verse":1,"text":"ข้าแต่ชายผู้มีอำนาจ เหตุใดเจ้าจึงโอ้อวดในความชั่ว ความรักมั่นคงของพระเจ้าดำรงอยู่ตลอดวัน"},{"verse":2,"text":"ลิ้นของเจ้าคิดประดิษฐ์การทำลายล้าง ดุจมีดโกนคมกริบ เจ้าผู้ทำการหลอกลวง"},{"verse":3,"text":"เจ้ารักความชั่วมากกว่าความดี รักการพูดเท็จมากกว่าการพูดความจริง เซลาห์"},{"verse":4,"text":"เจ้ารักถ้อยคำทำลายล้างทั้งสิ้น โอ ลิ้นที่หลอกลวง"},{"verse":5,"text":"แต่พระเจ้าจะทรงทำลายเจ้าลงเป็นนิตย์ พระองค์จะทรงฉวยเจ้าและกระชากเจ้าออกจากเต็นท์ และถอนรากเจ้าออกจากแผ่นดินของคนเป็น เซลาห์"},{"verse":6,"text":"คนชอบธรรมจะเห็นและยำเกรง พวกเขาจะหัวเราะเยาะเขา"},{"verse":7,"text":"‘ดูเถิด นี่คือคนที่ไม่ยอมให้พระเจ้าเป็นที่กำบังเข้มแข็งของตน แต่วางใจในทรัพย์สมบัติอันมากมายของตน และเข้มแข็งขึ้นด้วยการทำลายล้างของตน’"},{"verse":8,"text":"แต่ข้าพเจ้าเป็นเหมือนต้นมะกอกเขียวสดในพระนิเวศของพระเจ้า ข้าพเจ้าวางใจในความรักมั่นคงของพระเจ้าตลอดไปเป็นนิตย์"},{"verse":9,"text":"ข้าพระองค์จะขอบพระคุณพระองค์เป็นนิตย์ เพราะพระองค์ได้ทรงกระทำ และข้าพระองค์จะรอคอยพระนามของพระองค์ เพราะพระนามนั้นประเสริฐ ต่อหน้าผู้ที่ภักดีของพระองค์"}]},{"chapter":53,"title":"ถึงหัวหน้านักดนตรี ตามทำนองมาฮาลัท บทมัสคีลของดาวิด","verses":[{"verse":1,"text":"คนโง่รำพึงในใจว่า ‘ไม่มีพระเจ้า’ พวกเขาเสื่อมทราม การกระทำของพวกเขาน่าชิงชัง ไม่มีสักคนที่ทำดี"},{"verse":2,"text":"พระเจ้าทอดพระเนตรลงมาจากฟ้าสวรรค์ดูบรร