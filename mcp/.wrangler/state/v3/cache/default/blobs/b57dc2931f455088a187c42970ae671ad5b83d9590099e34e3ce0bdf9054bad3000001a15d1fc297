ูคริสต์จากความตาย"},{"verse":4,"text":"และเข้าสู่มรดกที่ไม่เน่าเปื่อย ปราศจากมลทิน และไม่ร่วงโรย ที่ทรงสงวนไว้ในฟ้าสวรรค์สำหรับท่านทั้งหลาย"},{"verse":5,"text":"ผู้ซึ่งโดยฤทธิ์เดชของพระเจ้าได้รับการปกป้องไว้ผ่านความเชื่อ เพื่อความรอดที่พร้อมจะถูกเปิดเผยในวาระสุดท้าย"},{"verse":6,"text":"ในเรื่องนี้ท่านชื่นชมยินดียิ่ง แม้ว่าในขณะนี้อาจจะต้องทนทุกข์ด้วยความทุกข์ใจชั่วคราวจากการทดลองต่าง ๆ"},{"verse":7,"text":"เพื่อว่าการทดสอบความเชื่อของท่าน ซึ่งล้ำค่ายิ่งกว่าทองคำที่จะเสื่อมสูญแม้ถูกถลุงด้วยไฟ จะได้กลายเป็นคำสรรเสริญ พระสิริ และเกียรติ ในเวลาที่พระเยซูคริสต์ทรงสำแดงพระองค์"},{"verse":8,"text":"ท่านทั้งหลายรักพระองค์โดยที่ไม่เคยเห็น และแม้บัดนี้ก็ยังไม่ได้เห็นพระองค์ แต่ท่านก็เชื่อ และชื่นชมยินดียิ่งด้วยความยินดีอันไม่อาจกล่าวพรรณนาและเปี่ยมด้วยพระสิริ"},{"verse":9,"text":"ขณะที่ท่านกำลังรับเป้าหมายแห่งความเชื่อของท่าน คือความรอดของจิตวิญญาณ"},{"verse":10,"text":"เกี่ยวกับความรอดนี้ บรรดาผู้เผยพระวจนะที่ได้พยากรณ์ถึงพระคุณซึ่งจะมีแก่ท่าน ได้เสาะแสวงหาและค้นคว้าอย่างละเอียด"},{"verse":11,"text":"พวกเขาค้นหาว่าเวลาใดและสภาพการณ์เช่นไรที่พระวิญญาณของพระคริสต์ผู้สถิตในพวกเขาทรงชี้ให้เห็น เมื่อทรงเป็นพยานล่วงหน้าถึงการทนทุกข์ของพระคริสต์ และพระสิริที่จะตามมา"},{"verse":12,"text":"ทรงเปิดเผยแก่พวกเขาว่า พวกเขามิได้รับใช้ตนเอง แต่รับใช้ท่านทั้งหลาย เกี่ยวกับสิ่งเหล่านั้น ซึ่งบัดนี้ได้รับการประกาศแก่ท่าน โดยผู้ที่ประกาศข่าวประเสริฐแก่ท่านด้วยพระวิญญาณบริสุทธิ์ที่ทรงส่งมาจากฟ้าสวรรค์ ซึ่งทูตสวรรค์ทั้งหลายก็ปรารถนาจะเข้าใจสิ่งเหล่านี้"},{"verse":13,"text":"เพราะฉะนั้น จงคาดเอวจิตใจของท่านให้พร้อม จงมีสติอย่างเต็มที่ และจงตั้งความหวังอย่างเต็มที่ในพระคุณซึ่งจะนำมาให้ท่านในเวลาที่พระเยซูคริสต์ทรงสำแดงพระองค์"},{"verse":14,"text":"ในฐานะลูกที่เชื่อฟัง อย่าทำตนตามตัณหาที่มีในความไม่รู้ของท่านในอดีต"},{"verse":15,"text":"แต่จงเป็นผู้บริสุทธิ์ในความประพฤติทุกประการ ตามแบบของพระองค์ผู้ทรงเรียกท่าน ผู้ทรงบริสุทธิ์"},{"verse":16,"text":"เพราะมีคำเขียนไว้ว่า “พวกเจ้าจงเป็นผู้บริสุทธิ์ เพราะเราเป็นผู้บริสุทธิ์”"},{"verse":17,"text":"และถ้าท่านทูลเรียกพระบิดาผู้ทรงพิพากษาโดยไม่เลือกหน้าตามการกระทำของแต่ละคน ก็จงประพฤติด้วยความยำเกรงตลอดเวลาที่ท่านพำนักอยู่ในต่างถิ่น"},{"verse":18,"text":"เพราะท่านรู้ว่าท่านได้รับการไถ่จากความประพฤติที่ไร้ค่าซึ่งสืบทอดมาจากบรรพบุรุษ ไม่ใช่ด้วยสิ่งที่จะเสื่อมสูญ ไม่ว่าจะเป็นเงินหรือทองคำ"},{"verse":19,"text":"แต่ด้วยพระโลหิตอันล้ำค่าของพระคริสต์ ดุจดังลูกแกะที่ปราศจากที่ติและปราศจากมลทิน"},{"verse":20,"text":"พระองค์ทรงเป็นที่ทรงรู้ล่วงหน้าก่อนการวางรากฐานของโลก แต่ทรงปรากฏในยุคสุดท้ายเพื่อท่านทั้งหลาย"},{"verse":21,"text":"ผู้ที่โดยทางพระองค์ ก็เชื่อในพระเจ้าผู้ทรงให้พระองค์เป็นขึ้นจากความตาย และทรงประทานพระสิริแก่พระองค์ เพื่อความเชื่อและความหวังของท่านจะอยู่ในพระเจ้า"},{"verse":22,"text":"เมื่อท่านทั้งหลายได้ชำระจิตวิญญาณของท่านให้บริสุทธิ์โดยการเชื่อฟังความจริง สู่ความรักฉันพี่น้องที่ไม่หน้าซื่อใจคดแล้ว จงรักซึ่งกันและกันอย่างจริงจังจากใจที่บริสุทธิ์"},{"verse":23,"text":"เพราะท่านได้รับการบังเกิดใหม่ ไม่ใช่จากเมล็ดพันธุ์ที่จะเสื่อมสูญ แต่จากที่ไม่เน่าเปื่อย โดยทางพระวจนะของพระเจ้าผู้ทรงพระชนม์และดำรงอยู่"},{"verse":24,"text":"เพราะ “เนื้อหนังทั้งสิ้นเป็นเหมือนหญ้า และศักดิ์ศรีทั้งสิ้นของมันเป็นเหมือนดอกไม้ในทุ่งหญ้า หญ้าก็เหี่ยวแห้งและดอกไม้ก็ร่วงโรย"},{"verse":25,"text":"แต่พระวจนะขององค์พระผู้เป็นเจ้าดำรงอยู่เป็นนิตย์” และพระวจนะนี้เองคือพระวจนะที่ได้ประกาศแก่ท่านทั้งหลาย"}]},{"chapter":2,"verses":[{"verse":1,"text":"เพราะฉะนั้น จงทิ้งความใจร้ายทั้งหมด การหลอกลวงทั้งสิ้น ความหน้าซื่อใจคด ความริษยา และการพูดใส่ร้ายทุกชนิด"},{"verse":2,"text":"ดุจดังทารกที่เพิ่งเกิดใหม่ จงโหยหานมฝ่ายวิญญาณอันบริสุทธิ์ปราศจากการหลอกลวง เพื่อท่านทั้งหลายจะเติบโตขึ้นโดยทางนมนั้นไปสู่ความรอด"},{"verse":3,"text":"ในเมื่อท่านได้ลิ้มรสแล้วว่าองค์พระผู้เป็นเจ้าทรงประเสริฐ"},{"verse":4,"text":"เมื่อท่านเข้ามาหาพระองค์ ผู้ทรงเป็นศิลาที่มีชีวิต ที่ถูกมนุษย์ทอดทิ้ง แต่ในสายพระเนตรพระเจ้าทรงเลือกและทรงล้ำค่า"},{"verse":5,"text":"ท่านทั้งหลายก็เช่นเดียวกัน ดุจดังศิลามีชีวิต ทรงกำลังสร้างขึ้นเป็นวิหารฝ่ายวิญญาณ ให้เป็นปุโรหิตบริสุทธิ์ เพื่อถวายเครื่องบูชาฝ่ายวิญญาณซึ่งเป็นที่ทรงโปรดของพระเจ้า โดยทางพระเยซูคริสต์"},{"verse":6,"text":"เพราะมีคำในพระคัมภีร์ว่า “ดูเถิด เราวางศิลาก้อนหนึ่งไว้ในศิโยน เป็นศิลามุมเอกที่ทรงเลือกและล้ำค่า และผู้ที่เชื่อในพระองค์จะไม่อับอายเลย”"},{"verse":7,"text":"ดังนั้นสำหรับท่านที่เชื่อ พระองค์ก็เป็นที่ล้ำค่า แต่สำหรับผู้ที่ไม่เชื่อ “ศิลาที่ช่างก่อสร้างได้ทอดทิ้ง ได้กลายเป็นศิลามุมเอก”"},{"verse":8,"text":"และ “ศิลาแห่งการสะดุดและหินแห่งเหตุสะดุด” พวกเขาสะดุดเพราะไม่เชื่อฟังพระวจนะ ซึ่งพวกเขาได้ถูกกำหนดไว้แล้ว"},{"verse":9,"text":"แต่ท่านทั้งหลายเป็น “ชนชาติที่ทรงเลือกสรร เป็นปุโรหิตหลวง เป็นชนชาติบริสุทธิ์ เป็นประชากรเป็นของพระองค์เอง” เพื่อท่านจะประกาศคุณความดีของพระองค์ผู้ทรงเรียกท่านออกจากความมืดเข้าสู่ความสว่างอันน่าอัศจรรย์ของพระองค์"},{"verse":10,"text":"ครั้งหนึ่งท่านมิใช่ประชากร แต่บัดนี้ท่านเป็นประชากรของพระเจ้า ครั้งหนึ่งท่านไม่ได้รับพระเมตตา แต่บัดนี้ท่านได้รับพระเมตตาแล้ว"},{"verse":11,"text":"ท่านที่รักทั้งหลาย ในฐานะคนต่างถิ่นและคนพำนักชั่วคราว ข้าพเจ้าวิงวอนท่านให้ละเว้นจากตัณหาฝ่ายเนื้อหนัง ซึ่งทำสงครามต่อจิตวิญญาณ"},{"verse":12,"text":"จงประพฤติอย่างดีในหมู่คนต่างชาติ เพื่อในเรื่องที่เขาพูดใส่ร้ายท่านว่าเป็นคนทำชั่ว เขาจะได้เห็นการดีของท่านและถวายเกียรติแด่พระเจ้าในวันที่พระองค์เสด็จมาเยี่ยม"},{"verse":13,"text":"เพราะเห็นแก่องค์พระผู้เป็นเจ้า จงยอมจำนนต่อสถาบันของมนุษย์ทุกอย่าง ไม่ว่าจะเป็นกษัตริย์ในฐานะผู้มีอำนาจสูงสุด"},{"verse":14,"text":"หรือต่อผู้ปกครองในฐานะผู้ที่กษัตริย์ส่งมาเพื่อลงโทษคนทำชั่วและสรรเสริญคนทำดี"},{"verse":15,"text":"เพราะนี่คือพระประสงค์ของพระเจ้า คือให้ท่านปิดปากความไม่รู้ของคนโง่เขลาด้วยการทำดี"},{"verse":16,"text":"จงดำเนินชีวิตในฐานะคนเสรี แต่อย่าใช้เสรีภาพเป็นเครื่องบังหน้าความชั่ว แต่จงเป็นผู้รับใช้ของพระเจ้า"},{"verse":17,"text":"จงให้เกียรติแก่คนทั้งปวง จงรักหมู่พี่น้อง จงยำเกรงพระเจ้า จงให้เกียรติแก่กษัตริย์"},{"verse":18,"text":"บรรดาคนรับใช้ จงยอมจำนนต่อนายของตนด้วยความยำเกรงทุกประการ ไม่เพียงแต่นายที่ดีและสุภาพอ่อนโยนเท่านั้น แต่แม้กระทั่งนายที่คดดื้อ"},{"verse":19,"text":"เพราะเป็นพระคุณที่ทรงพอพระทัย ถ้าผู้ใดอดทนต่อความทุกข์ใจในการทนทุกข์อย่างไม่ยุติธรรม เพราะเห็นแก่จิตสำนึกของตนต่อพระเจ้า"},{"verse":20,"text":"เพราะจะเป็นเกียรติอันใด ถ้าท่านอดทนเมื่อถูกตบเพราะทำบาป แต่ถ้าท่านอดทนเมื่อทนทุกข์เพราะทำดี นี่คือพระคุณที่ทรงพอพระทัยต่อพระเจ้า"},{"verse":21,"text":"เพราะท่านได้รับการทรงเรียกมาเพื่อสิ่งนี้ เพราะพระคริสต์ก็ทรงทนทุกข์เพื่อท่านทั้งหลาย ทรงทิ้งแบบอย่างไว้แก่ท่าน เพื่อท่านจะเดินตามรอยพระบาทของพระองค์"},{"verse":22,"text":"“พระองค์ไม่ได้ทรงทำบาปเลย และไม่พบการหลอกลวงในพระโอษฐ์ของพระองค์”"},{"verse":23,"text":"เมื่อทรงถูกด่าว่า พระองค์ไม่ทรงด่าตอบ เมื่อทรงทนทุกข์ พระองค์ไม่ทรงข่มขู่ใคร แต่ทรงมอบพระองค์เองไว้กับผู้ที่ทรงพิพากษาอย่างเที่ยงธรรม"},{"verse":24,"text":"พระองค์เองทรงรับเอาบาปของเราไว้ในพระกายของพระองค์บนต้นไม้นั้น เพื่อเราจะตายต่อบาปและมีชีวิตอยู่เพื่อความชอบธรรม “โดยรอยรับบาดเจ็บของพระองค์ ท่านทั้งหลายก็ได้รับการรักษา”"},{"verse":25,"text":"เพราะ “ท่านเคยเป็นเหมือนแกะที่หลงทาง” แต่บัดนี้ท่านได้กลับมาหาผู้เลี้ยงและผู้ดูแลจิตวิญญาณของท่านทั้งหลาย"}]},{"chapter":3,"verses":[{"verse":1,"text":"เช่นเดียวกัน ภรรยาทั้งหลาย จงยอมจำนนต่อสามีของตน เพื่อแม้ว่าบางคนจะไม่เชื่อฟังพระวจนะ พวกเขาก็จะถูกชักนำมาสู่ความเชื่อโดยความประพฤติของภรรยา โดยไม่ต้องใช้คำพูด"},{"verse":2,"text":"เมื่อเขาทั้งหลายได้เห็นความประพฤติอันบริสุทธิ์ด้วยความยำเกรงของท่าน"},{"verse":3,"text":"ความงามของท่านอย่าให้มาจากการประดับภายนอก เช่น การถักทรงผม การประดับด้วยทอง หรือการสวมเสื้อผ้าหรูหรา"},{"verse":4,"text":"แต่ให้มาจากตัวตนภายในของจิตใจ ในความไม่เน่าเปื่อยของจิตวิญญาณที่อ่อนโยนและสงบ ซึ่งเป็นที่มีค่ายิ่งในสายพระเนตรของพระเจ้า"},{"verse":5,"text":"เพราะในสมัยก่อน บรรดาหญิงผู้บริสุทธิ์ที่ได้ตั้งความหวังในพระเจ้าก็ประดับตนเองอย่างนี้ และยอมจำนนต่อสามีของตน"},{"verse":6,"text":"เช่นเดียวกับซาราห์ที่เชื่อฟังอับราฮัม โดยเรียกท่านว่านาย ท่านทั้งหลายก็ได้กลายเป็นบุตรของนาง ถ้าท่านทำดีและไม่กลัวสิ่งใดเลย"},{"verse":7,"text":"บรรดาสามี เช่นเดียวกัน จงอยู่กินกับภรรยาของท่านอย่างเข้าใจ โดยให้เกียรติแก่นางในฐานะภาชนะที่อ่อนแอกว่า และในฐานะผู้รับมรดกร่วมแห่งพระคุณคือชีวิต เพื่อคำอธิษฐานของท่านจะไม่ถูกขัดขวาง"},{"verse":8,"text":"ในที่สุด ท่านทุกคนจงเป็นน้ำหนึ่งใจเดียวกัน เห็นอกเห็นใจกัน รักฉันพี่น้อง มีจิตใจเอ็นดู และถ่อมใจ"},{"verse":9,"text":"อย่าตอบแทนความชั่วด้วยความชั่ว หรือการด่าว่าด้วยการด่าว่า แต่จงอวยพรในทางตรงกันข้าม เพราะท่านได้รับการทรงเรียกมาเพื่อสิ่งนี้ เพื่อท่านจะได้รับพระพรเป็นมรดก"},{"verse":10,"text":"เพราะ “ผู้ใดที่ต้องการรักชีวิต และเห็นวันคืนที่ดี ก็จงห้ามลิ้นของตนจากความชั่ว และห้ามริมฝีปากจากการพูดหลอกลวง"},{"verse":11,"text":"จงหันออกจากความชั่ว และจงทำสิ่งดี จงแสวงหาสันติสุขและไล่ตามมันไป"},{"verse":12,"text":"เพราะพระเนตรขององค์พระผู้เป็นเจ้าทรงเฝ้าดูคนชอบธรรม และพระกรรณของพระองค์ก็ทรงเอียงฟังคำอธิษฐานของพวกเขา แต่พระพักตร์ขององค์พระผู้เป็นเจ้าทรงต่อต้านคนที่ทำชั่ว”"},{"verse":13,"text":"ใครเล่าจะทำร้ายท่านได้ ถ้าท่านมีความกระตือรือร้นในการทำดี"},{"verse":14,"text":"แต่แม้ว่าท่านจะต้องทนทุกข์เพราะความชอบธรรม ท่านก็เป็นสุข “อย่ากลัวสิ่งที่เขาทั้งหลายกลัวเลย และอย่าหวั่นไหว”"},{"verse":15,"text":"แต่จงให้พระคริสต์เป็นองค์พระผู้เป็นเจ้าผู้ทรงบริสุทธิ์ในใจของท่าน จงเตรียมพร้อมเสมอที่จะให้คำแก้แก่ทุกคนที่ขอเหตุผลเรื่องความหวังที่อยู่ในท่าน"},{"verse":16,"text":"แต่จงทำด้วยความสุภาพอ่อนโยนและความยำเกรง โดยมีจิตสำนึกที่ดี เพื่อในเรื่องที่เขาพูดใส่ร้ายท่าน บรรดาผู้ที่กล่าวร้ายความประพฤติดีของท่านในพระคริสต์จะอับอาย"},{"verse":17,"text":"เพราะการทนทุกข์เพราะทำดี ถ้านั่นเป็นพระประสงค์ของพระเจ้า ก็ดีกว่าการทนทุกข์เพราะทำชั่ว"},{"verse":18,"text":"เพราะพระคริสต์ก็ทรงทนทุกข์เพื่อบาปครั้งเดียวเป็นพอ ผู้ทรงชอบธรรมเพื่อผู้อธรรม เพื่อนำท่านทั้งหลายมาถึงพระเจ้า ทรงถูกประหารในเนื้อหนัง แต่ทรงได้ชีวิตในพระวิญญาณ"},{"verse":19,"text":"ในพระวิญญาณนั้น พระองค์ได้เสด็จไปประกาศแก่บรรดาวิญญาณที่อยู่ในที่กักขัง"},{"verse":20,"text":"ซึ่งในสมัยก่อนได้ไม่เชื่อฟัง เมื่อความอดทนของพระเจ้าทรงรอคอยในยุคของโนอาห์ ขณะที่กำลังสร้างเรือใหญ่ ในเรือนั้นมีคนเพียงไม่กี่คน คือแปดคน ที่ได้รับการช่วยให้รอดผ่านน้ำ"},{"verse":21,"text":"บัพติศมาซึ่งเป็นภาพแทนของน้ำนั้น บัดนี้ก็ช่วยท่านทั้งหลายให้รอด ไม่ใช่การล้างความสกปรกออกจากร่างกาย แต่เป็นคำสัญญาของจิตสำนึกที่ดีต่อพระเจ้า โดยทางการคืนพระชนม์ของพระเยซูคริสต์"},{"verse":22,"text":"ผู้ทรงเสด็จขึ้นสู่ฟ้าสวรรค์แล้ว ทรงประทับเบื้องขวาของพระเจ้า โดยมีบรรดาทูตสวรรค์ ผู้ทรงอำนาจ และผู้มีฤทธิ์ ยอมจำนนต่อพระองค์"}]},{"chapter":4,"verses":[{"verse":1,"text":"เพราะฉะนั้น เมื่อพระคริสต์ทรงทนทุกข์ในเนื้อหนังแล้ว ท่านทั้งหลายก็จงสวมใส่ความตั้งใจเดียวกันนั้นเป็นอาวุธ เพราะผู้ที่ได้ทนทุกข์ในเนื้อหนังก็ได้ละจากบาปแล้ว"},{"verse":2,"text":"เพื่อจะไม่ดำเนินชีวิตในเวลาที่เหลืออยู่ในเนื้อหนังตามตัณหาของมนุษย์ แต่ตามพระประสงค์ของพระเจ้า"},{"verse":3,"text":"เพราะเวลาที่ผ่านมาก็เพียงพอแล้วที่ท่านได้ทำตามใจปรารถนาของคนต่างชาติ ได้ดำเนินชีวิตในความเสเพล ตัณหา การเมาสุรา การเฮฮาสุรุ่ยสุร่าย การดื่มเหล้า และการกราบไหว้รูปเคารพอันชั่วร้าย"},{"verse":4,"text":"เพราะเหตุนี้เขาทั้งหลายจึงประหลาดใจที่ท่านไม่ร่วมวิ่งไปกับเขาในกระแสแห่งการฟุ้งซ่านไร้สำนึกอันเดียวกันนั้น และพากันด่าว่าท่าน"},{"verse":5,"text":"พวกเขาจะต้องให้คำชี้แจงต่อพระองค์ผู้ทรงพร้อมจะพิพากษาคนเป็นและคนตาย"},{"verse":6,"text":"เพราะเหตุนี้เอง ข่าวประเสริฐจึงได้ถูกประกาศแก่ผู้ที่บัดนี้ตายไปแล้วด้วย เพื่อพวกเขาจะถูกพิพากษาตามมนุษย์ในเนื้อหนัง แต่จะมีชีวิตตามพระเจ้าในวิญญาณ"},{"verse":7,"text":"บัดนี้วาระสุดท้ายของสรรพสิ่งใกล้เข้ามาแล้ว เพราะฉะนั้น จงมีสติสัมปชัญญะและมีสติเพื่อการอธิษฐาน"},{"verse":8,"text":"เหนือสิ่งอื่นใด จงมีความรักต่อกันและกันอย่างจริงจัง เพราะ “ความรักปกปิดบาปเป็นอันมาก”"},{"verse":9,"text":"จงต้อนรับซึ่งกันและกันด้วยน้ำใจ ไม่บ่นพึมพำ"},{"verse":10,"text":"แต่ละคน เมื่อได้รับของประทานใด ก็จงรับใช้ซึ่งกันและกันด้วยของประทานนั้น ในฐานะเป็นผู้ดูแลที่ดีแห่งพระคุณอันหลากหลายของพระเจ้า"},{"verse":11,"text":"ถ้าผู้ใดพูด ก็จงพูดเหมือนถ้อยคำของพระเจ้า ถ้าผู้ใดรับใช้ ก็จงรับใช้ด้วยกำลังที่พระเจ้าทรงประทาน เพื่อในทุกสิ่งพระเจ้าจะได้รับเกียรติยศโดยทางพระเยซูคริสต์ ขอพระสิริและฤทธานุภาพจงมีแด่พระองค์สืบ ๆ ไปเป็นนิตย์ อาเมน"},{"verse":12,"text":"ท่านที่รักทั้งหลาย อย่าประหลาดใจในการทดลองอันร้อนแรงที่เกิดขึ้นกับท่าน เหมือนสิ่งแปลกประหลาดได้เกิดขึ้นกับท่าน"},{"verse":13,"text":"แต่ตามที่ท่านมีส่วนร่วมในการทนทุกข์ของพระคริสต์ ก็จงชื่นชมยินดี เพื่อในเวลาที่พระสิริของพระองค์ทรงสำแดง ท่านจะได้ชื่นชมยินดีอย่างเปี่ยมล้นเช่นกัน"},{"verse":14,"text":"ถ้าท่านถูกตำหนิเพราะพระนามของพระคริสต์ ท่านก็เป็นสุข เพราะพระวิญญาณแห่งพระสิริและพระวิญญาณของพระเจ้าทรงสถิตอยู่กับท่าน"},{"verse":15,"text":"อย่าให้ผู้ใดในพวกท่านต้องทนทุกข์ในฐานะคนฆ่า คนขโมย คนทำชั่ว หรือคนที่ยุ่งกับเรื่องของผู้อื่น"},{"verse":16,"text":"แต่ถ้าทนทุกข์ในฐานะคริสเตียน อย่าให้ผู้นั้นอาย แต่ให้ถวายเกียรติแด่พระเจ้าในนามนั้น"},{"verse":17,"text":"เพราะนี่เป็นเวลาที่การพิพากษาจะเริ่มต้นจากครอบครัวของพระเจ้า ถ้าเริ่มต้นจากเราเสียก่อนแล้ว ผลสุดท้ายของผู้ที่ไม่เชื่อฟังข่าวประเสริฐของพระเจ้าจะเป็นอย่างไรเล่า"},{"verse":18,"text":"และ “ถ้าคนชอบธรรมยังรอดได้อย่างยากเย็น คนอธรรมและคนบาปจะปรากฏที่ไหนเล่า”"},{"verse":19,"text":"เพราะฉะนั้น ผู้ที่ทนทุกข์ตามพระประสงค์ของพระเจ้า ก็ให้มอบจิตวิญญาณของตนไว้กับพระผู้สร้างผู้ทรงสัตย์ซื่อ พร้อมกับการทำดีต่อไป"}]},{"chapter":5,"verses":[{"verse":1,"text":"เพราะฉะนั้น ในฐานะผู้ปกครองคริสตจักรเพื่อนร่วมงาน เป็นพยานในการทนทุกข์ของพระคริสต์ และเป็นผู้มีส่วนร่วมในพระสิริที่จะทรงสำแดง ข้าพเจ้าขอวิงวอนผู้ปกครองคริสตจักรในหมู่พวกท่าน"},{"verse":2,"text":"จงเลี้ยงดูฝูงแกะของพระเจ้าที่อยู่ในหมู่พวกท่าน ดูแลพวกเขาไม่ใช่ด้วยการบังคับ แต่ด้วยความสมัครใจตามพระประสงค์ของพระเจ้า ไม่ใช่ด้วยความโลภในกำไรอันน่าอาย แต่ด้วยความกระตือรือร้น"},{"verse":3,"text":"ไม่ใช่ด้วยการครอบครองเหนือผู้ที่ทรงมอบไว้แก่ท่าน แต่จงเป็นแบบอย่างแก่ฝูงแกะ"},{"verse":4,"text":"และเมื่อพระผู้เลี้ยงใหญ่ทรงสำแดงพระองค์ ท่านจะได้รับมงกุฎแห่งพระสิริที่ไม่ร่วงโรย"},{"verse":5,"text":"เช่นเดียวกัน คนหนุ่มทั้งหลาย จงยอมจำนนต่อผู้ปกครองคริสตจักร และพวกท่านทุกคนจงสวมใส่ความถ่อมใจในการปฏิบัติต่อกันและกัน เพราะ “พระเจ้าทรงต่อต้านคนเย่อหยิ่ง แต่ทรงประทานพระคุณแก่คนถ่อมใจ”"},{"verse":6,"text":"เพราะฉะนั้น จงถ่อมตัวลงภายใต้พระหัตถ์อันทรงฤทธิ์ของพระเจ้า เพื่อในเวลาอันสมควรพระองค์จะทรงยกท่านขึ้น"},{"verse":7,"text":"จงมอบความกังวลทั้งสิ้นของท่านไว้กับพระองค์ เพราะพระองค์ทรงห่วงใยพวกท่าน"},{"verse":8,"text":"จงมีสติและตื่นตัว ปฏิปักษ์ของท่านคือมาร เดินวนเวียนไปมาดุจสิงโตคำราม เสาะหาผู้ที่จะกลืนกิน"},{"verse":9,"text":"จงต่อสู้มันโดยมั่นคงในความเชื่อ โดยรู้ว่าหมู่พี่น้องของท่านที่อยู่ในโลกก็กำลังทนทุกข์อย่างเดียวกัน"},{"verse":10,"text":"ส่วนพระเจ้าแห่งพระคุณทั้งสิ้น ผู้ทรงเรียกท่านเข้าสู่พระสิริอันเป็นนิรันดร์ของพระองค์ในพระคริสต์ เมื่อท่านทนทุกข์เพียงชั่วครู่แล้ว พระองค์เองจะทรงทำให้ท่านครบบริบูรณ์ ทำให้มั่นคง ทำให้เข้มแข็ง และตั้งรากฐาน"},{"verse":11,"text":"ขอฤทธานุภาพจงมีแด่พระองค์สืบ ๆ ไปเป็นนิตย์ อาเมน"},{"verse":12,"text":"ข้าพเจ้าได้เขียนถึงท่านอย่างย่อ ๆ โดยทางสิลวานัส พี่น้องที่สัตย์ซื่อ ตามที่ข้าพเจ้าถือ เพื่อหนุนใจและยืนยันว่านี่คือพระคุณที่แท้จริงของพระเจ้า จงยืนหยัดอยู่ในพระคุณนั้น"},{"verse":13,"text":"คริสตจักรที่อยู่ในบาบิโลน ผู้ที่ทรงเลือกสรรร่วมกับท่านทั้งหลาย ฝากความระลึกถึงท่าน และมาระโกบุตรของข้าพเจ้าก็เช่นกัน"},{"verse":14,"text":"จงทักทายกันและกันด้วยจุมพิตแห่งความรัก ขอสันติสุขจงมีแก่ท่านทุกคนที่อยู่ในพระคริสต์"}]}]},{"osis":"2Pet","usfm":"2PE","name_en":"2 Peter","name_th":"จดหมายฉบับที่สองของเปโตร","chapters":[{"chapter":1,"verses":[{"verse":1,"text":"ซีโมนเปโตร ทาสและอัครทูตของพระเยซูคริสต์ ถึงผู้ที่ได้รับความเชื่ออันล้ำค่าเช่นเดียวกับเรา โดยความชอบธรรมของพระเจ้าและพระผู้ช่วยให้รอดของเราคือพระเยซูคริสต์"},{"verse":2,"text":"ขอพระคุณและสันติสุขจงทวีคูณแก่ท่านทั้งหลาย โดยความรู้ที่แท้จริงของพระเจ้าและของพระเยซูองค์พระผู้เป็นเจ้าของเรา"},{"verse":3,"text":"ฤทธานุภาพแห่งพระเจ้าของพระองค์ได้ประทานทุกสิ่งแก่เราที่จำเป็นต่อชีวิตและความเคร่งในพระเจ้า โดยทางความรู้ที่แท้จริงของพระองค์ผู้ทรงเรียกเราด้วยพระสิริและคุณความดีของพระองค์เอง"},{"verse":4,"text":"โดยสิ่งเหล่านี้ พระองค์ได้ประทานพระสัญญาอันล้ำค่าและยิ่งใหญ่ที่สุดแก่เรา เพื่อโดยพระสัญญาเหล่านี้ ท่านทั้งหลายจะได้มีส่วนร่วมในพระลักษณะแห่งพระเจ้า โดยหลีกเลี่ยงความเสื่อมทรามในโลกอันเกิดจากตัณหา"},{"verse":5,"text":"เพราะเหตุนี้เอง ท่านทั้งหลายจงเพียรพยายามอย่างเต็มที่ที่จะเสริมคุณธรรมเข้ากับความเชื่อของท่าน และเสริมความรู้เข้ากับคุณธรรม"},{"verse":6,"text":"และเสริมการควบคุมตัวเองเข้ากับความรู้ และเสริมความอดทนเข้ากับการควบคุมตัวเอง และเสริมความเคร่งในพระเจ้าเข้ากับความอดทน"},{"verse":7,"text":"และเสริมความรักฉันพี่น้องเข้ากับความเคร่งในพระเจ้า และเสริมความรักเข้ากับความรักฉันพี่น้อง"},{"verse":8,"text":"เพราะถ้าสิ่งเหล่านี้มีอยู่ในท่านและเจริญงอกงามขึ้น สิ่งเหล่านี้จะทำให้ท่านไม่ขาดผลและไม่ปราศจากผลในความรู้ที่แท้จริงเกี่ยวกับพระเยซูคริสต์องค์พระผู้เป็นเจ้าของเรา"},{"verse":9,"text":"ส่วนผู้ใดที่ไม่มีสิ่งเหล่านี้ ผู้นั้นเป็นคนตาบอดและสายตาสั้น โดยลืมว่าเขาได้รับการชำระจากบาปในอดีตของตนแล้ว"},{"verse":10,"text":"เพราะฉะนั้น พี่น้องทั้งหลาย ยิ่งจงเพียรพยายามที่จะทำให้การทรงเรียกและการทรงเลือกสรรของท่านมั่นคง เพราะถ้าท่านปฏิบัติสิ่งเหล่านี้ ท่านจะไม่มีวันสะดุดล้ม"},{"verse":11,"text":"เพราะเช่นนี้แล้ว ท่านจะได้รับการต้อนรับอย่างบริบูรณ์เข้าสู่อาณาจักรนิรันดร์ของพระเยซูคริสต์องค์พระผู้เป็นเจ้าและพระผู้ช่วยให้รอดของเรา"},{"verse":12,"text":"เพราะฉะนั้น ข้าพเจ้าจะตั้งใจเตือนท่านเสมอเรื่องสิ่งเหล่านี้ แม้ท่านจะรู้และตั้งมั่นในความจริงที่ท่านมีอยู่ในเวลานี้แล้วก็ตาม"},{"verse":13,"text":"และข้าพเจ้าถือว่าเป็นการสมควร ตราบใดที่ข้าพเจ้ายังอยู่ในเต็นท์แห่งร่างกายนี้ ที่จะปลุกท่านให้ตื่นขึ้นโดยการเตือนความทรงจำ"},{"verse":14,"text":"เพราะข้าพเจ้ารู้ว่าการที่ข้าพเจ้าจะวางเต็นท์แห่งร่างกายของข้าพเจ้าลงนั้นใกล้เข้ามาแล้ว ดังที่พระเยซูคริสต์องค์พระผู้เป็นเจ้าของเราได้ทรงสำแดงแก่ข้าพเจ้า"},{"verse":15,"text":"และข้าพเจ้าจะเพียรพยายามที่จะให้ท่านสามารถระลึกถึงสิ่งเหล่านี้ได้ทุกเมื่อหลังจากข้าพเจ้าจากไปแล้ว"},{"verse":16,"text":"เพราะเมื่อเราได้ประกาศแก่ท่านทั้งหลายเรื่องฤทธานุภาพและการเสด็จมาของพระเยซูคริสต์องค์พระผู้เป็นเจ้าของเรา เราไม่ได้ทำตามนิทานที่แต่งขึ้นอย่างฉลาดแกมโกง แต่เราได้เป็นพยานผู้เห็นด้วยตาตนเองถึงความยิ่งใหญ่ของพระองค์"},{"verse":17,"text":"เพราะพระองค์ได้รับเกียรติและพระสิริจากพระเจ้าพระบิดา เมื่อมีพระสุรเสียงดังนี้มาถึงพระองค์จากพระสิริอันยิ่งใหญ่ตระการตาว่า “นี่คือบุตรที่รักของเรา ผู้ซึ่งเราพอใจ”"},{"verse":18,"text":"และเราเองก็ได้ยินพระสุรเสียงนี้จากสวรรค์ เมื่อเราอยู่กับพระองค์บนภูเขาบริสุทธิ์"},{"verse":19,"text":"และเรามีถ้อยคำของผู้พยากรณ์ที่ได้รับการยืนยันยิ่งกว่าเดิม ซึ่งท่านทั้งหลายทำดีแล้วที่ใส่ใจในถ้อยคำนั้น ดุจดวงประทีปที่ส่องสว่างในที่มืดมิด จนกว่าวันจะรุ่งและดาวประจำรุ่งจะขึ้นในใจของท่าน"},{"verse":20,"text":"เหนือสิ่งอื่นใด ท่านทั้งหลายจงเข้าใจว่า คำพยากรณ์ทั้งหมดในพระคัมภีร์ไม่ได้เกิดจากการตีความตามใจของผู้เผยพระวจนะเอง"},{"verse":21,"text":"เพราะคำพยากรณ์นั้นไม่เคยเกิดขึ้นโดยน้ำใจของมนุษย์เลย แต่มนุษย์ได้กล่าวถ้อยคำที่มาจากพระเจ้า โดยการนำของพระวิญญาณบริสุทธิ์"}]},{"chapter":2,"verses":[{"verse":1,"text":"แต่ก็มีผู้เผยพระวจนะเท็จเกิดขึ้นในหมู่ประชาชน เช่นเดียวกับที่จะมีครูสอนเท็จอยู่ในหมู่พวกท่าน ผู้ซึ่งจะแอบนำลัทธินอกรีตอันนำไปสู่ความพินาศเข้ามา และปฏิเสธองค์เจ้านายผู้ทรงไถ่พวกเขาไว้ นำความพินาศอันรวดเร็วมาสู่ตนเอง"},{"verse":2,"text":"และคนเป็นจำนวนมากจะทำตามความเสเพลของพวกเขา เพราะคนเหล่านั้น ทางแห่งความจริงจะถูกหมิ่นประมาท"},{"verse":3,"text":"ด้วยความโลภ พวกเขาจะใช้ถ้อยคำที่ปลอมแปลงเพื่อแสวงประโยชน์จากท่าน การพิพากษาที่กำหนดไว้แต่นานมาแล้วต่อพวกเขาก็ไม่ได้หยุดยั้ง และความพินาศของพวกเขาก็ไม่หลับใหล"},{"verse":4,"text":"เพราะถ้าพระเจ้าไม่ทรงละเว้นบรรดาทูตสวรรค์เมื่อพวกเขาทำบาป แต่ทรงโยนพวกเขาลงในนรกขุมลึกที่สุด ทรงล่ามไว้ในโซ่แห่งความมืดเพื่อรอการพิพากษา"},{"verse":5,"text":"และทรงไม่ละเว้นโลกในยุคโบราณ แต่ทรงปกป้องโนอาห์ ผู้ประกาศความชอบธรรม กับอีกเจ็ดคน เมื่อพระองค์ทรงนำน้ำท่วมมาเหนือโลกของคนอธรรม"},{"verse":6,"text":"และทรงพิพากษาเมืองโสโดมและโกโมราห์ให้พินาศ ทรงเผาเมืองเหล่านั้นเป็นเถ้าถ่าน ทรงทำให้เป็นตัวอย่างของสิ่งที่จะเกิดขึ้นแก่คนอธรรมในภายภาคหน้า"},{"verse":7,"text":"และทรงช่วยโลทผู้ชอบธรรมให้รอด ผู้ซึ่งทุกข์ทรมานจากความประพฤติเสเพลของพวกคนนอกกฎหมาย"},{"verse":8,"text":"เพราะผู้ชอบธรรมท่านนั้นซึ่งอาศัยอยู่ท่ามกลางพวกเขา ทุกวันได้ทรมานจิตวิญญาณอันชอบธรรมของตนเพราะการกระทำที่ไร้กฎหมายซึ่งท่านเห็นและได้ยิน"},{"verse":9,"text":"องค์พระผู้เป็นเจ้าทรงรู้วิธีช่วยผู้เคร่งในพระเจ้าให้รอดพ้นจากการทดลอง และทรงรู้วิธีกักขังคนอธรรมไว้รอการลงโทษในวันแห่งการพิพากษา"},{"verse":10,"text":"โดยเฉพาะอย่างยิ่งคนเหล่านั้นที่ดำเนินตามเนื้อหนัง ในตัณหาแห่งความเสื่อมทราม และดูหมิ่นอำนาจ พวกเขาเป็นคนกล้าหาญในทางชั่ว เป็นคนถือทิฐิ ไม่เกรงกลัวที่จะดูหมิ่นเหล่าผู้ทรงสง่าราศี"},{"verse":11,"text":"ในขณะที่แม้แต่บรรดาทูตสวรรค์ที่มีกำลังและฤทธานุภาพมากกว่า ก็ไม่กล่าวคำพิพากษาเชิงดูหมิ่นต่อพวกเขาต่อหน้าองค์พระผู้เป็นเจ้า"},{"verse":12,"text":"แต่คนเหล่านี้เป็นเหมือนสัตว์ป่าที่ปราศจากเหตุผล สัตว์ที่กำเนิดมาด้วยสัญชาตญาณเพื่อให้ถูกจับและทำลาย พวกเขาดูหมิ่นในสิ่งที่ตนไม่เข้าใจ และจะถูกทำลายในความเสื่อมทรามของตน"},{"verse":13,"text":"พวกเขาจะได้รับค่าจ้างแห่งความอธรรมเป็นความชั่วที่กลับมาทำร้ายตน พวกเขาถือว่าการสำเริงสำราญในเวลากลางวันเป็นความสนุก เป็นรอยด่างและตำหนิ ปล่อยตัวในความสนุกอย่างฟุ่มเฟือยขณะที่พวกเขาร่วมรับประทานอาหารกับท่านด้วยความหลอกลวง"},{"verse":14,"text":"ดวงตาของพวกเขาเต็มไปด้วยการล่วงประเวณี และไม่หยุดทำบาป พวกเขาล่อจิตวิญญาณที่ไม่มั่นคง มีใจที่ถูกฝึกให้โลภ เป็นบุตรแห่งคำสาปแช่ง"},{"verse":15,"text":"พวกเขาได้ละทิ้งทางตรง และหลงทางไปทำตามทางของบาลาอัมบุตรของเบโอร์ ผู้ซึ่งรักค่าจ้างแห่งความอธรรม"},{"verse":16,"text":"แต่เขาก็ได้ถูกตำหนิเรื่องการละเมิดของตน — ลาที่ไม่มีเสียงพูดได้กล่าวด้วยเสียงมนุษย์ และยับยั้งความบ้าคลั่งของผู้พยากรณ์ผู้นี้ไว้"},{"verse":17,"text":"คนเหล่านี้เป็นบ่อน้ำพุที่ไม่มีน้ำ และเป็นหมอกที่ถูกพายุพัดไป ความมืดมิดที่ดำสนิทถูกสงวนไว้สำหรับพวกเขา"},{"verse":18,"text":"เพราะพวกเขากล่าวถ้อยคำที่อวดโอ่อันว่างเปล่า ล่อด้วยตัณหาแห่งเนื้อหนังและความเสเพล ดักจับคนที่เพิ่งหลีกเลี่ยงจากผู้ที่ดำเนินชีวิตในความหลงผิด"},{"verse":19,"text":"พวกเขาสัญญาว่าจะให้เสรีภาพแก่คนเหล่านั้น แต่ตัวพวกเขาเองเป็นทาสของความเสื่อมทราม เพราะผู้ใดถูกสิ่งใดเอาชนะ ผู้นั้นก็ตกเป็นทาสของสิ่งนั้น"},{"verse":20,"text":"เพราะถ้าเมื่อพวกเขาได้หลีกเลี่ยงความเสื่อมทรามของโลกโดยทางความรู้ที่แท้จริงของพระเยซูคริสต์องค์พระผู้เป็นเจ้าและพระผู้ช่วยให้รอดของเรา แล้วก็กลับเข้าไปพัวพันและถูกเอาชนะอีกครั้ง สภาพสุดท้ายของพวกเขาก็เลวร้ายกว่าสภาพแรก"},{"verse":21,"text":"เพราะการที่พวกเขาไม่รู้จักทางแห่งความชอบธรรมเลยก็ดีกว่าการที่พวกเขาได้รู้จักแล้วหันกลับจากพระบัญญัติบริสุทธิ์ที่ทรงมอบให้แก่พวกเขา"},{"verse":22,"text":"สิ่งที่เกิดขึ้นกับพวกเขาเป็นจริงตามสุภาษิตที่ว่า “สุนัขกลับไปกินสิ่งที่มันสำรอกเอง” และ “สุกรที่ล้างแล้วก็กลับไปเกลือกกลั้วในโคลนตม”"}]},{"chapter":3,"verses":[{"verse":1,"text":"ท่านที่รัก จดหมายฉบับนี้เป็นฉบับที่สองของข้าพเจ้าที่เขียนถึงท่าน ในจดหมายทั้งสองฉบับนั้น ข้าพเจ้าได้ปลุกความคิดอันบริสุทธิ์ของท่านโดยการเตือนความทรงจำ"},{"verse":2,"text":"เพื่อให้ท่านระลึกถึงถ้อยคำที่ได้ตรัสไว้ก่อนแล้วโดยบรรดาผู้เผยพระวจนะบริสุทธิ์ และถึงพระบัญชาขององค์พระผู้เป็นเจ้าและพระผู้ช่วยให้รอด ที่ทรงประทานผ่านบรรดาอัครทูตของท่าน"},{"verse":3,"text":"เหนือสิ่งอื่นใด ท่านทั้งหลายจงเข้าใจว่า ในวาระสุดท้าย จะมีคนเย้ยหยันเกิดขึ้น พวกเขาจะเย้ยหยัน และดำเนินตามตัณหาของตนเอง"},{"verse":4,"text":"พวกเขาจะกล่าวว่า “พระสัญญาเรื่องการเสด็จมาของพระองค์อยู่ที่ไหน? เพราะตั้งแต่บรรพบุรุษล่วงหลับไป ทุกสิ่งก็คงอยู่อย่างเดิมตั้งแต่เริ่มสร้างโลก”"},{"verse":5,"text":"เพราะพวกเขาจงใจมองข้ามข้อเท็จจริงที่ว่า ฟ้าสวรรค์มีอยู่ตั้งแต่นานมาแล้ว และแผ่นดินโลกได้ก่อตัวขึ้นจากน้ำและด้วยน้ำ โดยพระวจนะของพระเจ้า"},{"verse":6,"text":"ผ่านสิ่งเหล่านั้น โลกในยุคนั้นได้ถูกน้ำท่วมและพินาศไป"},{"verse":7,"text":"ส่วนฟ้าสวรรค์และแผ่นดินโลกในปัจจุบันก็ถูกสะสมไว้สำหรับไฟ โดยพระวจนะเดียวกันนั้น ถูกเก็บไว้สำหรับวันแห่งการพิพากษาและการพินาศของคนอธรรม"},{"verse":8,"text":"ท่านที่รัก อย่ามองข้ามสิ่งนี้แม้แต่อย่างเดียว นั่นคือ “หนึ่งวันต่อองค์พระผู้เป็นเจ้าก็เหมือนพันปี และพันปีก็เหมือนวันเดียว”"},{"verse":9,"text":"องค์พระผู้เป็นเจ้าไม่ได้ทรงล่าช้าในเรื่องพระสัญญา ดังที่บางคนเข้าใจว่าเป็นความล่าช้า แต่พระองค์ทรงอดกลั้นพระทัยต่อท่านทั้งหลาย ไม่ทรงประสงค์ให้ผู้ใดพินาศเลย แต่ทรงประสงค์ให้ทุกคนกลับใจใหม่"},{"verse":10,"text":"แต่วันขององค์พระผู้เป็นเจ้าจะมาถึงเหมือนขโมย ในวันนั้น ฟ้าสวรรค์จะหายไปด้วยเสียงดังกึกก้อง บรรดาสิ่งทรงสร้างจะถูกเผาและละลายไป และแผ่นดินโลกพร้อมกิจการต่าง ๆ บนนั้นจะถูกเปิดเผย"},{"verse":11,"text":"ในเมื่อทุกสิ่งจะถูกทำลายอย่างนี้ ท่านทั้งหลายสมควรเป็นคนเช่นไร? ท่านสมควรประพฤติตนในความบริสุทธิ์และความเคร่งในพระเจ้า"},{"verse":12,"text":"ขณะที่ท่านรอคอยและเร่งให้วันแห่งพระเจ้าเสด็จมาถึงโดยเร็ว ในวันนั้น ฟ้าสวรรค์จะถูกเผาด้วยไฟและละลายไป และบรรดาสิ่งทรงสร้างจะถูกเผาและหลอมละลาย"},{"verse":13,"text":"แต่ตามพระสัญญาของพระองค์ เรารอคอยฟ้าสวรรค์ใหม่และแผ่นดินโลกใหม่ ที่ซึ่งความชอบธรรมสถิตอยู่"},{"verse":14,"text":"เพราะฉะนั้น ท่านที่รัก ขณะที่ท่านรอคอยสิ่งเหล่านี้ จงเพียรพยายามที่จะเป็นผู้ปราศจากรอยด่างและตำหนิ และมีสันติสุขในสายพระเนตรของพระองค์"},{"verse":15,"text":"และจงถือว่าความอดกลั้นพระทัยขององค์พระผู้เป็นเจ้าของเรานั้นเป็นความรอด ดังที่เปาโล พี่น้องที่รักของเรา ได้เขียนถึงท่านทั้งหลายตามสติปัญญาที่ทรงประทานให้แก่เขา"},{"verse":16,"text":"เช่นเดียวกับที่เขาได้กล่าวในจดหมายของเขาทุกฉบับเรื่องสิ่งเหล่านี้ ในจดหมายเหล่านั้นมีบางสิ่งที่ยากจะเข้าใจ ซึ่งคนโง่เขลาและไม่มั่นคงได้บิดเบือนเสีย เช่นเดียวกับที่พวกเขาบิดเบือนพระคัมภีร์อื่น ๆ จนนำพวกเขาไปสู่ความพินาศของตน"},{"verse":17,"text":"เพราะฉะนั้น ท่านที่รัก ในเมื่อท่านรู้สิ่งเหล่านี้ล่วงหน้าแล้ว จงระวังตัว เพื่อท่านจะไม่ถูกพาไปด้วยความหลงผิดของพวกคนนอกกฎหมาย และร่วงหล่นจากความมั่นคงของท่าน"},{"verse":18,"text":"แต่จงเจริญขึ้นในพระคุณและความรู้ของพระเยซูคริสต์องค์พระผู้เป็นเจ้าและพระผู้ช่วยให้รอดของเรา ขอพระสิริจงมีแด่พระองค์ทั้งบัดนี้และจนถึงวันนิรันดร์ อาเมน"}]}]},{"osis":"1John","usfm":"1JN","name_en":"1 John","name_th":"จดหมายฉบับที่หนึ่งของยอห์น","chapters":[{"chapter":1,"verses":[{"verse":1,"text":"สิ่งที่ดำรงอยู่ตั้งแต่ปฐมกาล สิ่งที่เราทั้งหลายได้ยิน สิ่งที่เราได้เห็นด้วยตาของเรา สิ่งที่เราได้เพ่งพินิจ และมือของเราได้สัมผัส คือเรื่องของพระวาทะแห่งชีวิต"},{"verse":2,"text":"และชีวิตนั้นได้ทรงสำแดงพระองค์ให้ปรากฏ เราได้เห็นและเป็นพยาน และเราประกาศแก่ท่านทั้งหลายถึงชีวิตนิรันดร์นั้น ซึ่งเดิมทรงดำรงอยู่กับพระบิดา และได้ทรงสำแดงพระองค์ให้ปรากฏแก่เรา"},{"verse":3,"text":"สิ่งที่เราได้เห็นและได้ยินนั้น เราประกาศแก่ท่านทั้งหลายด้วย เพื่อท่านทั้งหลายจะได้มีส่วนร่วมกับเรา และการมีส่วนร่วมของเรานั้นก็คือกับพระบิดาและกับพระบุตรของพระองค์ คือพระเยซูคริสต์"},{"verse":4,"text":"และเราเขียนสิ่งเหล่านี้เพื่อความยินดีของเราจะเต็มบริบูรณ์"},{"verse":5,"text":"และนี่คือถ้อยแถลงที่เราได้ยินจากพระองค์ และเราประกาศแก่ท่านทั้งหลาย คือ พระเจ้าทรงเป็นความสว่าง และในพระองค์ไม่มีความมืดเลย"},{"verse":6,"text":"ถ้าเรากล่าวว่าเรามีส่วนร่วมกับพระองค์ แต่เรากลับดำเนินในความมืด เราก็โกหก และไม่ได้ปฏิบัติตามความจริง"},{"verse":7,"text":"แต่ถ้าเราดำเนินในความสว่างเหมือนพระองค์ทรงสถิตในความสว่าง เราก็มีส่วนร่วมซึ่งกันและกัน และพระโลหิตของพระเยซูพระบุตรของพระองค์ก็ชำระเราให้พ้นจากบาปทั้งสิ้น"},{"verse":8,"text":"ถ้าเรากล่าวว่าเราไม่มีบาป เราก็หลอกตัวเอง และความจริงก็ไม่อยู่ในเรา"},{"verse":9,"text":"ถ้าเราสารภาพบาปของเรา พระองค์ทรงสัตย์ซื่อและทรงชอบธรรม จะทรงอภัยบาปของเรา และทรงชำระเราจากความอธรรมทั้งสิ้น"},{"verse":10,"text":"ถ้าเรากล่าวว่าเราไม่ได้ทำบาป เราก็ทำให้พระองค์เป็นคนโกหก และพระวจนะของพระองค์ก็ไม่อยู่ในเรา"}]},{"chapter":2,"verses":[{"verse":1,"text":"ลูกที่รักของข้าพเจ้า ข้าพเจ้าเขียนสิ่งเหล่านี้ถึงท่านทั้งหลายเพื่อท่านจะไม่ทำบาป และถ้าผู้ใดทำบาป เราก็มีพระผู้ช่วยที่อยู่ต่อพระพักตร์พระบิดา คือพระเยซูคริสต์ผู้ทรงชอบธรรม"},{"verse":2,"text":"และพระองค์เองทรงเป็นเครื่องบูชาไถ่บาปของเราทั้งหลาย และไม่เพียงเฉพาะของเราเท่านั้น แต่เป็นเครื่องบูชาไถ่บาปของคนทั้งโลกด้วย"},{"verse":3,"text":"และโดยสิ่งนี้ เรารู้ได้ว่าเรารู้จักพระองค์ คือถ้าเรารักษาพระบัญญัติของพระองค์"},{"verse":4,"text":"ผู้ที่กล่าวว่า “ข้าพเจ้ารู้จักพระองค์” แต่ไม่รักษาพระบัญญัติของพระองค์ ผู้นั้นก็เป็นคนโกหก และความจริงไม่อยู่ในเขา"},{"verse":5,"text":"แต่ผู้ใดรักษาพระดำรัสของพระองค์ ความรักของพระเจ้าก็ได้สมบูรณ์ในผู้นั้นอย่างแท้จริง โดยสิ่งนี้ เรารู้ว่าเราอยู่ในพระองค์"},{"verse":6,"text":"ผู้ที่อ้างว่าตนอยู่ในพระองค์ ก็ต้องดำเนินชีวิตเหมือนที่พระองค์ทรงดำเนิน"},{"verse":7,"text":"ท่านที่รัก ข้าพเจ้าไม่ได้เขียนพระบัญญัติใหม่ถึงท่าน แต่เป็นพระบัญญัติเก่าที่ท่านมีมาตั้งแต่ปฐมกาล พระบัญญัติเก่านี้ก็คือถ้อยคำที่ท่านได้ยินแล้ว"},{"verse":8,"text":"อีกประการหนึ่ง ข้าพเจ้าก็เขียนพระบัญญัติใหม่ถึงท่าน เป็นสิ่งที่จริงทั้งในพระองค์และในท่านทั้งหลาย เพราะความมืดกำลังจางหาย และความสว่างที่แท้จริงก็ส่องอยู่แล้ว"},{"verse":9,"text":"ผู้ที่กล่าวว่าตนอยู่ในความสว่าง แต่เกลียดชังพี่น้องของตน ผู้นั้นก็ยังอยู่ในความมืดจนกระทั่งบัดนี้"},{"verse":10,"text":"ผู้ที่รักพี่น้องของตนก็อยู่ในความสว่าง และไม่มีเหตุให้สะดุดในผู้นั้น"},{"verse":11,"text":"แต่ผู้ที่เกลียดชังพี่น้องของตนก็อยู่ในความมืด และดำเนินอยู่ในความมืด และเขาไม่รู้ว่าตนกำลังไปไหน เพราะความมืดได้ทำให้ตาของเขาบอด"},{"verse":12,"text":"ลูกที่รักทั้งหลาย ข้าพเจ้าเขียนถึงท่าน เพราะบาปของท่านได้รับการอภัยแล้วโดยพระนามของพระองค์"},{"verse":13,"text":"บิดาทั้งหลาย ข้าพเจ้าเขียนถึงท่าน เพราะท่านรู้จักพระองค์ผู้ทรงดำรงอยู่ตั้งแต่ปฐมกาล คนหนุ่มทั้งหลาย ข้าพเจ้าเขียนถึงท่าน เพราะท่านได้ชนะมารร้ายแล้ว"},{"verse":14,"text":"เด็กทั้งหลาย ข้าพเจ้าได้เขียนถึงท่าน เพราะท่านรู้จักพระบิดา บิดาทั้งหลาย ข้าพเจ้าได้เขียนถึงท่าน เพราะท่านรู้จักพระองค์ผู้ทรงดำรงอยู่ตั้งแต่ปฐมกาล คนหนุ่มทั้งหลาย ข้าพเจ้าได้เขียนถึงท่าน เพราะท่านเข้มแข็ง และพระวจนะของพระเจ้าก็อยู่ในท่าน และท่านได้ชนะมารร้ายแล้ว"},{"verse":15,"text":"อย่ารักโลก หรือสิ่งใดในโลก ถ้าผู้ใดรักโลก ความรักของพระบิดาก็ไม่อยู่ในผู้นั้น"},{"verse":16,"text":"เพราะทุกสิ่งที่อยู่ในโลก คือ ตัณหาของเนื้อหนัง ตัณหาของตา และความเย่อหยิ่งในชีวิต ไม่ได้มาจากพระบิดา แต่มาจากโลก"},{"verse":17,"text":"และโลกพร้อมกับตัณหาของมันก็กำลังจางหายไป แต่ผู้ที่ทำตามพระประสงค์ของพระเจ้าจะดำรงอยู่ตลอดกาล"},{"verse":18,"text":"เด็กทั้งหลาย เวลานี้เป็นวาระสุดท้าย และตามที่ท่านได้ยินว่าผู้ต่อต้านพระคริสต์กำลังจะมา และบัดนี้ก็มีผู้ต่อต้านพระคริสต์มากมายเกิดขึ้นแล้ว ด้วยเหตุนั้น เราจึงรู้ว่าเวลานี้เป็นวาระสุดท้าย"},{"verse":19,"text":"พวกเขาออกจากพวกเราไป แต่พวกเขาไม่เคยเป็นของพวกเรา เพราะถ้าพวกเขาเป็นของพวกเรา พวกเขาคงอยู่กับเราต่อไป แต่การที่พวกเขาออกไปก็ทำให้ปรากฏชัดว่า ไม่มีใครในพวกเขาเป็นของพวกเราเลย"},{"verse":20,"text":"ส่วนท่านทั้งหลาย ท่านได้รับการเจิมจากพระผู้บริสุทธิ์ และท่านทุกคนรู้"},{"verse":21,"text":"ข้าพเจ้าไม่ได้เขียนถึงท่าน เพราะท่านไม่รู้ความจริง แต่เพราะท่านรู้ความจริงนั้น และเพราะคำโกหกใด ๆ ก็ไม่ได้มาจากความจริง"},{"verse":22,"text":"ผู้ใดเล่าคือคนโกหก ถ้าไม่ใช่ผู้ที่ปฏิเสธว่าพระเยซูเป็นพระคริสต์? ผู้นั้นแหละเป็นผู้ต่อต้านพระคริสต์ คือผู้ที่ปฏิเสธทั้งพระบิดาและพระบุตร"},{"verse":23,"text":"ทุกคนที่ปฏิเสธพระบุตรก็ไม่มีพระบิดาด้วย ผู้ที่สารภาพรับพระบุตรก็มีพระบิดาด้วย"},{"verse":24,"text":"ส่วนท่านทั้งหลาย จงให้สิ่งที่ท่านได้ยินมาตั้งแต่ปฐมกาลคงอยู่ในท่าน ถ้าสิ่งที่ท่านได้ยินมาตั้งแต่ปฐมกาลคงอยู่ในท่าน ท่านก็จะคงอยู่ในพระบุตรและในพระบิดาด้วย"},{"verse":25,"text":"และนี่คือพระสัญญาที่พระองค์เองทรงสัญญาแก่เรา คือชีวิตนิรันดร์"},{"verse":26,"text":"ข้าพเจ้าได้เขียนสิ่งเหล่านี้ถึงท่าน เกี่ยวกับผู้ที่กำลังพยายามล่อลวงท่าน"},{"verse":27,"text":"ส่วนท่านทั้งหลาย การเจิมที่ท่านได้รับจากพระองค์นั้น คงอยู่ในท่าน และท่านก็ไม่จำเป็นต้องให้ใครสอนท่าน แต่เหมือนการเจิมของพระองค์สอนท่านในทุกสิ่ง การเจิมนั้นจริงและไม่เป็นเท็จ และตามที่พระองค์ได้ทรงสอนท่าน ท่านก็จงคงอยู่ในพระองค์"},{"verse":28,"text":"และบัดนี้ ลูกที่รักทั้งหลาย จงคงอยู่ในพระองค์ เพื่อว่าเมื่อพระองค์ทรงสำแดงพระองค์ เราจะมีความกล้าและไม่ละอายต่อพระองค์ในการเสด็จมาของพระองค์"},{"verse":29,"text":"ถ้าท่านรู้ว่าพระองค์ทรงชอบธรรม ท่านก็รู้ว่าทุกคนที่ประพฤติชอบธรรมก็ได้บังเกิดจากพระองค์"}]},{"chapter":3,"verses":[{"verse":1,"text":"จงดูเถิด พระบิดาทรงประทานความรักอันยิ่งใหญ่เพียงใดแก่เรา ที่เราจะได้ชื่อว่าเป็นบุตรของพระเจ้า และเราก็เป็นเช่นนั้นจริง ๆ ด้วยเหตุนี้ โลกจึงไม่รู้จักเรา เพราะโลกไม่รู้จักพระองค์"},{"verse":2,"text":"ท่านที่รัก บัดนี้เราเป็นบุตรของพระเจ้า และยังไม่ปรากฏให้รู้ว่าต่อไปเราจะเป็นเช่นไร แต่เรารู้ว่าเมื่อพระองค์ทรงสำแดงพระองค์ เราจะเป็นเหมือนพระองค์ เพราะเราจะได้เห็นพระองค์อย่างที่พระองค์ทรงเป็น"},{"verse":3,"text":"และทุกคนที่มีความหวังนี้ในพระองค์ ก็ชำระตนให้บริสุทธิ์ เหมือนพระองค์ทรงบริสุทธิ์"},{"verse":4,"text":"ทุกคนที่ทำบาปก็ทำการละเมิดธรรมบัญญัติด้วย และบาปก็คือการละเมิดธรรมบัญญัติ"},{"verse":5,"text":"ท่านทั้งหลายก็รู้ว่าพระองค์ได้ทรงสำแดงพระองค์ให้ปรากฏ เพื่อกำจัดบาปทั้งหลายออกไป และในพระองค์ไม่มีบาปเลย"},{"verse":6,"text":"ทุกคนที่คงอยู่ในพระองค์ก็ไม่ได้ทำบาปต่อไป ทุกคนที่ทำบาปต่อไปก็ไม่ได้เห็นพระองค์ หรือรู้จักพระองค์เลย"},{"verse":7,"text":"ลูกที่รักทั้งหลาย อย่าให้ใครล่อลวงท่าน ผู้ที่ประพฤติชอบธรรมก็เป็นคนชอบธรรม เหมือนพระองค์ทรงชอบธรรม"},{"verse":8,"text":"ผู้ที่ทำบาปก็เป็นของมาร เพราะมารทำบาปตั้งแต่ปฐมกาล เพราะเหตุนี้พระบุตรของพระเจ้าจึงทรงสำแดงพระองค์ เพื่อทำลายกิจการของมาร"},{"verse":9,"text":"ทุกคนที่ได้บังเกิดจากพระเจ้าก็ไม่ได้ทำบาปต่อไป เพราะพระเมล็ดพันธุ์ของพระเจ้าคงอยู่ในเขา และเขาไม่สามารถทำบาปต่อไปได้ เพราะเขาได้บังเกิดจากพระเจ้าแล้ว"},{"verse":10,"text":"โดยสิ่งนี้ บุตรของพระเจ้ากับบุตรของมารก็ปรากฏชัด คือ ทุกคนที่ไม่ประพฤติชอบธรรมก็ไม่ได้เป็นของพระเจ้า และผู้ที่ไม่รักพี่น้องของตนก็เช่นกัน"},{"verse":11,"text":"เพราะนี่คือถ้อยแถลงที่ท่านได้ยินมาตั้งแต่ปฐมกาล ได้แก่ ให้เรารักซึ่งกันและกัน"},{"verse":12,"text":"อย่าเป็นเหมือนคาอินที่เป็นของมารร้าย และฆ่าน้องชายของตน เหตุใดเขาจึงฆ่าน้องชาย? เพราะการกระทำของเขาชั่วร้าย ส่วนการกระทำของน้องชายเขาเป็นการชอบธรรม"},{"verse":13,"text":"พี่น้องทั้งหลาย อย่าประหลาดใจหากโลกเกลียดชังท่าน"},{"verse":14,"text":"เรารู้ว่าเราได้ผ่านพ้นจากความตายไปสู่ชีวิต เพราะเรารักพี่น้อง ผู้ที่ไม่รักก็คงอยู่ในความตาย"},{"verse":15,"text":"ทุกคนที่เกลียดชังพี่น้องของตนเป็นฆาตกร และท่านทั้งหลายรู้ว่า ฆาตกรไม่มีชีวิตนิรันดร์คงอยู่ในตน"},{"verse":16,"text":"โดยสิ่งนี้ เราจึงรู้จักความรัก คือพระองค์ได้ทรงสละพระชนม์ของพระองค์เพื่อเรา และเราเองก็ต้องสละชีวิตของเราเพื่อพี่น้องด้วย"},{"verse":17,"text":"แต่ผู้ใดมีทรัพย์สมบัติในโลกนี้ และเห็นพี่น้องของตนขัดสน แล้วปิดใจกรุณาของตนต่อพี่น้องนั้น ความรักของพระเจ้าจะคงอยู่ในผู้นั้นได้อย่างไร?"},{"verse":18,"text":"ลูกที่รักทั้งหลาย อย่าให้เรารักเพียงคำพูดหรือเพียงปาก แต่ให้รักด้วยการกระทำและความจริง"},{"verse":19,"text":"และโดยสิ่งนี้ เราจะรู้ว่าเราเป็นของความจริง และเราจะทำให้ใจของเราเชื่อมั่นต่อพระพักตร์พระองค์"},{"verse":20,"text":"เพราะถ้าใจของเรากล่าวโทษเรา พระเจ้าทรงยิ่งใหญ่กว่าใจของเรา และพระองค์ทรงรู้ทุกสิ่ง"},{"verse":21,"text":"ท่านที่รัก ถ้าใจของเราไม่กล่าวโทษเรา เราก็มีความกล้าต่อพระเจ้า"},{"verse":22,"text":"และสิ่งใดที่เราทูลขอ เราก็ได้รับจากพระองค์ เพราะเรารักษาพระบัญญัติของพระองค์ และทำสิ่งที่พอพระทัยพระองค์"},{"verse":23,"text":"และนี่คือพระบัญญัติของพระองค์ ได้แก่ ให้เราเชื่อในพระนามของพระบุตรของพระองค์ คือพระเยซูคริสต์ และให้เรารักซึ่งกันและกัน เหมือนที่พระองค์ทรงบัญญัติไว้แก่เรา"},{"verse":24,"text":"และผู้ที่รักษาพระบัญญัติของพระองค์ก็คงอยู่ในพระองค์ และพระองค์ก็คงอยู่ในผู้นั้น โดยสิ่งนี้ เราจึงรู้ว่าพระองค์คงอยู่ในเรา คือโดยทางพระวิญญาณที่พระองค์ทรงประทานให้เรา"}]},{"chapter":4,"verses":[{"verse":1,"text":"ท่านที่รัก อย่าเชื่อทุกวิญญาณ แต่จงทดสอบวิญญาณว่ามาจากพระเจ้าหรือไม่ เพราะผู้เผยพระวจนะเท็จมากมายได้ออกไปในโลก"},{"verse":2,"text":"โดยสิ่งนี้ ท่านจะรู้จักพระวิญญาณของพระเจ้า คือ วิญญาณใดที่สารภาพรับว่าพระเยซูคริสต์ได้เสด็จมาในเนื้อหนัง วิญญาณนั้นมาจากพระเจ้า"},{"verse":3,"text":"และวิญญาณใดที่ไม่สารภาพรับพระเยซู วิญญาณนั้นก็ไม่ได้มาจากพระเจ้า และนี่คือวิญญาณของผู้ต่อต้านพระคริสต์ ซึ่งท่านได้ยินว่ากำลังจะมา และบัดนี้ก็อยู่ในโลกแล้ว"},{"verse":4,"text":"ลูกที่รักทั้งหลาย ท่านเป็นของพระเจ้า และท่านได้ชนะคนเหล่านั้นแล้ว เพราะพระองค์ผู้สถิตในท่านยิ่งใหญ่กว่าผู้ที่อยู่ในโลก"},{"verse":5,"text":"พวกเขาเป็นของโลก เพราะเหตุนี้ พวกเขาจึงพูดตามโลก และโลกก็ฟังพวกเขา"},{"verse":6,"text":"เราเป็นของพระเจ้า ผู้ที่รู้จักพระเจ้าก็ฟังเรา ผู้ที่ไม่ได้เป็นของพระเจ้าก็ไม่ฟังเรา โดยสิ่งนี้ เราจึงรู้จักพระวิญญาณแห่งความจริง และวิญญาณแห่งความหลงผิด"},{"verse":7,"text":"ท่านที่รัก ให้เรารักซึ่งกันและกัน เพราะความรักมาจากพระเจ้า และทุกคนที่รักก็ได้บังเกิดจากพระเจ้า และรู้จักพระเจ้า"},{"verse":8,"text":"ผู้ที่ไม่รักก็ไม่รู้จักพระเจ้า เพราะพระเจ้าทรงเป็นความรัก"},{"verse":9,"text":"โดยสิ่งนี้ ความรักของพระเจ้าได้ปรากฏท่ามกลางเรา คือ พระเจ้าทรงใช้พระบุตรองค์เดียวของพระองค์มาในโลก เพื่อเราจะมีชีวิตโดยทางพระองค์"},{"verse":10,"text":"ความรักนั้นอยู่ในสิ่งนี้ คือ มิใช่ที่เรารักพระเจ้า แต่เป็นที่พระองค์ทรงรักเรา และทรงใช้พระบุตรของพระองค์มาเป็นเครื่องบูชาไถ่บาปของเรา"},{"verse":11,"text":"ท่านที่รัก ถ้าพระเจ้าทรงรักเราถึงเพียงนั้น เราเองก็ต้องรักซึ่งกันและกันด้วย"},{"verse":12,"text":"ไม่มีผู้ใดเคยเห็นพระเจ้าเลย ถ้าเรารักซึ่งกันและกัน พระเจ้าก็คงอยู่ในเรา และความรักของพระองค์ก็สมบูรณ์ในเรา"},{"verse":13,"text":"โดยสิ่งนี้ เราจึงรู้ว่าเราคงอยู่ในพระองค์ และพระองค์คงอยู่ในเรา คือพระองค์ทรงประทานพระวิญญาณของพระองค์ให้แก่เรา"},{"verse":14,"text":"และเราได้เห็นแล้วและเป็นพยานว่าพระบิดาทรงใช้พระบุตรมาเป็นพระผู้ช่วยให้รอดของโลก"},{"verse":15,"text":"ผู้ใดสารภาพรับว่าพระเยซูทรงเป็นพระบุตรของพระเจ้า พระเจ้าก็คงอยู่ในผู้นั้น และผู้นั้นก็คงอยู่ในพระเจ้า"},{"verse":16,"text":"และเราได้รู้จักและเชื่อในความรักที่พระเจ้าทรงมีต่อเรา พระเจ้าทรงเป็นความรัก ผู้ใดที่คงอยู่ในความรักก็คงอยู่ในพระเจ้า และพระเจ้าก็คงอยู่ในผู้นั้น"},{"verse":17,"text":"ความรักนั้นสมบูรณ์ในหมู่เราโดยสิ่งนี้ เพื่อว่าเราจะมีความกล้าในวันแห่งการพิพากษา เพราะพระองค์ทรงเป็นเช่นไร เราในโลกนี้ก็เป็นเช่นนั้น"},{"verse":18,"text":"ในความรักไม่มีความกลัว แต่ความรักที่สมบูรณ์ก็ขับความกลัวออกไป เพราะความกลัวมาพร้อมกับการลงโทษ ผู้ที่ยังกลัวอยู่ก็ยังไม่สมบูรณ์ในความรัก"},{"verse":19,"text":"เรารัก เพราะพระองค์ทรงรักเราก่อน"},{"verse":20,"text":"ถ้าผู้ใดกล่าวว่า “ข้าพเจ้ารักพระเจ้า” แต่เกลียดชังพี่น้องของตน ผู้นั้นก็เป็นคนโกหก เพราะผู้ที่ไม่รักพี่น้องของตนซึ่งตนมองเห็น ก็ไม่สามารถรักพระเจ้าซึ่งตนไม่ได้เห็นได้"},{"verse":21,"text":"และเรามีพระบัญญัตินี้จากพระองค์ คือ ผู้ที่รักพระเจ้าก็จงรักพี่น้องของตนด้วย"}]},{"chapter":5,"verses":[{"verse":1,"text":"ทุกคนที่เชื่อว่าพระเยซูเป็นพระคริสต์ก็ได้บังเกิดจากพระเจ้า และทุกคนที่รักพระบิดาผู้ทรงให้กำเนิดก็รักผู้ที่ได้บังเกิดจากพระองค์ด้วย"},{"verse":2,"text":"โดยสิ่งนี้ เรารู้ว่าเรารักบุตรของพระเจ้า คือเมื่อเรารักพระเจ้า และปฏิบัติตามพระบัญญัติของพระองค์"},{"verse":3,"text":"เพราะนี่คือความรักต่อพระเจ้า คือการที่เรารักษาพระบัญญัติของพระองค์ และพระบัญญัติของพระองค์ก็ไม่หนักเกินไป"},{"verse":4,"text":"เพราะทุกคนที่ได้บังเกิดจากพระเจ้าก็มีชัยเหนือโลก และนี่คือชัยชนะที่ได้มีชัยเหนือโลก คือความเชื่อของเรา"},{"verse":5,"text":"ใครเล่าคือผู้ที่มีชัยเหนือโลก ถ้าไม่ใช่ผู้ที่เชื่อว่าพระเยซูเป็นพระบุตรของพระเจ้า?"},{"verse":6,"text":"ผู้นี้แหละคือผู้ที่ได้เสด็จมาโดยทางน้ำและโลหิต คือพระเยซูคริสต์ ไม่ใช่โดยน้ำเท่านั้น แต่โดยน้ำและโลหิต และพระวิญญาณทรงเป็นพยาน เพราะพระวิญญาณทรงเป็นความจริง"},{"verse":7,"text":"เพราะมีพยานสามฝ่าย"},{"verse":8,"text":"คือพระวิญญาณ น้ำ และโลหิต และทั้งสามฝ่ายนี้ก็เห็นเป็นหนึ่งเดียวกัน"},{"verse":9,"text":"ถ้าเรารับคำพยานของมนุษย์ คำพยานของพระเจ้าก็ยิ่งใหญ่กว่า เพราะนี่คือคำพยานของพระเจ้าที่พระองค์ทรงเป็นพยานเกี่ยวกับพระบุตรของพระองค์"},{"verse":10,"text":"ผู้ที่เชื่อในพระบุตรของพระเจ้าก็มีคำพยานนี้อยู่ในตน ผู้ที่ไม่เชื่อพระเจ้าก็ได้ทำให้พระองค์เป็นคนโกหก เพราะเขาไม่ได้เชื่อในคำพยานที่พระเจ้าทรงเป็นพยานเกี่ยวกับพระบุตรของพระ